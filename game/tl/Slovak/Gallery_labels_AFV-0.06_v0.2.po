# game/Gallery_labels_AFV-0.06_v0.2.rpy:9553 #-#-# translate crowdin label_gal_Lauren_Diaz_01_a7c37087:
msgid "[_L_] You should be able to help get Dad off on all charges right?"
msgstr "[_L_] Mala by si byť schopná pomôcť otcovi zbaviť sa všetkých obvinení, však?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9554 #-#-# translate crowdin label_gal_Lauren_Diaz_01_6bc64428:
msgid "[_AD_] Well, that was the original plan."
msgstr "[_AD_] Taký bol pôvodný plán."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9555 #-#-# translate crowdin label_gal_Lauren_Diaz_01_8b36a4cb:
msgid "[_AD_] But now Joey DeCapo is happier with the arrangement as it is now. He's getting paid each week, or he's gettina a visit from your mom."
msgstr "[_AD_] Joey DeCapo je však teraz spokojnejší s terajším usporiadaním. Každý týždeň dostáva výplatu alebo ho navštevuje tvoja mama."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9556 #-#-# translate crowdin label_gal_Lauren_Diaz_01_36545c57:
msgid "[_AD_] He actually enjoys those visits more than he does the money."
msgstr "[_AD_] V skutočnosti sa z týchto návštev teší viac ako z peňazí."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9557 #-#-# translate crowdin label_gal_Lauren_Diaz_01_c51a0b44:
msgid "[_AD_] Now he wants to keep your dad in jail as long as possible."
msgstr "[_AD_] Teraz chce udržať vášho otca vo väzení čo najdlhšie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9560 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f595fb80:
msgid "[_L_] Well, what do you want with us?"
