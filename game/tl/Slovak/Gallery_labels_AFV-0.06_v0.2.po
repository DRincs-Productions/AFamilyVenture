# game/Gallery_labels_AFV-0.06_v0.2.rpy:9561 #-#-# translate crowdin label_gal_Lauren_Diaz_01_1dfa9e70:
msgid "[_AD_] That's simple..."
msgstr "[_AD_] To je jednoduché..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9562 #-#-# translate crowdin label_gal_Lauren_Diaz_01_7916e651:
msgid "[_AD_] I'm here to extort you."
msgstr "[_AD_] Som tu, aby som vás vydierala."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9563 #-#-# translate crowdin label_gal_Lauren_Diaz_01_c6841c25_3:
msgid "[_R_] ..."
msgstr "[_R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9566 #-#-# translate crowdin label_gal_Lauren_Diaz_01_29c6f165:
msgid "[_R_] For what?"
msgstr "[_R_] Za čo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9567 #-#-# translate crowdin label_gal_Lauren_Diaz_01_d9f4be24:
msgid "[_AD_] Money and favors of course."
msgstr "[_AD_] Samozrejme, peniaze a láskavosti."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9568 #-#-# translate crowdin label_gal_Lauren_Diaz_01_83dd39a4:
msgid "[_R_] Favors?"
msgstr "[_R_] Priazeň?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9569 #-#-# translate crowdin label_gal_Lauren_Diaz_01_0b83320f:
msgid "[_R_] You mean if we don't pay you what you want, I have to do a strip dance for you?"
msgstr "[_R_] Chceš povedať, že ak ti nezaplatíme toľko, koľko chceš, budem ti musieť zatancovať striptíz?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9570 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f384769e:
msgid "[_AD_] Haha.... do you see the pant-suit?"
msgstr "[_AD_] Haha.... vidíš nohavicový oblek?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9571 #-#-# translate crowdin label_gal_Lauren_Diaz_01_41847f48:
msgid "[_AD_] It's not you I would want to see lose their clothes."
msgstr "[_AD_] Nie si to ty, koho by som chcela vidieť, ako stráca šaty."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9572 #-#-# translate crowdin label_gal_Lauren_Diaz_01_5c05342c:
