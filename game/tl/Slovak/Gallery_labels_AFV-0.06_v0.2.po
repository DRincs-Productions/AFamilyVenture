# game/Gallery_labels_AFV-0.06_v0.2.rpy:37011 #-#-# translate crowdin label_gal_cosplay_02_6a183bc8:
msgid "[_R_] Not yet, but don't tell her. I don't want to get her hopes up until we are doing better."
