# game/Gallery_labels_AFV-0.06_v0.2.rpy:3732 #-#-# translate crowdin label_gal_mom_ph_read_9c03ac9d:
msgid "[_RT_] {i}Perry Hotter and the Sorceror's Bone...{/i}"
