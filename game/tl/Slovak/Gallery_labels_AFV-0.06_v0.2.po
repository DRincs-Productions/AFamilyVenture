# game/Gallery_labels_AFV-0.06_v0.2.rpy:37023 #-#-# translate crowdin label_gal_cosplay_02_bfd8516a:
msgid "[_S_] Good for you little brother! Keep it up and maybe we will be able to get along without Dad after all."
msgstr "[_S_] Dobre pre teba, bratíčku! Pokračuj v tom a možno sa nám podarí vydržať bez otca."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37025 #-#-# translate crowdin label_gal_cosplay_02_0770ae02:
msgid "[_R_] Why should I be the one responsible to pay off the debt every week, Mom can help out too."
