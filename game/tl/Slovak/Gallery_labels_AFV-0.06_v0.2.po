# game/Gallery_labels_AFV-0.06_v0.2.rpy:13780 #-#-# translate crowdin label_gal_Sidney_park_activities_01e83a86:
msgid "[_RT_] {i}Could Sidney be right? Could I really have a chance with Mrs. Stone?{/i}"
msgstr "[_RT_] {i}Môže Sidney byť správne? Mohol by som naozaj mať šancu s pani Stoneou?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13782 #-#-# translate crowdin label_gal_Sidney_park_activities_4b2ab474:
msgid "[_R_] I'm over her. I've got another girl in mind."
msgstr "[_ R_] Som nad ňou. Mám na mysli ďalšie dievča."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13783 #-#-# translate crowdin label_gal_Sidney_park_activities_b19a116f:
msgid "[_R_] One that lives a little closer to home, if you know what I mean."
msgstr "[_ R_] Jeden, ktorý žije trochu bližšie k domovu, ak viete, čo tým myslím."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13784 #-#-# translate crowdin label_gal_Sidney_park_activities_c7a7f7d1:
msgid "[_RT_] {i}Actually several, but Sidney will think I just mean her.{/i}"
msgstr "[_RT_] {i}Vlastne niekoľko, ale Sidney bude myslieť, že som to proste myslel. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13785 #-#-# translate crowdin label_gal_Sidney_park_activities_93e19acf:
msgid "[_RT_] {i}At least I'm pretty sure that's what she wants to hear.{/i}"
msgstr "[_RT_] {i}Aspoň som si istý, že to chce počuť. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13786 #-#-# translate crowdin label_gal_Sidney_park_activities_c00317dc:
msgid "[_S_] Well, the park will be a lot less interesting with Mr. Peterson gone."
msgstr "No, park bude oveľa menej zaujímavý s pánom Petersonom preč."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13787 #-#-# translate crowdin label_gal_Sidney_park_activities_e82de818:
msgid "[_S_] Unless we can find a way to make it more interesting."
msgstr "[_S_] Ak nenájdeme spôsob, ako by sme to mohli urobiť zaujímavejšie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13788 #-#-# translate crowdin label_gal_Sidney_park_activities_9fa4c171:
msgid "[_S_] I'll beat you home!"
msgstr "[_S_] Porazím vás!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13793 #-#-# translate crowdin label_gal_Sidney_park_activities_1705afeb:
msgid "[_RT_] And that's all the memory I have of that event!"
msgstr "[_RT_] A to je všetko, čo si z tejto udalosti pamätám!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13802 #-#-# translate crowdin label_gal_Sidney_club_trick_34a9d44a:
msgid "[_RT_] {i}Looks like Lauren's watching her ponies show again.{/i}"
msgstr "[_RT_] {i}Vyzerá to tak, že Lauren opäť sleduje svoj seriál o poníkoch.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13803 #-#-# translate crowdin label_gal_Sidney_club_trick_e81a1dd4:
msgid "DING DONG"
msgstr "DING DONG"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13804 #-#-# translate crowdin label_gal_Sidney_club_trick_47a6f8a0:
msgid "[_RT_] {i}That's the doorbell. I'm pretty sure I know who that is.{/i}"
msgstr "[_RT_] {i}To je zvonček. Som si celkom istý, že viem, kto to je.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13809 #-#-# translate crowdin label_gal_Sidney_club_trick_1a5d2dea:
msgid "[_J_] Hello little boy, is [mom_name] at home?"
msgstr "[_J_] Ahoj malý chlapec, je [mom_name] doma?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13812 #-#-# translate crowdin label_gal_Sidney_club_trick_63899ea1:
msgid "{i}\"A few minutes earlier.\"{/i}"
msgstr "{i}\"O pár minút skôr.\" {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13815 #-#-# translate crowdin label_gal_Sidney_club_trick_376519e8:
msgid "[_ST_] {i}I don't have much time. I've got to make this fast.{/i}"
msgstr "[_ST_] {i}Ja nemám veľa času. Musím to urobiť rýchlo. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13816 #-#-# translate crowdin label_gal_Sidney_club_trick_91362ee6:
msgid "[_ST_] {i}If I were [ryan], where would I hide my money?{/i}"
msgstr "[_ST_] {i}Ak by som bol [ryan], kde by som skryť svoje peniaze? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13819 #-#-# translate crowdin label_gal_Sidney_club_trick_5e4b6846:
msgid "[_ST_] {i}It's not in his desk.{/i}"
msgstr "[_ST_] {i}Nie je to v jeho stole. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13822 #-#-# translate crowdin label_gal_Sidney_club_trick_28604ff5:
msgid "[_ST_] {i}No shoe boxes of cash under the bed.{/i}"
msgstr "[_ST_] {i}Žiadne topánky krabice v hotovosti pod posteľou. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13825 #-#-# translate crowdin label_gal_Sidney_club_trick_ddc9e671:
msgid "[_ST_] {i}Bingo....{/i}"
msgstr "[_ST_] {i}Bingo .... {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13826 #-#-# translate crowdin label_gal_Sidney_club_trick_930ca79c:
msgid "[_ST_] {i}That's a lot of cash just sitting in his top drawer.{/i}"
msgstr "[_ST_] {i}To je veľa peňazí, len sedí vo svojej vrchnej zásuvke. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13827 #-#-# translate crowdin label_gal_Sidney_club_trick_2c5d9aff:
msgid "[_ST_] {i}As soon as Mom's off to the club, I'll put it right back.{/i}"
msgstr "[_ST_] {i}Akonáhle mama je mimo klubu, dám to hneď späť. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13828 #-#-# translate crowdin label_gal_Sidney_club_trick_2058127b:
msgid "[_ST_] {i}I can't believe I'm doing this.{/i}"
msgstr "[_ST_] {i}Nemôžem uveriť, že robím toto. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13829 #-#-# translate crowdin label_gal_Sidney_club_trick_286d5629:
msgid "[_ST_] {i}What has come over me lately?{/i}"
msgstr "[_ST_] {i}Čo sa mi v poslednej dobe deje? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13830 #-#-# translate crowdin label_gal_Sidney_club_trick_e02ae6a7:
msgid "[_ST_] {i}I think it's just the fact that Mom has always been such a prude.{/i}"
msgstr "[_ST_] {i}Myslím si, že je to len fakt, že mama bola vždy taká prude. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13831 #-#-# translate crowdin label_gal_Sidney_club_trick_be122b2c:
msgid "[_ST_] {i}I can't even imaging her stripping on a stage.{/i}"
msgstr "[_ST_] {i}Nemôžem ani zobraziť jej stripovanie na javoroch. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13832 #-#-# translate crowdin label_gal_Sidney_club_trick_1e94d931:
msgid "[_ST_] {i}I've got to see it to believe it.{/i}"
msgstr "[_ST_] {i}Musím to vidieť, aby som tomu veril. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13833 #-#-# translate crowdin label_gal_Sidney_club_trick_eac5a0c1:
msgid "[_ST_] {i}And if [ryan] doesn't have the cash to pay the Mafia, than Mom's got to go work the pole.{/i}"
msgstr "[_ST_] {i}A ak [ryan] nemá peniaze na zaplatenie mafii, ako mama musí ísť do práce tyč. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13834 #-#-# translate crowdin label_gal_Sidney_club_trick_461fc264:
msgid "[_ST_] {i}Shit!.... Am I going too far?....{/i}"
msgstr "[_ST_] {i}Do riti! .... Zašiel som príliš ďaleko?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13835 #-#-# translate crowdin label_gal_Sidney_club_trick_e81a1dd4_1:
msgid "DING DONG"
msgstr "DING DONG"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13836 #-#-# translate crowdin label_gal_Sidney_club_trick_1957ed99:
msgid "[_ST_] {i}Shit! That's probably them. I've got to really hurry and get my clubbing outfit on.{/i}"
msgstr "[_ST_] {i}Do riti! To je asi oni. Musím sa naozaj poponáhľať a dostať svoje clubbing oblečenie na. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13842 #-#-# translate crowdin label_gal_Sidney_club_trick_1a5d2dea_1:
msgid "[_J_] Hello little boy, is [mom_name] at home?"
msgstr "[_J_] Ahoj malý chlapec, je [mom_name] doma?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13843 #-#-# translate crowdin label_gal_Sidney_club_trick_907e3218:
msgid "[_RT_] {i}He knows I'm an adult by now. What an asshole.{/i}"
msgstr "[_RT_] {i}Vie, že som teraz dospelý. Aký debil. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13844 #-#-# translate crowdin label_gal_Sidney_club_trick_cf1fab13:
msgid "[_R_] Just a second."
msgstr "[_R_] Len sekundu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13845 #-#-# translate crowdin label_gal_Sidney_club_trick_970855d5:
msgid "[_R_] Hey Mom, there's some strange men at the door for you!"
msgstr "[_R_] Hej, mami, za dverami sú nejakí cudzí muži!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13848 #-#-# translate crowdin label_gal_Sidney_club_trick_2ad5f047:
msgid "[_R_] Wow, Mom! Looking good as ever!"
msgstr "Fíha, mami! Vyzerá dobre ako vždy!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13849 #-#-# translate crowdin label_gal_Sidney_club_trick_6656fe70:
msgid "[_M_] Please, [ryan].... not now."
msgstr "[_M_] Prosím, [ryan].... nie teraz."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13850 #-#-# translate crowdin label_gal_Sidney_club_trick_84e273a3:
msgid "[_M_] Were you able to get enough money together to pay them off this week?"
msgstr "[_M_] Podarilo sa ti tento týždeň získať dostatok peňazí na ich platbu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13851 #-#-# translate crowdin label_gal_Sidney_club_trick_74239e20:
msgid "[_R_] Of course, Mom, did you really doubt me?"
msgstr "[_R_] Samozrejme, mami, naozaj si o mne pochybovala?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13854 #-#-# translate crowdin label_gal_Sidney_club_trick_47a155b9:
msgid "[_R_] I've just got to run to my room and get it. I'll be right back."
msgstr "[_ R_] Len som sa dostal do mojej izby a dostať ho. Hneď som späť."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13859 #-#-# translate crowdin label_gal_Sidney_club_trick_b897a39c:
msgid "[_RT_] {i}What in the hell?!{/i}"
msgstr "[_RT_] {i}Čo do pekla?! {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13860 #-#-# translate crowdin label_gal_Sidney_club_trick_cbd3f10d:
msgid "[_RT_] {i}Where is my Goddamned money?{/i}"
msgstr "[_RT_] {i}Kde je moje Goddamned peniaze? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13861 #-#-# translate crowdin label_gal_Sidney_club_trick_77e4a19c:
msgid "[_RT_] {i}Shit.... What could have happened to it?{/i}"
msgstr "[_RT_] {i}Sakra .... Čo sa s ním mohlo stať? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13862 #-#-# translate crowdin label_gal_Sidney_club_trick_7e5dbab6:
msgid "[_RT_] {i}Did I leave it at the warehouse or something?{/i}"
msgstr "[_RT_] {i}Neopustila som ho v sklade alebo niečo? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13863 #-#-# translate crowdin label_gal_Sidney_club_trick_f0c31955:
msgid "[_RT_] {i}Fuck!.... The DeCapos aren't going to sit around while I look for it.{/i}"
msgstr "[_RT_] {i}jebať! .... DeCapos tu nesedia, kým sa na to pozriem. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13864 #-#-# translate crowdin label_gal_Sidney_club_trick_6a591152:
msgid "[_RT_] {i}How am I going to break the news to Mom?{/i}"
msgstr "[_RT_] {i}Ako odlomím správy k mame? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13869 #-#-# translate crowdin label_gal_Sidney_club_trick_cdc9e159:
msgid "[_R_] So, it turns out that I can't find my cash?"
msgstr "[_R_] Ukázalo sa, že nemôžem nájsť svoju hotovosť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13870 #-#-# translate crowdin label_gal_Sidney_club_trick_74201a25:
msgid "[_M_] What? No that can't be. Let me come help you look for it."
msgstr "[_M_] Čo? Nie, to nemôže byť. Dovoľte mi, aby som vám pomohol s tým."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13871 #-#-# translate crowdin label_gal_Sidney_club_trick_56b45535:
msgid "[_J_] I'm sorry [mom_name], but we aren't going to just hang around at your house until you find where Ron misplaced his cash."
msgstr "[_ J_] Je mi ľúto [mom_name], ale my sa nechystáme len visí okolo vášho domu, kým nenájdete, kde Ron znelo svoje peniaze."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13872 #-#-# translate crowdin label_gal_Sidney_club_trick_4189a79f:
msgid "[_R_] My name's [ryan], actually."
msgstr "[_ R_] Moje meno je [ryan], vlastne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13873 #-#-# translate crowdin label_gal_Sidney_club_trick_eeddfe87:
msgid "[_J_] So either you've got it, or you don't."
msgstr "Takže buď ho máš, alebo nie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13876 #-#-# translate crowdin label_gal_Sidney_club_trick_5f829f6c:
msgid "[_J_] And it looks like you don't got it."
msgstr "[_J_] A vyzerá to, že ste ho nezískali."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13877 #-#-# translate crowdin label_gal_Sidney_club_trick_6428a2de:
msgid "[_J_] So [mom_name], Why don't we go ahead and jump in the car."
msgstr "[_ J_] Takže [mom_name], Prečo nejdeme dopredu a skočíme do auta."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13878 #-#-# translate crowdin label_gal_Sidney_club_trick_3f6e100a:
msgid "[_R_] I'm so sorry Mom! I really have it. I just don't have a clue where it is right now."
msgstr "Je mi to tak ľúto mami! Naozaj to mám. Ja len nemám potušenie, kde je práve teraz."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13879 #-#-# translate crowdin label_gal_Sidney_club_trick_23ce227c:
msgid "[_M_] It's okay honey. We'll find it, and at least I won't have to go next week."
msgstr "[_ M_] To je v poriadku med. Nájdeme ho, a aspoň nebudem musieť ísť budúci týždeň."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13880 #-#-# translate crowdin label_gal_Sidney_club_trick_5bc5c0af:
msgid "[_RT_] {i}Shit!.... She looks so sad!{/i}"
msgstr "[_RT_] {i}Do riti! .... Vyzerá tak smutno!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13881 #-#-# translate crowdin label_gal_Sidney_club_trick_5291e93d:
msgid "[_J_] Ok, Let's get on our way."
msgstr "-Dobre, poďme na to."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13884 #-#-# translate crowdin label_gal_Sidney_club_trick_bb64a15e:
msgid "[_RT_] {i}There she goes off to the club.{/i}"
msgstr "[_RT_] {i}Tam odchádza do klubu.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13885 #-#-# translate crowdin label_gal_Sidney_club_trick_322c85a6:
msgid "[_RT_] {i}She seemed extra down tonight. I'd better jump on my scooter and head down to the club to make sure she's ok.{/i}"
msgstr "[_ RT_] {i}Zdalo sa, že dnes večer je mimo. Radšej skočím na skúter a odpálim sa do klubu, aby som sa uistil, že je v poriadku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13891 #-#-# translate crowdin label_gal_Sidney_club_trick_8904c035:
msgid "[_ST_] {i}Hopefully Mom doesn't mind if I borrow the car.{/i}"
msgstr "[_ST_] {i}Dúfajme, že mama nebude vadiť, keď si požičiam auto. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13892 #-#-# translate crowdin label_gal_Sidney_club_trick_74ae3aac:
msgid "[_ST_] {i}And that must be them driving off.{/i}"
msgstr "[_ST_] {i}A to musí byť ich jazda preč. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13893 #-#-# translate crowdin label_gal_Sidney_club_trick_632ce6d3:
msgid "[_ST_] {i}Now to follow from a discreet distance.{/i}"
msgstr "[_ST_] {i}Teraz nasledovať od diskrétnej vzdialenosti. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13901 #-#-# translate crowdin label_gal_Sidney_club_trick_0ceef333:
msgid "[_ST_] {i}So, this is the Mafia's club. It's pretty well hidden.{/i}"
msgstr "[_ST_] {i}Takže toto je Mafínsky klub. Je to celkom dobre skryté. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13902 #-#-# translate crowdin label_gal_Sidney_club_trick_eaae3917:
msgid "[_ST_] {i}I never could have found it on my own.{/i}"
msgstr "[_ST_] {i}Nikdy som to nemohol nájsť na vlastnú pätinu. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13903 #-#-# translate crowdin label_gal_Sidney_club_trick_d590e10c:
msgid "[_ST_] {i}I'll just go park around the corner.{/i}"
msgstr "[_ST_] {i}Budem len parkovať za rohom. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13904 #-#-# translate crowdin label_gal_Sidney_club_trick_230150ef:
msgid "[_ST_] {i}Hopefully I can get in.{/i}"
msgstr "[_ST_] {i}Dúfajme, že sa môžem dostať do. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13905 #-#-# translate crowdin label_gal_Sidney_club_trick_d89517b3:
msgid "[_ST_] {i}Somehow [ryan] was able to get in. I'm sure I'll find a way too.{/i}"
msgstr "[_ST_] {i}Niehow [ryan] bol schopný dostať sa do. Som si istý, že nájdem cestu taky."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13910 #-#-# translate crowdin label_gal_Sidney_club_trick_20b46912:
msgid "[_S_] Uhhh.... Hi.... Can I come in?"
msgstr "[_S_] Uhhh .... Ahoj ... Môžem ísť dnu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13911 #-#-# translate crowdin label_gal_Sidney_club_trick_668ff27f:
msgid "[_G_] Do you know the password?"
msgstr "[_G_] Poznáte heslo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13912 #-#-# translate crowdin label_gal_Sidney_club_trick_cfd5d96f:
msgid "[_S_] Uhh.... is it Scarface?"
msgstr "Je to Scarface?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13913 #-#-# translate crowdin label_gal_Sidney_club_trick_7570e50a:
msgid "[_G_] Is that supposed to be a joke?"
msgstr "To má byť vtip?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13914 #-#-# translate crowdin label_gal_Sidney_club_trick_aa33b69b:
msgid "[_S_] Ummmm.... I don't actually know the password.... But, I know one of the dancers, and I was hoping to go see her."
msgstr "[_S_] Ummmm .... Ja vlastne nepoznám heslo .... Ale, poznám jedného z tanečníkov, a dúfal som, že ju uvidím."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13915 #-#-# translate crowdin label_gal_Sidney_club_trick_0c31e2da:
msgid "[_G_] Oh really? Which one?"
msgstr "[_ G_] Oh naozaj? Ktorý z nich?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13916 #-#-# translate crowdin label_gal_Sidney_club_trick_15900924:
msgid "[_S_] Ummm.... [mom_name]."
msgstr "[_S_] Ummm .... [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13917 #-#-# translate crowdin label_gal_Sidney_club_trick_cfc03a7d:
msgid "[_G_] Oh yeah, [mom_name], of course! Why didn't you just say so in the first place."
msgstr "[_ G_] Oh áno, [mom_name], samozrejme! Prečo ste to nepovedali práve na prvom mieste."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13918 #-#-# translate crowdin label_gal_Sidney_club_trick_b5b3ff76:
msgid "[_S_] Any friend of [mom_name], is a friend to us."
msgstr "[_S_] Každý priateľ [mom_name], je to priateľ pre nás."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13919 #-#-# translate crowdin label_gal_Sidney_club_trick_15119a9e:
msgid "[_S_] Ummm.... Thank you?"
msgstr "[_S_] Ummm .... Ďakujem ti?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13920 #-#-# translate crowdin label_gal_Sidney_club_trick_19d9ae53:
msgid "[_G_] Of course.... Come on in."
msgstr "[_G_] Samozrejme .... Poď ďalej."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13929 #-#-# translate crowdin label_gal_Sidney_club_trick_345a2083:
msgid "[_ST_] {i}Wow! This place is so much bigger than it looks from the outside.{/i}"
msgstr "[_ST_] {i}Wow! Toto miesto je oveľa väčšie, ako to vyzerá zvonku. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13930 #-#-# translate crowdin label_gal_Sidney_club_trick_5c704644:
msgid "[_ST_] {i}And so many important people. I think I saw State Senetor McFeely by the craps table.{/i}"
msgstr "[_ST_] {i}A tak veľa dôležitých ľudí. Myslím, že som videl v tabuľke craps State Senetor McFeely. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13931 #-#-# translate crowdin label_gal_Sidney_club_trick_e9b2a89a:
msgid "[_ST_] {i}And I think I recognized that creep that was making lude gestures at me from the slot machine.{/i}"
msgstr "[_ST_] {i}A ja si myslím, že som spoznal ten krep, ktorý na mňa robí z automatového stroja lude. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13932 #-#-# translate crowdin label_gal_Sidney_club_trick_7ed38fc3:
msgid "[_ST_] {i}I think it was that school board member that Mom hates. I think his name is Bill, or Will Tylor, or something.{/i}"
msgstr "[_ST_] {i}Myslím si, že to bol člen školskej rady, ktorý mama nenávidí. Myslím, že jeho meno je Bill, alebo Will Tylor, alebo niečo. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13935 #-#-# translate crowdin label_gal_Sidney_club_trick_9b66c3b0:
msgid "[_J_] Well, hello there young lady."
msgstr "-Ahoj, mladá dáma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13936 #-#-# translate crowdin label_gal_Sidney_club_trick_0aad4e90:
msgid "[_S_] Oh shit!.... You scared me."
msgstr "Och, do riti! Vystrašil si ma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13937 #-#-# translate crowdin label_gal_Sidney_club_trick_dd39d110:
msgid "[_J_] I'm so sorry, allow me to introduce myself."
msgstr "[_ J_] Je mi to tak ľúto, dovoľte mi predstaviť sa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13940 #-#-# translate crowdin label_gal_Sidney_club_trick_ebea7511:
msgid "[_J_] My name is Joey DeCapo."
msgstr "Volám sa Joey DeCapo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13941 #-#-# translate crowdin label_gal_Sidney_club_trick_aa621b03:
msgid "[_J_] And you must be.... Sidney.... I think?"
msgstr "[_ J_] A vy musíte byť .... Sidney ... -Myslím, že?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13942 #-#-# translate crowdin label_gal_Sidney_club_trick_171494c7:
msgid "[_S_] Yes.... but how did you?...."
msgstr "[_S_] Áno .... ale ako ste sa ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13943 #-#-# translate crowdin label_gal_Sidney_club_trick_74d6ad58:
msgid "[_J_] I pay a lot of people a lot of money to make sure I know everything about everyone of interest to me."
msgstr "[_J_] Ja platím veľa ľudí veľa peňazí, aby som sa uistil, že viem všetko o každého, kto ma zaujíma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13944 #-#-# translate crowdin label_gal_Sidney_club_trick_9c849b05:
msgid "[_J_] And your household has been very interesting this last little while."
msgstr "[_J_] A vaša domácnosť je veľmi zaujímavá poslednou chvílkou."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13947 #-#-# translate crowdin label_gal_Sidney_club_trick_d15e5051:
msgid "[_J_] But I must say that you are much prettier in person."
msgstr "[_ J_] Ale musím povedať, že ste veľmi krajšia osoba."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13948 #-#-# translate crowdin label_gal_Sidney_club_trick_429b142a:
msgid "[_J_] A very different kind of beauty than [mom_name], but very beautiful nonetheless."
msgstr "[_J_] Veľmi odlišný druh krásy ako [mom_name], ale veľmi krásna napriek tomu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13951 #-#-# translate crowdin label_gal_Sidney_club_trick_5841f3ee:
msgid "[_S_] Uhhhh.... Thank you?"
msgstr "[_S_] Uhhhh .... Ďakujem ti?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13952 #-#-# translate crowdin label_gal_Sidney_club_trick_bfd7d919:
msgid "[_S_] And you're the guy we have to pay every week to keep [mom_name] out of the club?"
msgstr "A vy ste ten chlap, ktorého musíme platiť každý týždeň, aby sme si udržali [mom_name] mimo klubu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13953 #-#-# translate crowdin label_gal_Sidney_club_trick_3ade86f6:
msgid "[_J_] A very regrettable situation, but in life, all debts must be paid."
msgstr "[_J_] Veľmi poľutovaniahodná situácia, ale v živote, musia byť vyplatené všetky dlhy."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13954 #-#-# translate crowdin label_gal_Sidney_club_trick_831eadab:
msgid "[_S_] But Dad took out the loan, not us."
msgstr "Ale otec nám požičal pôžičku, nie my."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13955 #-#-# translate crowdin label_gal_Sidney_club_trick_6133c7d0:
msgid "[_J_] And when he took it out, we made sure it was very clear to him that the debt would fall on his household if anything happened to him."
msgstr "[_ J_] A keď to vzal, uistili sme sa, že je pre neho veľmi jasné, že dlh spadne na jeho domácnosť, ak sa mu niečo stane."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13956 #-#-# translate crowdin label_gal_Sidney_club_trick_9ee2623f:
msgid "[_J_] So, he knew the risks."
msgstr "[_J_] Takže vedel o rizikách."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13957 #-#-# translate crowdin label_gal_Sidney_club_trick_6bd709d8:
msgid "[_S_] That asshole!"
msgstr "Ten kretén!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13958 #-#-# translate crowdin label_gal_Sidney_club_trick_20d522cf:
msgid "[_J_] Haha.... We can arrange for him to stay in prison for as long as you like."
msgstr "[_J_] Haha .... Môžeme zariadiť, aby zostal vo väzení tak dlho, ako sa vám páči."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13959 #-#-# translate crowdin label_gal_Sidney_club_trick_7adea004:
msgid "[_S_] We might just take you up on that offer."
msgstr "[_S_] Môžeme vás prijať na túto ponuku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13960 #-#-# translate crowdin label_gal_Sidney_club_trick_73fc5dd0:
msgid "[_J_] But where are my manners. Let's go sit down and have a drink."
msgstr "[_J_] Ale kde sú moje spôsoby. Poďme si sadať a napiť sa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13961 #-#-# translate crowdin label_gal_Sidney_club_trick_d6fd8077:
msgid "[_J_] Come.... Follow me."
msgstr "[_ J_] Príďte .... Nasledujte ma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13964 #-#-# translate crowdin label_gal_Sidney_club_trick_2c023f61:
msgid "[_J_] This is the pole room, and this is our very lovely dancer Emma."
msgstr "[_J_] To je pól miestnosti, a to je naša veľmi krásna tanečnica Emma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13965 #-#-# translate crowdin label_gal_Sidney_club_trick_32d57bb1:
msgid "[_S_] She's very beautiful."
msgstr "Je veľmi krásna."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13966 #-#-# translate crowdin label_gal_Sidney_club_trick_239622d4:
msgid "[_J_] Yes, she's quite popular, but not nearly as popular as [mom_name]."
msgstr "[_ J_] Áno, je veľmi populárna, ale nie takmer tak populárna ako [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13967 #-#-# translate crowdin label_gal_Sidney_club_trick_74b4f012:
msgid "[_S_] Oh God!.... She's here isn't she?"
msgstr "Bože! Ona je tu, že?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13968 #-#-# translate crowdin label_gal_Sidney_club_trick_4d2f3e20:
msgid "[_J_] Haha.... yes, she's in the dressing room, she goes on after the next dancer."
msgstr "[_ J_] Haha .... áno, ona je v šatni, ide po ďalšom tanečník."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13969 #-#-# translate crowdin label_gal_Sidney_club_trick_0bfd4db0:
msgid "[_J_] Shall we take a seat?"
msgstr "-Ideme si sadať?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13972 #-#-# translate crowdin label_gal_Sidney_club_trick_7d070b33:
msgid "[_J_] I want you to know that I feel very sorry for your families situation."
msgstr "[_J_] Chcem, aby ste vedeli, že je mi veľmi ľúto vašej rodinnej situácie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13973 #-#-# translate crowdin label_gal_Sidney_club_trick_f922f6a9:
msgid "[_J_] And I know I'm in an awkward position to help you all out, being your creditor and all."
msgstr "[_J_] A viem, že som v nepríjemnej pozícii, aby som vám pomohol všetko, byť vaším veriteľom a všetkým."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13974 #-#-# translate crowdin label_gal_Sidney_club_trick_74174243:
msgid "[_J_] But I have a way you can help your family make the monthly payments, and maybe get you some spending money besides."
msgstr "[_J_] Ale ja mám spôsob, ako by ste mohli pomôcť vašej rodine zarobiť mesačné platby, a možno dostanete niektoré výdavky peniaze okrem."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13975 #-#-# translate crowdin label_gal_Sidney_club_trick_b97cb517:
msgid "[_J_] I heard how the FBI cut out your discretionary spending."
msgstr "Počul som, ako FBI vystrižilo vaše diskrečné výdavky."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13976 #-#-# translate crowdin label_gal_Sidney_club_trick_8e00f764:
msgid "[_S_] I'm not becomming a stripper, if that's what you're thinking."
msgstr "Nehovorím o striptérke, ak je to to, na čo myslíš."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13977 #-#-# translate crowdin label_gal_Sidney_club_trick_1f739f57:
msgid "[_J_] Haha.... No of course not! We wouldn't hire you even if you wanted to."
msgstr "[_J_] Haha .... Nie, samozrejme, že nie! Najali by sme vás ani keby ste chceli."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13978 #-#-# translate crowdin label_gal_Sidney_club_trick_2edab44f:
msgid "[_S_] What?.... Why not?"
msgstr "[_S_] Čo?.... Prečo nie?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13979 #-#-# translate crowdin label_gal_Sidney_club_trick_24aefce8:
msgid "[_J_] You don't have the dancing experience like [mom_name] does."
msgstr "[_ J_] Vy nemáte tanečné skúsenosti ako [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13980 #-#-# translate crowdin label_gal_Sidney_club_trick_7b7b1433:
msgid "[_J_] But I do have another decent paying job that doesn't take any experience to get into, and only requires a pretty face."
msgstr "[_J_] Ale ja mám ďalšiu slušnú plavenú prácu, ktorá neberie žiadne skúsenosti, aby sa dostať do, a vyžaduje len peknú tvár."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13981 #-#-# translate crowdin label_gal_Sidney_club_trick_9560318f:
msgid "[_S_] What would that be?"
msgstr "Čo by to malo byť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13982 #-#-# translate crowdin label_gal_Sidney_club_trick_64a44913:
msgid "[_J_] Take a look over there."
msgstr "[_ J_] Pozrite sa tam."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13985 #-#-# translate crowdin label_gal_Sidney_club_trick_d2981908:
msgid "[_J_] Do you see that girl in the tights and blue shirt serving drinks to the customers."
msgstr "[_J_] Vidíš to dievča v pančuchách a modrej košeli, ako podáva nápoje zákazníkom."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13986 #-#-# translate crowdin label_gal_Sidney_club_trick_afd5cbd9:
msgid "[_S_] Yeah."
msgstr "[_S_] Áno."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13987 #-#-# translate crowdin label_gal_Sidney_club_trick_017c4b06:
msgid "[_J_] Well, she wants to be a bartender, so I'm letting her help tend the bar whenever things get a little slower."
msgstr "Ona chce byť barmanom, takže dovolím jej pomôcť pri bare, keď sa veci trochu pomalšie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13988 #-#-# translate crowdin label_gal_Sidney_club_trick_152710b1:
msgid "[_J_] So, she needs some help filling her job while she's practicing her drink mixing skills."
msgstr "[_J_] Takže ona potrebuje pomoc, aby jej pomohla pri práci, zatiaľ čo ona cvičí jej miešanie zručností."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13989 #-#-# translate crowdin label_gal_Sidney_club_trick_7d1a995d:
msgid "[_J_] Let me call her over here so you can meet her."
msgstr "Dovoč mi ju sem zavolať, aby si sa s ňou stretol."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13992 #-#-# translate crowdin label_gal_Sidney_club_trick_68717c9c:
msgid "[_J_] HEY! Armani! Can I get a couple drinks?"
msgstr "[_J_] HEY! Armani! Môžem si dať pár drinkov?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13995 #-#-# translate crowdin label_gal_Sidney_club_trick_2abdd7c4:
msgid "[_A_] Hey Uncle! Do you want the usual?"
msgstr "Hej, strýko! Chceš to normálne?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13996 #-#-# translate crowdin label_gal_Sidney_club_trick_f2eb0d18:
msgid "[_J_] Yes darling!, and get Sidney here whatever she wants."
msgstr "[_J_] Áno, zlato!, a doprajte Sidneyho čokoľvek, čo chce."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13997 #-#-# translate crowdin label_gal_Sidney_club_trick_ad752753:
msgid "[_S_] I don't want anything. I'm actually not old enough to buy a drink."
msgstr "-Ja nechcem nič. Vlastne nie som dosť starý na to, aby som si kúpil drink."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13998 #-#-# translate crowdin label_gal_Sidney_club_trick_0c2676df:
msgid "[_J_] Yeah, well regular rules don't apply here."
msgstr "[_ J_] Áno, správne pravidlá sa tu neplatia."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13999 #-#-# translate crowdin label_gal_Sidney_club_trick_9db52021:
msgid "[_S_] I'm really ok."
msgstr "[_S_] Som naozaj v poriadku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14000 #-#-# translate crowdin label_gal_Sidney_club_trick_8b77dee6:
msgid "[_J_] Suit yourself."
msgstr "Suit sám."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14001 #-#-# translate crowdin label_gal_Sidney_club_trick_89aa9450:
msgid "[_J_] Armani, this is Sidney.... She's thinking about coming here sometimes to help you serve drinks."
msgstr "[_J_] Armani, toto je Sidney .... Myslí na to, že sem príde niekedy, aby ti pomohol slúžiť drinkom."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14002 #-#-# translate crowdin label_gal_Sidney_club_trick_e10f00ff:
msgid "[_J_] Sidney, this is my niece Armani."
msgstr "-Sidney, toto je moja neter Armani."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14005 #-#-# translate crowdin label_gal_Sidney_club_trick_8a2d51b0:
msgid "[_A_] Aren't you a pretty thing?"
msgstr "Nie si celkom pekná vec?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14006 #-#-# translate crowdin label_gal_Sidney_club_trick_2f90028e:
msgid "[_S_] I wasn't really thinking about serving drinks...."
msgstr "[_S_] Naozaj som si nemyslel, že servíta nápoje ...."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14007 #-#-# translate crowdin label_gal_Sidney_club_trick_ebabb98d:
msgid "[_J_] Not yet, you mean."
msgstr "[_J_] Ešte nie, to znamená."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14008 #-#-# translate crowdin label_gal_Sidney_club_trick_b9d930f7:
msgid "[_A_] Well, I would sure love to work with someone as beautiful as you, and we can make a ton in tips in one night."
msgstr "[_A_] No, určite by som rád pracoval s niekým tak krásnou ako ty, a my môžeme urobiť tonu v tipoch za jednu noc."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14009 #-#-# translate crowdin label_gal_Sidney_club_trick_3494722b:
msgid "[_A_] So, think about it."
msgstr "Takže, porozmýšľaj o tom."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14012 #-#-# translate crowdin label_gal_Sidney_club_trick_9b656435:
msgid "[_J_] And you'd be under very little commitment. I would only require you to be here on Mondays, since that's when Armani's at the bar full time."
msgstr "[_J_] A boli by ste pod veľmi malým záväzkom. Chcel by som, aby ste tu boli len v pondelok, pretože to je vtedy, keď Armani je v bare plný čas."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14013 #-#-# translate crowdin label_gal_Sidney_club_trick_50717fc0:
msgid "[_J_] Other than that, You could come in any day you want. Oh.... except Saturdays, since [mom_name] might be here."
msgstr "[_J_] Iné, než to, môžete prísť v ktorýkoľvek deň, ktorý chcete. Oh .... okrem soboty, pretože [mom_name] môže byť tu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14014 #-#-# translate crowdin label_gal_Sidney_club_trick_6196b8fb:
msgid "[_ST_] {i}That doesn't sound bad at all.{/i}"
msgstr "[_ST_] {i}To neznie zlé vôbec. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14015 #-#-# translate crowdin label_gal_Sidney_club_trick_d9ecee9e:
msgid "[_ST_] {i}And I'd love to be able to help [ryan] out. He's taken most of the responsibility on himself.{/i}"
msgstr "[_ST_] {i}A ja by som rád pomohol [ryan] von. Berie väčšinu zodpovednosti na seba. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14016 #-#-# translate crowdin label_gal_Sidney_club_trick_d9b21643:
msgid "[_S_] That's a very tempting offer."
msgstr "[_S_] To je veľmi lákajúce."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14017 #-#-# translate crowdin label_gal_Sidney_club_trick_7815ca65:
msgid "[_J_] Well, then why don't you run along with Armani and she can show you the ropes. You can keep any tips you make tonight."
msgstr "Tak prečo nebežíš spolu s Armani a ona ti ukáže laná. Môžete si nechať všetky tipy, ktoré dnes večer."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14018 #-#-# translate crowdin label_gal_Sidney_club_trick_55f2407f:
msgid "[_S_] Ok.... Thank you."
msgstr "[_S_] OK .... Ďakujem vám."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14021 #-#-# translate crowdin label_gal_Sidney_club_trick_aa726d46:
msgid "[_J_] Oh.... and Sidney! I almost forgot."
msgstr "[_J_] Oh .... a Sidney! Skoro som zabudla."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14022 #-#-# translate crowdin label_gal_Sidney_club_trick_c58cb65c:
msgid "[_J_] It would be best if [mom_name] didn't know if you were here. If you are inclined to peek like [ryan] does, just don't get caught."
msgstr "[_ J_] Bolo by najlepšie, ak by [mom_name] nevedel, či ste tu. Ak sa prikláňate k Peek, ako je [ryan] robí, len sa nenechajte chytiť."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14023 #-#-# translate crowdin label_gal_Sidney_club_trick_804412d2:
msgid "[_J_] I don't even think my best \"Made Man\" could stop her from murdering me, if she knew you were here."
msgstr "[_ J_] Ani si nemyslím, že môj najlepší \"Made Man\" by ju mohol zastaviť pred vraždou, ak by vedela, že ste tu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14024 #-#-# translate crowdin label_gal_Sidney_club_trick_8d3ec460:
msgid "[_ST_] {i}Does [ryan] regularly peek at Mom when she's stripping?{/i}"
