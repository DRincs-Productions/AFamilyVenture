# game/Gallery_labels_AFV-0.06_v0.2.rpy:37215 #-#-# translate crowdin label_gal_cosplay_02_b048f5d8:
msgid "[_R_] Perfect.... I got it."
msgstr "[_R_] Perfektné.... Mám to."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37217 #-#-# translate crowdin label_gal_cosplay_02_f10646ca:
msgid "[_R_] Since we've got this kick-ass green screen, I'll be able to add a forest background to this picture."
