# game/Gallery_labels_AFV-0.06_v0.2.rpy:9574 #-#-# translate crowdin label_gal_Lauren_Diaz_01_a624b532:
msgid "[_AD_] Oh, not much, just $500 a week."
msgstr "[_AD_] Nie veľa, len 500 dolárov týždenne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9575 #-#-# translate crowdin label_gal_Lauren_Diaz_01_e791425d:
msgid "[_R_] But what if we can't pay the DeCapo's because you're extorting us?"
msgstr "[_R_] Ale čo ak nemôžem zaplatiť DeCapovi, pretože nás vydieraš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9576 #-#-# translate crowdin label_gal_Lauren_Diaz_01_219a7df5:
