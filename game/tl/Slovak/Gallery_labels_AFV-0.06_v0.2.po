# game/Gallery_labels_AFV-0.06_v0.2.rpy:21792 #-#-# translate crowdin label_gal_aunt_06_b9a868d6:
msgid "[_R_] If they did, you could make a killing by suing them in court for violating your free speech rights."
msgstr "[_ R_] Ak áno, mohli by ste sa zabiť tým, že ich žalujete na súde za porušenie vašich práv na slobodu prejavu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21793 #-#-# translate crowdin label_gal_aunt_06_75654a0a:
