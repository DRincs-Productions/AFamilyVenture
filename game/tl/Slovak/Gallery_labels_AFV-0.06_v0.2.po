# game/Gallery_labels_AFV-0.06_v0.2.rpy:16201 #-#-# translate crowdin label_gal_halloween_event_start_34d711fe:
msgid "[_MD_] {i}(Talking quietly){/i} [ryan] I think you ought to get the game rolling again."
msgstr "[_MD_] {i}(Hovorí potichu){/i} [ryan] Myslím, že by sme mali znovu rozbehnúť hru."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16202 #-#-# translate crowdin label_gal_halloween_event_start_cfb218d0:
msgid "[_R_] I think you're right."
msgstr "[_R_] Myslím, že máš pravdu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16203 #-#-# translate crowdin label_gal_halloween_event_start_49f47229:
msgid "[_R_] Who's turn is it?"
msgstr "[_R_] Kto je na rade?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16206 #-#-# translate crowdin label_gal_halloween_event_start_81b96cfa:
msgid "[_L_] It's my turn. I was trying to decide which spell I should use against the DemiGobbler."
msgstr "[_L_] Teraz som na rade ja. Rozhodujem sa, ktoré kúzlo mám použiť proti DemiGoblerovi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16209 #-#-# translate crowdin label_gal_halloween_event_start_1901061c:
msgid "[_L_] If I remember right, I think a fire spell would be best."
msgstr "[_L_] Ak si dobre pamätám, myslím, že najlepšie by bolo ohnivé kúzlo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16212 #-#-# translate crowdin label_gal_halloween_event_start_0f32dc9f:
msgid "[_MG_] No, isn't water it's weakness?"
msgstr "[_MG_] Nie, nie je voda slabosťou?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16215 #-#-# translate crowdin label_gal_halloween_event_start_bf3fd057:
msgid "[_MD_] I think we'd be safer to cast a protective spell on our party first."
msgstr "[_MD_] Myslím, že by bolo bezpečnejšie, keby sme najprv na našu skupinu zoslali ochranné kúzlo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16218 #-#-# translate crowdin label_gal_halloween_event_start_1095e8e0:
msgid "[_MT_] {i}Wow!... This really is a pretty nerdy game.{/i}"
msgstr "[_MT_] {i}Wow! ... To je naozaj pekná nerdy hra. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16223 #-#-# translate crowdin label_gal_halloween_event_start_15ecb064:
msgid "[_M_] That was weird!"
msgstr "[_M_] To bolo divné!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16226 #-#-# translate crowdin label_gal_halloween_event_start_4461e222:
msgid "[_M_] Don't worry, it was probably just caused by the wind."
msgstr "[_M_] Nebojte sa, pravdepodobne to bolo spôsobené len vetrom."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16227 #-#-# translate crowdin label_gal_halloween_event_start_9f8ab9b2:
msgid "[_M_] I'm going to run get dressed. Just yell if you need me."
msgstr "[_M_] Pobežím sa obliecť. Len zakrič, ak ma budeš potrebovať."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16233 #-#-# translate crowdin label_gal_halloween_event_start_9cb523ba:
msgid "[_ST_] {i}That was a geat run!{/i}"
msgstr "[_ST_] {i}To bola skvelá hra!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16236 #-#-# translate crowdin label_gal_halloween_event_start_5ddd54de:
msgid "[_ST_] {i}I think it's the fastest I've ever ran that loop.{/i}"
msgstr "[_ST_] {i}Myslím, že je to najrýchlejšie, ako som kedykoľvek túto slučku spustila.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16237 #-#-# translate crowdin label_gal_halloween_event_start_4f785b35:
msgid "[_ST_] {i}Why did Mom have to bring up creepers though? Now I'm feeling a little nervous.{/i}"
msgstr "[_ST_] {i}Prečo mama musela vyťahovať creeperov? Teraz som trochu nervózná.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16240 #-#-# translate crowdin label_gal_halloween_event_start_5b49ed0b:
msgid "[_ST_] {i}It's not like I haven't had experience with creepers.{/i}"
msgstr "[_ST_] {i}Nie je to tak, že by som nemala skúsenosti s úchylákmi.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16241 #-#-# translate crowdin label_gal_halloween_event_start_96fc81d0:
msgid "[_ST_] {i}I don't care if Mr. Peterson is a decorated war vet, he shouldn't be grabbing girls in the park!{/i}"
msgstr "[_ST_] {i}Je mi jedno, či je pán Peterson vyznamenaný vojnový veterán, ale nemal by chytať dievčatá v parku!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16242 #-#-# translate crowdin label_gal_halloween_event_start_c58ec1c3:
msgid "[_ST_] {i}And that wasn't even late at night!{/i}"
msgstr "[_ST_] {i}A to nebolo ani neskoro v noci! {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16249 #-#-# translate crowdin label_gal_halloween_event_start_d1749759:
msgid "[_ST_] {i}Well, that's creepy.{/i}"
msgstr "[_ST_] {i}No, to je strašidelné.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16250 #-#-# translate crowdin label_gal_halloween_event_start_37e005c7:
msgid "[_ST_] {i}I sure as hell don't need that right now.{/i}"
msgstr "[_ST_] {i}To teraz určite nepotrebujem.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16253 #-#-# translate crowdin label_gal_halloween_event_start_2676a7e1:
msgid "[_ST_] {i}Hopefully I'll feel better after a nice hot shower.{/i}"
msgstr "[_ST_] {i}Dúfam, že sa budem cítiť lepšie po príjemnej horúcej sprche.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16256 #-#-# translate crowdin label_gal_halloween_event_start_a35628d2:
msgid "[_ST_] {i}Oh, good! My skin's not looking too bad.{/i}"
msgstr "[_ST_] {i}Ach, dobre! Moja pleť nevyzerá zle.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16261 #-#-# translate crowdin label_gal_halloween_event_start_dd2a82b0:
msgid "[_ST_] {i}Yikes!... I hope that doesn't keep happening!{/i}"
msgstr "[_ST_] {i}Jaj!... Dúfam, že sa to nebude opakovať!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16264 #-#-# translate crowdin label_gal_halloween_event_start_40c4aa6c:
msgid "[_ST_] {i}What is that!?{/i}"
msgstr "[_ST_] {i}Čo to je?!?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16265 #-#-# translate crowdin label_gal_halloween_event_start_121d3c96:
msgid "[_ST_] {i}Has that been there this whole time?{/i}"
msgstr "[_ST_] {i}Bolo to tam celý čas?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16268 #-#-# translate crowdin label_gal_halloween_event_start_66cc4a9e:
msgid "[_ST_] {i}It feels like spooge.{/i}"
msgstr "[_ST_] {i}Je to ako špina.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16269 #-#-# translate crowdin label_gal_halloween_event_start_a4c77eff:
msgid "[_ST_] {i}Did [ryan] blast the mirror and nobody noticed?{/i}"
msgstr "[_ST_] {i}Bol [ryan] výbuch zrkadla a nikto si to nevšimol? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16270 #-#-# translate crowdin label_gal_halloween_event_start_2a7345fd:
msgid "[_ST_] {i}Maybe it's growing mold in it?{/i}"
msgstr "[_ST_] {i}Možno v ňom rastie pleseň?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16273 #-#-# translate crowdin label_gal_halloween_event_start_418c6d15:
msgid "[_S_] [ryan]! Come clean up your mess in here!"
msgstr "[_S_] [ryan]! Poď si sem upratať svoj neporiadok!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16274 #-#-# translate crowdin label_gal_halloween_event_start_dcd911b4:
msgid "[_R_] {i}(Muffled Shouting){/i} I didn't pee on the seat!"
msgstr "[_R_] {i}(Tlmený výkrik){/i} Nečúral som na sedadlo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16275 #-#-# translate crowdin label_gal_halloween_event_start_9ee14df2:
msgid "[_S_] I'm talking about your other mess."
msgstr "[_S_] Hovorím o tvojom ďalšom neporiadku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16278 #-#-# translate crowdin label_gal_halloween_event_start_cf3ddee6:
msgid "[_ST_] {i}Oh, what the hell?{/i}"
msgstr "[_ST_] {i}Čo to do pekla?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16286 #-#-# translate crowdin label_gal_halloween_event_start_ea25a979:
msgid "[_R_] Alright, with the right spells and high enough rolls, you just might have a chance at defeating the DemiGobbler."
msgstr "[_R_] Dobre, so správnymi kúzlami a dostatočne vysokými hodmi by sme mohli mať šancu poraziť DemiGoblera."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16287 #-#-# translate crowdin label_gal_halloween_event_start_9456c0b7:
msgid "[_R_] Megan, you're up first."
msgstr "[_R_] Megan, ty si prvá na rade."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16290 #-#-# translate crowdin label_gal_halloween_event_start_55544d52:
msgid "[_MD_] Cast an orb of protection!"
msgstr "[_MD_] Vyčaruj ochranný orb!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16293 #-#-# translate crowdin label_gal_halloween_event_start_75789547:
msgid "[_L_] No, go for the glory! Cast \"Major Fireball!\""
msgstr "[_L_] Nie, choď za slávou! Vyčaruj \"Veľkú ohnivú guľu\""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16296 #-#-# translate crowdin label_gal_halloween_event_start_ce5013c7:
msgid "[_R_] You've got to decide, Megan."
msgstr "[_R_] Musíš sa rozhodnúť, Megan."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16297 #-#-# translate crowdin label_gal_halloween_event_start_923f91a8:
msgid "[_R_] What's it going to be?"
msgstr "[_R_] Čo to bude?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16300 #-#-# translate crowdin label_gal_halloween_event_start_6df91d37:
msgid "[_MG_] I cast \"Greyoll's Roar\"!"
msgstr "[_MG_] Čarujem \"Šialený rev\"!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16308 #-#-# translate crowdin label_gal_halloween_event_start_a680d058:
msgid "[_S_] It's growing!"
msgstr "[_S_] Rastie!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16311 #-#-# translate crowdin label_gal_halloween_event_start_303e64bb:
msgid "[_S_] Why is it growin?"
msgstr "Prečo je to growin?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16312 #-#-# translate crowdin label_gal_halloween_event_start_c20775b5:
msgid "[_S_] What's going on?"
msgstr "[_S_] Čo sa deje?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16352 #-#-# translate crowdin label_gal_halloween_event_start_dbfa0ec2:
msgid "[_MG_] Oh, no!"
msgstr "[_MG_] Ale nie!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16353 #-#-# translate crowdin label_gal_halloween_event_start_ac1f452b:
msgid "[_MD_] It went on the floor!"
msgstr "[_MD_] Išlo to na zem!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16354 #-#-# translate crowdin label_gal_halloween_event_start_f9114e79:
msgid "[_MG_] Quick, find it, we need to know what she rolled!"
msgstr "[_MG_] Rýchlo, nájdite ich, potrebujem vedieť koľko hodila!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16357 #-#-# translate crowdin label_gal_halloween_event_start_f283c3ca:
msgid "[_L_] What was that noise?"
msgstr "[_L_] Čo to bolo za zvuk?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16360 #-#-# translate crowdin label_gal_halloween_event_start_f91674c1:
msgid "[_MB_] Haha... Sidney must be taking a monster shit!"
msgstr "[_MB_] Haha... Sidney sa musí monštruózne vysrať!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16361 #-#-# translate crowdin label_gal_halloween_event_start_7a2317d6:
msgid "[_L_] [ryan], you should go check it out!"
msgstr "[_L_] [ryan], mal by si to ísť skontrolovať!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16362 #-#-# translate crowdin label_gal_halloween_event_start_f3baf10d:
msgid "[_RT_] {i}Shit! What was the noise? I should probably go check it out. The only problem is that if Lauren finds the die first, she's going to cheat.{/i}"
msgstr "[_RT_] {i}Do prdele! Čo to bolo za hluk? Asi by som to mal ísť skontrolovať. Jediný problém je, že ak Lauren nájde kocku prvá, bude podvádzať.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16363 #-#-# translate crowdin label_gal_halloween_event_start_82482f19:
msgid "[_RT_] {i}She always fudges the dice rolls whenever she gets the chance.{/i}"
msgstr "[_RT_] {i}Vždy, keď má príležitosť, hádže kockami.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16364 #-#-# translate crowdin label_gal_halloween_event_start_3ad23a44:
msgid "[_RT_] {i}What should I do?{/i}"
msgstr "[_RT_] {i}Čo mám robiť? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16369 #-#-# translate crowdin label_gal_halloween_event_start_ee5067ab:
msgid "[_RT_] {i}Goddammit! I hope Sidney's ok... Somebody else besides Lauren better find that die!{/i}"
msgstr "[_RT_] {i}Do riti! Dúfam, že Sidney je v poriadku... Niekto iný okrem Lauren by mal nájsť tú mŕtvolu!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16376 #-#-# translate crowdin label_gal_halloween_event_start_6a854948:
msgid "{b}{i}\"Are you sure you're okay with monster sex? If not, you should roll back and choose the other one.\"{/i}{/b}"
msgstr "{b}{i}\" Si si istý, že si v poriadku s príšerným sexom? Ak nie, mali by ste sa vrátiť späť a zvoliť si druhú. \" {/i} {/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16377 #-#-# translate crowdin label_gal_halloween_event_start_fb92f28c:
msgid "{b}{i}\"You have been warned! Please don't complain about being offended later!\"{/i}{/b}"
msgstr "{b}{i}\"Boli ste varovaní! Nesťažujte sa, prosím, neskôr, že ste sa urazili!\" {/i}{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16380 #-#-# translate crowdin label_gal_halloween_event_start_6eb70fe0:
msgid "[_R_] Oh, you'd like me to go check on Sidney, wouldn't you?"
msgstr "[_R_] Chceš, aby som išiel skontrolovať Sidney, však?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16381 #-#-# translate crowdin label_gal_halloween_event_start_1b02fc69:
msgid "[_R_] Then you can cheat like you always do!"
msgstr "[_R_] Potom môžeš podvádzať ako vždy!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16382 #-#-# translate crowdin label_gal_halloween_event_start_93576736:
msgid "[_L_] Let go of me!"
msgstr "[_L_] Pusti ma!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16393 #-#-# translate crowdin label_gal_sidney_loyalty_path_2163eb75:
msgid "[_R_] Sidney?"
msgstr "[_R_] Sidney?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16394 #-#-# translate crowdin label_gal_sidney_loyalty_path_b9ef4ee8:
msgid "[_R_] Sidney, where'd you go?"
msgstr "[_R_] Sidney, kam si išla?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16397 #-#-# translate crowdin label_gal_sidney_loyalty_path_76682bed:
msgid "[_RT_] {i}What the hell is this?{/i}"
msgstr "[_RT_] {i}Čo to má byť?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16400 #-#-# translate crowdin label_gal_sidney_loyalty_path_1f7eada3:
msgid "[_RT_] {i}It looks like pink cum.{/i}"
msgstr "[_RT_] {i}Vyzerá to ako ružové semeno.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16401 #-#-# translate crowdin label_gal_sidney_loyalty_path_1f675ba1:
msgid "[_RT_] {i}Is this what Sidney was telling me I needed to come clean up?{/i}"
msgstr "[_RT_] {i}To mi Sidney hovorila, že mám prísť upratať?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16402 #-#-# translate crowdin label_gal_sidney_loyalty_path_b800c80c:
msgid "[_RT_] {i}I don't remember splooging on the mirror, but in the heat of passion, sometimes I don't know where it all goes.{/i}"
msgstr "[_RT_] {i}Nepamätám si, že by som sa na zrkadlo vyfŕkal, ale v zápale vášne niekedy neviem, kam to všetko ide.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16405 #-#-# translate crowdin label_gal_sidney_loyalty_path_5e63d1f0:
msgid "[_RT_] {i}Maybe she ran to grab a rag to clean this up.{/i}"
msgstr "[_RT_] {i}Možno si odbehla po handru, aby to vyčistila.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16412 #-#-# translate crowdin label_gal_sidney_loyalty_path_5b981402:
msgid "[_R_] Oh my God!... What the hell is going on?"
msgstr "[_R_] Bože môj!... Čo sa to, do pekla, deje?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16413 #-#-# translate crowdin label_gal_sidney_loyalty_path_332593de:
msgid "[_R_] Sidney!"
msgstr "[_R_] Sidney!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16416 #-#-# translate crowdin label_gal_sidney_loyalty_path_4cc2a66a:
msgid "[_S_] Oh my God! [ryan], is that you?"
msgstr "[_S_] Bože môj! [ryan], si to ty?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16417 #-#-# translate crowdin label_gal_sidney_loyalty_path_85d13f3e:
msgid "[_S_] Can you hear me?"
msgstr "[_S_] Počuješ ma?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16418 #-#-# translate crowdin label_gal_sidney_loyalty_path_9b421f00:
msgid "[_R_] Yes, and I can see you through the mirror!"
msgstr "[_R_] Áno, a vidím ťa cez zrkadlo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16419 #-#-# translate crowdin label_gal_sidney_loyalty_path_173d01ed:
msgid "[_R_] Sidney, what the hell is going on?"
msgstr "[_R_] Sidney, čo sa to, do pekla, deje?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16422 #-#-# translate crowdin label_gal_sidney_loyalty_path_69d46914:
msgid "[_S_] [ryan]! You've got to help me! Some... thing!... Like... a monster, pulled me through the mirror into this... I don't know... scary version of our bathroom."
msgstr "[_S_] [ryan]! Musíš mi pomôcť! Nejaká... vec!... Ako... príšera, ktorá ma vtiahla cez zrkadlo do tohto... ja neviem... strašidelnej verzie našej kúpeľne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16423 #-#-# translate crowdin label_gal_sidney_loyalty_path_719e4e4b:
msgid "[_S_] He vomited out this goo and it's so sticky I can't get out."
msgstr "[_S_] Vyzvracal ten sliz a je taký lepkavý, že sa z neho nemôžem dostať."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16424 #-#-# translate crowdin label_gal_sidney_loyalty_path_67a21f4f:
msgid "[_S_] [ryan], you've got to help me. What if it comes back?... What does it want with me?"
msgstr "[_S_] [ryan], musíš mi pomôcť. Čo ak sa to vráti?... Čo to odo mňa chce?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16425 #-#-# translate crowdin label_gal_sidney_loyalty_path_e2e4ae5a:
msgid "[_R_] Uhhh... ok... shit! shit, shit, shit, shit, SHIT!"
msgstr "[_R_] Uhhhh... ok... hovno! hovno, hovno, hovno, hovno, HOVNO!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16428 #-#-# translate crowdin label_gal_sidney_loyalty_path_fc40935f:
msgid "[_R_] What am I supposed to do?"
msgstr "[_R_] Čo mám robiť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16429 #-#-# translate crowdin label_gal_sidney_loyalty_path_178ff641:
msgid "[_R_] How do I get in there?"
msgstr "[_R_] Ako sa tam dostanem?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16434 #-#-# translate crowdin label_gal_sidney_loyalty_path_4e228b54:
msgid "[_R_] Shit, Sidney... Where did you go?"
msgstr "[_R_] Sakra, Sidney... Kam si išla?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16435 #-#-# translate crowdin label_gal_sidney_loyalty_path_e6c9a965:
msgid "[_R_] Sidney? can you hear me?"
msgstr "[_R_] Sidney? Počuješ ma?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16436 #-#-# translate crowdin label_gal_sidney_loyalty_path_07bdde05:
msgid "....."
msgstr "....."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16437 #-#-# translate crowdin label_gal_sidney_loyalty_path_6d505198:
msgid "[_R_] Goddammit! I'm going to need a weapon!"
msgstr "[_R_] Do riti! Budem potrebovať zbraň!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16443 #-#-# translate crowdin label_gal_sidney_loyalty_path_4ccf3a2c:
msgid "[_MD_] {i}(muffled voice){/i} Whoa, [ryan]! What's the hurry?"
msgstr "[_MD_] {i}(tlmený hlas){/i} Whoa, [ryan]! Kam sa ponáhľaš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16444 #-#-# translate crowdin label_gal_sidney_loyalty_path_c1c6df81:
msgid "[_MG_] Yeah, didn't you want to hear if we beat the DemiGobbler?"
msgstr "[_MG_] Áno, nechceli ste počuť, či sme porazili DemiGobbler?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16445 #-#-# translate crowdin label_gal_sidney_loyalty_path_74ff334a:
msgid "[_L_] We did!"
msgstr "[_L_] My sme to urobili!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16446 #-#-# translate crowdin label_gal_sidney_loyalty_path_ee5de6c4:
msgid "[_R_] Did you cheat?... Wait! Nevermind! I don't have time for this!"
msgstr "Podvádzal si sa? Počkajte! Nevadí! Na toto nemám čas!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16447 #-#-# translate crowdin label_gal_sidney_loyalty_path_742f66d1:
msgid "[_L_] Where are you going with that knife?"
msgstr "[_L_] Kam s tým nožom ideš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16448 #-#-# translate crowdin label_gal_sidney_loyalty_path_5bbd413d:
msgid "[_R_] No time to explain!"
msgstr "[_R_] Nie je čas na vysvetľovanie!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16449 #-#-# translate crowdin label_gal_sidney_loyalty_path_d23358a0:
msgid "[_L_] Moooom!"
msgstr "[_L_] Moooom!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16455 #-#-# translate crowdin label_gal_sidney_loyalty_path_846455d1:
msgid "[_R_] Here I come, Sidney!"
msgstr "[_R_] Už idem, Sidney!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16458 #-#-# translate crowdin label_gal_sidney_loyalty_path_4e4a0d47:
msgid "[_M_] [ryan], no!"
msgstr "[_M_] [ryan], nie!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16459 #-#-# translate crowdin label_gal_sidney_loyalty_path_c7abe705:
msgid "[_M_] Don't you dare!"
msgstr "[_M_] Neopovažuj sa!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16462 #-#-# translate crowdin label_gal_sidney_loyalty_path_79676139:
msgid "[_M_] Are you kidding me?"
msgstr "[_M_] Robíš si zo mňa srandu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16463 #-#-# translate crowdin label_gal_sidney_loyalty_path_98459e9d:
msgid "[_M_] What are you thinking?"
msgstr "[_M_] Čo si myslíš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16466 #-#-# translate crowdin label_gal_sidney_loyalty_path_82663da4:
msgid "[_R_] Sidney's stuck in the mirror!"
msgstr "[_R_] Sidney je uväznená v zrkadle!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16467 #-#-# translate crowdin label_gal_sidney_loyalty_path_d8bf5ca9:
msgid "[_M_] What?"
msgstr "[_M_] Čo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16468 #-#-# translate crowdin label_gal_sidney_loyalty_path_13d0d53d:
msgid "[_R_] I said, Sidney's stuck..."
msgstr "[_R_] Povedal som, že Sidney sa zasekla..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16472 #-#-# translate crowdin label_gal_sidney_loyalty_path_41f6935a:
msgid "[_R_] Why are you running around in your underwear when my friends are over?"
msgstr "[_R_] Prečo beháš v spodnom prádle, keď sú tu moji priatelia?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16475 #-#-# translate crowdin label_gal_sidney_loyalty_path_05d5141b:
msgid "[_M_] I was getting dressed, when I heard the commotion and Lauren said you ran in here with a knife."
msgstr "[_M_] Obliekala som sa, keď som počula rozruch a Lauren povedala, že si sem vbehol s nožom."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16476 #-#-# translate crowdin label_gal_sidney_loyalty_path_b51de32b:
msgid "[_M_] Why are you trying to break my mirror?"
msgstr "[_M_] Prečo sa snažíš rozbiť moje zrkadlo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16479 #-#-# translate crowdin label_gal_sidney_loyalty_path_d9a7cf3b:
msgid "[_M_] And is that what I think it is?"
msgstr "[_M_] A je to to, čo si myslím?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16480 #-#-# translate crowdin label_gal_sidney_loyalty_path_63d4c8a9:
msgid "[_R_] I don't know what you think it is, but no, I didn't do it, if that's what you're thinking."
msgstr "[_R_] Neviem, čo si myslíš, ale nie, neurobil som to, ak si to myslíš."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16481 #-#-# translate crowdin label_gal_sidney_loyalty_path_19a7eb8c:
msgid "[_R_] Besides, that's not what's important!"
msgstr "[_R_] Okrem toho, to nie je dôležité!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16482 #-#-# translate crowdin label_gal_sidney_loyalty_path_afb3e459:
msgid "[_R_] Sidney is trapped in the mirror!"
msgstr "[_R_] Sidney je uväznená v zrkadle!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16483 #-#-# translate crowdin label_gal_sidney_loyalty_path_fca643f5:
msgid "[_M_] What do you mean, trapped in the mirror?"
msgstr "[_M_] Ako to myslíš, uväznená v zrkadle?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16484 #-#-# translate crowdin label_gal_sidney_loyalty_path_27e38ca8:
msgid "[_R_] The lights flickered a few times, and then I could see..."
msgstr "[_R_] Svetlá niekoľkokrát blikli a potom som uvidel..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16485 #-#-# translate crowdin label_gal_sidney_loyalty_path_c52a8cdf:
msgid "[_R_] Well, it was like I was looking into a different world... Like ours, only... scary."
msgstr "[_R_] No, bolo to, akoby som sa pozeral do iného sveta... Ako ten náš, len... desivý."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16486 #-#-# translate crowdin label_gal_sidney_loyalty_path_a39ddd87:
msgid "[_R_] And Sidney was trapped in a slimy goo!"
msgstr "[_R_] A Sidney bola uväznená v slizkom slize!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16489 #-#-# translate crowdin label_gal_sidney_loyalty_path_6c943f20:
msgid "[_M_] A slimy goo!?"
msgstr "[_M_] Slizký sliz!?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16490 #-#-# translate crowdin label_gal_sidney_loyalty_path_551d6346:
msgid "[_M_] Oh, no!"
msgstr "[_M_] Ale nie!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16491 #-#-# translate crowdin label_gal_sidney_loyalty_path_7574192e:
msgid "[_R_] Yeah, I know!... What are we going to do?"
msgstr "[_R_] Áno, ja viem!... Čo budeme robiť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16494 #-#-# translate crowdin label_gal_sidney_loyalty_path_fb82c25b:
msgid "[_M_] Uhh... I'm not..."
msgstr "[_M_] Uhh... Nie som..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16497 #-#-# translate crowdin label_gal_sidney_loyalty_path_733db35e:
msgid "[_M_] First off, you're going to show me what drugs you're taking, where they are, and tell me who gave them to you!"
msgstr "[_M_] Najprv mi ukážeš, aké drogy berieš, kde sú, a povieš mi, kto ti ich dal!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16498 #-#-# translate crowdin label_gal_sidney_loyalty_path_678dae12:
msgid "[_MB_] {i}(Muffled from behind the door){/i} You've got drugs? Why are you holding out? You should have shared them with us!"
msgstr "[_MB_] {i}(Tlmene spoza dverí){/i} Máš drogy? Prečo ich zadržiavaš? Mal si sa s nami o ne podeliť!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16499 #-#-# translate crowdin label_gal_sidney_loyalty_path_993f8d56:
msgid "[_M_] {i}(Shouting){/i}Matt, and everybody else! Party's over, go home!"
msgstr "[_M_] {i}(Výkrik){/i}Matt a všetci ostatní! Párty sa skončila, choďte domov!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16500 #-#-# translate crowdin label_gal_sidney_loyalty_path_2a4054dc:
msgid "[_MG_] {i}(Muffled from behind the door){/i} We're on our way out the door Miss [mom_name]! Thanks for having us!"
msgstr "[_MG_] {i}(Tlmene spoza dverí){/i} Sme na ceste von z dverí, slečna [mom_name]! Ďakujeme, že ste nás pozvali!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16501 #-#-# translate crowdin label_gal_sidney_loyalty_path_9040f0a8:
msgid "[_M_] ...."
msgstr "[_M_]...."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16502 #-#-# translate crowdin label_gal_sidney_loyalty_path_28b37f6e:
msgid "[_M_] Now, about those drugs!"
msgstr "[_M_] A teraz o tých drogách!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16503 #-#-# translate crowdin label_gal_sidney_loyalty_path_06ee32c5:
msgid "[_R_] I'm not on any drugs! I swear!"
msgstr "[_R_] Neberiem žiadne drogy! Prísahám!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16504 #-#-# translate crowdin label_gal_sidney_loyalty_path_21e10533:
msgid "[_R_] I saw Sidney inside the mirror, but she wasn't in this room!"
msgstr "[_R_] Videl som Sidney v zrkadle, ale nebola v tejto miestnosti!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16505 #-#-# translate crowdin label_gal_sidney_loyalty_path_950b8bfa:
msgid "[_M_] Oh, good Lord!... I'm going to go find Sidney to help me straighten this out."
msgstr "Oh, dobrý Bože! Idem nájsť Sidneyho, aby mi pomohol vystríhať toto."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16508 #-#-# translate crowdin label_gal_sidney_loyalty_path_23465af7:
msgid "[_M_] Even if Sidney were trapped in some mirror world, which she most definitely is not, wouldn't breaking the mirror, break your connection with that world?"
msgstr "[_M_] Aj keby Sidney bol uväzený v nejakom zrkadle svete, ktorý rozhodne nie je, nezlomí zrkadlo, zlomiť si spojenie s týmto svetom?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16509 #-#-# translate crowdin label_gal_sidney_loyalty_path_eff28c14:
msgid "[_R_] I didn't think of that!"
msgstr "[_ R_] Ja som si to nemyslel!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16510 #-#-# translate crowdin label_gal_sidney_loyalty_path_f6cc57bf:
msgid "[_M_] So, don't break my mirror while I'm gone!"
msgstr "[_ M_] Takže, nezlomte mi zrkadlo, kým som preč!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16518 #-#-# translate crowdin label_gal_sidney_loyalty_path_fd98aa1c:
msgid "[_R_] How... do... I... get... in?!"
msgstr "[_R_] Ako... sa... sa... dostanem... dovnútra?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16522 #-#-# translate crowdin label_gal_sidney_loyalty_path_332593de_1:
msgid "[_R_] Sidney!"
msgstr "[_R_] Sidney!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16523 #-#-# translate crowdin label_gal_sidney_loyalty_path_5e0c5e0c:
msgid "[_S_] You can hear me again?"
msgstr "[_S_] Počuješ ma ešte?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16524 #-#-# translate crowdin label_gal_sidney_loyalty_path_8703231e:
msgid "[_S_] Help! The monster's back!"
msgstr "[_S_] Pomoc! Netvor sa vrátil!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16525 #-#-# translate crowdin label_gal_sidney_loyalty_path_50b6f003:
msgid "[_R_] How do I get in?"
msgstr "[_R_] Ako sa tam dostanem?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16526 #-#-# translate crowdin label_gal_sidney_loyalty_path_3aa56c5e:
msgid "[_S_] He pulled me in through the slime!"
msgstr "[_S_] Vtiahol ma do bahna!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16529 #-#-# translate crowdin label_gal_sidney_loyalty_path_332593de_2:
msgid "[_R_] Sidney!"
msgstr "[_R_] Sidney!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16530 #-#-# translate crowdin label_gal_sidney_loyalty_path_d9f5fd82:
msgid "[_R_] Fuck!"
msgstr "[_R_] Kurva!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16533 #-#-# translate crowdin label_gal_sidney_loyalty_path_56a6aa54:
msgid "[_RT_] {i}She said, through the slime.{/i}"
msgstr "[_RT_] {i}Povedala cez sliz.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16534 #-#-# translate crowdin label_gal_sidney_loyalty_path_7b84a809:
msgid "[_RT_] {i}She must mean through this little puddle of goo.{/i}"
msgstr "[_RT_] {i}Musí to myslieť cez túto malú kaluž slizu.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16537 #-#-# translate crowdin label_gal_sidney_loyalty_path_f795ad4b:
msgid "[_RT_] {i}Holy shit! That's so weird!{/i}"
msgstr "[_RT_] {i}Do prdele! To je také divné!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16538 #-#-# translate crowdin label_gal_sidney_loyalty_path_2315942f:
msgid "[_RT_] {i}Now, how do I fit my body through it?{/i}"
msgstr "[_RT_] {i}A teraz, ako sa do nej zmestím?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16539 #-#-# translate crowdin label_gal_sidney_loyalty_path_b033ab68:
msgid "[_RT_] {i}Maybe I can smear it into a big enough puddle to get through.{/i}"
msgstr "[_RT_] {i}Možno sa mi ho podarí rozotrieť do dostatočne veľkej kaluže, aby som sa tam dostal.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16547 #-#-# translate crowdin label_gal_sidney_loyalty_path_e56f555c:
msgid "[_S_] [ryan], Help! It's got me!"
msgstr "[_S_] [ryan], Pomoc! Dostalo ma to!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16550 #-#-# translate crowdin label_gal_sidney_loyalty_path_30d12913:
msgid "[_S_] Aaarch... Lerch..."
msgstr "[_S_] Aaarch... Lerch..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16551 #-#-# translate crowdin label_gal_sidney_loyalty_path_4b6590a3:
msgid "[_ST_] {i}What does it want? What is it doing?{/i}"
msgstr "[_ST_] {i}Čo to chce? Čo to robí? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16552 #-#-# translate crowdin label_gal_sidney_loyalty_path_97a1fbb2:
msgid "[_ST_] {i}Why is it shoving it's huge claw into my mouth!{/i}"
msgstr "[_ST_] {i}Prečo mi strká svoj obrovský pazúr do úst!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16557 #-#-# translate crowdin label_gal_sidney_loyalty_path_ffc68175:
msgid "[_ST_] {i}Oh, that's disgusting!{/i}"
msgstr "[_ST_] {i}To je nechutné!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16558 #-#-# translate crowdin label_gal_sidney_loyalty_path_90d9cc7f:
msgid "[_ST_] {i}No, no, please, noooo!{/i}"
msgstr "[_ST_] {i}Nie, nie, prosím, nieeee!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16561 #-#-# translate crowdin label_gal_sidney_loyalty_path_cc88d953:
msgid "[_S_] {i}(Gurgling and gagging sounds){/i}"
msgstr "[_S_] {i}(Hrkotavé a dávivé zvuky){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16566 #-#-# translate crowdin label_gal_sidney_loyalty_path_072fe4ac:
msgid "[_RT_] {i}Hold on Sidney! I'm coming!{/i}"
msgstr "[_RT_] {i}Vydrž Sidney! Už idem!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16567 #-#-# translate crowdin label_gal_sidney_loyalty_path_56317cd2:
msgid "[_RT_] {i}I've got to take this son of a bitch by surprise!{/i}"
msgstr "[_RT_] {i}Musím toho hajzla prekvapiť!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16570 #-#-# translate crowdin label_gal_sidney_loyalty_path_430cbe5b:
msgid "[_RT_] {i}Alright you giant, rotten scrotum.{/i}"
msgstr "[_RT_] {i}Dobre, ty obrovský, prehnitý šupák.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16571 #-#-# translate crowdin label_gal_sidney_loyalty_path_b5d2a0e1:
msgid "[_R_] Nobody grabs my sister's naked body like that, but me!"
msgstr "[_R_] Nikto okrem mňa takto neuchopí nahé telo mojej sestry!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16572 #-#-# translate crowdin label_gal_sidney_loyalty_path_05393d44:
msgid "[_ST_] {i}Yes!... Somebody grab my body!... Grab my boobies!{/i}"
msgstr "[_ST_] {i}Áno!... Chyťte niekto moje telo!... Chyťte ma za prsia!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16579 #-#-# translate crowdin label_gal_sidney_loyalty_path_c0babc00:
msgid "[_R_] Oh shit! It looks pissed!"
msgstr "[_R_] Do prdele! Vyzerá to ako nasratá!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16580 #-#-# translate crowdin label_gal_sidney_loyalty_path_42fad9c8:
msgid "[_R_] Is it going to attack?"
msgstr "[_R_] Chystá sa zaútočiť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16581 #-#-# translate crowdin label_gal_sidney_loyalty_path_f47b7f7e:
msgid "[_R_] This might be the end!"
msgstr "[_R_] Toto môže byť koniec!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16587 #-#-# translate crowdin label_gal_sidney_loyalty_path_7fec2a48:
msgid "[_RT_] {i}Oh, thank God!{/i}"
msgstr "[_RT_] {i}Oh, vďaka Bohu! {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16588 #-#-# translate crowdin label_gal_sidney_loyalty_path_83d209e9:
msgid "[_RT_] {i}I'd better lock it out in case it tries to come back.{/i}"
msgstr "[_RT_] {i}Radšej ho zamknem, keby sa chcel vrátiť.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16592 #-#-# translate crowdin label_gal_sidney_loyalty_path_66845906:
msgid "[_R_] Sidney, are you ok?"
msgstr "[_R_] Sidney, si v poriadku?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16595 #-#-# translate crowdin label_gal_sidney_loyalty_path_2163eb75_1:
msgid "[_R_] Sidney?"
msgstr "[_R_] Sidney?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16596 #-#-# translate crowdin label_gal_sidney_loyalty_path_79e69269:
msgid "[_S_] I'm more than ok! This is the second time you've saved my life!"
msgstr "[_S_] Som viac ako v poriadku! Už druhýkrát si mi zachránil život!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16597 #-#-# translate crowdin label_gal_sidney_loyalty_path_da555c13:
msgid "[_S_] Now, my hero! Come and claim you prize."
msgstr "[_S_] Teraz, môj hrdina! Príď si prevziať svoju cenu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16598 #-#-# translate crowdin label_gal_sidney_loyalty_path_aae35473:
msgid "[_R_] Sidney! Now is hardly the time, or the place!"
msgstr "[_R_] Sidney! Teraz je na to sotva vhodný čas alebo miesto!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16599 #-#-# translate crowdin label_gal_sidney_loyalty_path_07c40de2:
msgid "[_R_] We need to get out of here!"
msgstr "[_R_] Musíme odtiaľto vypadnúť!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16600 #-#-# translate crowdin label_gal_sidney_loyalty_path_3eca4052:
msgid "[_R_] Shit, the mirror slime is gone!"
msgstr "[_R_] Sakra, zrkadlový sliz je preč!"

