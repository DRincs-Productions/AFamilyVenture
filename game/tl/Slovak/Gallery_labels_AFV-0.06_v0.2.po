# game/Gallery_labels_AFV-0.06_v0.2.rpy:9467 #-#-# translate crowdin label_gal_Lauren_Diaz_01_559bc79a:
msgid "[_R_] Who in the hell?"
msgstr "[_R_] Kto, do pekla?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9469 #-#-# translate crowdin label_gal_Lauren_Diaz_01_5beee9ea:
msgid "[_S_] It's only six in the morning!"
msgstr "[_S_] Je len šesť hodín ráno!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9470 #-#-# translate crowdin label_gal_Lauren_Diaz_01_02e1ece4:
msgid "[_S_] Get the door [ryan], I'm too tired.... not dressed.... crusty.... panties.... {i}snore{/i}..."
msgstr "[_S_] Otvor dvere [ryan], som príliš unavená.... nie som oblečená.... chrumkavé.... nohavičky.... {i}chrápanie{/i}..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9471 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f21c2334:
msgid "[_RT_] {i}Anyone ringing the doorbell this early, can't be here with good news.{/i}"
msgstr "[_RT_] {i}Kto zazvoní pri dverách tak skoro, nemôže mať dobré správy.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9476 #-#-# translate crowdin label_gal_Lauren_Diaz_01_80cae6de:
msgid "[_AD_] Well, good morning [ryan]!"
msgstr "[_AD_] Dobré ráno, [ryan]!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9477 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f25223a4:
msgid "[_R_] Huh?.... Hi?.... How do you know me?"
msgstr "[_R_] Huh?.... Ahoj?.... Odkiaľ ma poznáš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9478 #-#-# translate crowdin label_gal_Lauren_Diaz_01_af20e3b0:
msgid "[_AD_] My name is Special Agent Diaz of the FBI Criminal Investigation Division."
msgstr "[_AD_] Volám sa špeciálny agent Diazová z oddelenia kriminálneho vyšetrovania FBI."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9479 #-#-# translate crowdin label_gal_Lauren_Diaz_01_6624d48a:
msgid "[_AD_] I've just been reassigned to head the case against your father."
msgstr "[_AD_] Práve ma poverili vedením prípadu proti tvojmu otcovi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9480 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f392b75e:
msgid "[_AD_] Aren't you going to invite me in?"
msgstr "[_AD_] Nepozveš ma dnu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9481 #-#-# translate crowdin label_gal_Lauren_Diaz_01_0cfeb5d2:
msgid "[_R_] Uhhhh.... It's 6 in the morning.... do you have a warrant?"
msgstr "[_R_] Uhhhhh.... Je šesť hodín ráno.... máš príkaz?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9484 #-#-# translate crowdin label_gal_Lauren_Diaz_01_6ac2abd0:
msgid "[_AD_] It's not that kind of visit, and we have an ongoing warrant to search the premises whenever we feel there is a need."
msgstr "[_AD_] Nejde o takýto druh návštevy a máme priebežný príkaz na prehliadku priestorov, kedykoľvek to považujeme za potrebné."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9485 #-#-# translate crowdin label_gal_Lauren_Diaz_01_97be63b2:
msgid "[_R_] Ok, let me go get my mom."
msgstr "[_R_] Dobre, pôjdem po mamu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9486 #-#-# translate crowdin label_gal_Lauren_Diaz_01_79ea7cb6:
msgid "[_AD_] She's not here, I just watched her drive away."
msgstr "[_AD_] Nie je tu, práve som ju videla odchádzať."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9487 #-#-# translate crowdin label_gal_Lauren_Diaz_01_abc2caa1:
msgid "[_AD_] I've arranged for her to have an early morning meeting with her lawyer and the federal proscecutor each Thursday morning to go over details of the investigation against her husband."
msgstr "[_AD_] Dohodla som jej skoré ranné stretnutie s jej právnikom a federálnym prokurátorom každý štvrtok ráno, aby sme prebrali podrobnosti vyšetrovania proti jej manželovi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9488 #-#-# translate crowdin label_gal_Lauren_Diaz_01_377b52c5:
msgid "[_R_] Then who are you here to see?"
msgstr "[_R_] Tak koho si prišla navštíviť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9491 #-#-# translate crowdin label_gal_Lauren_Diaz_01_4bdfb08b:
msgid "[_AD_] I actually want to have a few words with you and your sister Lauren."
msgstr "[_AD_] Vlastne si chcem s tebou a tvojou sestrou Lauren pohovoriť."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9492 #-#-# translate crowdin label_gal_Lauren_Diaz_01_4881927b:
msgid "[_R_] What?"
msgstr "[_R_] Čo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9493 #-#-# translate crowdin label_gal_Lauren_Diaz_01_81d16400:
msgid "[_R_] What could you possibly want with us?"
msgstr "[_R_] Čo by si od nás mohla chcieť?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9494 #-#-# translate crowdin label_gal_Lauren_Diaz_01_70b47061:
msgid "[_AD_] Why don't you go get your sister and I'll meet you in the lounge."
msgstr "[_AD_] Prečo nejdeš po svoju sestru a stretneme v salóniku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9495 #-#-# translate crowdin label_gal_Lauren_Diaz_01_2e4a6d3a:
msgid "[_R_] Uhhhh.... ok.... let me show you where it..."
msgstr "[_R_] Uhhhhh.... ok.... ukážem, kde je..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9496 #-#-# translate crowdin label_gal_Lauren_Diaz_01_1abb2e84:
msgid "[_AD_] I know where it is.... just run and get Lauren."
msgstr "[_AD_] Viem, kde je.... len bež a vezmi Lauren."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9499 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f5e057fd:
msgid "[_RT_] {i}Oh my God.... what is this about?.... I hope I haven't done anything to get Lauren in trouble.{/i}"
msgstr "[_RT_] {i}Preboha.... čo to má znamenať?.... Dúfam, že som neurobil nič, čím by som Lauren dostal do problémov.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9502 #-#-# translate crowdin label_gal_Lauren_Diaz_01_2bd18c71:
msgid "[_AD_] Good morning Lauren, I hope you slept well."
msgstr "[_AD_] Dobré ráno Lauren, dúfam, že si sa dobre vyspala."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9503 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f770b05c:
msgid "[_L_] Uuuuhhhh.... hi?"
msgstr "[_L_] Uuuuhhhhh.... hi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9504 #-#-# translate crowdin label_gal_Lauren_Diaz_01_bb33f9ab:
msgid "[_AD_] I'm sorry, but did [ryan] tell you who I am?"
msgstr "[_AD_] Prepáč, ale povedal ti [ryan] , kto som?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9505 #-#-# translate crowdin label_gal_Lauren_Diaz_01_efb40849:
msgid "[_L_] He said you're in charge of building a case against our dad?"
msgstr "[_L_] Povedal, že máš na starosti vytvorenie prípadu proti nášmu otcovi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9506 #-#-# translate crowdin label_gal_Lauren_Diaz_01_4af17a9e:
msgid "[_AD_] I am, but I'm not here to talk about his case, I'm here because of the actions of you two."
msgstr "[_AD_] Som, ale nie som tu, aby som hovorila o jeho prípade, som tu kvôli činom vás dvoch."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9509 #-#-# translate crowdin label_gal_Lauren_Diaz_01_f2449bf5:
msgid "[_L_] Oh, no.... what have we done?"
msgstr "[_L_] Ach, nie...., čo sme to urobili?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9510 #-#-# translate crowdin label_gal_Lauren_Diaz_01_0d8715ae:
msgid "[_R_] Lauren.... let me do the talking. We have to be careful what we say here."
msgstr "[_R_] Lauren.... nechaj hovoriť mňa. Musíme si dávať pozor na to, čo tu hovoríme."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9511 #-#-# translate crowdin label_gal_Lauren_Diaz_01_c73a52f0:
msgid "[_AD_] You bet your ass you do. You two have been naughty lately."
msgstr "[_AD_] To sa stav, že áno. Vy dvaja ste v poslednom čase boli nezbední."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9512 #-#-# translate crowdin label_gal_Lauren_Diaz_01_5d4af1b1:
msgid "[_L_] No, we haven't."
msgstr "[_L_] Nie, to sme neboli."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9513 #-#-# translate crowdin label_gal_Lauren_Diaz_01_9302d5ba:
msgid "[_AD_] So, you haven't been taking sexy pictures of yourself on the property of a company that has suspected dealings with the Mafia?"
msgstr "[_AD_] Takže ste si nerobili sexi fotky na pozemku spoločnosti, ktorá je podozrivá z kontaktov s mafiou?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9516 #-#-# translate crowdin label_gal_Lauren_Diaz_01_0e57b180:
msgid "[_L_] How do you know that?"
msgstr "[_L_] Ako to vieš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9517 #-#-# translate crowdin label_gal_Lauren_Diaz_01_61f99ab9:
msgid "[_R_] They're watching everything we do..."
msgstr "[_R_] Sledujú všetko, čo robíme..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9518 #-#-# translate crowdin label_gal_Lauren_Diaz_01_db04ce07:
msgid "[_AD_] Oh, please.... you aren't making it hard."
msgstr "[_AD_] Oh, prosím.... si to nesťažuj."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9519 #-#-# translate crowdin label_gal_Lauren_Diaz_01_09797b50:
msgid "[_AD_] Are you aware how easy it is to track your activity on the internet?"
msgstr "[_AD_] Vieš, aké jednoduché je sledovať tvoju aktivitu na internete?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9520 #-#-# translate crowdin label_gal_Lauren_Diaz_01_20dacfb6:
msgid "[_AD_] Are you aware how easy it is to follow teens on their bikes and mopeds?"
msgstr "[_AD_] Vieš, aké ľahké je sledovať tínedžerov na bicykloch a mopedoch?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9521 #-#-# translate crowdin label_gal_Lauren_Diaz_01_a11847bd:
msgid "[_RT_] {i}Oh my God, does that mean they know about me buying and installing my spy-cams?{/i}"
msgstr "[_RT_] {i}Preboha, to znamená, že vedia o tom, že som si kúpil a nainštaloval špionážne kamery?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9522 #-#-# translate crowdin label_gal_Lauren_Diaz_01_aecb30cb:
msgid "[_AD_] Your father obviously didn't teach you anything he knew about conducting business covertly."
msgstr "[_AD_] Tvoj otec ťa očividne nenaučil nič, čo vedel o tajnom podnikaní."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9525 #-#-# translate crowdin label_gal_Lauren_Diaz_01_e9720519:
msgid "[_RT_] But Lauren and I are both adults. It's not illegal for us to take and pose for adult pictures, and we've set up everything legally online through Cosplay Heaven."
msgstr "[_RT_] Ale Lauren aj ja sme už dospelí. Nie je pre nás nelegálne fotiť a pózovať na fotografiách pre dospelých a všetko sme legálne nastavili online prostredníctvom Cosplay Heaven."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9526 #-#-# translate crowdin label_gal_Lauren_Diaz_01_61fc2b1d:
msgid "[_AD_] Yes, and you generated tax forms that prove you're making an income that you aren't reporting and surrendering to the FBI."
msgstr "[_AD_] Áno, a vygenerovali ste daňové formuláre, ktoré dokazujú, že máte príjem, ktorý neoznamujete a neodovzdávate FBI."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9527 #-#-# translate crowdin label_gal_Lauren_Diaz_01_00f6c236:
msgid "[_R_] Oh, shit.... that's right..."
msgstr "[_R_] Oh, shit.... to je pravda..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9528 #-#-# translate crowdin label_gal_Lauren_Diaz_01_bbc2cbed:
msgid "[_AD_] And that's not even mentioning the money you're getting under the table from Uncle Bobby to help you pay off your weekly debt to the DeCapos."
msgstr "[_AD_] A to ani nehovorím o peniazoch, ktoré dostávaš pod stolom od strýka Bobbyho, aby ti pomohol splatiť tvoj týždenný dlh DeCapovcom."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9529 #-#-# translate crowdin label_gal_Lauren_Diaz_01_c6841c25:
msgid "[_R_] ..."
msgstr "[_R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9532 #-#-# translate crowdin label_gal_Lauren_Diaz_01_c6841c25_1:
msgid "[_R_] ..."
msgstr "[_R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9533 #-#-# translate crowdin label_gal_Lauren_Diaz_01_a8b48c7e:
msgid "[_R_] Wait!.... You know the DeCapos are extorting us for $1000 a week?"
msgstr "[_R_] Počkaj!.... Vieš, že nás DeCapovci vydierajú za 1000 dolárov týždenne?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9534 #-#-# translate crowdin label_gal_Lauren_Diaz_01_603e7276:
msgid "[_AD_] And I know they're making your mom strip if they don't get their payment each week."
msgstr "[_AD_] A viem, že tvoja mama robí striptíz, ak nedostanú každý týždeň výplatu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9537 #-#-# translate crowdin label_gal_Lauren_Diaz_01_8bfbbc86:
msgid "[_L_] What?.... Mom's not serving drinks at Joey's club? She's actually stripping?"
msgstr "[_L_] Čo?.... Mama nepodáva nápoje v Joeyho klube? Ona sa vlastne vyzlieka?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9538 #-#-# translate crowdin label_gal_Lauren_Diaz_01_4da22d70:
msgid "[_R_] Yeah.... she asked me not to tell you. I'll fill you in later."
msgstr "[_R_] Áno.... ona ma požiadala, aby som ti to nehovoril. Zasvätím ťa do toho neskôr."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9541 #-#-# translate crowdin label_gal_Lauren_Diaz_01_5ce21906:
msgid "[_R_] So, you know about all of this?.... And we're the ones who are in trouble? Why aren't you going after the DeCapo's?"
msgstr "[_R_] Takže ty o tom všetkom vieš?.... A my sme tí, ktorí majú problémy? Prečo nejdeš po DeCapovi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9542 #-#-# translate crowdin label_gal_Lauren_Diaz_01_0ee628bf:
msgid "[_AD_] [ryan], you're a bright boy.... I'm sure you've seen Mafia movies before."
msgstr "[_AD_] [ryan], si bystrý chlapec.... Som si istá, že si už videl mafiánske filmy."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9543 #-#-# translate crowdin label_gal_Lauren_Diaz_01_81c7844f:
msgid "[_AD_] It shouldn't be too hard for you to put this together."
msgstr "[_AD_] Nemalo by pre teba byť príliš ťažké to zostaviť."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9546 #-#-# translate crowdin label_gal_Lauren_Diaz_01_c6841c25_2:
msgid "[_R_] ..."
msgstr "[_R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9547 #-#-# translate crowdin label_gal_Lauren_Diaz_01_d5b2c6d8:
msgid "[_R_] Oh my God.... you're in the pocket of the DeCapos."
msgstr "[_R_] Bože môj.... si vo vrecku DeCapovcov."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9548 #-#-# translate crowdin label_gal_Lauren_Diaz_01_9ead3cdb:
msgid "[_L_] Oh my God..."
msgstr "[_L_] Bože môj..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9549 #-#-# translate crowdin label_gal_Lauren_Diaz_01_2d42041c:
msgid "[_AD_] Haha.... bingo."
msgstr "[_AD_] Haha.... bingo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:9552 #-#-# translate crowdin label_gal_Lauren_Diaz_01_ef91a493:
msgid "[_L_] Well, thats not horrible news."
