# game/Gallery_labels_AFV-0.06_v0.2.rpy:21060 #-#-# translate crowdin label_gal_aunt_05_272e3e7a:
msgid "[_C_] You're a creep, [ryan]! Even when you were a little kid, I had you pegged as a loser."
msgstr "[_C_] Vy ste creep, [ryan]! Aj keď si bol malý chlapec, tak som ťa napichla ako smoliar."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21061 #-#-# translate crowdin label_gal_aunt_05_8f115a63:
msgid "{i}{b}\"Aunt Camille's Affection =0\"{/b}{/i}"
msgstr "{i}{b}\"Aunt Aunt Camille's Affection = 0\" {/b} {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21062 #-#-# translate crowdin label_gal_aunt_05_5e599aa5:
msgid "[_C_] You'll never amount to anything."
msgstr "Nikdy nič neznesiješ."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21063 #-#-# translate crowdin label_gal_aunt_05_a56d0f26:
msgid "{i}{b}\"Aunt Camille's Respect = 0\"{/b}{/i}"
msgstr "{i}{b}\"Aunt Camille's Respect = 0\" {/b} {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21064 #-#-# translate crowdin label_gal_aunt_05_02d158d0:
msgid "[_C_] I can't believe I ever let you treat me like you have. Well, not anymore."
msgstr "[_ C_] Nemôžem uveriť, že som niekedy nechal, aby si so mnou zaobchádzal tak ako ty. No, už nie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21065 #-#-# translate crowdin label_gal_aunt_05_56090968:
