# game/Gallery_labels_AFV-0.06_v0.2.rpy:3706 #-#-# translate crowdin label_gal_mom_blackmailed_91250809:
msgid "[_M_] All my wages are garnished by the FBI, and I hardly think our extortioner is going to offer to pick up the bill."
msgstr "[_M_] Všetky moje platy sú obstavené FBI a sotva si myslím, že sa náš vydierač ponúkne, že vyplatí účet."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3707 #-#-# translate crowdin label_gal_mom_blackmailed_9ff1fa2b:
msgid "[_MG_] You thought right."
msgstr "[_MG_] Myslel si správne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3708 #-#-# translate crowdin label_gal_mom_blackmailed_ce73a1d5:
msgid "[_R_] Fine!"
msgstr "[_R_] Dobre!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3709 #-#-# translate crowdin label_gal_mom_blackmailed_253373e3:
msgid "[_R_] I'll give Sidney the money the next time I see her."
msgstr "[_R_] Dám Sidney peniaze, keď ju najbližšie uvidím."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3712 #-#-# translate crowdin label_gal_mom_blackmailed_4204fcaf:
msgid "[_MG_] This is so awesome! I can't wait to see the costumes! Just let me know when Sidney's got them ready."
msgstr "[_MG_] To je tak úžasné! Nemôžem sa dočkať, až uvidím kostýmy! Len mi daj vedieť, keď ich Sidney pripraví."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3713 #-#-# translate crowdin label_gal_mom_blackmailed_2decb5dc:
msgid "[_R_] ... fine."
msgstr "[_R_] ... v poriadku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3716 #-#-# translate crowdin label_gal_mom_blackmailed_e932ea58:
msgid "[_RT_] {i}Well that was an interesting turn of events. I've been trying to think of a way to get Mom in the studio, but now Megan has done it for me!{/i}"
msgstr "[_RT_] {i}To bol zaujímavý zvrat udalostí. Snažil som sa vymyslieť spôsob, ako dostať mamu do štúdia, ale teraz to za mňa urobila Megan!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3717 #-#-# translate crowdin label_gal_mom_blackmailed_4c834465:
msgid "[_RT_] {i}As excited as I am though, I think Megan's even more excited.{/i}"
msgstr "[_RT_] {i}Tak ako sa teším ja, myslím, že Megan sa teší ešte viac.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3721 #-#-# translate crowdin label_gal_mom_blackmailed_1705afeb:
msgid "[_RT_] And that's all the memory I have of that event!"
