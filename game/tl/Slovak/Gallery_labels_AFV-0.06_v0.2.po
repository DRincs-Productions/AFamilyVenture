# game/Gallery_labels_AFV-0.06_v0.2.rpy:21743 #-#-# translate crowdin label_gal_aunt_06_069d462f:
msgid "[_M_] I wish I were strong enough to carry this all on my own, but you volunteering to help me carry it means the world to me."
msgstr "[_ M_] Kieli by som bol dosť silný na to, aby som to všetko sám, ale vy dobrovoľník, aby mi pomohol niesť to znamená, že svet ku mne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21744 #-#-# translate crowdin label_gal_aunt_06_a9a873e4:
msgid "[_M_] I'm sorry I've been keeping you at arms length, I've just been imagining that I've damaged you to a point where it's irreparable."
