# game/Gallery_labels_AFV-0.06_v0.2.rpy:3735 #-#-# translate crowdin label_gal_mom_ph_read_7d0423a7:
msgid "[_RT_] {i}I always thought being a Perry Hotter nerd would keep me from getting laid.{/i}"
