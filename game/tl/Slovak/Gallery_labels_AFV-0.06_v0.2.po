# game/Gallery_labels_AFV-0.06_v0.2.rpy:21067 #-#-# translate crowdin label_gal_aunt_05_da6005ab:
msgid "[_BJ_dealer_] Ace of Diamonds... Dealer has {b}BlackJack{/b}."
msgstr "[_BJ_dealer_] Ace diamantov ... Dealer má {b}Blackjack {/b}."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21070 #-#-# translate crowdin label_gal_aunt_05_8a709e4a:
msgid "[_BJ_dealer_] Player loses."
msgstr "[_BJ_dealer_] prehrávač prehrá."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21071 #-#-# translate crowdin label_gal_aunt_05_6e3a2a53_1:
msgid "[_C_] What?"
msgstr "[_C_] Čo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21072 #-#-# translate crowdin label_gal_aunt_05_466961ca:
msgid "[_R_] Oh, fuck..."
msgstr "[_] Oh, kurva ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21075 #-#-# translate crowdin label_gal_aunt_05_33e40c4d:
msgid "[_R_] I told you to quit while you were ahead!"
msgstr "[_ R_] Povedal som vám, aby ste prestať, zatiaľ čo ste boli dopredu!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21076 #-#-# translate crowdin label_gal_aunt_05_e2c8cd52:
msgid "[_C_] But... Hang on, it's a tie... I mean a, umm... a push!"
msgstr "[_C_] Ale ... Vydrž, to je kravata ... Myslím tým, umm ... tlačenie!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21079 #-#-# translate crowdin label_gal_aunt_05_e96c9672:
msgid "[_C_] Stop!"
msgstr "[_ C_] Zastaviť!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21080 #-#-# translate crowdin label_gal_aunt_05_d573edcc:
msgid "[_C_] We both have twenty one. It's a tie!"
msgstr "Obaja máme dvadsiatku. To je kravata!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21081 #-#-# translate crowdin label_gal_aunt_05_d9dcc9e3:
msgid "[_BJ_dealer_] Sorry, but a blackjack beats a twenty one. I'll need to take these chips Ma'am."
msgstr "[_BJ_dealer_] Prepáčte, ale blackjack bije dvadsaťjeden. Budem potrebovať, aby sa tieto čipy madam."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21084 #-#-# translate crowdin label_gal_aunt_05_3e8fee8a:
msgid "[_J_] Hello, Camille. Just checking in. Thought I'd bring you over another drink."
msgstr "-Ahoj, Camille. Len kontrolujte. Myslel som, že ti prinesiem ďalší drink."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21085 #-#-# translate crowdin label_gal_aunt_05_c6f31f01:
msgid "[_C_] Joey! Tell your employee that I didn't lose. It's a tie!"
msgstr "Joey! Povedzte svojmu zamestnancovi, že som nestratil. To je kravata!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21086 #-#-# translate crowdin label_gal_aunt_05_0dddcc04:
msgid "[_J_] I'm afraid it looks like the dealer has blackjack."
msgstr "[_ J_] Obávam sa, že to vyzerá tak, že dealer má blackjack."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21087 #-#-# translate crowdin label_gal_aunt_05_05819562:
msgid "[_J_] Oooo... and you were doing so well too. Bad luck on that ace."
msgstr "[_ J_] Oooo ... a tiež ste sa robili tak dobre. Smola na tom eso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21088 #-#-# translate crowdin label_gal_aunt_05_d856478d:
msgid "[_C_] The Ace! I saw that ace two hands ago. It shouldn't have still been in the deck."
msgstr "[_C_] Ace! Videl som to pred dvoma rukami. Ešte stále by to nemalo byť v balíčku."

