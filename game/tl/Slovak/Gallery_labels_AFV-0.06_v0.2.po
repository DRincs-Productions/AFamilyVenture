# game/Gallery_labels_AFV-0.06_v0.2.rpy:17004 #-#-# translate crowdin label_gal_sidney_monster_path_950b8bfa:
msgid "[_M_] Oh, good Lord!... I'm going to go find Sidney to help me straighten this out."
