# game/Gallery_labels_AFV-0.06_v0.2.rpy:3761 #-#-# translate crowdin label_gal_mom_ph_read_18a9c6b4:
msgid "[_R_] You do?... Really?... You wouldn't mind being called \"The boy with the golden snatch?\""
msgstr "[_R_] Tebe áno?... Naozaj?... Nevadilo by ti, keby ťa volali \"Chlapec so zlatým chrbtom\"?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3762 #-#-# translate crowdin label_gal_mom_ph_read_b9824c43:
msgid "[_R_] You do know what a snatch is slang for, right?"
