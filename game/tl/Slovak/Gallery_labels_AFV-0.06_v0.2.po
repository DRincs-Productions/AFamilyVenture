# game/Gallery_labels_AFV-0.06_v0.2.rpy:37218 #-#-# translate crowdin label_gal_cosplay_02_0456e9c5:
msgid "[_R_] I can see it now."
msgstr "[_R_] Už to všetko vidím."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37228 #-#-# translate crowdin label_gal_cosplay_02_e1957aeb:
msgid "[_R_] That's going to look really good."
