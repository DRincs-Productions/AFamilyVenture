# game/Gallery_labels_AFV-0.06_v0.2.rpy:23107 #-#-# translate crowdin label_gal_Xmas_event_d7557e14:
msgid "[_RT_] {i}Really?.... Cuz Mom told me that they met when she was working at a strip club.{/i}"
