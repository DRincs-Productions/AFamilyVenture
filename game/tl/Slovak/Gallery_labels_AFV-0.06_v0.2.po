# game/Gallery_labels_AFV-0.06_v0.2.rpy:21758 #-#-# translate crowdin label_gal_aunt_06_ddf63bff:
msgid "[_M_] That's only fair. She caused this mess, if she wants to live here, she needs to be willing to help us get out of it."
msgstr "[_M_] To je fér. Spôsobila ten neporiadok, ak chce žiť tu, musí byť ochotná, aby nám pomohla dostať sa z toho."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21759 #-#-# translate crowdin label_gal_aunt_06_41d92efe:
msgid "[_M_] And now, she's out there playing this humble \"poor me\" act."
