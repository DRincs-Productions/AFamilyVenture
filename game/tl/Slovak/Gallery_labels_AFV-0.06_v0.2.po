# game/Gallery_labels_AFV-0.06_v0.2.rpy:37328 #-#-# translate crowdin label_gal_cosplay_02_594e0ea2:
msgid "[_RT_] {i}Should I go on?{/i}"
msgstr "[_RT_] {i}Mám pokračovať?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37332 #-#-# translate crowdin label_gal_cosplay_02_ed2d2668:
msgid "[_R_] Let's see what we can do to that outfit to sexy it up even more."
msgstr "[_R_] Pozrime sa, čo môžeme urobiť s týmto oblečením, aby bolo ešte viac sexy."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37333 #-#-# translate crowdin label_gal_cosplay_02_e60e938d_1:
msgid "[_L_] How do you mean?"
msgstr "[_L_] Ako to myslíš?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37334 #-#-# translate crowdin label_gal_cosplay_02_35bfda16:
msgid "[_R_] Let's show off that thong from behind."
