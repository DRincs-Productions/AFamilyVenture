# game/Gallery_labels_AFV-0.06_v0.2.rpy:17910 #-#-# translate crowdin label_gal_aunt_01_9d58336f:
msgid "[_B_] I'm in some trouble, and I've gots to dissapear."
msgstr "[_] Som v nejakom probléme, a ja sa idem dišvihovať."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17911 #-#-# translate crowdin label_gal_aunt_01_fc60abf1:
msgid "[_R_] Oh my God, are you serious?"
