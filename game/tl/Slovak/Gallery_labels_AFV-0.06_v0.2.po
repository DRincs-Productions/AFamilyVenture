# game/Gallery_labels_AFV-0.06_v0.2.rpy:21800 #-#-# translate crowdin label_gal_aunt_06_ed2fc5b9:
msgid "[_R_] Desperate times call for desperate measures."
msgstr "[_ R_] Desperáni časy volanie pre zúfalé opatrenia."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21801 #-#-# translate crowdin label_gal_aunt_06_91bb7f92:
msgid "[_R_] Trust me, if it was as simple as starting a pretzel stand, or starting a real estate company, or some other family venture, we'd do it."
msgstr "[_ R_] Ver mi, ak by to bolo také jednoduché, ako začať stáť, alebo začať realitnú spoločnosť, alebo nejaký iný rodinný podnik, tak by sme to urobili."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21802 #-#-# translate crowdin label_gal_aunt_06_bd824ae8:
msgid "[_R_] We don't have time to build anything from the ground up."
