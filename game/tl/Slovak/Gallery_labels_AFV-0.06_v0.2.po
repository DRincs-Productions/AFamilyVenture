# game/Gallery_labels_AFV-0.06_v0.2.rpy:17002 #-#-# translate crowdin label_gal_sidney_monster_path_06ee32c5:
msgid "[_R_] I'm not on any drugs! I swear!"
msgstr "[_R_] Neberiem žiadne drogy! Prísahám!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17003 #-#-# translate crowdin label_gal_sidney_monster_path_21e10533:
msgid "[_R_] I saw Sidney inside the mirror, but she wasn't in this room!"
