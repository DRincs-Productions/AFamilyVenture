# game/Gallery_labels_AFV-0.06_v0.2.rpy:3756 #-#-# translate crowdin label_gal_mom_ph_read_0d9bc7cf:
msgid "[_M_] Don't you just love it?"
msgstr "[_M_] Nemiluješ to?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3757 #-#-# translate crowdin label_gal_mom_ph_read_7c92d0cd:
msgid "[_R_] It's ok... but there's one thing that's been bugging me... he's got a terrible nickname."
msgstr "[_R_] Je to v poriadku... ale je tu jedna vec, ktorá ma trápi... má hroznú prezývku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3760 #-#-# translate crowdin label_gal_mom_ph_read_7d77aaaa:
msgid "[_M_] Oh, really? You don't like it?"
