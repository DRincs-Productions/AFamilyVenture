# game/Gallery_labels_AFV-0.06_v0.2.rpy:37257 #-#-# translate crowdin label_gal_cosplay_02_b4bb4ab4:
msgid "[_R_] This one's going to look great with the forest background as well."
msgstr "[_R_] Táto bude vyzerať skvele aj s lesným pozadím."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37269 #-#-# translate crowdin label_gal_cosplay_02_364809a5:
msgid "[_R_] Lauren, you're so photogenic!"
