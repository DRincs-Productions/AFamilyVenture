# game/Gallery_labels_AFV-0.06_v0.2.rpy:37290 #-#-# translate crowdin label_gal_cosplay_02_dbbab13a:
msgid "[_R_] And get rid of that axe and shield while you're at it. We shouldn't need those any more."
msgstr "[_R_] A keď už budeš v tom, zbav sa sekery a štítu. Tie by sme už nemali potrebovať."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37291 #-#-# translate crowdin label_gal_cosplay_02_316668ef:
msgid "[_L_] Ok, give me just a second."
