# game/Gallery_labels_AFV-0.06_v0.2.rpy:3689 #-#-# translate crowdin label_gal_mom_blackmailed_5e175dd6:
msgid "[_MG_] [ryan], I want you to create the background with your Photochop and 3d modeling skills."
msgstr "[_MG_] [ryan], chcem, aby si vytvoril pozadie s tvojimi schopnosťami Photochop a 3d modelovania."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3692 #-#-# translate crowdin label_gal_mom_blackmailed_f9f763c7:
msgid "[_MG_] And I love the Perry Hotter movies and books."
msgstr "[_MG_] A milujem filmy a knihy Perryho Hottera."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3693 #-#-# translate crowdin label_gal_mom_blackmailed_9ec20a00:
msgid "[_MG_] So I want you to get some Perry Hotter cosplay outfits."
msgstr "[_MG_] Takže chcem, aby si zaobstaral nejaké cosplay oblečenie Perry Hotter."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3694 #-#-# translate crowdin label_gal_mom_blackmailed_7e5a14ee:
msgid "[_MG_] I'm thinking a student and a teacher outfit."
msgstr "[_MG_] Myslím oblečenie študenta a učiteľa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3695 #-#-# translate crowdin label_gal_mom_blackmailed_8bafe8f4:
msgid "[_R_] Really? Isn't Perry Hotter kind of juvenile?"
msgstr "[_R_] Naozaj? Nie je Perry Hotter tak trochu mladistvý?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3698 #-#-# translate crowdin label_gal_mom_blackmailed_6d3c7569:
msgid "[_M_] If you had actually read the books then you'd know they appeal to all ages."
msgstr "[_M_] Ak by si knihy skutočne čítal, vedel by si, že sú vhodné pre všetky vekové kategórie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3699 #-#-# translate crowdin label_gal_mom_blackmailed_814cd7e0:
msgid "[_R_] Ok... sorry."
msgstr "[_R_] Ok... prepáč."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3700 #-#-# translate crowdin label_gal_mom_blackmailed_10e7c676:
msgid "[_M_] You should be!"
msgstr "[_M_] Mal by si byť!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3701 #-#-# translate crowdin label_gal_mom_blackmailed_3217f575:
msgid "[_R_] So, who's going to pay for the cosplay outfits?"
