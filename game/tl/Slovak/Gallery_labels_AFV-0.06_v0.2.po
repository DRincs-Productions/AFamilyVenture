# game/Gallery_labels_AFV-0.06_v0.2.rpy:16927 #-#-# translate crowdin label_gal_sidney_monster_path_67a21f4f:
msgid "[_S_] [ryan], you've got to help me. What if it comes back?... What does it want with me?"
