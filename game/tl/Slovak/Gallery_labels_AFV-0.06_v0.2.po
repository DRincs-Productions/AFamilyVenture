# game/Gallery_labels_AFV-0.06_v0.2.rpy:21784 #-#-# translate crowdin label_gal_aunt_06_720ab0bf:
msgid "[_R_] Lauren and Mandy start to advertise that their moms, who also happen to be sisters, will be doing a steamy photo shoot together on \"Cosplay Heaven.\""
