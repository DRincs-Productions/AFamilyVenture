# game/Gallery_labels_AFV-0.06_v0.2.rpy:17914 #-#-# translate crowdin label_gal_aunt_01_226b6c69:
msgid "[_B_] Unfortunately, yes.... "
msgstr "[_B_] Bohužiaľ, áno.... "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17915 #-#-# translate crowdin label_gal_aunt_01_d5446a1a:
msgid "[_B_] I just got a tip from our friend Agent Diaz.... "
