# game/Gallery_labels_AFV-0.06_v0.2.rpy:37138 #-#-# translate crowdin label_gal_cosplay_02_0998349b_1:
msgid "[_R_] It will make it so we can add any background we want to the pictures later."
msgstr "[_R_] Vďaka tomu budeme môcť neskôr do obrázkov pridať ľubovoľné pozadie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37139 #-#-# translate crowdin label_gal_cosplay_02_5b03caaa_1:
msgid "[_R_] I've been playing with the ZAD 3D computer program, and I should be able to do a lot of fun effects with the pictures we take."
msgstr "[_R_] Hral som sa s počítačovým programom ZAD 3D a mal by som byť schopný urobiť veľa zábavných efektov s fotografiami, ktoré sme urobili."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37140 #-#-# translate crowdin label_gal_cosplay_02_6844630d_1:
