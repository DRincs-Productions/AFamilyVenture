# game/Gallery_labels_AFV-0.06_v0.2.rpy:37022 #-#-# translate crowdin label_gal_cosplay_02_98c19aa7:
msgid "[_R_] I've been working really hard lately, and I should have enough to pay for Lauren's outfit and the weekly Mafia debt."
