# game/Gallery_labels_AFV-0.06_v0.2.rpy:3736 #-#-# translate crowdin label_gal_mom_ph_read_185f75a4:
msgid "[_RT_] {i}Now, it seems like it's the best path to getting laid.{/i}"
msgstr "[_RT_] {i}Teraz sa zdá, že je to najlepšia cesta k tomu, ako si vrznúť.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3737 #-#-# translate crowdin label_gal_mom_ph_read_fce8b27c:
msgid "[_RT_] {i}Ok... I can do this...{/i}"
