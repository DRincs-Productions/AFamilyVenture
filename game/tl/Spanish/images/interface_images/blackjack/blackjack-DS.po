# TODO: Translation updated at 2024-07-23 08:27 #|#|# # game/images/interface_images/blackjack/blackjack-DS.rpy:511 #-#-# translate crowdin startGameBJ_ddfcd22e:
msgid "[_BJ_dealer_] I'll start dealing the cards!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡Empezaré a repartir las cartas! {w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:581 #-#-# translate crowdin handCheckLabel_8e5fda21:
msgid "[_BJ_dealer_] Dealer Bust, you won $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] El repartidor se ha pasado, ha ganado $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:593 #-#-# translate crowdin handCheckLabel_1a74bd53:
msgid "[_BJ_dealer_] You bust! You lost $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] El repartidor se ha pasado, ha ganado $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:605 #-#-# translate crowdin handCheckLabel_d1330db7:
msgid "[_BJ_dealer_] Blackjack! The dealer also has blackjack, but you have insurance! You win $[betSum]!{w=2.0}{nw}"
msgstr "[¡Blackjack! El crupier también tiene blackjack, ¡pero tú tienes seguro! Usted gana $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:608 #-#-# translate crowdin handCheckLabel_f74531ea:
msgid "[_BJ_dealer_] Blackjack! The dealer also has blackjack, so it's a push! You get your $[betSum] back!{w=2.0}{nw}"
msgstr "[¡Blackjack! El crupier también tiene blackjack, ¡pero tú tienes seguro! Usted gana $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:620 #-#-# translate crowdin handCheckLabel_3b883a25:
msgid "[_BJ_dealer_] Blackjack! You won the game and $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡Blackjack! Usted ganó el juego y $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:631 #-#-# translate crowdin handCheckLabel_4b09cedb:
msgid "[_BJ_dealer_] Dealer has blackjack, but you have insurance! You make your bets back, $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡La banca tiene blackjack, pero tú tienes seguro! Usted recupera sus apuestas, $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:634 #-#-# translate crowdin handCheckLabel_1d95a20c:
msgid "[_BJ_dealer_] Dealer has blackjack! You lose the game and $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡Blackjack! Usted ganó el juego y $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:645 #-#-# translate crowdin handCheckLabel_b384deae:
msgid "[_BJ_dealer_] You won the game and $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡Blackjack! Usted ganó el juego y $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:657 #-#-# translate crowdin handCheckLabel_e4d35a85:
msgid "[_BJ_dealer_] You lost the game and $[betSum]!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡Blackjack! Usted ganó el juego y $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:669 #-#-# translate crowdin handCheckLabel_901a9a2d:
msgid "[_BJ_dealer_] The dealer also has [computerScore], so it's a push! You get your $[betSum] back minus $[betIns] for insurance.{w=2.0}{nw}"
msgstr "[El crupier también tiene [computerScore], ¡así que es un empate! Recuperas tu $[betSum] menos $[betIns] por el seguro.{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:671 #-#-# translate crowdin handCheckLabel_3615550f:
msgid "[_BJ_dealer_] The dealer also has [computerScore], so it's a push! You get your $[betSum] back!{w=2.0}{nw}"
msgstr "[¡Blackjack! El crupier también tiene blackjack, ¡pero tú tienes seguro! Usted gana $[betSum]!{w=2.0}{nw}"

# game/images/interface_images/blackjack/blackjack-DS.rpy:689 #-#-# translate crowdin noMoney_9706b720:
msgid "[_BJ_dealer_] Sorry! You don't have enough money!{w=2.0}{nw}"
msgstr "[_BJ_dealer_] ¡Lo siento! No tienes suficiente dinero! {w=2.0}{nw}"

# §translate crowdin strings: #|#|# # game/images/interface_images/blackjack/blackjack-DS.rpy:257
msgid "Dealer"
msgstr "Distribuidor"

# game/images/interface_images/blackjack/blackjack-DS.rpy:375
msgid "Place your bets!"
msgstr "Hagan sus apuestas"

# game/images/interface_images/blackjack/blackjack-DS.rpy:382
msgid "Do you want to bet $100 and start the game?"
msgstr "¿Quieres apostar 100 $ y empezar la partida?"

# game/images/interface_images/blackjack/blackjack-DS.rpy:389
msgid "Do you want to bet $500 and start the game?"
msgstr "¿Quieres apostar 500 $ y empezar el juego?"

# game/images/interface_images/blackjack/blackjack-DS.rpy:396
msgid "Do you want to bet $1000 and start the game?"
msgstr "¿Quieres apostar 1000 $ y empezar la partida?"

# game/images/interface_images/blackjack/blackjack-DS.rpy:404
msgid "Do you want to leave the BlackJack game?"
msgstr "¿Quieres dejar el juego de BlackJack?"

# game/images/interface_images/blackjack/blackjack-DS.rpy:412
msgid "Games won: [persistent.playerWin] / lost: [persistent.computerWin]"
msgstr "Partidas ganadas: [persistent.playerWin] / perdidas: [persistent.computerWin]"

# game/images/interface_images/blackjack/blackjack-DS.rpy:478
msgid "Player cards: [playerScore]"
msgstr "Tarjetas de jugador: [playerScore]"

# game/images/interface_images/blackjack/blackjack-DS.rpy:681
msgid "Do you want to play again?"
msgstr "¿Quieres volver a jugar?"

