# game/Gallery_labels_AFV-0.06_v0.2.rpy:24784 #-#-# translate crowdin label_gal_Xmas_event_86b04e69:
msgid "[_R_] ....Mmm.... Mom?"
msgstr "[_R_] ...Mmm.... mamãe?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24785 #-#-# translate crowdin label_gal_Xmas_event_dee82788:
