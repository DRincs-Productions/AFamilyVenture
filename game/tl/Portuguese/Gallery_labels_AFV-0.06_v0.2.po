# game/Gallery_labels_AFV-0.06_v0.2.rpy:29950 #-#-# translate crowdin label_gal_ntr_blackmail_9c41f462:
msgid "[_M_] Hmmm... that had better be the case!"
msgstr "[_M_] Hmmm ... que tinha melhor ser o caso!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:29953 #-#-# translate crowdin label_gal_ntr_blackmail_bd7eaea7:
msgid "[_M_] So, to explain what we were doing, it's going to sound weird, expecially since it's a little bit theoretical, even though it's backed up by significant research."
