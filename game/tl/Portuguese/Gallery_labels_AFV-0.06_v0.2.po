# game/Gallery_labels_AFV-0.06_v0.2.rpy:23859 #-#-# translate crowdin label_gal_Xmas_event_472bee99:
msgid "[_R_] Great! I like the buddy-buddy pose."
msgstr "[_R_] Ótimo! Eu gosto da pose de companheiro."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23860 #-#-# translate crowdin label_gal_Xmas_event_d295a5a8:
