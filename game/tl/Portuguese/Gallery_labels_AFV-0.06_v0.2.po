# game/Gallery_labels_AFV-0.06_v0.2.rpy:16134 #-#-# translate crowdin label_gal_halloween_event_start_3c0fea65:
msgid "[_S_] Normally I jog in the early morning, but [ryan] and I were up super late last night, and I was too tired to get up this morning."
