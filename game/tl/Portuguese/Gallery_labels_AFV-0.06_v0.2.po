msgstr "[_RT_] {i}Acho que não vou conseguir aguentar até que a mamãe saia. Vou soprar minha carga na frente dela dela!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15867 #-#-# translate crowdin label_gal_mom_investigates_839f812e_1:
msgid "[_M_] ...Ok, fine... I'm gonna let her continue to sleep in your bedroom... for now."
msgstr "[_M_] ...Ok, bem... Vou deixar ela continuar a dormir no seu quarto... por enquanto."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15868 #-#-# translate crowdin label_gal_mom_investigates_b065b0b7_1:
msgid "[_M_] But you two have to promise to be good!"
msgstr "[_M_] Mas vocês dois têm que prometer ser bons!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15869 #-#-# translate crowdin label_gal_mom_investigates_059cd4ee_1:
msgid "[_M_] Make sure you tell Sidney when she wakes up in the morning."
msgstr "[__M_] Certifique-se de dizer a Sidney quando ela acordar de manhã."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15872 #-#-# translate crowdin label_gal_mom_investigates_0cf5ca8d_1:
msgid "[_M_] There's that face again... Are you going to be able to sneeze?"
msgstr "U[_M_] Tem aquele rosto de novo... você vai ser capaz de espirrar?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15873 #-#-# translate crowdin label_gal_mom_investigates_c7e47a50_1:
msgid "[_R_] Maybe... Fuck!"
msgstr "[_R_] Talvez... Adeus!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15874 #-#-# translate crowdin label_gal_mom_investigates_c8d412f7_1:
msgid "[_M_] Don't use language like that for just a little sneeze you can't get out!"
msgstr "[__M_] Não use a linguagem assim para apenas um pequeno espirro que você não pode sair!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15877 #-#-# translate crowdin label_gal_mom_investigates_a109a8b7_1:
msgid "[_R_] Almost... Got it!"
msgstr "[_R_] Quase ... Conseguiu!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15878 #-#-# translate crowdin label_gal_mom_investigates_062a95bd_1:
msgid "[_RT_] {i}Fuck!... Here it comes!{/i}"
msgstr "U[_RT_] {i}Presa!... Aqui está!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15883 #-#-# translate crowdin label_gal_mom_investigates_d162184a_1:
msgid "[_ST_] {i}Holy Fuck!{/i}"
msgstr "[_ST_] {i}Santa Fuck! {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15884 #-#-# translate crowdin label_gal_mom_investigates_c30e03be_1:
msgid "[_RT_] {i}Ffffuuuck!{/i}"
msgstr "[_RT_] {i}Ffffuuuck!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15885 #-#-# translate crowdin label_gal_mom_investigates_5adbfc8c_2:
msgid "[_M_] You ok?"
msgstr "U[_M_] Você sabe?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15888 #-#-# translate crowdin label_gal_mom_investigates_e5f81c0f_1:
msgid "[_R_] Mmmm hmmmm..."
msgstr "[_R_] Mmmm hmmmm..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15889 #-#-# translate crowdin label_gal_mom_investigates_cf834904_1:
msgid "[_R_] I'll... be... fine."
msgstr "[_R_] I'll... be... fine."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15890 #-#-# translate crowdin label_gal_mom_investigates_a0a94c61_1:
msgid "[_M_] Ok, I'm gonna go, but I'm glad we had this talk... I don't want you to feel like you have to hide these kinds of things from me. You just needed to talk to me about it."
msgstr "[_M_] Ok, eu vou embora, mas estou feliz por termos tido esta conversa... Eu não quero que você sinta que tem que esconder esses tipos de coisas de mim. Você só precisava falar comigo sobre isso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15891 #-#-# translate crowdin label_gal_mom_investigates_8e1ef326_1:
msgid "[_RT_] {i}Hide these kinds of things?... We'd blow her mind if she knew what we just hid from her in plain sight.{/i}"
msgstr "[_RT_] {i}Hide esses tipos de coisas? ... A gente sopria a mente dela se ela soubesse o que acabamos de esconder dela à vista. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15892 #-#-# translate crowdin label_gal_mom_investigates_f27d0992_1:
msgid "[_M_] Love you, [ryan]!"
msgstr "[_M_] Love you, [ryan]!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15893 #-#-# translate crowdin label_gal_mom_investigates_838f9643_1:
msgid "[_R_] Mmmm hmmm... Love you too Mom!"
msgstr "[_R_] Hmmm Mmmm ... Ama você também!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15894 #-#-# translate crowdin label_gal_mom_investigates_f0d4132e_1:
msgid "[_M_] Do you want me to get the light on the way out?"
msgstr "[_M_] Você quer que eu obtenha a luz no caminho?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15895 #-#-# translate crowdin label_gal_mom_investigates_f2e1fc74_1:
msgid "[_R_] Yes, please."
msgstr "[_R_] Sim, por favor."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15901 #-#-# translate crowdin label_gal_mom_investigates_c1759516:
msgid "[_R_] My God, Sidney!"
msgstr "[__R_] Meu Deus, Sidney!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15902 #-#-# translate crowdin label_gal_mom_investigates_96dcd49f:
msgid "[_R_] I can't believe you did that!"
msgstr "[_R_] Não acredito que você fez isso!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15903 #-#-# translate crowdin label_gal_mom_investigates_80e648c0:
msgid "[_S_] You fucking deserved it."
msgstr "[_S_] Você mereceu isso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15904 #-#-# translate crowdin label_gal_mom_investigates_9d01c4d1:
msgid "[_R_] You started the teasing!"
msgstr "U[_R_] Você começou a jogada!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15907 #-#-# translate crowdin label_gal_mom_investigates_87eb05dc:
msgid "[_S_] And now look... We don't have to be so sneaky anymore."
msgstr "[_S_] E agora olhe... Não precisamos mais ser tão sorrateiros."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15908 #-#-# translate crowdin label_gal_mom_investigates_c53f52e2_1:
msgid "[_S_] And now, I'm going to sleep."
msgstr "[_S_] E agora, eu vou dormir."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15909 #-#-# translate crowdin label_gal_mom_investigates_cf5810a5:
msgid "[_R_] Everyone will soon know we're sleeping together. You won't have to rush out of bed so early in the morning anymore."
msgstr "[_R_] Todo mundo vai saber que estamos dormindo juntos. Você não terá que correr da cama tão cedo da manhã."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15910 #-#-# translate crowdin label_gal_mom_investigates_1caa3650:
msgid "[_S_] Sleeping together... that sounds so naughty... Still... I probably will continue to sneak out early. Running every morning has been really therapeutic for me."
msgstr "[_S_] dormindo junto... que soa tão malvado... Ainda assim... Eu provavelmente vou continuar esgueirando cedo. Correr todas as manhãs tem sido realmente terapêutico para mim."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15911 #-#-# translate crowdin label_gal_mom_investigates_eb301bc7:
msgid "[_R_] Suit yourself. Maybe I'll join you one of these mornings."
msgstr "[_R_] Roupa consigo mesmo. Talvez eu me junte a você uma dessas manhãs."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15912 #-#-# translate crowdin label_gal_mom_investigates_5bbe8cfd:
msgid "[_S_] Ooohh... You want to get in an extra workout at the park?"
msgstr "[_S_] Oohh... Quer fazer um treino extra no parque?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15913 #-#-# translate crowdin label_gal_mom_investigates_0a0025a1:
msgid "[_S_] I'm up for it anytime."
msgstr "[_S_] Estou pronto a qualquer hora."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15917 #-#-# translate crowdin label_gal_mom_investigates_1705afeb:
msgid "[_RT_] And that's all the memory I have of that event!"
msgstr "[_RT_] E essa é toda a memória que eu tenho daquele evento!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15930 #-#-# translate crowdin label_gal_halloween_event_start_5c240a68:
msgid "{b}{i}\"Happy Halloween, and welcome to \"Stranger Ventures\"!\"{/i}{/b}"
msgstr "{b}{i}\"Feliz Dia das Bruxas e bem-vindo a \"Ventureiras\"!\"{/i}{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15931 #-#-# translate crowdin label_gal_halloween_event_start_62c4ee5d:
msgid "{b}{i}\"We hope you enjoy!\"{/i}{/b}"
msgstr "{b}{i}\"Esperamos que goste!\"{/i}{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15959 #-#-# translate crowdin label_gal_halloween_event_start_e5884594:
msgid "[_SM_] We've got to find a way out!"
msgstr "[__SM_] Nós temos que encontrar uma saída!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15962 #-#-# translate crowdin label_gal_halloween_event_start_a5c87e11:
msgid "[_SM_] Martha! We can't stop running!"
msgstr "[_SM_] Martha! Não podemos parar de correr!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15963 #-#-# translate crowdin label_gal_halloween_event_start_1a58b5c5:
msgid "[_SM_] That... Thing... is right behind us!"
msgstr "[_SM_] Que ... Coisa ... está bem atrás de nós!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15964 #-#-# translate crowdin label_gal_halloween_event_start_81e91006:
msgid "[_SF_] My lungs... are about... to explode!"
msgstr "[_SF_] Meus pulmões ... estão prestes ... a explodir!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15965 #-#-# translate crowdin label_gal_halloween_event_start_bd7f4e76:
msgid "[_SM_] Can't we just... Hide for a minute?"
msgstr "[_SM_] Não podemos simplesmente ... Escondem-se por um minuto?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15968 #-#-# translate crowdin label_gal_halloween_event_start_c7b400af:
msgid "[_SM_] I don't hear it coming anymore."
msgstr "[_SM_] Eu não ouço mais aparecer."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15969 #-#-# translate crowdin label_gal_halloween_event_start_c00ac7f6:
msgid "[_SF_] I think I'm about to lose my lunch!"
msgstr "[_SF_] acho que estou prestes a perder meu almoço!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15970 #-#-# translate crowdin label_gal_halloween_event_start_04fa5a7d:
msgid "[_SF_] What the hell was that thing?"
msgstr "[_SF_] O que diabos foi isso?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15971 #-#-# translate crowdin label_gal_halloween_event_start_2ae9a32d:
msgid "[_SM_] I don't know... But we never should have been playing God!"
msgstr "[_SM_] Eu não sei ... Mas nunca deveríamos ter jogado Deus!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15972 #-#-# translate crowdin label_gal_halloween_event_start_03f09a4a:
msgid "[_SM_] Now, how can we ask him to save us?"
msgstr "[_SM_] Agora, como podemos pedir a ele que nos salve?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15973 #-#-# translate crowdin label_gal_halloween_event_start_cdd3babd:
msgid "[_SF_] Are you kidding? Did you see that thing? There is no God!"
msgstr "[_SF_] Você está brincando? Você viu isso? Não há Deus!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15974 #-#-# translate crowdin label_gal_halloween_event_start_0ea38a0f:
msgid "[_SF_] We have to save ourselves!"
msgstr "[_SF_] Temos que nos salvar!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15977 #-#-# translate crowdin label_gal_halloween_event_start_802617d3:
msgid "[_SM_] Fuck, Martha! The guards are all dead!"
msgstr "[_SM_] Fuck, Martha! Os guardas estão todos mortos!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15978 #-#-# translate crowdin label_gal_halloween_event_start_1242aa5b:
msgid "[_SM_] How are we supposed to defend ourselves?"
msgstr "[__SM_] Como é que devemos nos defender?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15981 #-#-# translate crowdin label_gal_halloween_event_start_987d0ace:
msgid "[_SM_] Ok, I see a crowbar over there."
msgstr "[_SM_] Ok, vejo uma barra de coroa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15982 #-#-# translate crowdin label_gal_halloween_event_start_45ba0be1:
msgid "[_SM_] I'm going to run grab it!"
msgstr "[_SM_] Eu vou correr pra pegá-lo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15983 #-#-# translate crowdin label_gal_halloween_event_start_4bfa3019:
msgid "[_SF_] A crowbar? The guards couldn't even stop this thing with bullets!"
msgstr "[_SF_] uma coroa? Os guardas não conseguiram parar isso com balas!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15984 #-#-# translate crowdin label_gal_halloween_event_start_b40de364:
msgid "[_SM_] It's better than nothing!"
msgstr "[_SM_] É melhor do que nada!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15987 #-#-# translate crowdin label_gal_halloween_event_start_52d50737:
msgid "[_SF_] You're just going to get yourself killed."
msgstr "[_SF_] Você só vai se matar."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15988 #-#-# translate crowdin label_gal_halloween_event_start_06c92f66:
msgid "[_SF_] Dr. Branson?"
msgstr "[_SF_] Dr. Branson?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15991 #-#-# translate crowdin label_gal_halloween_event_start_669aa1e2:
msgid "[_SF_] Fuck!"
msgstr "[_SF_] Ai!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15992 #-#-# translate crowdin label_gal_halloween_event_start_44c00ede:
msgid "[_SF_] He's going to get us both killed!"
msgstr "[_SF_] Ele vai nos matar os dois!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15998 #-#-# translate crowdin label_gal_halloween_event_start_c60945d4:
msgid "[_SF_] {i}(Whispering){/i} Dr. Branson? Where did you go?"
msgstr "[_SF_] {i}(Sussurro){/i} Dra. Branson? Para onde você foi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15999 #-#-# translate crowdin label_gal_halloween_event_start_06c92f66_1:
msgid "[_SF_] Dr. Branson?"
msgstr "[_SF_] Dr. Branson?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16002 #-#-# translate crowdin label_gal_halloween_event_start_32b0b14d:
msgid "[_SF_] {i}(Whispering to herself){/i} Oh, no!... Oh, God!..."
msgstr "[_SF_] {i}(sussurrando para si mesmo){/i} Oh, não!... Oh, Deus!..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16003 #-#-# translate crowdin label_gal_halloween_event_start_ccb61749:
msgid "[_SF_] I can't die! Who's goin to take care of my cats?"
msgstr "[_SF_] Não posso morrer! Quem é que vai cuidar dos meus gatos?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16006 #-#-# translate crowdin label_gal_halloween_event_start_100fd34f:
msgid "[_SF_] Dr. Branson! Where are you?"
msgstr "[_SF_] Dr. Branson! Onde você está?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16007 #-#-# translate crowdin label_gal_halloween_event_start_8c14b33a:
msgid "[_SF_] Oh, God... Oh, no..."
msgstr "[_SF_] Oh, Deus ... Oh, não ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16010 #-#-# translate crowdin label_gal_halloween_event_start_4f90af39:
msgid "[_SF_] Is that blood?"
msgstr "[_SF_] É sangue?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16011 #-#-# translate crowdin label_gal_halloween_event_start_7d00402d:
msgid "[_SF_] Is that the crowbar Dr. Branson was trying to get?"
msgstr "[__SF_] É que o \"crowbar\" Dr. Branson estava tentando conseguir?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16014 #-#-# translate crowdin label_gal_halloween_event_start_c6d900c0:
msgid "[_SF_] What on earth is this viscous substance it's laying in?"
msgstr "[_SF_] O que na terra é essa substância viscosa que está se colocando?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16015 #-#-# translate crowdin label_gal_halloween_event_start_19d64e0f:
msgid "[_SF_] Is it glowing?"
msgstr "[_SF_] Está brilhando?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16018 #-#-# translate crowdin label_gal_halloween_event_start_aa784e8e:
msgid "[_SF_] Is this from the thing that's wreaking havoc on the lab?"
msgstr "[_SF_] É isso a partir da coisa que está causando estragos no laboratório?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16019 #-#-# translate crowdin label_gal_halloween_event_start_3f4361f5:
msgid "[_SF_] Is it some sort of bioluminescent discharge?"
msgstr "[_SF_] É algum tipo de descarga bioluminescente?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16026 #-#-# translate crowdin label_gal_halloween_event_start_33d8c602:
msgid "[_SF_] Goddammit! If I wasn't running for my life, I'd take a sample to study."
msgstr "[_SF_] Deusado! Se eu não estivesse correndo pela minha vida, eu pegaria uma amostra para estudar."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16027 #-#-# translate crowdin label_gal_halloween_event_start_b95c5c2f:
msgid "[_SF_] Maybe I've got time to collect a small amount."
msgstr "[_SF_] Talvez tenha tempo para coletar uma pequena quantidade."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16059 #-#-# translate crowdin label_gal_halloween_event_start_989a8cfd:
msgid "[_MD_] Good God, [ryan]! Tell us!"
msgstr "[_MD_] Bom Deus, [ryan]! Conte-nos!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16062 #-#-# translate crowdin label_gal_halloween_event_start_3ff91ba6:
msgid "[_L_] Yeah! I broke my level sixty nine magic staff to get that tomb unsealed!"
msgstr "[_L_] Sim! Eu quebrei o meu nível sessenta e nove funcionários mágicos para conseguir aquele túmulo desselado!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16063 #-#-# translate crowdin label_gal_halloween_event_start_afd432ea:
msgid "[_MD_] What's waiting behind the door?"
msgstr "[__MD_] O que está esperando atrás da porta?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16064 #-#-# translate crowdin label_gal_halloween_event_start_7ea9d909:
msgid "[_MG_] Yeah, enough with the suspense!"
msgstr "[_MG_] Sim, o suficiente com o suspenso!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16065 #-#-# translate crowdin label_gal_halloween_event_start_80e18cae:
msgid "[_R_] Alright, alright, Sheesh!"
msgstr "[_R_] Alright, tudo bem, Sheesh!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16066 #-#-# translate crowdin label_gal_halloween_event_start_0007043b:
msgid "[_R_] Nobody appreciates the art of a good Dungeon Master."
msgstr "[_R_] Ninguém aprecia a arte de um bom Mestre da Masmorra."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16069 #-#-# translate crowdin label_gal_halloween_event_start_eae336f0:
msgid "[_R_] So, as the heavy stone door of the ancient king's tomb crashed to the floor, the stench of putrid rotting flesh overwhelms you nostrils!"
msgstr "U[_R_] Então, enquanto a forte porta de pedra da tumba do antigo rei caía no chão, o cheiro de carne podre apodrecida sobrecarrega sua ninha!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16070 #-#-# translate crowdin label_gal_halloween_event_start_33241e1b:
msgid "[_R_] As you try to peer into the darkness, you suddenly hear a high pitched"
msgstr "[__R_] À medida que você tenta se espremem na escuridão, você de repente ouve um alto arremessado"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16073 #-#-# translate crowdin label_gal_halloween_event_start_8d1d31a2:
msgid "[_R_] SCRRREEEAAAACH!..."
msgstr "U[_R_] ESCRRREEEAAAACH!..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16074 #-#-# translate crowdin label_gal_halloween_event_start_b317e21c:
msgid "[_MG_] Oh, God! What could it be? I'm literally on the edge of my seat!"
msgstr "[_MG_] Oh, Deus! O que poderia ser? Eu estou literalmente na borda do meu assento!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16077 #-#-# translate crowdin label_gal_halloween_event_start_8b8de774:
msgid "[_R_] From the darkness within, you can barely see the terrifying silhouette of a creature emerging into the pale torch light."
msgstr "[_R_] Da escuridão dentro, você mal consegue ver a terrível silhueta de uma criatura emergindo na luz da tocha pálida."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16078 #-#-# translate crowdin label_gal_halloween_event_start_e13c10eb:
msgid "[_MB_] {i}(Muttering to himself){/i}Oh my God... I can't believe this is how we're spending our Sunday night."
msgstr "[_MB_] {i}(Muttering to self){/i}Oh meu Deus... Não acredito que seja assim que passamos o domingo à noite."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16079 #-#-# translate crowdin label_gal_halloween_event_start_8dc27091:
msgid "[_R_] To your horror, you finally are able to identify this horrifying monster!"
