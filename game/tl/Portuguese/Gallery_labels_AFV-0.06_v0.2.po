# game/Gallery_labels_AFV-0.06_v0.2.rpy:23099 #-#-# translate crowdin label_gal_Xmas_event_0b621abc:
msgid "[_RT_] {i}And now I'm just thinking at her!{/i}"
msgstr "[_RT_] {i}E agora estou só pensando nela! {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23100 #-#-# translate crowdin label_gal_Xmas_event_91fb80ea:
msgid "[_RT_] {i}And I assume that I'm the only one who can see or hear you?{/i}"
msgstr "[_RT_] {i}e presumo que sou o único que pode ver ou ouvi-lo?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23101 #-#-# translate crowdin label_gal_Xmas_event_c56ccb17:
msgid "[_GP_] You have assumed correctly."
msgstr "[_GP_] Você assumiu corretamente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23102 #-#-# translate crowdin label_gal_Xmas_event_b170a7b7:
msgid "[_RT_] {i}So where the fuck are we?{/i}"
