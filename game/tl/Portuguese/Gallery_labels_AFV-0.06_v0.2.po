# game/Gallery_labels_AFV-0.06_v0.2.rpy:4191 #-#-# translate crowdin label_gal_mom_sushi_date_0610d205:
msgid "[_M_] It would be one things if you looked older than your actual age."
msgstr "[_M_] Seria uma coisa se você parecesse mais velho do que a sua idade real."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4192 #-#-# translate crowdin label_gal_mom_sushi_date_26c2871d:
msgid "[_M_] And I know you don't like to hear this, but if anything, you look younger."
msgstr "[__M_] E eu sei que você não gosta de ouvir isso, mas se algo, você parecer mais jovem."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4195 #-#-# translate crowdin label_gal_mom_sushi_date_6c877cb6:
msgid "[_M_] What if they try to investigate it?"
