# game/Gallery_labels_AFV-0.06_v0.2.rpy:23128 #-#-# translate crowdin label_gal_Xmas_event_602fffc1:
msgid "[_RT_] {i}We did go through time.... that's my mom!.... Only.... much younger.{/i}"
