msgid "[_X_] {i}(Chanting){/i} Lauren... Lauren... Lauren!!"
msgstr "[_X_] {i}(Chanting){/i} Laura... Laura... Laura!! Lauren!!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:12050 #-#-# translate crowdin label_election_win_e7e30581:
