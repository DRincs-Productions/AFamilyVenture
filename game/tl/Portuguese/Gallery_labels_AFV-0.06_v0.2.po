# game/Gallery_labels_AFV-0.06_v0.2.rpy:24752 #-#-# translate crowdin label_gal_Xmas_event_922365cf:
msgid "[_R_] Nah.... making you look like my hot crush Sidney, kind of takes away the whole fear factor."
msgstr "[_R_] Nah.... fazendo você parecer meu Sidney quente, está meio que tira todo o fator de medo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24753 #-#-# translate crowdin label_gal_Xmas_event_51167278:
msgid "[_GF_] See! That's what I've been saying! Let me wear a holocaust robe, and give me a skull for a head, you know, like they did in the old days."
msgstr "[_GF_] Veja! É o que eu tenho dito! Deixe-me usar uma vara de holocausto e dar-me um crânio para uma cabeça, você sabe, como aconteceu nos velhos tempos."

