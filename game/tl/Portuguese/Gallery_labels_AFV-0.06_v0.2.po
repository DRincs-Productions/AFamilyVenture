# game/Gallery_labels_AFV-0.06_v0.2.rpy:29977 #-#-# translate crowdin label_gal_ntr_blackmail_e1cc6eed:
msgid "[_MB_] Yeah, I have no desire to stir up any trouble, but there is just a small thing I want from you."
