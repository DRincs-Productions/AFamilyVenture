# game/Gallery_labels_AFV-0.06_v0.2.rpy:7342 #-#-# translate crowdin label_gal_beach_date_745c9267:
msgid "[_J_] Oh, no... I want to burry that traitorous son of a bitch personally."
msgstr "[_J_] Oh, non... Je veux enterrer ce fils traître d'une chienne personnellement."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7343 #-#-# translate crowdin label_gal_beach_date_b35441f5:
