# game/Gallery_labels_AFV-0.06_v0.2.rpy:33474 #-#-# translate crowdin label_gal_mom_sushi_date_joey_7858d291:
msgid "[_A_] No, Uncle.... it's Perry Hotter... Harry Potter just sounds like a stupid name for a main character."
