# game/Gallery_labels_AFV-0.06_v0.2.rpy:21060 #-#-# translate crowdin label_gal_aunt_05_272e3e7a:
msgid "[_C_] You're a creep, [ryan]! Even when you were a little kid, I had you pegged as a loser."
