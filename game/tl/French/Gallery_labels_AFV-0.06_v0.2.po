# game/Gallery_labels_AFV-0.06_v0.2.rpy:33488 #-#-# translate crowdin label_gal_mom_sushi_date_joey_8e3a2bbb:
msgid "[_RT_] {i}Pretty small as far as breasts go, but a perfect size for her petite frame.{/i}"
