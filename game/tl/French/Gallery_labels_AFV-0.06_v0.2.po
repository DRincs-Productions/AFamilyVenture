# game/Gallery_labels_AFV-0.06_v0.2.rpy:33568 #-#-# translate crowdin label_gal_mom_sushi_date_joey_79bbc32b:
msgid "[_RT_] {i}Does she want to mess around? And do I dare do anything with Joey's niece?{/i}"
