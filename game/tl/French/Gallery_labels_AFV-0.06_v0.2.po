# game/Gallery_labels_AFV-0.06_v0.2.rpy:34324 #-#-# translate crowdin label_gal_girl_time_club_3f9a327e:
msgid "[_M_] Oh, Honey! I'm so sorry! You seemed like you had it all together. Good grades, lots of friends, and your whole life already planned."
