# game/Gallery_labels_AFV-0.06_v0.2.rpy:21031 #-#-# translate crowdin label_gal_aunt_05_0a4ea6ad:
msgid "[_R_] You're drunk... Look at your chips! You're all in! If you lose this, you'll owe Mr. DeCapo a ton of money. Just like my Mom."
msgstr "[ _R_ ] Vous êtes soûl ... Regarde tes jetons ! Vous êtes tous là ! Si vous perdez ça, vous devez une tonne d'argent à M. DeCapo. Tout comme ma mère."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21032 #-#-# translate crowdin label_gal_aunt_05_d24b15e9:
msgid "[_C_] Oh... I... Shit! The dealer had a jack... I didn't even look at her card."
msgstr "[_C_] Oh... Je... Merde! Le dealer avait un jack... Je n'ai même pas regardé sa carte."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21035 #-#-# translate crowdin label_gal_aunt_05_899ef953:
msgid "[_BJ_dealer_] A ten for the lucky lady."
msgstr "[ _BJ_dealer_ ] Une dizaine pour la dame chanceuse."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21036 #-#-# translate crowdin label_gal_aunt_05_5318e77d:
msgid "[_C_] Hah! Twenty one!"
msgstr "[_C_] Hah! Vingt !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21039 #-#-# translate crowdin label_gal_aunt_05_182d8c88:
msgid "[_BJ_dealer_] Another ten. Player has twenty one on both bets."
msgstr "[ _BJ_dealer_ ] Une autre dizaine. Le joueur a vingt un sur les deux paris."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21040 #-#-# translate crowdin label_gal_aunt_05_5d8c8893:
