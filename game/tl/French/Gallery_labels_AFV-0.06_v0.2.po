# game/Gallery_labels_AFV-0.06_v0.2.rpy:33873 #-#-# translate crowdin label_gal_mom_sushi_date_joey_eff30755:
msgid "[_R_] Mom?... you doing ok?"
msgstr "[_R_] Maman ?... tu vas bien ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33874 #-#-# translate crowdin label_gal_mom_sushi_date_joey_db33e34a:
msgid "[_M_] Yeah, I'm doing great."
msgstr "[_M_] Oui, je m'en sors très bien."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33875 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b96064ef:
msgid "[_RT_] {i}There's a puddle of water next to her. There's no water cups on the table, so... not a spill.{/i}"
msgstr "[_RT_] {i}Il y a une flaque d'eau à côté d'elle. Il n'y a pas de gobelets d'eau sur la table, donc... ce n'est pas un déversement.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33878 #-#-# translate crowdin label_gal_mom_sushi_date_joey_cc508ab7:
msgid "[_M_] Joey's paying for our dinner, so I guess we can go any time you're ready."
msgstr "[_M_] Joey paie notre dîner, donc on peut y aller quand tu veux."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33881 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d00dd51d:
msgid "[_R_] That sounds good, but I've got to ask. Why is there a puddle right under you?"
msgstr "[_R_] Ça a l'air bien, mais j'ai une question à poser. Pourquoi y a-t-il une flaque d'eau juste en dessous de vous ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33882 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b319d0df:
msgid "[_MT_] Oh, fuck!... I should have wiped that up before he came in here."
msgstr "[_MT_] Oh, putain !... J'aurais dû l'essuyer avant qu'il ne vienne ici."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33885 #-#-# translate crowdin label_gal_mom_sushi_date_joey_3b0962d2:
msgid "[_M_] Is there?... Huh..."
msgstr "[_M_] Est-ce qu'il y en a ? Huh..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33886 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d54888fd:
msgid "[_MT_] {i}Think, [mom_name]!{/i}"
msgstr "[_MT_] {i}Réfléchissez, [mom_name]!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33887 #-#-# translate crowdin label_gal_mom_sushi_date_joey_fe22034a:
msgid "[_M_] Maybe one of us spilled our water."
msgstr "[_M_] L'un d'entre nous a peut-être renversé son eau."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33888 #-#-# translate crowdin label_gal_mom_sushi_date_joey_8c3cd221:
msgid "[_R_] We didn't get any water... only wine."
msgstr "[_R_] Nous n'avons pas eu d'eau... seulement du vin."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33889 #-#-# translate crowdin label_gal_mom_sushi_date_joey_067533fb:
msgid "[_R_] And that's definitely not wine."
msgstr "[_R_] Et ce n'est certainement pas du vin."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33890 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d41afebb:
msgid "[_R_] Mom... Is that?..."
msgstr "[_R_] Maman... C'est ça ?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33893 #-#-# translate crowdin label_gal_mom_sushi_date_joey_7e08a163:
msgid "[_M_] Is it what?"
msgstr "[_M_] Qu'est-ce que c'est ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33894 #-#-# translate crowdin label_gal_mom_sushi_date_joey_c6841c25:
msgid "[_R_] ..."
msgstr "[_R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33895 #-#-# translate crowdin label_gal_mom_sushi_date_joey_6114f84e:
msgid "[_M_] What were you going to say?"
msgstr "[_M_] Qu'alliez-vous dire ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33896 #-#-# translate crowdin label_gal_mom_sushi_date_joey_2e764014:
msgid "[_R_] Let's just say, I've seen you leave puddles in other places before, too."
msgstr "[_R_] Disons que je t'ai déjà vu laisser des flaques à d'autres endroits."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33897 #-#-# translate crowdin label_gal_mom_sushi_date_joey_73a80eec:
msgid "[_M_] I don't like what you're insinuating!"
msgstr "[_M_] Je n'aime pas ce que vous insinuez !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33898 #-#-# translate crowdin label_gal_mom_sushi_date_joey_eb8b7b1b:
msgid "[_M_] You'd better watch it!"
msgstr "[_M_] Vous feriez mieux de le regarder !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33901 #-#-# translate crowdin label_gal_mom_sushi_date_joey_13594df2:
msgid "[_M_] I think we'd better go before you say something stupid."
msgstr "[_M_] Je pense que nous devrions partir avant que tu ne dises quelque chose de stupide."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33906 #-#-# translate crowdin label_gal_mom_sushi_date_joey_641cc204:
msgid "[_R_] Yeah. I've lost my appetite, so we can go."
msgstr "[_R_] Oui. J'ai perdu l'appétit, alors on peut y aller."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33909 #-#-# translate crowdin label_gal_mom_sushi_date_joey_74259267:
msgid "[_MT_] {i}Is he upset?... Does he suspect something?{/i}"
msgstr "[_MT_] {i}Est-il contrarié ?... Suspecte-t-il quelque chose ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33910 #-#-# translate crowdin label_gal_mom_sushi_date_joey_ebe26aff:
msgid "[_MT_] {i}Shit! Were we more obvious than I thought?{/i}"
msgstr "[_MT_] {i}Merde ! Sommes-nous plus évidents que je ne le pensais ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33916 #-#-# translate crowdin label_gal_mom_sushi_date_joey_51fb20d8:
msgid "[_M_] I've really enjoyed our date!"
msgstr "[_M_] J'ai vraiment apprécié notre rendez-vous !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33917 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b1a54848:
msgid "[_M_] Thank you so much for taking me out. I really needed this!"
msgstr "[_M_] Merci beaucoup de m'avoir fait sortir. J'en avais vraiment besoin !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33918 #-#-# translate crowdin label_gal_mom_sushi_date_joey_7147a093:
msgid "[_R_] You're welcome."
msgstr "[_R_] Il n'y a pas de quoi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33921 #-#-# translate crowdin label_gal_mom_sushi_date_joey_e6ab092d:
msgid "[_RT_] {i}Ok, [ryan]... Mom seems pretty happy.{/i}"
msgstr "[_RT_] {i}Ok, [ryan]... Maman semble assez heureuse."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33922 #-#-# translate crowdin label_gal_mom_sushi_date_joey_aa7d2a69:
msgid "[_RT_] {i}She doesn't need you ruining her day by calling her out for a moment of weakness.{/i}"
msgstr "[_RT_] {i}Elle n'a pas besoin que vous gâchiez sa journée en l'appelant pour un moment de faiblesse."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33923 #-#-# translate crowdin label_gal_mom_sushi_date_joey_16e5c810:
msgid "[_RT_] {i}I mean, she's your mom for fuck's sake! Of course in her head, getting relief from someone outside the family is more moral than getting it from me.{/i}"
msgstr "[_RT_] {i}Je veux dire, c'est ta mère pour l'amour du ciel ! Bien sûr, dans sa tête, obtenir un soulagement de quelqu'un en dehors de la famille est plus moral que de l'obtenir de moi.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33924 #-#-# translate crowdin label_gal_mom_sushi_date_joey_4a6483dc:
msgid "[_RT_] {i}I'm the one who's been pushing her to be more open sexually, and I need to accept the fact that I can't predict or control all the unintended consequences.{/i}"
msgstr "[_RT_] {i}C'est moi qui l'ai poussée à être plus ouverte sexuellement, et je dois accepter le fait que je ne peux pas prédire ou contrôler toutes les conséquences involontaires.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33925 #-#-# translate crowdin label_gal_mom_sushi_date_joey_379e0756:
msgid "[_RT_] {i}The night is still young.{/i}"
msgstr "[_RT_] {i}La nuit est encore jeune."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33926 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0a169539:
msgid "[_RT_] {i}I might be able to salvage what's left of it.{/i}"
msgstr "[_RT_] {i}Je pourrais peut-être récupérer ce qu'il en reste."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33927 #-#-# translate crowdin label_gal_mom_sushi_date_joey_afa8f235:
msgid "[_RT_] {i}Time to stop acting butt hurt, and treat Mom like the goddess she is.{/i}"
msgstr "[_RT_] {i}Il est temps d'arrêter de se faire mal au cul et de traiter maman comme la déesse qu'elle est."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33928 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a52cbe36:
msgid "[_R_] So, you ready for some more fun?"
msgstr "[_R_] Alors, prêt à t'amuser un peu plus ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33931 #-#-# translate crowdin label_gal_mom_sushi_date_joey_c5a107e6:
msgid "[_M_] Really?... I kind of thought our date was over."
msgstr "[_M_] Vraiment ?... Je pensais que notre rendez-vous était terminé."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33932 #-#-# translate crowdin label_gal_mom_sushi_date_joey_bede9e5d:
msgid "[_R_] I had one more little adventure in mind."
msgstr "[_R_] J'avais encore une petite aventure en tête."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33933 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0eea338b:
msgid "[_R_] That is, if you're still up for some fun."
msgstr "[_R_] Enfin, si vous avez encore envie de vous amuser."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33934 #-#-# translate crowdin label_gal_mom_sushi_date_joey_21d94d7f:
msgid "[_M_] Hmmm... More fun than we've already had?"
msgstr "[_M_] Hmmm... Plus de plaisir que nous n'en avons déjà eu ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33937 #-#-# translate crowdin label_gal_mom_sushi_date_joey_2a065f78:
msgid "[_M_] Yes, please!"
msgstr "[_M_] Oui, s'il vous plaît !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33938 #-#-# translate crowdin label_gal_mom_sushi_date_joey_22715e52:
msgid "[_R_] Awesome! Now, when you get to our road, don't turn down it... Just keep going straight towards the ocean."
msgstr "[_R_] Génial ! Maintenant, quand vous arrivez à notre route, ne la prenez pas... Continue tout droit vers l'océan."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33947 #-#-# translate crowdin label_gal_pizza_date_matt_b4d1bf22:
msgid "[_R_] See?... What did I tell you?"
msgstr "[_R_] Tu vois ?... Qu'est-ce que je t'ai dit ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33948 #-#-# translate crowdin label_gal_pizza_date_matt_69eb8bf9:
msgid "[_MT_] {i}That woman looks like me ten years ago.{/i}"
msgstr "[_MT_] {i}Cette femme me ressemble depuis dix ans."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33949 #-#-# translate crowdin label_gal_pizza_date_matt_015b8f8c:
msgid "[_MT_] {i}I need to warn her!{/i}"
msgstr "[_MT_] {i}Je dois l'avertir !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33950 #-#-# translate crowdin label_gal_pizza_date_matt_692b3472:
msgid "[_MT_] {i}Keep that son of yours away from incest games!{/i}"
msgstr "[_MT_] {i}Tenez votre fils à l'écart des jeux d'inceste!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33951 #-#-# translate crowdin label_gal_pizza_date_matt_9eaf5062:
msgid "[_R_] Mom?"
msgstr "[_R_] Maman?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33954 #-#-# translate crowdin label_gal_pizza_date_matt_836ca93d:
msgid "[_M_] Didn't this used to be Paul's Pizza?"
msgstr "[_M_] N'était-ce pas le Paul's Pizza ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33955 #-#-# translate crowdin label_gal_pizza_date_matt_fa3b5526:
msgid "[_R_] Maybe, it just re-opened last year. Now it's called \"The La Trattoria\"."
msgstr "[_R_] Peut-être, car il a rouvert ses portes l'année dernière. Elle s'appelle désormais «La Trattoria«."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33956 #-#-# translate crowdin label_gal_pizza_date_matt_a5b744f5:
msgid "[_M_] You mean La Trattoria."
msgstr "[_M_] Vous voulez dire La Trattoria."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33957 #-#-# translate crowdin label_gal_pizza_date_matt_29aad80e:
msgid "[_R_] No, I'm pretty sure it's The La Trattoria"
msgstr "[_R_] Non, je suis presque sûr qu'il s'agit de La Trattoria."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33958 #-#-# translate crowdin label_gal_pizza_date_matt_92d77159:
msgid "[_M_] But that means it's called The The Tratt... Never mind."
msgstr "[_M_] Mais cela signifie qu'il s'appelle The The Tratt... Peu importe."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33959 #-#-# translate crowdin label_gal_pizza_date_matt_63c62402:
msgid "[_R_] Should we find a seat?"
msgstr "[_R_] Devons-nous trouver un siège ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33962 #-#-# translate crowdin label_gal_pizza_date_matt_31331a46:
msgid "[_M_] Okay, lets go sit in a booth in that dark corner over there."
msgstr "[_M_] D'accord, allons nous asseoir dans une cabine dans le coin sombre là-bas."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33963 #-#-# translate crowdin label_gal_pizza_date_matt_27a190cb:
msgid "[_R_] Okay, but the waitress might not see us over..."
msgstr "[_R_] D'accord, mais la serveuse risque de ne pas nous voir passer..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33964 #-#-# translate crowdin label_gal_pizza_date_matt_0911d791:
msgid "[_R_] Oh... Never mind."
msgstr "[_R_] Oh... Peu importe."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33967 #-#-# translate crowdin label_gal_pizza_date_matt_2dbb0075:
msgid "[_R_] It's not too pricey and the food is excellent!"
msgstr "[_R_] Ce n'est pas trop cher et la nourriture est excellente !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33968 #-#-# translate crowdin label_gal_pizza_date_matt_da238438:
msgid "[_M_] I can't wait."
msgstr "[_M_] J'ai hâte d'y être."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33971 #-#-# translate crowdin label_gal_pizza_date_matt_bccf8abe:
msgid "[_W_] I'm sorry, I didn't see you over here in the corner."
msgstr "[_W_] Je suis désolé, je ne vous avais pas vu dans le coin."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33972 #-#-# translate crowdin label_gal_pizza_date_matt_e07c27a3:
msgid "[_W_] My goodness, Miss [mom_name], Don't you look stunning in that dress?"
msgstr "[_W_] Mon Dieu, Mademoiselle [mom_name], n'êtes-vous pas magnifique dans cette robe ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33973 #-#-# translate crowdin label_gal_pizza_date_matt_2fb3bd3e:
msgid "[_M_] Hi Chelsea, I may be a little overdressed for..."
msgstr "[_M_] Bonjour Chelsea, je suis peut-être un peu trop habillé pour..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33974 #-#-# translate crowdin label_gal_pizza_date_matt_79976b81:
msgid "[_W_] Oh, don't be silly! You're just the classiest woman in the restaurant, and that's a good thing!"
msgstr "[_W_] Oh, ne sois pas bête ! Vous êtes juste la femme la plus classe du restaurant, et c'est une bonne chose !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33975 #-#-# translate crowdin label_gal_pizza_date_matt_6353fa32:
msgid "[_M_] How long have you been waitressing here?"
msgstr "[_M_] Depuis combien de temps êtes-vous serveuse ici ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33976 #-#-# translate crowdin label_gal_pizza_date_matt_7eff42cf:
msgid "[_W_] Oh, since they opened last year."
msgstr "[_W_] Oh, depuis qu'ils ont ouvert l'année dernière."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33977 #-#-# translate crowdin label_gal_pizza_date_matt_0dd31f99:
msgid "[_W_] So, can I get you something to drin..."
msgstr "[_W_] Alors, puis-je vous offrir quelque chose à boire..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33978 #-#-# translate crowdin label_gal_pizza_date_matt_0d366554:
msgid "[_M_] Wine!... please."
msgstr "[_M_] Du vin !... s'il vous plaît."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33979 #-#-# translate crowdin label_gal_pizza_date_matt_9db65144:
msgid "[_W_] And for you?"
msgstr "[_W_] Et pour vous ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33980 #-#-# translate crowdin label_gal_pizza_date_matt_2e0372ac:
msgid "[_R_] Hey, Chelsea... It's me, [ryan]."
msgstr "[_R_] Hé, Chelsea... C'est moi, [ryan]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33981 #-#-# translate crowdin label_gal_pizza_date_matt_62b89af6:
msgid "[_W_] Oh, hey [ryan]. I didn't recognize you."
msgstr "[_W_] Oh, hey [ryan]. Je ne vous avais pas reconnu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33982 #-#-# translate crowdin label_gal_pizza_date_matt_5f5cbe7f:
msgid "[_W_] Or, maybe I just didn't expect to see you on a date with Miss [mom_name]."
msgstr "[_W_] Ou peut-être que je ne m'attendais pas à ce que tu aies un rendez-vous avec Mlle [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33983 #-#-# translate crowdin label_gal_pizza_date_matt_a424d926:
msgid "[_R_] Well, she's my mom, so..."
msgstr "[_R_] C'est ma mère, alors..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33984 #-#-# translate crowdin label_gal_pizza_date_matt_5e670f16:
msgid "[_W_] Oh, I didn't know that!"
msgstr "[_W_] Oh, je ne le savais pas !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33985 #-#-# translate crowdin label_gal_pizza_date_matt_04db2179:
msgid "[_W_] So, Did you want a drink?"
msgstr "[_W_] Alors, vous voulez un verre ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33986 #-#-# translate crowdin label_gal_pizza_date_matt_e0dd42c4:
msgid "[_RT_] {i}Damn... I won't be able to get away with using my fake ID with Chelsea as the waitress.{/i}"
msgstr "[_RT_] {i}Bon sang... Je ne pourrai pas m'en sortir en utilisant ma fausse carte d'identité avec Chelsea comme serveuse."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33987 #-#-# translate crowdin label_gal_pizza_date_matt_6a80328d:
msgid "[_R_] I'll just have a Cola."
msgstr "[_R_] Je prendrai juste un Cola."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33988 #-#-# translate crowdin label_gal_pizza_date_matt_c011d372:
msgid "[_W_] I'll be right back with that."
msgstr "[_W_] Je reviens tout de suite."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33989 #-#-# translate crowdin label_gal_pizza_date_matt_0ec33e5c:
msgid "[_W_] And I'll try not to forget you two are over here in this dark corner."
msgstr "[_W_] Et j'essaierai de ne pas oublier que vous êtes tous les deux dans ce coin sombre."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33990 #-#-# translate crowdin label_gal_pizza_date_matt_1705f4da:
msgid "[_M_] Oh, Don't worry too much about us. We can wave at you if we really need something."
msgstr "[_M_] Oh, ne vous inquiétez pas trop pour nous. Nous pouvons vous faire signe si nous avons vraiment besoin de quelque chose."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33991 #-#-# translate crowdin label_gal_pizza_date_matt_d99e8966:
msgid "[_W_] Oh, thank you, Miss [mom_name]! That's really helpful. I'm the only one hosting and waitressing tonight."
msgstr "[_W_] Oh, merci, Mlle [mom_name]! C'est très utile. Je suis la seule à accueillir et à servir ce soir."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33994 #-#-# translate crowdin label_gal_pizza_date_matt_704b659d:
msgid "{i}\"A short time later.\"{/i}"
msgstr "{i}«Peu de temps après.« {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33997 #-#-# translate crowdin label_gal_pizza_date_matt_1d7459ed:
msgid "[_MT_] {i}To just look at him, you'd think he's just an average high school senior, but this last little while, he's grown so much.{/i}"
msgstr "[_MT_] {i}En le regardant, on pourrait penser qu'il n'est qu'un lycéen moyen, mais il a tellement grandi ces derniers temps."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33998 #-#-# translate crowdin label_gal_pizza_date_matt_f776c5b5:
msgid "[_MT_] {i}Maybe not in stature, but he's become a man in so many ways.{/i}"
