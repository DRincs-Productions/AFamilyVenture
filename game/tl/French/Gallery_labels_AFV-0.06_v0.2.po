msgstr "[_MP_] ...."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13693 #-#-# translate crowdin label_gal_Sidney_park_activities_e7fd8a85:
msgid "[_R_] Are you ok, Mr Peterson?"
msgstr "[_R_] Ça va, M. Peterson ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13694 #-#-# translate crowdin label_gal_Sidney_park_activities_4b9d57af:
