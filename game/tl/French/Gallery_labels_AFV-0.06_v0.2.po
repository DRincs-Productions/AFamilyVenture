msgid "[_J_] It's alright, My mother was a very attractive woman too. I understand these feelings."
msgstr "[_J_] C'est bon, ma mère était aussi une femme très attireuse. Je comprends ces sentiments."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7414 #-#-# translate crowdin label_gal_beach_date_a81b30e0:
msgid "[_RT_] {i}Fucking Agent Diaz!{/i}"
msgstr "[_RT_] {i}Fucking Agent Diaz !{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7415 #-#-# translate crowdin label_gal_beach_date_ab7495da:
