# game/Gallery_labels_AFV-0.06_v0.2.rpy:7344 #-#-# translate crowdin label_gal_beach_date_0ee9daa0:
msgid "[_AD_] No... Sergeant Philips said he'd keep the beach clear tonight, and take off as soon as I radio him, which I've done."
msgstr "[_AD_] Non... Le sergent Philips a dit qu'il gardait la plage claire ce soir, et qu'il décolle dès que je le radiais, ce que j'ai fait."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7345 #-#-# translate crowdin label_gal_beach_date_d588d203:
msgid "[_J_] Perfect, Diaz! You're a real asset to the family."
msgstr "[_J_] Parfait, Diaz! Vous êtes un véritable atout pour la famille."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7346 #-#-# translate crowdin label_gal_beach_date_255d4000:
