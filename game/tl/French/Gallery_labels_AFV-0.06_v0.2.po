msgstr "[_RT_] {i}Uuuhhhh.... c'est de l'oncle Bobby.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17872 #-#-# translate crowdin label_gal_aunt_01_e493fa16:
msgid "[_RT_] {i}Why is he texting me so early in the morning?{/i}"
