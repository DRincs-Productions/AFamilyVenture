# game/Gallery_labels_AFV-0.06_v0.2.rpy:715 #-#-# translate crowdin label_gal_mom_weekend_pool_01_e8419ec9:
msgid "[_RT_] {i}YES!!.... She just acknowledged that I'm the man of the house!{/i}"
