msgstr "[_M_] Que faites-vous ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:27372 #-#-# translate crowdin label_girl_time_garden_fc1c4de9:
msgid "[_R_] I told you, I'm going to make sure you're completely covered. Head to toe."
msgstr "[_R_] Je te l'ai dit, je vais m'assurer que tu es complètement couvert. De la tête aux pieds."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:27373 #-#-# translate crowdin label_girl_time_garden_135ebfcd:
