# game/Gallery_labels_AFV-0.06_v0.2.rpy:7376 #-#-# translate crowdin label_gal_beach_date_aea8e1d6_1:
msgid "[_M_] {i}(Whispering){/i} [ryan], What's going on out there?"
msgstr "[_M_] {i}(Whispering){/i} [ryan], Que se passe-t-il là-bas ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7379 #-#-# translate crowdin label_gal_beach_date_b0ce5225:
msgid "[_R_] It's Agent Diaz, Joey Decapo and his goon! They're just standing out there."
msgstr "[_R_] C'est l'agent Diaz, Joey Decapo et son goon ! Ils sont juste là dehors."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7380 #-#-# translate crowdin label_gal_beach_date_63034c7f_1:
msgid "[_M_] Shit!... We don't want them to find us together and naked in here."
msgstr "[_M_] Shit!... Nous ne voulons pas qu'ils nous retrouvent ensemble et nus."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7381 #-#-# translate crowdin label_gal_beach_date_a0ff54c7_1:
msgid "[_M_] Hurry, shut the door. Maybe they'll go away!"
msgstr "[_M_] Vite, fermez la porte. Peut-être vont-ils partir!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7384 #-#-# translate crowdin label_gal_beach_date_3dcc2f8a:
msgid "[_R_] {i}(Muffled){/i} They already know somebody's in here. I don't think I have a choice but to go talk to them."
msgstr "[_R_] {i}(Muffled){/i} Ils connaissent déjà quelqu'un ici. Je ne pense pas que j'ai le choix, mais d'aller leur parler."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7387 #-#-# translate crowdin label_gal_beach_date_ba72b2c9:
msgid "[_J_] If you don't come out with your hands up by the time I count to three, we're going to start shooting!"
