msgstr "{i}«Une explication ultérieure.« {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7405 #-#-# translate crowdin label_gal_beach_date_d118bc9f:
msgid "[_J_] But why were you skinny dipping? Why weren't you just swimming in your underwear? She's your mom for fuck's sake."
msgstr "[_J_] Mais pourquoi étiez-vous une trempette habillée ? Pourquoi n'étiez-vous pas juste à nager dans vos sous-vêtements ? Elle est votre mère pour le plaisir de baiser."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7406 #-#-# translate crowdin label_gal_beach_date_e936c079:
msgid "[_R_] You saw the dress she was wearing earlier. You can't wear a bra with that dress."
msgstr "[_R_] Vous avez vu la robe qu'elle portait plus tôt. Tu ne peux pas porter de soutien-gorge avec cette robe."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7407 #-#-# translate crowdin label_gal_beach_date_3cbf588d:
msgid "[_R_] I didn't want her to feel uncomfortable being the only one naked."
msgstr "[_R_] Je ne voulais pas qu'elle se sente mal à l'aise étant la seule nue."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7408 #-#-# translate crowdin label_gal_beach_date_2c51a04d:
msgid "[_AD_] Mr. DeCapo, From my observations of the family, It appears that [ryan] might have some unnatural feelings for his mom."
msgstr "[_AD_] M. DeCapo, D'après mes observations de la famille, il semble que [ryan] ait des sentiments non naturels pour sa mère."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7411 #-#-# translate crowdin label_gal_beach_date_1302750e:
