msgstr "[ _C_ ] Pas une chance !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21050 #-#-# translate crowdin label_gal_aunt_05_0493fb33:
msgid "[_C_] I'm taking Mandy, and we're moving out as soon as possible to start our new life."
msgstr "[ _C_ ] Je prends Mandy, et nous déménageons le plus tôt possible pour commencer notre nouvelle vie."

