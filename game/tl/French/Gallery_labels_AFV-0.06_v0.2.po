# game/Gallery_labels_AFV-0.06_v0.2.rpy:3608 #-#-# translate crowdin label_gal_mom_blackmailed_061634b4:
msgid "[_M_] It just involves a few handjobs from time to time. And it will never go any farther than that."
msgstr "[_M_] Cela implique juste quelques branlettes de temps en temps. Et cela n'ira jamais plus loin que cela."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3611 #-#-# translate crowdin label_gal_mom_blackmailed_ae0ea9d6:
