# game/Gallery_labels_AFV-0.06_v0.2.rpy:21125 #-#-# translate crowdin label_gal_aunt_05_044493a3:
msgid "[_RT_] {i}I've got to make her understand the situation she's in before she gets herself killed.{/i}"
