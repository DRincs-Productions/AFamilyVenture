# game/Gallery_labels_AFV-0.06_v0.2.rpy:13697 #-#-# translate crowdin label_gal_Sidney_park_activities_01ff5265:
msgid "[_P_] Nice tackle, kid!"
msgstr "[_P_] Joli tacle, gamin!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13698 #-#-# translate crowdin label_gal_Sidney_park_activities_696681ec:
msgid "[_P_] And by the looks of things, I don't think you broke any of his bones."
msgstr "[_P_] Et par l'apparence des choses, je ne pense pas que vous ayez cassé un de ses os."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13699 #-#-# translate crowdin label_gal_Sidney_park_activities_47be81c9:
msgid "[_P_] That tough son of a bitch."
msgstr "[_P_] Ce fils de pute dur."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13700 #-#-# translate crowdin label_gal_Sidney_park_activities_5207b67f:
msgid "[_P_] He's a war hero, you know!"
msgstr "[_P_] C'est un héros de guerre, vous savez !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13701 #-#-# translate crowdin label_gal_Sidney_park_activities_205b7959:
msgid "[_R_] Yeah, and a Medal of Honor recipient."
msgstr "[_R_] Oui, et un récipiendaire de la Médaille d'honneur."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13702 #-#-# translate crowdin label_gal_Sidney_park_activities_48da257e:
msgid "[_P_] His family is going to be so relieved to have him back."
msgstr "[_P_] Sa famille va être tellement soulagée de l'avoir de retour."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13703 #-#-# translate crowdin label_gal_Sidney_park_activities_fb3a81d1:
msgid "[_P_] You're a hero!"
msgstr "[_P_] Tu es un héros!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13704 #-#-# translate crowdin label_gal_Sidney_park_activities_42152a77:
msgid "[_R_] Oh.... Just doing my civic duty."
msgstr "[_R_] Oh.... Je fais juste mon devoir civique."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13705 #-#-# translate crowdin label_gal_Sidney_park_activities_f44a70af:
msgid "[_P_] Well, I'll make sure they hear about it."
msgstr "[_P_] Eh bien, je vais m'assurer qu'ils en entendent parler."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13708 #-#-# translate crowdin label_gal_Sidney_park_activities_748c6753:
msgid "[_P_] Come on Mr. Peterson. Your family is worried sick about you."
msgstr "[_P_] Allez M. Peterson. Votre famille est inquiète pour vous."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13709 #-#-# translate crowdin label_gal_Sidney_park_activities_e2725ab0:
msgid "[_MP_] Can that young prostitute come with us?"
msgstr "[_MP_] Cette jeune prostituée peut-elle venir avec nous?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13710 #-#-# translate crowdin label_gal_Sidney_park_activities_f578cc1f:
msgid "[_P_] We'll see if she's willing to visit you in the nursing home."
msgstr "[_P_] Nous verrons si elle est prête à vous rendre visite à la maison de retraite."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13711 #-#-# translate crowdin label_gal_Sidney_park_activities_d6e6272f:
msgid "[_S_] Ahhh...."
msgstr "[_S_] Ahhh...."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13715 #-#-# translate crowdin label_gal_Sidney_park_activities_f75be925:
msgid "[_MS_] Oh my God! [ryan]!.... You're my hero!"
msgstr "[_MS_] Oh mon Dieu! [ryan]!.... Tu es mon héros !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13716 #-#-# translate crowdin label_gal_Sidney_park_activities_232c6572:
msgid "[_MS_] Let me just help you up, and give you a great big hug!"
msgstr "[_MS_] Permettez-moi de vous aider et de vous faire un grand câlin!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13719 #-#-# translate crowdin label_gal_Sidney_park_activities_bb1c3ae1:
msgid "[_R_] Thanks, Mrs. Stone!"
msgstr "[_R_] Merci, Mme Stone!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13720 #-#-# translate crowdin label_gal_Sidney_park_activities_855e6e00:
msgid "[_MS_] I just can't believe how brave you were!"
msgstr "[_MS_] Je n'arrive tout simplement pas à croire à quel point vous étiez courageux!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13723 #-#-# translate crowdin label_gal_Sidney_park_activities_a87ec360:
msgid "[_MS_] Not only did you rescue me, but you also helped that poor old man."
msgstr "[_MS_] Non seulement tu m'as secouru, mais tu as aussi aidé ce pauvre vieillard."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13724 #-#-# translate crowdin label_gal_Sidney_park_activities_ada889d0:
msgid "[_MS_] The poor thing's been surviving off of the land for weeks."
msgstr "[_MS_] Le pauvre a survécu hors de la terre pendant des semaines."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13727 #-#-# translate crowdin label_gal_Sidney_park_activities_9cc9275e:
msgid "[_MS_] I sure hope they give you some kind of medal."
msgstr "[_MS_] J'espère qu'ils vous donneront une sorte de médaille."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13728 #-#-# translate crowdin label_gal_Sidney_park_activities_b9871172:
msgid "[_R_] Oh, don't be silly. I don't deserve a medal."
msgstr "[_R_] Oh, ne sois pas bête. Je ne mérite pas de médaille."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13729 #-#-# translate crowdin label_gal_Sidney_park_activities_d45a24be:
msgid "[_MS_] Oh, and you're so humble."
msgstr "[_MS_] Oh, et tu es si humble."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13733 #-#-# translate crowdin label_gal_Sidney_park_activities_0f365492:
msgid "[_S_] Sorry to interrupt, but shouldn't we be getting home?"
msgstr "[_S_] Désolé de vous interrompre, mais ne devrions-nous pas rentrer à la maison?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13734 #-#-# translate crowdin label_gal_Sidney_park_activities_152e64b9:
msgid "[_ST_] {i}This bitch better back off my [ryan].{/i}"
msgstr "[_ST_] {i}Cette chienne ferait mieux revenir sur [ryan].{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13737 #-#-# translate crowdin label_gal_Sidney_park_activities_7cf31ca8:
msgid "[_MS_] And who might this be?"
msgstr "[_M_] Mmmhhh.... qui.... Qui est là?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13738 #-#-# translate crowdin label_gal_Sidney_park_activities_d2aba1d7:
msgid "[_R_] Oh, no one.... I mean.... this is my roommate Sidney."
msgstr "[_R_] Oh, personne.... Je veux dire.... voici mon coloc Sidney."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13741 #-#-# translate crowdin label_gal_Sidney_park_activities_f9392eb2:
msgid "[_MS_] Roommate?.... But didn't I see her climbing up on your lap right before I got grabbed by Mr. Peterson?"
msgstr "[_MS_] Colocataire?.... Mais ne l'ai-je pas vue monter sur vos genoux juste avant que M. Peterson ne m'attrape ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13742 #-#-# translate crowdin label_gal_Sidney_park_activities_6ccb256f:
msgid "[_R_] Oh, she was just giving me a purely platonic, sisterly hug."
msgstr "[_R_] Oh, elle me faisait juste un câlin purement platonique et fraternel."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13745 #-#-# translate crowdin label_gal_Sidney_park_activities_8ca005c5:
msgid "[_MS_] Oh.... So that's how white folks show their roommates affection?"
msgstr "[_MS_] Oh.... C'est ainsi que les blancs montrent l'affection de leurs colocataires?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13746 #-#-# translate crowdin label_gal_Sidney_park_activities_65374d18:
msgid "[_S_] As a matter of fact, yeah, that's how it is."
msgstr "[_S_] En fait, oui, c'est comme ça."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13749 #-#-# translate crowdin label_gal_Sidney_park_activities_228dba03:
msgid "[_MS_] Well, it's none of my business anyhow."
msgstr "[_MS_] Eh bien, ce ne sont pas mes affaires de toute façon."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13750 #-#-# translate crowdin label_gal_Sidney_park_activities_f25921b9:
msgid "[_MS_] And I've got to get to school before my first class starts."
msgstr "[_MS_] Et je dois aller à l'école avant le début de ma première classe."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13753 #-#-# translate crowdin label_gal_Sidney_park_activities_10602f31:
msgid "[_MS_] Thank you so much again for saving me today!"
msgstr "[_MS_] Merci encore une fois de m'avoir sauvé aujourd'hui!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13754 #-#-# translate crowdin label_gal_Sidney_park_activities_930c5750:
msgid "[_MS_] If the city doesn't give you a reward, I'm sure I can think up a good one to give you."
msgstr "[_MS_] Si la ville ne vous donne pas de récompense, je suis sûr que je peux en imaginer une bonne à vous donner."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13755 #-#-# translate crowdin label_gal_Sidney_park_activities_2add12e8:
msgid "[_ST_] {i}She better not be implying what I think she's implying!{/i}"
msgstr "[_ST_] {i}Elle ferait mieux de ne pas sous-entendre ce que je pense qu'elle sous-entend!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13756 #-#-# translate crowdin label_gal_Sidney_park_activities_7b635169:
msgid "[_RT_] {i}Holy shit! Is she implying what I think she's implying?{/i}"
msgstr "[_RT_] {i}Merde! Est-ce qu'elle sous-entend ce que je pense qu'elle sous-entend?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13757 #-#-# translate crowdin label_gal_Sidney_park_activities_b8a93b4f:
msgid "[_S_] And I think I'm going to be sick. [ryan], let's go home."
msgstr "[_S_] Et je pense que je vais être malade. [ryan], rentrons chez nous."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13758 #-#-# translate crowdin label_gal_Sidney_park_activities_5b557bee:
msgid "[_MS_] Goodbye, my savior!"
msgstr "[_MS_] Au revoir, mon sauveur!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13763 #-#-# translate crowdin label_gal_Sidney_park_activities_8d8c66e6:
msgid "[_S_] You did it! No more crazy pervert to worry about at the park."
msgstr "[_S_] Vous l'avez fait! Plus de pervers fou à craindre au parc."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13764 #-#-# translate crowdin label_gal_Sidney_park_activities_a97d1568:
msgid "[_R_] Yeah, now you'll be able to go there any time you like."
msgstr "[_R_] Ouais, maintenant tu pourras y aller quand tu veux."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13765 #-#-# translate crowdin label_gal_Sidney_park_activities_633eae76:
msgid "[_S_] And what about Mrs. Stone?"
msgstr "[_S_] Et qu'en est-il de Mme Stone?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13766 #-#-# translate crowdin label_gal_Sidney_park_activities_54901870:
msgid "[_R_] What about her?"
msgstr "[_R_] Quoi?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13767 #-#-# translate crowdin label_gal_Sidney_park_activities_be18ee70:
msgid "[_S_] She was all over you."
msgstr "[_S_] Elle était partout sur toi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13768 #-#-# translate crowdin label_gal_Sidney_park_activities_2186d757:
msgid "[_R_] Oh, she was just super grateful that I saved her."
msgstr "[_R_] Oh, elle était juste super reconnaissante de l'avoir sauvée."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13769 #-#-# translate crowdin label_gal_Sidney_park_activities_19c5b98a:
msgid "[_S_] Seemed like more than that to me."
msgstr "[_S_] me semblait plus que cela."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13770 #-#-# translate crowdin label_gal_Sidney_park_activities_cd99e398:
msgid "[_R_] Hmmmm.... I didn't notice."
msgstr "[_R_] Cosplay?.... Je ne savais pas que Lauren était dans ça."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13771 #-#-# translate crowdin label_gal_Sidney_park_activities_d51ba584:
msgid "[_S_] Would you like it to be more?"
msgstr "[_S_] Voulez-vous que ce soit plus?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13772 #-#-# translate crowdin label_gal_Sidney_park_activities_bd39e475:
msgid "[_S_] I mean, I know you've told me you think of her when we fooled around."
msgstr "[_S_] Je veux dire, je sais que tu m'as dit que tu pensais à elle quand on s'est amusés."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13773 #-#-# translate crowdin label_gal_Sidney_park_activities_a78c639d:
msgid "[_RT_] {i}I was lying when I said that, but after those soft pillows in my face, I might actually start thinking about her.{/i}"
msgstr "[_RT_] {i}Je mentais quand j'ai dit ça, mais après ces oreillers moelleux dans mon visage, je pourrais commencer à penser à elle.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13774 #-#-# translate crowdin label_gal_Sidney_park_activities_e1d415e4:
msgid "[_S_] Well?"
msgstr "[_S_] Eh bien, qu'est-ce que tu penses que j'ai fait au collège idiot!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13775 #-#-# translate crowdin label_gal_Sidney_park_activities_60db524f:
msgid "[_R_] Well, what?"
msgstr "[_R_] Qu’est-ce que c’est?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13776 #-#-# translate crowdin label_gal_Sidney_park_activities_d51ba584_1:
msgid "[_S_] Would you like it to be more?"
msgstr "[_S_] Voulez-vous que ce soit plus?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13779 #-#-# translate crowdin label_gal_Sidney_park_activities_5a5caf43:
msgid "[_R_] I mean I guess I wouldn't complain if she wanted a go at me."
msgstr "[_R_] Je suppose que je ne me plaindrais pas si elle voulait m'attaquer."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13780 #-#-# translate crowdin label_gal_Sidney_park_activities_01e83a86:
msgid "[_RT_] {i}Could Sidney be right? Could I really have a chance with Mrs. Stone?{/i}"
msgstr "[_RT_] {i}Sidney aurait-il raison ? Pourrais-je vraiment avoir une chance avec Mme Stone?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13782 #-#-# translate crowdin label_gal_Sidney_park_activities_4b2ab474:
msgid "[_R_] I'm over her. I've got another girl in mind."
msgstr "[_R_] Je suis au-dessus d'elle. J'ai une autre fille en tête."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13783 #-#-# translate crowdin label_gal_Sidney_park_activities_b19a116f:
msgid "[_R_] One that lives a little closer to home, if you know what I mean."
msgstr "[_R_] Celui qui vit un peu plus près de chez lui, si vous voyez ce que je veux dire."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13784 #-#-# translate crowdin label_gal_Sidney_park_activities_c7a7f7d1:
msgid "[_RT_] {i}Actually several, but Sidney will think I just mean her.{/i}"
msgstr "[_RT_] {i}En fait plusieurs, mais Sidney pensera que je ne parle que d'elle.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13785 #-#-# translate crowdin label_gal_Sidney_park_activities_93e19acf:
msgid "[_RT_] {i}At least I'm pretty sure that's what she wants to hear.{/i}"
msgstr "[_RT_] {i}Au moins, je suis presque sûr que c'est ce qu'elle veut entendre.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13786 #-#-# translate crowdin label_gal_Sidney_park_activities_c00317dc:
msgid "[_S_] Well, the park will be a lot less interesting with Mr. Peterson gone."
msgstr "[_S_] Eh bien, le parc sera beaucoup moins intéressant avec la disparition de M. Peterson."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13787 #-#-# translate crowdin label_gal_Sidney_park_activities_e82de818:
msgid "[_S_] Unless we can find a way to make it more interesting."
msgstr "[_S_] À moins que nous puissions trouver un moyen de le rendre plus intéressant."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13788 #-#-# translate crowdin label_gal_Sidney_park_activities_9fa4c171:
msgid "[_S_] I'll beat you home!"
msgstr "[_S_] Je vais te battre à la maison!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13793 #-#-# translate crowdin label_gal_Sidney_park_activities_1705afeb:
msgid "[_RT_] And that's all the memory I have of that event!"
msgstr "[_RT_] Et c'est tout le souvenir que j'ai de cet événement!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13802 #-#-# translate crowdin label_gal_Sidney_club_trick_34a9d44a:
msgid "[_RT_] {i}Looks like Lauren's watching her ponies show again.{/i}"
msgstr "[_RT_] {i}On dirait que Lauren regarde à nouveau ses poneys.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13803 #-#-# translate crowdin label_gal_Sidney_club_trick_e81a1dd4:
msgid "DING DONG"
msgstr "DING DONG"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13804 #-#-# translate crowdin label_gal_Sidney_club_trick_47a6f8a0:
msgid "[_RT_] {i}That's the doorbell. I'm pretty sure I know who that is.{/i}"
msgstr "[_RT_] {i}C'est la sonnette. Je suis sûr de savoir qui c'est.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13809 #-#-# translate crowdin label_gal_Sidney_club_trick_1a5d2dea:
msgid "[_J_] Hello little boy, is [mom_name] at home?"
msgstr "[_J_] Bonjour petit garçon, [mom_name] est-il à la maison?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13812 #-#-# translate crowdin label_gal_Sidney_club_trick_63899ea1:
msgid "{i}\"A few minutes earlier.\"{/i}"
msgstr "{i}'Quelques minutes plus tôt'{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13815 #-#-# translate crowdin label_gal_Sidney_club_trick_376519e8:
msgid "[_ST_] {i}I don't have much time. I've got to make this fast.{/i}"
msgstr "[_ST_] {i}Je n'ai pas beaucoup de temps. Je dois faire vite.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13816 #-#-# translate crowdin label_gal_Sidney_club_trick_91362ee6:
msgid "[_ST_] {i}If I were [ryan], where would I hide my money?{/i}"
msgstr "[_ST_] {i}Si j'étais [ryan], où pourrais-je cacher mon argent?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13819 #-#-# translate crowdin label_gal_Sidney_club_trick_5e4b6846:
msgid "[_ST_] {i}It's not in his desk.{/i}"
msgstr "[_ST_] {i}Ce n'est pas dans son bureau.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13822 #-#-# translate crowdin label_gal_Sidney_club_trick_28604ff5:
msgid "[_ST_] {i}No shoe boxes of cash under the bed.{/i}"
msgstr "[_ST_] {i}Pas de boîtes à chaussures avec de l'argent sous le lit.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13825 #-#-# translate crowdin label_gal_Sidney_club_trick_ddc9e671:
msgid "[_ST_] {i}Bingo....{/i}"
msgstr "[_ST_] {i}Bingo.... {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13826 #-#-# translate crowdin label_gal_Sidney_club_trick_930ca79c:
msgid "[_ST_] {i}That's a lot of cash just sitting in his top drawer.{/i}"
msgstr "[_ST_] {i}C'est beaucoup d'argent dans son tiroir supérieur.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13827 #-#-# translate crowdin label_gal_Sidney_club_trick_2c5d9aff:
msgid "[_ST_] {i}As soon as Mom's off to the club, I'll put it right back.{/i}"
msgstr "[_ST_] {i}Dès que maman sera au club, je vais la remettre en ordre.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13828 #-#-# translate crowdin label_gal_Sidney_club_trick_2058127b:
msgid "[_ST_] {i}I can't believe I'm doing this.{/i}"
msgstr "[_ST_] {i}Je n'arrive pas à croire que je fais ça.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13829 #-#-# translate crowdin label_gal_Sidney_club_trick_286d5629:
msgid "[_ST_] {i}What has come over me lately?{/i}"
msgstr "[_ST_] {i}Qu'est-ce qui s'est passé sur moi dernièrement ?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13830 #-#-# translate crowdin label_gal_Sidney_club_trick_e02ae6a7:
msgid "[_ST_] {i}I think it's just the fact that Mom has always been such a prude.{/i}"
msgstr "[_ST_] {i}Je pense que c'est juste le fait que maman a toujours été une prude.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13831 #-#-# translate crowdin label_gal_Sidney_club_trick_be122b2c:
msgid "[_ST_] {i}I can't even imaging her stripping on a stage.{/i}"
msgstr "[_ST_] {i}Je ne peux même pas l'imaginer en train de se déshabiller sur une scène.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13832 #-#-# translate crowdin label_gal_Sidney_club_trick_1e94d931:
msgid "[_ST_] {i}I've got to see it to believe it.{/i}"
msgstr "[_ST_] {i}Je dois le voir pour le croire.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13833 #-#-# translate crowdin label_gal_Sidney_club_trick_eac5a0c1:
msgid "[_ST_] {i}And if [ryan] doesn't have the cash to pay the Mafia, than Mom's got to go work the pole.{/i}"
msgstr "[_ST_] {i}Et si [ryan] n'a pas l'argent pour payer la Mafia, alors maman doit aller travailler sur la barre.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13834 #-#-# translate crowdin label_gal_Sidney_club_trick_461fc264:
msgid "[_ST_] {i}Shit!.... Am I going too far?....{/i}"
msgstr "[_ST_] {i}Merde!.... Je vais trop loin ?....{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13835 #-#-# translate crowdin label_gal_Sidney_club_trick_e81a1dd4_1:
msgid "DING DONG"
msgstr "DING DONG"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13836 #-#-# translate crowdin label_gal_Sidney_club_trick_1957ed99:
msgid "[_ST_] {i}Shit! That's probably them. I've got to really hurry and get my clubbing outfit on.{/i}"
msgstr "[_ST_] {i}Merde! C'est probablement eux. Je dois vraiment me dépêcher et enfiler ma tenue de clubbing.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13842 #-#-# translate crowdin label_gal_Sidney_club_trick_1a5d2dea_1:
msgid "[_J_] Hello little boy, is [mom_name] at home?"
msgstr "[_J_] Bonjour petit garçon, [mom_name] est-il à la maison?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13843 #-#-# translate crowdin label_gal_Sidney_club_trick_907e3218:
msgid "[_RT_] {i}He knows I'm an adult by now. What an asshole.{/i}"
msgstr "[_RT_] {i}Il sait que je suis maintenant adulte. Quel connard.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13844 #-#-# translate crowdin label_gal_Sidney_club_trick_cf1fab13:
msgid "[_R_] Just a second."
msgstr "[_R_] Juste une seconde."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13845 #-#-# translate crowdin label_gal_Sidney_club_trick_970855d5:
msgid "[_R_] Hey Mom, there's some strange men at the door for you!"
msgstr "[_R_] Hé maman, il y a des hommes étranges à la porte pour toi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13848 #-#-# translate crowdin label_gal_Sidney_club_trick_2ad5f047:
msgid "[_R_] Wow, Mom! Looking good as ever!"
msgstr "[_R_] Wow, maman! Toujours aussi belle!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13849 #-#-# translate crowdin label_gal_Sidney_club_trick_6656fe70:
msgid "[_M_] Please, [ryan].... not now."
msgstr "[_M_] S'il te plait, [ryan].... pas maintenant."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13850 #-#-# translate crowdin label_gal_Sidney_club_trick_84e273a3:
msgid "[_M_] Were you able to get enough money together to pay them off this week?"
msgstr "[_M_] Avez-vous pu réunir assez d'argent pour les rembourser cette semaine?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13851 #-#-# translate crowdin label_gal_Sidney_club_trick_74239e20:
msgid "[_R_] Of course, Mom, did you really doubt me?"
msgstr "[_R_] Bien sûr, maman, tu as vraiment douté de moi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13854 #-#-# translate crowdin label_gal_Sidney_club_trick_47a155b9:
msgid "[_R_] I've just got to run to my room and get it. I'll be right back."
msgstr "[_R_] Je dois juste aller dans ma chambre et l'obtenir. Je reviens tout de suite."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13859 #-#-# translate crowdin label_gal_Sidney_club_trick_b897a39c:
msgid "[_RT_] {i}What in the hell?!{/i}"
msgstr "[_RT_] {i}Que diable?!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13860 #-#-# translate crowdin label_gal_Sidney_club_trick_cbd3f10d:
msgid "[_RT_] {i}Where is my Goddamned money?{/i}"
msgstr "[_RT_] {i}Où est mon putain d'argent?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13861 #-#-# translate crowdin label_gal_Sidney_club_trick_77e4a19c:
msgid "[_RT_] {i}Shit.... What could have happened to it?{/i}"
msgstr "[_RT_] {i}Merde.... Qu'est-ce qui a pu lui arriver ?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13862 #-#-# translate crowdin label_gal_Sidney_club_trick_7e5dbab6:
msgid "[_RT_] {i}Did I leave it at the warehouse or something?{/i}"
msgstr "[_RT_] {i}Est-ce que je l'ai laissé à l'entrepôt ou quelque chose comme ça?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13863 #-#-# translate crowdin label_gal_Sidney_club_trick_f0c31955:
msgid "[_RT_] {i}Fuck!.... The DeCapos aren't going to sit around while I look for it.{/i}"
msgstr "[_RT_] {i}Merde !... Les DéCapos ne vont pas rester assis pendant que je la cherche.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13864 #-#-# translate crowdin label_gal_Sidney_club_trick_6a591152:
msgid "[_RT_] {i}How am I going to break the news to Mom?{/i}"
msgstr "[_RT_] {i}Comment vais-je annoncer la nouvelle à maman?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13869 #-#-# translate crowdin label_gal_Sidney_club_trick_cdc9e159:
msgid "[_R_] So, it turns out that I can't find my cash?"
msgstr "[_R_] Donc, il s'avère que je ne trouve pas mon argent?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13870 #-#-# translate crowdin label_gal_Sidney_club_trick_74201a25:
msgid "[_M_] What? No that can't be. Let me come help you look for it."
msgstr "[_M_] Quoi? Non, ça ne peut pas être. Laisses-moi venir t'aider à le chercher."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13871 #-#-# translate crowdin label_gal_Sidney_club_trick_56b45535:
msgid "[_J_] I'm sorry [mom_name], but we aren't going to just hang around at your house until you find where Ron misplaced his cash."
msgstr "[_J_] Je suis désolé [mom_name], mais nous n'allons pas traîner chez vous jusqu'à ce que vous trouviez où Ron a égaré son argent."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13872 #-#-# translate crowdin label_gal_Sidney_club_trick_4189a79f:
msgid "[_R_] My name's [ryan], actually."
msgstr "[_R_] Je m'appelle [ryan], en fait."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13873 #-#-# translate crowdin label_gal_Sidney_club_trick_eeddfe87:
msgid "[_J_] So either you've got it, or you don't."
msgstr "[_J_] Donc soit tu l'as, soit tu ne l'as pas."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13876 #-#-# translate crowdin label_gal_Sidney_club_trick_5f829f6c:
msgid "[_J_] And it looks like you don't got it."
msgstr "[_J_] Et il semble que tu ne l'aies pas."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13877 #-#-# translate crowdin label_gal_Sidney_club_trick_6428a2de:
msgid "[_J_] So [mom_name], Why don't we go ahead and jump in the car."
msgstr "[_J_] Donc [mom_name], Pourquoi ne pas aller de l'avant et aller dans la voiture."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13878 #-#-# translate crowdin label_gal_Sidney_club_trick_3f6e100a:
msgid "[_R_] I'm so sorry Mom! I really have it. I just don't have a clue where it is right now."
msgstr "[_R_] Je suis tellement désolé maman! Je l'ai vraiment. Je n'ai pas la moindre idée d'où il se trouve en ce moment."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13879 #-#-# translate crowdin label_gal_Sidney_club_trick_23ce227c:
msgid "[_M_] It's okay honey. We'll find it, and at least I won't have to go next week."
msgstr "[_M_] C'est bon, chérie. On le trouvera, et au moins je n'aurai pas à y aller la semaine prochaine."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13880 #-#-# translate crowdin label_gal_Sidney_club_trick_5bc5c0af:
msgid "[_RT_] {i}Shit!.... She looks so sad!{/i}"
msgstr "[_RT_] {i}Merde!.... Elle a l'air si triste!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13881 #-#-# translate crowdin label_gal_Sidney_club_trick_5291e93d:
msgid "[_J_] Ok, Let's get on our way."
msgstr "[_J_] Ok, allons-y."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13884 #-#-# translate crowdin label_gal_Sidney_club_trick_bb64a15e:
msgid "[_RT_] {i}There she goes off to the club.{/i}"
msgstr "[_RT_] {i}Là, elle va au club.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13885 #-#-# translate crowdin label_gal_Sidney_club_trick_322c85a6:
msgid "[_RT_] {i}She seemed extra down tonight. I'd better jump on my scooter and head down to the club to make sure she's ok.{/i}"
msgstr "[_RT_] {i}Elle semblait très déprimée ce soir. Je ferais mieux de sauter sur mon scooter et de descendre au club pour m'assurer qu'elle va bien.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13891 #-#-# translate crowdin label_gal_Sidney_club_trick_8904c035:
msgid "[_ST_] {i}Hopefully Mom doesn't mind if I borrow the car.{/i}"
msgstr "[_ST_] {i}J'espère que maman ne me dérange pas si j'emprunte la voiture.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13892 #-#-# translate crowdin label_gal_Sidney_club_trick_74ae3aac:
msgid "[_ST_] {i}And that must be them driving off.{/i}"
msgstr "[_ST_] {i}Et ça doit être eux qui partent.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13893 #-#-# translate crowdin label_gal_Sidney_club_trick_632ce6d3:
msgid "[_ST_] {i}Now to follow from a discreet distance.{/i}"
msgstr "[_ST_] {i}Maintenant les suivre à distance discrète.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13901 #-#-# translate crowdin label_gal_Sidney_club_trick_0ceef333:
msgid "[_ST_] {i}So, this is the Mafia's club. It's pretty well hidden.{/i}"
msgstr "[_ST_] {i}Donc, c'est le club de la mafia. C'est plutôt bien caché.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13902 #-#-# translate crowdin label_gal_Sidney_club_trick_eaae3917:
msgid "[_ST_] {i}I never could have found it on my own.{/i}"
msgstr "[_ST_] {i}Je n'aurais jamais pu le trouver par moi-même.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13903 #-#-# translate crowdin label_gal_Sidney_club_trick_d590e10c:
msgid "[_ST_] {i}I'll just go park around the corner.{/i}"
msgstr "[_ST_] {i}Je vais juste me garer au coin de la rue.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13904 #-#-# translate crowdin label_gal_Sidney_club_trick_230150ef:
msgid "[_ST_] {i}Hopefully I can get in.{/i}"
msgstr "[_ST_] {i}J'espère pouvoir entrer.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13905 #-#-# translate crowdin label_gal_Sidney_club_trick_d89517b3:
msgid "[_ST_] {i}Somehow [ryan] was able to get in. I'm sure I'll find a way too.{/i}"
msgstr "[_ST_] {i}En quelque sorte [ryan] a pu entrer. Je suis sûr que je trouverai un moyen aussi.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13910 #-#-# translate crowdin label_gal_Sidney_club_trick_20b46912:
msgid "[_S_] Uhhh.... Hi.... Can I come in?"
msgstr "[_S_] Uhhh.... Salut.... Je peux entrer ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13911 #-#-# translate crowdin label_gal_Sidney_club_trick_668ff27f:
msgid "[_G_] Do you know the password?"
msgstr "[_L_] Sais-tu où elle se trouve?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13912 #-#-# translate crowdin label_gal_Sidney_club_trick_cfd5d96f:
msgid "[_S_] Uhh.... is it Scarface?"
msgstr "[_S_] AAHHAAHHAHHHEMMMMM..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13913 #-#-# translate crowdin label_gal_Sidney_club_trick_7570e50a:
msgid "[_G_] Is that supposed to be a joke?"
msgstr "[_G_] Est-ce censé être une blague?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13914 #-#-# translate crowdin label_gal_Sidney_club_trick_aa33b69b:
msgid "[_S_] Ummmm.... I don't actually know the password.... But, I know one of the dancers, and I was hoping to go see her."
msgstr "[_S_] UmmMm.... Je ne connais pas vraiment le mot de passe.... Mais, je connais une des danseuses, et j'espérais aller la voir."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13915 #-#-# translate crowdin label_gal_Sidney_club_trick_0c31e2da:
msgid "[_G_] Oh really? Which one?"
msgstr "[_G_] Oh vraiment? Laquelle ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13916 #-#-# translate crowdin label_gal_Sidney_club_trick_15900924:
msgid "[_S_] Ummm.... [mom_name]."
msgstr "[_S_] Hmmm.... [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13917 #-#-# translate crowdin label_gal_Sidney_club_trick_cfc03a7d:
msgid "[_G_] Oh yeah, [mom_name], of course! Why didn't you just say so in the first place."
msgstr "[_G_] Oh oui, [mom_name], bien sûr! Pourquoi tu ne l'as pas dit en premier lieu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13918 #-#-# translate crowdin label_gal_Sidney_club_trick_b5b3ff76:
msgid "[_S_] Any friend of [mom_name], is a friend to us."
msgstr "[_S_] Tout ami de [mom_name]est un ami pour nous."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13919 #-#-# translate crowdin label_gal_Sidney_club_trick_15119a9e:
msgid "[_S_] Ummm.... Thank you?"
msgstr "[_D_] Merci fils!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13920 #-#-# translate crowdin label_gal_Sidney_club_trick_19d9ae53:
msgid "[_G_] Of course.... Come on in."
msgstr "[_R_] Oh oui.... bien sûr."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13929 #-#-# translate crowdin label_gal_Sidney_club_trick_345a2083:
msgid "[_ST_] {i}Wow! This place is so much bigger than it looks from the outside.{/i}"
msgstr "[_ST_] {i}Wow! Cet endroit est tellement plus grand qu'il n'y paraît de l'extérieur.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13930 #-#-# translate crowdin label_gal_Sidney_club_trick_5c704644:
msgid "[_ST_] {i}And so many important people. I think I saw State Senetor McFeely by the craps table.{/i}"
msgstr "[_ST_] {i}Et tant de personnes importantes. Je pense avoir vu le sénateur de l'État McFeely près de la table de craps.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13931 #-#-# translate crowdin label_gal_Sidney_club_trick_e9b2a89a:
msgid "[_ST_] {i}And I think I recognized that creep that was making lude gestures at me from the slot machine.{/i}"
msgstr "[_ST_] {i}Et je pense avoir reconnu ce connard qui me faisait des gestes obscènes depuis la machine à sous.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13932 #-#-# translate crowdin label_gal_Sidney_club_trick_7ed38fc3:
msgid "[_ST_] {i}I think it was that school board member that Mom hates. I think his name is Bill, or Will Tylor, or something.{/i}"
msgstr "[_ST_] {i}Je pense que c'est ce membre du conseil scolaire que maman déteste. Je pense qu'il s'appelle Bill, ou Will Tylor, ou quelque chose comme ça.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13935 #-#-# translate crowdin label_gal_Sidney_club_trick_9b66c3b0:
msgid "[_J_] Well, hello there young lady."
msgstr "[_J_] Eh bien, bonjour jeune femme."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13936 #-#-# translate crowdin label_gal_Sidney_club_trick_0aad4e90:
msgid "[_S_] Oh shit!.... You scared me."
msgstr "[_S_] Oh merde!.... Tu m'as fait peur."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13937 #-#-# translate crowdin label_gal_Sidney_club_trick_dd39d110:
msgid "[_J_] I'm so sorry, allow me to introduce myself."
msgstr "[_J_] Je suis désolé, permettez-moi de me présenter."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13940 #-#-# translate crowdin label_gal_Sidney_club_trick_ebea7511:
msgid "[_J_] My name is Joey DeCapo."
msgstr "[_J_] Je m'appelle Joey DeCapo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13941 #-#-# translate crowdin label_gal_Sidney_club_trick_aa621b03:
msgid "[_J_] And you must be.... Sidney.... I think?"
msgstr "[_J_] Et vous devez l'être.... Sidney.... Je pense?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13942 #-#-# translate crowdin label_gal_Sidney_club_trick_171494c7:
msgid "[_S_] Yes.... but how did you?...."
msgstr "[_M_] Comment es-tu entré dans le club?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13943 #-#-# translate crowdin label_gal_Sidney_club_trick_74d6ad58:
msgid "[_J_] I pay a lot of people a lot of money to make sure I know everything about everyone of interest to me."
msgstr "[_J_] Je paie beaucoup d'argent à beaucoup de gens pour m'assurer de tout savoir sur tout ce qui m'intéresse."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13944 #-#-# translate crowdin label_gal_Sidney_club_trick_9c849b05:
msgid "[_J_] And your household has been very interesting this last little while."
msgstr "[_J_] Et votre ménage a été très intéressant ces derniers temps."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13947 #-#-# translate crowdin label_gal_Sidney_club_trick_d15e5051:
msgid "[_J_] But I must say that you are much prettier in person."
msgstr "[_J_] Mais je dois dire que vous êtes beaucoup plus jolie en personne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13948 #-#-# translate crowdin label_gal_Sidney_club_trick_429b142a:
msgid "[_J_] A very different kind of beauty than [mom_name], but very beautiful nonetheless."
msgstr "[_J_] Une beauté très différente de [mom_name], mais très belle néanmoins."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13951 #-#-# translate crowdin label_gal_Sidney_club_trick_5841f3ee:
msgid "[_S_] Uhhhh.... Thank you?"
msgstr "[_D_] Merci fils!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13952 #-#-# translate crowdin label_gal_Sidney_club_trick_bfd7d919:
msgid "[_S_] And you're the guy we have to pay every week to keep [mom_name] out of the club?"
msgstr "[_S_] Et tu es le gars qu'on doit payer chaque semaine pour garder [mom_name] hors du club?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13953 #-#-# translate crowdin label_gal_Sidney_club_trick_3ade86f6:
msgid "[_J_] A very regrettable situation, but in life, all debts must be paid."
msgstr "[_J_] Une situation très regrettable, mais dans la vie, toutes les dettes doivent être payées."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13954 #-#-# translate crowdin label_gal_Sidney_club_trick_831eadab:
msgid "[_S_] But Dad took out the loan, not us."
msgstr "[_S_] Mais Papa a contracté le prêt, pas nous."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13955 #-#-# translate crowdin label_gal_Sidney_club_trick_6133c7d0:
msgid "[_J_] And when he took it out, we made sure it was very clear to him that the debt would fall on his household if anything happened to him."
msgstr "[_J_] Et quand il l'a retiré, nous nous sommes assurés qu'il était très clair pour lui que la dette tomberait sur son ménage s'il lui arrivait quelque chose."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13956 #-#-# translate crowdin label_gal_Sidney_club_trick_9ee2623f:
msgid "[_J_] So, he knew the risks."
msgstr "[_J_] Donc, il connaissait les risques."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13957 #-#-# translate crowdin label_gal_Sidney_club_trick_6bd709d8:
msgid "[_S_] That asshole!"
msgstr "[_S_] Ce connard!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13958 #-#-# translate crowdin label_gal_Sidney_club_trick_20d522cf:
msgid "[_J_] Haha.... We can arrange for him to stay in prison for as long as you like."
msgstr "[_J_] Haha.... Nous pouvons nous arranger pour qu'il reste en prison aussi longtemps que vous le souhaitez."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13959 #-#-# translate crowdin label_gal_Sidney_club_trick_7adea004:
msgid "[_S_] We might just take you up on that offer."
msgstr "[_S_] Nous pourrions simplement vous suivre pour cette offre."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13960 #-#-# translate crowdin label_gal_Sidney_club_trick_73fc5dd0:
msgid "[_J_] But where are my manners. Let's go sit down and have a drink."
msgstr "[_J_] Mais où sont mes manières. Allons nous asseoir et prendre un verre."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13961 #-#-# translate crowdin label_gal_Sidney_club_trick_d6fd8077:
msgid "[_J_] Come.... Follow me."
msgstr "[_J_] Venez ... Suivez-moi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13964 #-#-# translate crowdin label_gal_Sidney_club_trick_2c023f61:
msgid "[_J_] This is the pole room, and this is our very lovely dancer Emma."
msgstr "[_J_] Voici la salle des pôles, et voici notre très belle danseuse Emma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13965 #-#-# translate crowdin label_gal_Sidney_club_trick_32d57bb1:
msgid "[_S_] She's very beautiful."
msgstr "[_S_] Elle est très belle."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13966 #-#-# translate crowdin label_gal_Sidney_club_trick_239622d4:
msgid "[_J_] Yes, she's quite popular, but not nearly as popular as [mom_name]."
msgstr "[_J_] Oui, elle est très populaire, mais pas aussi populaire que [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13967 #-#-# translate crowdin label_gal_Sidney_club_trick_74b4f012:
msgid "[_S_] Oh God!.... She's here isn't she?"
msgstr "[_S_] Oh Mon Dieu!.... Elle est là, n'est-ce pas ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13968 #-#-# translate crowdin label_gal_Sidney_club_trick_4d2f3e20:
msgid "[_J_] Haha.... yes, she's in the dressing room, she goes on after the next dancer."
msgstr "[_J_] Haha.... oui, elle est dans la loge, elle continue après la danseuse suivante."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13969 #-#-# translate crowdin label_gal_Sidney_club_trick_0bfd4db0:
msgid "[_J_] Shall we take a seat?"
msgstr "[_J_] Allons-nous nous asseoir ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13972 #-#-# translate crowdin label_gal_Sidney_club_trick_7d070b33:
msgid "[_J_] I want you to know that I feel very sorry for your families situation."
msgstr "[_J_] Je veux que vous sachiez que je suis très désolé pour votre situation familiale."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13973 #-#-# translate crowdin label_gal_Sidney_club_trick_f922f6a9:
msgid "[_J_] And I know I'm in an awkward position to help you all out, being your creditor and all."
msgstr "[_J_] Et je sais que je suis dans une position inconfortable pour vous aider tous, étant votre créance et tout."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13974 #-#-# translate crowdin label_gal_Sidney_club_trick_74174243:
msgid "[_J_] But I have a way you can help your family make the monthly payments, and maybe get you some spending money besides."
msgstr "[_J_] Mais j'ai un moyen d'aider votre famille à faire les paiements mensuels, et peut-être vous faire dépenser de l'argent en plus."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13975 #-#-# translate crowdin label_gal_Sidney_club_trick_b97cb517:
msgid "[_J_] I heard how the FBI cut out your discretionary spending."
msgstr "[_J_] J'ai entendu comment le FBI a réduit vos dépenses."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13976 #-#-# translate crowdin label_gal_Sidney_club_trick_8e00f764:
msgid "[_S_] I'm not becomming a stripper, if that's what you're thinking."
msgstr "[_S_] Je ne suis pas en train de devenir une strip-teaseuse, si c'est ce que vous pensez."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13977 #-#-# translate crowdin label_gal_Sidney_club_trick_1f739f57:
msgid "[_J_] Haha.... No of course not! We wouldn't hire you even if you wanted to."
msgstr "[_J_] Haha.... Non bien sûr que non! On ne vous engagerait pas même si vous le vouliez."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13978 #-#-# translate crowdin label_gal_Sidney_club_trick_2edab44f:
msgid "[_S_] What?.... Why not?"
msgstr "[_R_] Quoi?.... Pourquoi pas?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13979 #-#-# translate crowdin label_gal_Sidney_club_trick_24aefce8:
msgid "[_J_] You don't have the dancing experience like [mom_name] does."
msgstr "[_J_] Vous n'avez pas l'expérience de la danse comme le fait [mom_name]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13980 #-#-# translate crowdin label_gal_Sidney_club_trick_7b7b1433:
msgid "[_J_] But I do have another decent paying job that doesn't take any experience to get into, and only requires a pretty face."
msgstr "[_J_] Mais j'ai un autre travail rémunéré décent qui ne nécessite aucune expérience et ne nécessite qu'un joli visage."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13981 #-#-# translate crowdin label_gal_Sidney_club_trick_9560318f:
msgid "[_S_] What would that be?"
msgstr "[_S_] Qu'est-ce que ce serait?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13982 #-#-# translate crowdin label_gal_Sidney_club_trick_64a44913:
msgid "[_J_] Take a look over there."
msgstr "[_J_] Jetez un oeil là-bas."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13985 #-#-# translate crowdin label_gal_Sidney_club_trick_d2981908:
msgid "[_J_] Do you see that girl in the tights and blue shirt serving drinks to the customers."
msgstr "[_J_] Voyez-vous cette fille en collants et chemise bleue servant des boissons aux clients."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13986 #-#-# translate crowdin label_gal_Sidney_club_trick_afd5cbd9:
msgid "[_S_] Yeah."
msgstr "[_S_] Ouais, bien en plus d'être extrêmement occupé, je suis aussi toujours assez énervée contre toi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13987 #-#-# translate crowdin label_gal_Sidney_club_trick_017c4b06:
msgid "[_J_] Well, she wants to be a bartender, so I'm letting her help tend the bar whenever things get a little slower."
msgstr "[_J_] Eh bien, elle veut être barman, alors je la laisse aider à s'occuper du bar chaque fois que les choses deviennent un peu plus lentes."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13988 #-#-# translate crowdin label_gal_Sidney_club_trick_152710b1:
msgid "[_J_] So, she needs some help filling her job while she's practicing her drink mixing skills."
msgstr "[_J_] Donc, elle a besoin d'aide pour remplir son travail pendant qu'elle pratique ses compétences en mélange de boissons."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13989 #-#-# translate crowdin label_gal_Sidney_club_trick_7d1a995d:
msgid "[_J_] Let me call her over here so you can meet her."
msgstr "[_J_] Laissez-moi l'appeler ici pour que vous puissiez la rencontrer."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13992 #-#-# translate crowdin label_gal_Sidney_club_trick_68717c9c:
msgid "[_J_] HEY! Armani! Can I get a couple drinks?"
msgstr "[_J_] HÉ! Armani ! Je peux prendre quelques verres?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13995 #-#-# translate crowdin label_gal_Sidney_club_trick_2abdd7c4:
msgid "[_A_] Hey Uncle! Do you want the usual?"
msgstr "[_A_] Salut mon oncle! Voulez-vous comme d'habitue?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13996 #-#-# translate crowdin label_gal_Sidney_club_trick_f2eb0d18:
msgid "[_J_] Yes darling!, and get Sidney here whatever she wants."
msgstr "[_J_] Oui chéri! et amène à Sidney ici ce qu'elle veut."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13997 #-#-# translate crowdin label_gal_Sidney_club_trick_ad752753:
msgid "[_S_] I don't want anything. I'm actually not old enough to buy a drink."
msgstr "[_S_] Je ne veux rien. En fait, je ne suis pas assez vieille pour acheter un verre."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13998 #-#-# translate crowdin label_gal_Sidney_club_trick_0c2676df:
msgid "[_J_] Yeah, well regular rules don't apply here."
msgstr "[_J_] Ouais, eh bien les règles régulières ne s'appliquent pas ici."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13999 #-#-# translate crowdin label_gal_Sidney_club_trick_9db52021:
msgid "[_S_] I'm really ok."
msgstr "[_R_] Ok, très bien je pars."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14000 #-#-# translate crowdin label_gal_Sidney_club_trick_8b77dee6:
msgid "[_J_] Suit yourself."
msgstr "[_J_] J'y conviens."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14001 #-#-# translate crowdin label_gal_Sidney_club_trick_89aa9450:
msgid "[_J_] Armani, this is Sidney.... She's thinking about coming here sometimes to help you serve drinks."
msgstr "[_J_] Armani, voici Sidney.... Elle pense parfois venir ici pour vous aider à servir des boissons."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14002 #-#-# translate crowdin label_gal_Sidney_club_trick_e10f00ff:
msgid "[_J_] Sidney, this is my niece Armani."
msgstr "[_J_] Sidney, voici ma nièce Armani."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14005 #-#-# translate crowdin label_gal_Sidney_club_trick_8a2d51b0:
msgid "[_A_] Aren't you a pretty thing?"
msgstr "[_A_] N'es-tu pas une jolie chose?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14006 #-#-# translate crowdin label_gal_Sidney_club_trick_2f90028e:
msgid "[_S_] I wasn't really thinking about serving drinks...."
msgstr "[_S_] Je ne pensais pas vraiment à servir des boissons...."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14007 #-#-# translate crowdin label_gal_Sidney_club_trick_ebabb98d:
msgid "[_J_] Not yet, you mean."
msgstr "[_J_] Pas encore, vous voulez dire."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14008 #-#-# translate crowdin label_gal_Sidney_club_trick_b9d930f7:
msgid "[_A_] Well, I would sure love to work with someone as beautiful as you, and we can make a ton in tips in one night."
msgstr "[_A_] Eh bien, j'aimerais bien travailler avec quelqu'un d'aussi beau que vous, et nous pouvons faire une tonne de pourboires en une nuit."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14009 #-#-# translate crowdin label_gal_Sidney_club_trick_3494722b:
msgid "[_A_] So, think about it."
msgstr "[_A_] Alors, pensez-y."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14012 #-#-# translate crowdin label_gal_Sidney_club_trick_9b656435:
msgid "[_J_] And you'd be under very little commitment. I would only require you to be here on Mondays, since that's when Armani's at the bar full time."
msgstr "[_J_] Et vous seriez sous très peu d'engagement. Je voudrais seulement que tu sois ici le lundi, car c'est à ce moment-là qu'Armani est au bar à plein temps."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14013 #-#-# translate crowdin label_gal_Sidney_club_trick_50717fc0:
msgid "[_J_] Other than that, You could come in any day you want. Oh.... except Saturdays, since [mom_name] might be here."
msgstr "[_J_] En dehors de cela, vous pouvez venir n'importe quand vous voulez. Oh.... sauf le samedi, puisque [mom_name] pourrait être ici."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14014 #-#-# translate crowdin label_gal_Sidney_club_trick_6196b8fb:
msgid "[_ST_] {i}That doesn't sound bad at all.{/i}"
msgstr "[_ST_] {i}Cela ne sonne pas mal du tout.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14015 #-#-# translate crowdin label_gal_Sidney_club_trick_d9ecee9e:
msgid "[_ST_] {i}And I'd love to be able to help [ryan] out. He's taken most of the responsibility on himself.{/i}"
msgstr "[_ST_] {i}Et j'aimerais pouvoir aider [ryan] . Il a pris la plus grande partie de la responsabilité sur lui.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14016 #-#-# translate crowdin label_gal_Sidney_club_trick_d9b21643:
msgid "[_S_] That's a very tempting offer."
msgstr "[_S_] C'est une offre très tentante."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14017 #-#-# translate crowdin label_gal_Sidney_club_trick_7815ca65:
msgid "[_J_] Well, then why don't you run along with Armani and she can show you the ropes. You can keep any tips you make tonight."
msgstr "[_J_] Eh bien, pourquoi ne allez-vous pas avec Armani et elle pourra vous montrer les ficelles du métier. Vous pouvez garder tous les conseils que vous faites ce soir."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14018 #-#-# translate crowdin label_gal_Sidney_club_trick_55f2407f:
msgid "[_S_] Ok.... Thank you."
msgstr "[_M_] Merci beaucoup!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14021 #-#-# translate crowdin label_gal_Sidney_club_trick_aa726d46:
msgid "[_J_] Oh.... and Sidney! I almost forgot."
msgstr "[_J_] Oh.... et Sidney ! J'ai presque oublié."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14022 #-#-# translate crowdin label_gal_Sidney_club_trick_c58cb65c:
msgid "[_J_] It would be best if [mom_name] didn't know if you were here. If you are inclined to peek like [ryan] does, just don't get caught."
msgstr "[_J_] Il serait préférable que [mom_name] ne sache pas si vous étiez ici. Si vous êtes enclin à jeter un coup d'œil comme le fait [ryan] , ne vous faites pas prendre."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14023 #-#-# translate crowdin label_gal_Sidney_club_trick_804412d2:
msgid "[_J_] I don't even think my best \"Made Man\" could stop her from murdering me, if she knew you were here."
msgstr "[_J_] Je ne pense même pas que mon meilleur 'Made Man' puisse l'empêcher de me tuer, si elle savait que vous étiez là."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14024 #-#-# translate crowdin label_gal_Sidney_club_trick_8d3ec460:
msgid "[_ST_] {i}Does [ryan] regularly peek at Mom when she's stripping?{/i}"
msgstr "[_ST_] {i}Est-ce que [ryan] regarde régulièrement maman quand elle se déshabille?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14025 #-#-# translate crowdin label_gal_Sidney_club_trick_e104edeb:
msgid "[_S_] Ok.... I'll be careful."
msgstr "[_R_] Ok maman, je viens tout de suite."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14031 #-#-# translate crowdin label_gal_Sidney_club_trick_66c7ce4f:
msgid "[_R_] Hey Lurch, How's it hanging?"
msgstr "[_R_] Salut Lurch, comment ça va?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14032 #-#-# translate crowdin label_gal_Sidney_club_trick_5aaa2f26:
msgid "[_R_] Are you just gonna leave me hanging?"
msgstr "[_R_] Tu vas me laisser faire?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14033 #-#-# translate crowdin label_gal_Sidney_club_trick_5f9b772e:
msgid "...."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14034 #-#-# translate crowdin label_gal_Sidney_club_trick_dcfdd779:
msgid "[_R_] Alright, I'll just show myself in then."
msgstr "[_R_] D'accord, je me montrerais alors."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14038 #-#-# translate crowdin label_gal_Sidney_club_trick_f7743867:
msgid "[_RT_] {i}Shit.... I hope Mom is ok.... The way I got her hopes up, and then crushed them a few minutes later.{/i}"
msgstr "[_RT_] {i}Merde.... J'espère que maman va bien.... La façon dont je lui ai fait espérer, puis je les ai déçus quelques minutes plus tard.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14039 #-#-# translate crowdin label_gal_Sidney_club_trick_4aca768f:
msgid "[_RT_] {i}I hate seeing Mom look so disappointed. And where the hell did I put that money?{/i}"
msgstr "[_RT_] {i}Je déteste voir maman avoir l'air si déçue. Et où ai-je mis cet argent ?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14042 #-#-# translate crowdin label_gal_Sidney_club_trick_bbbc8890:
msgid "[_RT_] {i}Past the bar, through the casino, and Bingo!{/i}"
msgstr "[_RT_] {i}Passer à côté du bar, à travers le casino et Bingo!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14045 #-#-# translate crowdin label_gal_Sidney_club_trick_1c68d51f:
msgid "[_RT_] {i}Oh wow! Now I don't feel so bad!{/i}"
msgstr "[_RT_] {i}Oh wow! Maintenant, je ne me sens pas si mal!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14046 #-#-# translate crowdin label_gal_Sidney_club_trick_0007c522:
msgid "[_RT_] {i}I never would have seen her in that outfit otherwise.{/i}"
msgstr "[_RT_] {i}Je ne l'aurais jamais vue dans cette tenue autrement.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14049 #-#-# translate crowdin label_gal_Sidney_club_trick_41ba6782:
msgid "[_RT_] {i}I sure wish I had access to the clubs wardrobe.{/i}"
msgstr "[_RT_] {i}J'aimerais bien avoir accès à la garde-robe du club.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14050 #-#-# translate crowdin label_gal_Sidney_club_trick_d015299a:
msgid "[_RT_] {i}Mom pulls off the edgy look really well!{/i}"
msgstr "[_RT_] {i}Maman énervée à vraiment bonne mine!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14053 #-#-# translate crowdin label_gal_Sidney_club_trick_28aa104e:
msgid "[_RT_] {i}Oh God, but she looks even better when she's not wearing it at all.{/i}"
msgstr "[_RT_] {i}Oh mon Dieu, mais elle a l'air encore mieux quand elle ne le porte pas du tout.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14054 #-#-# translate crowdin label_gal_Sidney_club_trick_9dba7459:
msgid "[_RT_] {i}How are her tits so perky? Did she even breastfeed us at all? Mmmm.... I wish I could remember that.{/i}"
msgstr "[_RT_] {i}Comme ses seins sont si beaux ? Nous a-t-elle même allaités ? Mmmm.... J'aimerais pouvoir m'en souvenir.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14055 #-#-# translate crowdin label_gal_Sidney_club_trick_54f0310e:
msgid "[_RT_] {i}And that's about all the self control I have.{/i}"
msgstr "[_RT_] {i}Et c'est à peu près tout le contrôle de moi que j'ai.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14058 #-#-# translate crowdin label_gal_Sidney_club_trick_f9d9e96a:
msgid "[_RT_] {i}Oh and that ass is to die for!{/i}"
msgstr "[_RT_] {i}Oh et ce cul est à tomber par terre!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14065 #-#-# translate crowdin label_gal_Sidney_club_trick_dd4798c4:
msgid "[_RT_] {i}One day, I'll get her moving like that in front of my camera.{/i}"
msgstr "[_RT_] {i}Un jour, je la ferais bouger comme ça devant ma caméra.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14072 #-#-# translate crowdin label_gal_Sidney_club_trick_e7799ce0:
msgid "[_ST_] {i}Oh my God! Is that guy doing what I think he's doing?{/i}"
msgstr "[_ST_] {i}Oh mon Dieu! Est-ce que ce type fait ce que je pense qu'il fait?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14073 #-#-# translate crowdin label_gal_Sidney_club_trick_b8e87b3f:
msgid "[_ST_] {i}That's disgusting!{/i}"
msgstr "[_ST_] {i}C'est dégoûtant!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:14076 #-#-# translate crowdin label_gal_Sidney_club_trick_0fddf94d:
msgid "[_S_] Hey buddy! I don't think you're supposed to be...."
