# game/Gallery_labels_AFV-0.06_v0.2.rpy:21056 #-#-# translate crowdin label_gal_aunt_05_72bfa7fd:
msgid "[_C_] I'm supposed to be grateful after she made me wear that ridiculous maid costume, and clean her house?"
