msgstr "Shlurp.... shluurp.... smack"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24700 #-#-# translate crowdin label_gal_Xmas_event_d71f5f49:
msgid "[_RT_] {i}What is that noise?{/i}"
msgstr "[_RT_] {i}Quel est ce bruit?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24705 #-#-# translate crowdin label_gal_Xmas_event_aa2b5fee:
msgid "Shlurp, shlirrk, shmork"
msgstr "Shlurp, shlirrk, shmork"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24706 #-#-# translate crowdin label_gal_Xmas_event_378eed57:
msgid "[_S_] (sleepily) Again!.... Oh [ryan]!.... That feels so good!"
msgstr "[_S_] (encore endormi)!.... Oh [ryan]!.... Ça fait tellement de bien !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24713 #-#-# translate crowdin label_gal_Xmas_event_9b8fdbd9:
msgid "Shlirk, shmlack"
msgstr "Shlirk, shmlack"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24714 #-#-# translate crowdin label_gal_Xmas_event_8cc7d32b:
msgid "[_R_] What the hell is going on?"
msgstr "[_R_] Que se passe-t-il ?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24717 #-#-# translate crowdin label_gal_Xmas_event_bc53ebd9:
msgid "[_X_] Oh.... hey [ryan]!"
msgstr "[_X_] Oh.... hé [ryan]!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24718 #-#-# translate crowdin label_gal_Xmas_event_7477d7b3:
msgid "[_X_] Sorry I woke you!"
msgstr "[_X_] Désolé de t'avoir réveillé!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24719 #-#-# translate crowdin label_gal_Xmas_event_9795a042:
msgid "[_X_] My sisters both told me I had to try out the all you can eat breakfast buffet."
msgstr "[_X_] Mes sœurs m'ont toutes deux dit que je devais essayer le buffet du petit-déjeuner à volonté."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24720 #-#-# translate crowdin label_gal_Xmas_event_2409e36d:
msgid "[_X_] They said you got a little hot under the collar when they did this."
msgstr "[_X_] Elles ont dit que tu avais un peu chaud sous le col quand elles ont fait ça."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24721 #-#-# translate crowdin label_gal_Xmas_event_c9c91e05:
msgid "[_X_] So I thought I'd just get it out of the way before you woke up."
msgstr "[_X_] Alors j'ai pensé que je l'enlèverais juste avant que tu te réveilles."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24722 #-#-# translate crowdin label_gal_Xmas_event_e6436c83:
msgid "[_X_] But I think I've had my fill. Should we get down to business?"
msgstr "[_X_] Mais je pense que j'ai fait le plein. Devrions-nous nous mettre au travail?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24728 #-#-# translate crowdin label_gal_Xmas_event_c931e5f6:
msgid "[_X_] Do I need to introduce myself, or do you already know who I am?"
msgstr "[_X_] Dois-je me présenter, ou sais-tu déjà qui je suis?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24729 #-#-# translate crowdin label_gal_Xmas_event_9758310c:
msgid "[_R_] The ghost of Christmas Future, I presume?"
msgstr "[_R_] Le fantôme de l'avenir de Noël, je présume?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24730 #-#-# translate crowdin label_gal_Xmas_event_3f1cd82f:
msgid "[_GF_] You are correct!"
msgstr "[_GF_] Tu as raison!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24731 #-#-# translate crowdin label_gal_Xmas_event_d602a554:
msgid "[_GF_] And do you know why I'm here?"
msgstr "[_GF_] Et sais-tu pourquoi je suis ici?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24732 #-#-# translate crowdin label_gal_Xmas_event_c0a6c83a:
msgid "[_R_] To stop me from fucking everyone in this house?"
msgstr "[_R_] Pour m'empêcher de baiser tout le monde dans cette maison?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24733 #-#-# translate crowdin label_gal_Xmas_event_cb9ec460:
msgid "[_GF_] Haha.... that's pretty blunt and to the point."
msgstr "[_GF_] Haha.... c'est assez direct et précis."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24734 #-#-# translate crowdin label_gal_Xmas_event_91c59f05:
msgid "[_GF_] But that's actually where you're wrong."
msgstr "[_GF_] Mais c'est en fait là que tu as tort."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24735 #-#-# translate crowdin label_gal_Xmas_event_5593d8de:
msgid "[_GF_] I'm not here to stop you from doing anything."
msgstr "[_GF_] Je ne suis pas là pour t'empêcher de faire quoi que ce soit."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24736 #-#-# translate crowdin label_gal_Xmas_event_ac0f7c0b:
msgid "[_GF_] In fact, I don't give a fuck about what you choose to do with your life."
msgstr "[_GF_] En fait, je m'en fous de ce que tu choisis de faire de ta vie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24737 #-#-# translate crowdin label_gal_Xmas_event_fa289250:
msgid "[_GF_] I'm just here as a guide, to take you a couple of years into the Christmas future, to show you the consequences of your actions."
msgstr "[_GF_] Je suis juste ici comme guide, pour t'emmener quelques années dans le futur de Noël, pour te montrer les conséquences de tes actions."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24738 #-#-# translate crowdin label_gal_Xmas_event_190ae3f3:
msgid "[_GF_] If you like the results, great! If not, you can decide to make different choices."
msgstr "[_GF_] Si tu aimes les résultats, super! Sinon, tu peux décider de faire des choix différents."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24739 #-#-# translate crowdin label_gal_Xmas_event_b9cd7c7f:
msgid "[_GF_] Whatever tickles your pickle."
msgstr "[_GF_] Tout ce qui chatouille ton cornichon."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24740 #-#-# translate crowdin label_gal_Xmas_event_f1bd82db:
msgid "[_R_] Well, I've got to say it's nice to meet a ghost that's not so judgy."
msgstr "[_R_] Eh bien, je dois dire que c'est agréable de rencontrer un fantôme qui n'est pas si sérieux."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24741 #-#-# translate crowdin label_gal_Xmas_event_e09f122f:
msgid "[_GF_] Yeah, my sisters can be real condescending bitches."
msgstr "[_GF_] Oui, mes sœurs peuvent être de vraies salopes condescendantes."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24742 #-#-# translate crowdin label_gal_Xmas_event_27c970d7:
msgid "[_GF_] Haha.... but you brought them down a peg."
msgstr "[_GF_] Haha.... mais tu les as fait tomber une cheville."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24743 #-#-# translate crowdin label_gal_Xmas_event_8a834488:
msgid "[_GF_] God's not going to be super happy with them after tonight's over."
msgstr "[_GF_] Dieu ne sera pas très heureux avec elles après la fin de ce soir."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24744 #-#-# translate crowdin label_gal_Xmas_event_0270a7ad:
msgid "[_GF_] I wouldn't be surprised if she sends them to the sex dungeon for a decade."
msgstr "[_GF_] Je ne serais pas surpris si elle les envoyait au cachot sexuel pendant une décennie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24745 #-#-# translate crowdin label_gal_Xmas_event_398ece5f:
msgid "[_R_] Oh, no!.... That sounds awful! Now I feel really bad that I didn't try to follow their game plan better."
msgstr "[_R_] Oh, non!.... Ça a l'air horrible ! Maintenant, je me sens vraiment mal de ne pas avoir essayé de mieux suivre leur plan de jeu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24746 #-#-# translate crowdin label_gal_Xmas_event_bbd13ed1:
msgid "[_GF_] Ahhh.... don't worry about it, everyone secretely likes the sex dungeon anyways."
msgstr "[_GF_] Ahhh.... ne vous inquiétez pas, tout le monde aime secrètement le donjon sexuel de toute façon."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24747 #-#-# translate crowdin label_gal_Xmas_event_5d5f5092:
msgid "[_GF_] I've been there so many times, they've made me an honorary torturer."
msgstr "[_GF_] J'y suis allé tant de fois, ils ont fait de moi un tortionnaire honoraire."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24748 #-#-# translate crowdin label_gal_Xmas_event_3c0bfcfd:
msgid "[_R_] Is that why you don't shine as bright as your sisters?"
msgstr "[_R_] Est-ce pour cela que tu ne brilles pas autant que tes sœurs?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24749 #-#-# translate crowdin label_gal_Xmas_event_0fb39396:
msgid "[_GF_] Naaahhh.... It's just because I'm supposed to be the more scary ghost."
msgstr "[_GF_] Naaahhh.... C'est juste parce que je suis censé être le fantôme le plus effrayant."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24750 #-#-# translate crowdin label_gal_Xmas_event_63db340d:
msgid "[_GF_] You see, most people fear their future, so they gave me this whole facade to make me more scary."
msgstr "[_GF_] Tu vois, la plupart des gens craignent leur avenir, alors ils m'ont donné toute cette façade pour me faire plus peur."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24751 #-#-# translate crowdin label_gal_Xmas_event_cb064996:
msgid "[_GF_] Do I seem scarier to you?"
msgstr "[_GF_] Est-ce que je te semble plus effrayante?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24752 #-#-# translate crowdin label_gal_Xmas_event_922365cf:
msgid "[_R_] Nah.... making you look like my hot crush Sidney, kind of takes away the whole fear factor."
msgstr "[_R_] Non.... te faire ressembler à mon béguin Sidney, ça enlève tout le facteur de peur."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24753 #-#-# translate crowdin label_gal_Xmas_event_51167278:
msgid "[_GF_] See! That's what I've been saying! Let me wear a holocaust robe, and give me a skull for a head, you know, like they did in the old days."
msgstr "[_GF_] Voit! C'est ce que j'ai dit ! Laisses-moi porter une robe de l'holocauste, et donnes-moi un crâne pour une tête, tu saais, comme ils le faisaient autrefois."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24754 #-#-# translate crowdin label_gal_Xmas_event_34bd417c:
msgid "[_GF_] Too much PC shit in Heaven. We're not allowed to scare anyone too badly anymore."
msgstr "[_GF_] Trop de merde de PC au Paradis. On n'a plus le droit de faire trop peur à personne."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24755 #-#-# translate crowdin label_gal_Xmas_event_41d69bb4:
msgid "[_GF_] Ahhh.... but we shouldn't be discussing heavenly politics. I've got a job to do, and not a lot of time to get it done."
msgstr "[_GF_] Ahhh.... mais nous ne devrions pas discuter de politique céleste. J'ai un travail à faire, et pas beaucoup de temps pour le faire."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24756 #-#-# translate crowdin label_gal_Xmas_event_eb7bbf9a:
msgid "[_GF_] Are you ready to go to the future?"
msgstr "[_GF_] Es-tu prêt à aller vers le futur?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24757 #-#-# translate crowdin label_gal_Xmas_event_718c1490:
msgid "[_R_] I guess! Go ahead and blow that magic fairy dust on me"
msgstr "[_R_] Je suppose! vas-y et souffles cette poussière de fée magique sur moi"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24758 #-#-# translate crowdin label_gal_Xmas_event_0117dc30:
msgid "[_GF_] Yeah.... I'm not into that flowery bull-shit. I do things a little differently."
msgstr "[_GF_] Ouais.... Je ne suis pas dans cette merde fleurie. Je fais les choses un peu différemment."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24761 #-#-# translate crowdin label_gal_Xmas_event_70cf7f50_1:
msgid "[_R_] What are you doing?"
msgstr "[_R_] Que fais-tu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24762 #-#-# translate crowdin label_gal_Xmas_event_84adaa77:
msgid "[_GF_] Just give me a second."
msgstr "[_GF_] Donne-moi juste une seconde."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24765 #-#-# translate crowdin label_gal_Xmas_event_20c89c81:
msgid "[_GF_] Huhhnngghhhh..."
msgstr "[_GF_] Huhhnngghhhh..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24766 #-#-# translate crowdin label_gal_Xmas_event_6cf37ce8:
msgid "[_R_] Oh, no!"
msgstr "[_R_] Oh, non!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24770 #-#-# translate crowdin label_gal_Xmas_event_b7bdf01a:
msgid "[_R_] Ohhhh..."
msgstr "[_R_] Ohhhh..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24771 #-#-# translate crowdin label_gal_Xmas_event_9e8fea21:
msgid "[_R_] Oh, my God!..."
msgstr "[_R_] Oh mon Dieu!..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24772 #-#-# translate crowdin label_gal_Xmas_event_ca2d6884:
msgid "[_R_] What in Futa God's name?..."
msgstr "[_R_] Qu'en est-il du nom de Futa Dieu?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24773 #-#-# translate crowdin label_gal_Xmas_event_8e95cc4a:
msgid "[_R_] Huh.... weird.... It.... smells like.... candy canes."
msgstr "[_R_] Hein.... étrange.... Il.... ça sent bon.... cannes de bonbons."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24779 #-#-# translate crowdin label_gal_Xmas_event_1b3e2c8f:
msgid "[_RT_] {i}What the.... I'm still in bed.... I don't think I've even moved.... these dreams are getting weird.{/i}"
msgstr "[_RT_] {i}C'est quoi ce.... Je suis toujours au lit.... Je ne pense même pas avoir déménagé.... ces rêves deviennent bizarres.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24780 #-#-# translate crowdin label_gal_Xmas_event_8a905434:
