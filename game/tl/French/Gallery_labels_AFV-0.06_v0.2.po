msgstr "[_M_] {i}(Voix silencieuse){/i} S'il vous plaît, ne tirez pas !"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7394 #-#-# translate crowdin label_gal_beach_date_60821e9e:
msgid "[_J_] [ryan]?... [mom_name]?..."
