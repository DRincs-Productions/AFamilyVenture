# TODO: Translation updated at 2024-07-23 08:27 #|#|# # game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:126 #-#-# translate crowdin ASS_Affect_game_start_lbl_aadc3f05:
msgid "[_MS_] Oh... I see Lauren is in a similar pose for this picture too."
msgstr "[_MS_] Oh... Widzę, że Lauren też jest w podobnej pozie na tym zdjęciu."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:127 #-#-# translate crowdin ASS_Affect_game_start_lbl_e52bac6b:
msgid "[_MS_] She is very photogenic from that angle."
msgstr "[_MS_] Pod tym kątem jest bardzo fotogeniczna. "

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:128 #-#-# translate crowdin ASS_Affect_game_start_lbl_cb04a16f:
msgid "[_R_] Yeah, what she lacks in the bra, she makes up for in the trunk."
msgstr "[_R_] Tak, to czego  brakuje jej w staniku, nadrabia w bagażniku."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:129 #-#-# translate crowdin ASS_Affect_game_start_lbl_737e5d1a:
msgid "[_MS_] Haha... [ryan]..."
msgstr "[_MS_] Haha... [ryan]..."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:130 #-#-# translate crowdin ASS_Affect_game_start_lbl_38ce0b4a:
msgid "[_R_] Oh, right... I shouldn't talk like that in school, sorry."
msgstr "[_R_] Oh, racja... Nie powinienem tak mówić w szkole, przepraszam."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:131 #-#-# translate crowdin ASS_Affect_game_start_lbl_43bfb9e7:
msgid "[_MS_] Uh huh... And who is Lauren supposed to be in this picture?"
msgstr "[[_MS_] Uh huh... A kim powinna być Lauren na tym zdjęciu?"

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:132 #-#-# translate crowdin ASS_Affect_game_start_lbl_2c794b2d:
msgid "[_R_] Well, she's supposed to be Penny Roberson from \"Missing in Space\", but she could pass for any number of sci-fi girls."
msgstr "[_R_] No więc ma być Penny Roberson z „Zaginionej w kosmosie”, jednak mogłaby być dowolną postacią z sci-fi."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:133 #-#-# translate crowdin ASS_Affect_game_start_lbl_ea3d16ca:
msgid "[_MS_] Ok, great... So remember, think of a theme, a background, and a slogan."
msgstr "[_MS_] Ok, świetnie... Więc pamiętaj, pomyśl o motywie, tle i sloganie."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:134 #-#-# translate crowdin ASS_Affect_game_start_lbl_dc7a84b6:
msgid "[_R_] ...."
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:135 #-#-# translate crowdin ASS_Affect_game_start_lbl_e9adfdff:
msgid "[_R_] Ok, I think I've got an idea."
msgstr "[_R_] Ok, sądzę, że mam pomysł."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:137 #-#-# translate crowdin ASS_Affect_game_start_lbl_62d847a6:
msgid "[_MS_] Ok, let's see if you can do any better this time."
msgstr "[_MS_] Ok, przekonajmy się, czy tym razem poradzisz sobie lepiej."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:138 #-#-# translate crowdin ASS_Affect_game_start_lbl_89598738:
msgid "[_MS_] Now, remember your theme."
msgstr "[_MS_] Teraz zapamiętaj swój motyw."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:139 #-#-# translate crowdin ASS_Affect_game_start_lbl_83bad045:
msgid "[_MS_] Think of a good slogan..."
msgstr "[_MS_] Wymyśl dobry slogan..."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:140 #-#-# translate crowdin ASS_Affect_game_start_lbl_4de1d815:
msgid "[_MS_] And let your creativity flow."
msgstr "[_MS_] I pozwól wypłynąć swojej kreatywności."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:141 #-#-# translate crowdin ASS_Affect_game_start_lbl_771f9494:
msgid "[_R_] Ok... I think I'm ready."
msgstr "[_MS_] Ok... Myślę, że jestem gotowy."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:154 #-#-# translate crowdin ASS_Affect_game_end_lbl_546445bc:
msgid "[_MS_] It looks really good!"
msgstr "[_MS_] Wygląda naprawdę dobrze!"

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:155 #-#-# translate crowdin ASS_Affect_game_end_lbl_c6660191:
msgid "[_MS_] What is \"Ass Affect\" referencing though?"
msgstr "[_MS_] Do czego jednak odnosi się \"Ass Affect\"?"

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:156 #-#-# translate crowdin ASS_Affect_game_end_lbl_31c97292:
msgid "[_R_] It's a parody on the sci-fi video game \"Ass Effect\", but it's really effect with an \"e\"."
msgstr "[_R_] To parodia gry wideo science-fiction \"Ass Effect\", ale tak naprawdę to efekt przez \"e\"."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:157 #-#-# translate crowdin ASS_Affect_game_end_lbl_4830b64e:
msgid "[_MS_] Oh... I think my nephew used to play that game."
msgstr "[_MS_] Och... Myślę, że mój siostrzeniec grał w tę grę."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:158 #-#-# translate crowdin ASS_Affect_game_end_lbl_d0eba5c2:
msgid "[_MS_] That's a pretty clever play on words."
msgstr "[_MS_] To całkiem sprytna gra słów."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:161 #-#-# translate crowdin ASS_Affect_game_end_lbl_546445bc_1:
msgid "[_MS_] It looks really good!"
msgstr "[_MS_] Wygląda naprawdę dobrze!"

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:162 #-#-# translate crowdin ASS_Affect_game_end_lbl_b24f79a5:
msgid "[_MS_] I'm not much for video games, but that poster makes me want to go try it."
msgstr "[_MS_] Nie przepadam za grami wideo, ale ten plakat sprawia, że chcę spróbować."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:163 #-#-# translate crowdin ASS_Affect_game_end_lbl_027f12d9:
msgid "[_MS_] Not to mention vote for Lauren, if I could."
msgstr "[_MS_] Nie wspominając o głosowaniu na Lauren, gdybym mógł."

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:164 #-#-# translate crowdin ASS_Affect_game_end_lbl_43244d4d:
msgid "[_MS_] Great job!"
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:175 #-#-# translate crowdin ASS_Affect_game_end_lbl_acb68e2b:
msgid "[_MS_] The background is looking nice, now bring it home with a creative slogan."
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:176 #-#-# translate crowdin ASS_Affect_game_end_lbl_67c6ec22:
msgid "[_R_] Alright... I've got this."
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:183 #-#-# translate crowdin ASS_Affect_game_end_lbl_6a323a1c:
msgid "[_MS_] Oh... That's... Hmmm..."
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:184 #-#-# translate crowdin ASS_Affect_game_end_lbl_8c85cc34:
msgid "[_R_] Well... That didn't end up the way I planned."
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:185 #-#-# translate crowdin ASS_Affect_game_end_lbl_14eba41d:
msgid "[_R_] But, I think nobody will really care since they will just be paying attention to the picture of Lauren."
msgstr ""

# game/images/interface_images/minigame/ASS_Affect_paint_timed_event.rpy:186 #-#-# translate crowdin ASS_Affect_game_end_lbl_6c494ceb:
msgid "[_MS_] Hmmm... Well, you may be right."
msgstr "[_MS_] Hmmm... Cóż, możesz mieć rację. "

