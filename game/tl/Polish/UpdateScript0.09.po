# game/UpdateScript0.09.rpy:5507 #-#-# translate crowdin cami_events_intro_b7680fa3:
msgid "[_R_] {i}(Screaming){/i} Fuck!"
msgstr "[_R_] {i}(Krzyczy){/i} Kurwa!"

# game/UpdateScript0.09.rpy:5508 #-#-# translate crowdin cami_events_intro_437aacac:
msgid "[_RT_] {i}All she had to do was walk away, but now I have to deal with the shit-storm she's created.{/i}"
msgstr "[_RT_] {i}Wystarczyło jej odejść, ale teraz muszę uporać się z gównianą burzą, którą wywołała.{/i}"

# game/UpdateScript0.09.rpy:5509 #-#-# translate crowdin cami_events_intro_d877be7c:
msgid "[_R_] {i}(sigh){/i}"
msgstr "[_R_] {i}(wzdycha){/i}"

# game/UpdateScript0.09.rpy:5510 #-#-# translate crowdin cami_events_intro_37fae585:
msgid "[_RT_] {i}If I can just get her to listen to me for once. There might be a way I can turn this disaster around, somehow.{/i}"
