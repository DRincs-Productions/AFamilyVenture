# game/UpdateScript0.09.rpy:5475 #-#-# translate crowdin cami_events_intro_211fd6fd:
msgid "[_J_] I'm afraid we can."
msgstr "[_J_] Obawiam się, że możemy."

# game/UpdateScript0.09.rpy:5476 #-#-# translate crowdin cami_events_intro_88ebe59d:
msgid "[_J_] Now, let's talk about how I can help you pay that money back."
msgstr "[_J_] Porozmawiajmy teraz o tym, jak mogę pomóc Ci zwrócić te pieniądze."

# game/UpdateScript0.09.rpy:5477 #-#-# translate crowdin cami_events_intro_f15c6346:
msgid "[_J_] I understand you aren't current working. I can offer you a way to make enough money..."
msgstr "[_J_] Rozumiem, że obecnie nie pracujesz.\n"
"Mogę zaoferować Ci sposób na zarobienie wystarczającej ilości pieniędzy..."

# game/UpdateScript0.09.rpy:5480 #-#-# translate crowdin cami_events_intro_d65ab0fd:
msgid "[_C_] That's what this is about! You're trying to turn me into a stripper like my sister."
msgstr "[_C_] O to właśnie chodzi!\n"
"Próbujesz mnie zmienić w striptizerkę jak moją siostrę."

# game/UpdateScript0.09.rpy:5481 #-#-# translate crowdin cami_events_intro_ce242892:
msgid "[_C_] Well, you can forget it!"
msgstr "[_C_] No cóż, możesz o tym zapomnieć!"

# game/UpdateScript0.09.rpy:5482 #-#-# translate crowdin cami_events_intro_04fdcb7b:
msgid "[_C_] I'll never work for you, and you can bet on that!"
msgstr "[_C_] Nigdy nie będę dla Ciebie pracować i możesz być o to spokojny!"

# game/UpdateScript0.09.rpy:5483 #-#-# translate crowdin cami_events_intro_45844a13:
msgid "[_J_] You'd be amazed how many of my employees have said that. In the end, they all found working for me preferable to the \"alternative\"."
msgstr "[_J_] Byłbyś zaskoczony, jak wielu moich pracowników to powiedziało.\n"
"Ostatecznie wszyscy uznali pracę dla mnie za lepszą od „alternatywy”."

# game/UpdateScript0.09.rpy:5484 #-#-# translate crowdin cami_events_intro_58ec583b:
msgid "[_R_] Whoa, there's no need for threats, Mr. DeCapo! My aunt's has had a lot to drink. She doesn't know what she's saying."
msgstr "[_R_] No cóż, nie ma potrzeby grozić, panie.\n"
"DeCapo!\n"
"Moja ciocia dużo wypiła.\n"
"Ona nie wie, co mówi."

# game/UpdateScript0.09.rpy:5485 #-#-# translate crowdin cami_events_intro_8bb33983:
msgid "[_R_] We can work something out here."
msgstr "[_R_] Możemy tutaj coś wymyślić."

# game/UpdateScript0.09.rpy:5488 #-#-# translate crowdin cami_events_intro_a8884214:
msgid "[_C_] Don't speak for me!"
msgstr "[_C_] Nie mów za mnie!"

# game/UpdateScript0.09.rpy:5489 #-#-# translate crowdin cami_events_intro_2fe00404:
msgid "[_C_] As far as I'm concerned, there's nothing to work out. You got your money back Joey. It's right there on your table."
msgstr "[_C_] Według mnie nie ma nad czym pracować.\n"
"Odzyskałeś pieniądze, Joey.\n"
