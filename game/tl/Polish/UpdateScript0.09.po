# game/UpdateScript0.09.rpy:5490 #-#-# translate crowdin cami_events_intro_85674604:
msgid "[_C_] Goodbye, Mr. DeCapo."
msgstr "[_C_] Do widzenia, Panie.\n"
"DeCapo."

# game/UpdateScript0.09.rpy:5491 #-#-# translate crowdin cami_events_intro_a4cb35fb:
msgid "[_C_] I'm going home to take a nice bath to forget all about tonight, and you."
msgstr "[_C_] Idę do domu, żeby wziąć miłą kąpiel i zapomnieć o dzisiejszym wieczorze i o Tobie."

# game/UpdateScript0.09.rpy:5499 #-#-# translate crowdin cami_events_intro_5170838f:
msgid "[_RT_] {i}Goddammit!{/i}"
msgstr "[_RT_] {i}Do cholery!{/i}"

# game/UpdateScript0.09.rpy:5500 #-#-# translate crowdin cami_events_intro_4685db1f:
msgid "[_RT_] {i}How stupid can she be?{/i}"
msgstr "[_RT_] {i}Jak głupia może być?{/i}"

# game/UpdateScript0.09.rpy:5501 #-#-# translate crowdin cami_events_intro_617ef5d9:
msgid "[_RT_] {i}Working as a stripper to pay the DeCapos back all that money wouldn't be the worst thing ever.{/i}"
msgstr "[_RT_] {i}Praca jako striptizerka, by spłacić DeCapos wszystkie te pieniądze, nie byłaby najgorszą rzeczą na świecie.{/i}"

# game/UpdateScript0.09.rpy:5502 #-#-# translate crowdin cami_events_intro_2b455b71:
msgid "[_RT_] {i}Hell, having to shake her tits and ass on stage might be good for that ego of hers.{/i}"
msgstr "[_RT_] {i}Do diabła, potrząsanie cyckami i tyłkiem na scenie może być dobre dla jej ego.{/i}"

# game/UpdateScript0.09.rpy:5503 #-#-# translate crowdin cami_events_intro_6e3eaa09:
msgid "[_RT_] {i}It's certainly better than what ever the \"alternative\" Joey DeCapo mentioned.{/i}"
msgstr "[_RT_] {i}Z pewnością jest lepsza niż ta „alternatywa”, o której wspominał Joey DeCapo.{/i}"

# game/UpdateScript0.09.rpy:5504 #-#-# translate crowdin cami_events_intro_63c4e501:
msgid "[_RT_] {i}But storming out, after telling him off like that? That has to be the most bone-headed thing she's ever done.{/i}"
msgstr "[_RT_] {i}Ale wybiec jak burza po tym, jak go tak zbeształ?\n"
