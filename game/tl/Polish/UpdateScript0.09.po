"Być może uda mi się jakoś odwrócić tę katastrofę.{/i}"

# game/UpdateScript0.09.rpy:5515 #-#-# translate crowdin cami_events_intro_eeba1944:
msgid "[_R_] Cami! Cami, wait!"
msgstr "[_R_] Cami!\n"
"Cami, czekaj!"

# game/UpdateScript0.09.rpy:5518 #-#-# translate crowdin cami_events_intro_774e49a4:
