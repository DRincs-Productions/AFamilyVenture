msgstr "{i}{b}„Poddanie cioci Camille = 0”{/b}{/i}"

# game/UpdateScript0.09.rpy:5446 #-#-# translate crowdin cami_events_intro_a7f1039d:
msgid "[_C_] Soon, I'll be drinking the best wines, and taking Mandy to get manny petties on the weekends..."
