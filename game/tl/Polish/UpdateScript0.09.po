# game/UpdateScript0.09.rpy:5461 #-#-# translate crowdin cami_events_intro_d9dcc9e3:
msgid "[_BJ_dealer_] Sorry, but a blackjack beats a twenty one. I'll need to take these chips Ma'am."
msgstr "[_BJ_dealer_] Przykro nam, ale blackjack przewyższa dwadzieścia jeden.\n"
"Muszę wziąć te żetony, proszę pani."

# game/UpdateScript0.09.rpy:5464 #-#-# translate crowdin cami_events_intro_3e8fee8a:
msgid "[_J_] Hello, Camille. Just checking in. Thought I'd bring you over another drink."
msgstr "[_J_] Witam, Camille.\n"
