# game/UpdateScript0.09.rpy:5506 #-#-# translate crowdin cami_events_intro_385ac909:
msgid "[_RT_] {i}I hate her guts right now, but she's still my aunt. Mandy would be devastated if anything happened to her mom.{/i}"
msgstr "[_RT_] {i}Nienawidzę teraz jej odwagi, ale nadal jest moją ciotką.\n"
