# game/UpdateScript0.09.rpy:5469 #-#-# translate crowdin cami_events_intro_bcfcd6dc:
msgid "[_J_] Well, no... The shoe has six decks in it."
msgstr "[_J_] No cóż, nie...\n"
"But ma sześć pokładów."

# game/UpdateScript0.09.rpy:5472 #-#-# translate crowdin cami_events_intro_9b9c6d76:
msgid "[_C_] You can't do that!"
msgstr "[_C_] Nie możesz tego zrobić!"

# game/UpdateScript0.09.rpy:5473 #-#-# translate crowdin cami_events_intro_3c2551b4:
msgid "[_R_] Hey, hey... calm down, Camille."
