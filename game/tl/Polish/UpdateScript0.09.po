# game/UpdateScript0.09.rpy:5443 #-#-# translate crowdin cami_events_intro_a56d0f26:
msgid "{i}{b}\"Aunt Camille's Respect = 0\"{/b}{/i}"
msgstr "{i}{b}„Szacunek cioci Camille = 0”{/b}{/i}"

# game/UpdateScript0.09.rpy:5444 #-#-# translate crowdin cami_events_intro_02d158d0:
msgid "[_C_] I can't believe I ever let you treat me like you have. Well, not anymore."
