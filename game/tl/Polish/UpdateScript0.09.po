# game/UpdateScript0.09.rpy:5615 #-#-# translate crowdin cami_events_intro_1c17a687:
msgid "[_C_] If I won big at the club, then I could pay it all off, and we'd all get our lives back."
msgstr "[_C_] Gdybym wygrał dużo w klubie, mógłbym to wszystko spłacić i wszyscy odzyskalibyśmy życie."

# game/UpdateScript0.09.rpy:5616 #-#-# translate crowdin cami_events_intro_c0b5c051:
msgid "[_R_] Bullshit!"
