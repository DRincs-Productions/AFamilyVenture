# game/UpdateScript0.04.rpy:1501 #-#-# translate crowdin hire_a_maid_32c0fabe:
msgid "[_M_] She has no idea how hard being in the actual workforce actually is."
msgstr "[_M_] Nie ma pojęcia, jak trudno jest pracować na prawdziwym rynku pracy."

# game/UpdateScript0.04.rpy:1502 #-#-# translate crowdin hire_a_maid_039ff579:
