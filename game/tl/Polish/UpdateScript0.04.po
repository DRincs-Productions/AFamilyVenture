msgstr "[_R_] Wiesz... jakiś seksowny strój pokojówki czy coś?"

# game/UpdateScript0.04.rpy:1513 #-#-# translate crowdin hire_a_maid_ecb5dd7a:
msgid "[_M_] A sexy maid outfit?.... Yes!!.... Brilliant idea!..."
msgstr "[_M_] Seksowny strój pokojówki?.... Tak!!.... Genialny pomysł!..."

# game/UpdateScript0.04.rpy:1514 #-#-# translate crowdin hire_a_maid_7d03c7cc:
