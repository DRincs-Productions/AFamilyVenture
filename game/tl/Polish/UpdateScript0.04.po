# game/UpdateScript0.04.rpy:1509 #-#-# translate crowdin hire_a_maid_184e2b40:
msgid "[_RT_] {i}Oh my God!!.... Is she deliberately setting me up here?.... Is this a test.... well, nothing ventured, and all that.... {/i}"
msgstr "[_RT_] {i}O mój Boże!!.... Czy ona celowo mnie tu wystawia?.... Czy to test... cóż, nic nie odważyło się i tak dalej.... {/i}"

# game/UpdateScript0.04.rpy:1510 #-#-# translate crowdin hire_a_maid_812d5688:
msgid "[_R_] Ummmm.... we could make her wear a uniform to clean the house."
