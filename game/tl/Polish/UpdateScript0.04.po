# game/UpdateScript0.04.rpy:1505 #-#-# translate crowdin hire_a_maid_77d7d5d5:
msgid "[_R_] Ok.... I'll see what I can think up..."
msgstr "[_R_] OK.... Zobaczę, co uda mi się wymyślić..."

# game/UpdateScript0.04.rpy:1506 #-#-# translate crowdin hire_a_maid_f96919db:
msgid "[_R_] {i}Oh, I can't believe Mom is giving me permission to try to humiliate my own aunt!{/i}"
