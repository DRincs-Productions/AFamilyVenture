msgstr "[_R_] Co?"

# game/UpdateScript0.08_2.rpy:5231 #-#-# translate crowdin prison_visit_ed68ab13:
msgid "[_UG_] To drink, which one do you want?"
msgstr "[_UG_] Do picia, jakiego chcesz?"

# game/UpdateScript0.08_2.rpy:5232 #-#-# translate crowdin prison_visit_de85a681:
msgid "[_R_] Oh, uhh... I guess I'll take the Cola... Thanks!"
msgstr "[_R_] Och, uhh... Chyba wezmę Colę... Dzięki!"

# game/UpdateScript0.08_2.rpy:5237 #-#-# translate crowdin prison_visit_3ed3a20f:
msgid "[_UG_] My name's Breanne, by the way."
msgstr "[_UG_] Nawiasem mówiąc, mam na imię Breanne."

# game/UpdateScript0.08_2.rpy:5238 #-#-# translate crowdin prison_visit_aa6f965c:
msgid "[_R_] Oh... That's a nice name... I'm [ryan]."
msgstr "[_R_] Och... Ładne imię... Jestem [ryan]."

# game/UpdateScript0.08_2.rpy:5239 #-#-# translate crowdin prison_visit_f7a407eb:
msgid "[_R_] Thanks again for the soda."
msgstr "[_R_] Jeszcze raz dziękuję za napój gazowany."

# game/UpdateScript0.08_2.rpy:5240 #-#-# translate crowdin prison_visit_6410ecc8:
msgid "[_BA_] Sure... What you in for?"
msgstr "[_BA_] Jasne... Po co to robisz?"

# game/UpdateScript0.08_2.rpy:5241 #-#-# translate crowdin prison_visit_bcab9ca2:
msgid "[_R_] Just visiting my dad."
msgstr "[_R_] Odwiedzam tylko mojego tatę."

# game/UpdateScript0.08_2.rpy:5242 #-#-# translate crowdin prison_visit_db3a479e:
msgid "[_R_] How bout you?"
msgstr "[_R_] Co u Ciebie?"

# game/UpdateScript0.08_2.rpy:5243 #-#-# translate crowdin prison_visit_b17075b6:
msgid "[_BA_] Visiting Dad as well."
msgstr "[_BA_] Odwiedziny także u taty."

# game/UpdateScript0.08_2.rpy:5244 #-#-# translate crowdin prison_visit_13a3c2f7:
msgid "[_BA_] Why's yours in prison?"
msgstr "[_BA_] Dlaczego twój jest w więzieniu?"

# game/UpdateScript0.08_2.rpy:5247 #-#-# translate crowdin prison_visit_01c6b786:
msgid "[_R_] Cuz the fucking idiot thought it would be a good idea to do business with the Mafia."
msgstr "[_R_] Bo ten pieprzony idiota pomyślał, że dobrym pomysłem będzie robienie interesów z mafią."

# game/UpdateScript0.08_2.rpy:5250 #-#-# translate crowdin prison_visit_d9479350:
msgid "[_R_] Then he got himself caught."
msgstr "[_R_] Potem dał się złapać."

# game/UpdateScript0.08_2.rpy:5251 #-#-# translate crowdin prison_visit_4d0df506:
msgid "[_BA_] Really? Which family?"
msgstr "[_BA_] Naprawdę?\n"
"Która rodzina?"

# game/UpdateScript0.08_2.rpy:5252 #-#-# translate crowdin prison_visit_3d9d4f3e:
msgid "[_R_] Uhh... The DeCapos... why?"
msgstr "[_R_] Uhh... DeCapos... dlaczego?"

# game/UpdateScript0.08_2.rpy:5253 #-#-# translate crowdin prison_visit_070b606e:
msgid "[_BA_] Well, then we're practically siblings."
msgstr "[_BA_] No cóż, w takim razie jesteśmy praktycznie rodzeństwem."

# game/UpdateScript0.08_2.rpy:5254 #-#-# translate crowdin prison_visit_94af0bea:
msgid "[_BA_] My dad worked for the DeCapos too... that is, before he stole money from them and went into hiding."
msgstr "[_BA_] Mój tata też pracował dla DeCaposów… to znaczy zanim ukradł im pieniądze i zaczął się ukrywać."

# game/UpdateScript0.08_2.rpy:5255 #-#-# translate crowdin prison_visit_c2523f6b:
msgid "[_R_] Oh, wow!... He's lucky to be alive."
msgstr "[_R_] Och, wow!... Ma szczęście, że żyje."

# game/UpdateScript0.08_2.rpy:5258 #-#-# translate crowdin prison_visit_6b33e6ec:
msgid "[_BA_] Yeah, some punk ass kid who didn't know how to mind his own business ratted him out for no reason... Just to be a dick."
msgstr "[_BA_] Tak, jakiś punkowy dzieciak, który nie wiedział, jak zająć się swoimi sprawami, wyrzucił go bez powodu... Tylko po to, żeby być kutasem."

# game/UpdateScript0.08_2.rpy:5261 #-#-# translate crowdin prison_visit_bee63e27:
msgid "[_BA_] So, now I'm devising a plan with my dad on how we can bring that stupid mother fucker down."
msgstr "[_BA_] Teraz obmyślam z tatą plan, jak pokonać tego głupiego skurwiela."

# game/UpdateScript0.08_2.rpy:5262 #-#-# translate crowdin prison_visit_8a4303ce:
msgid "[_BA_] And when I say mother fucker... I mean he's literally fucking his mom!"
msgstr "[_BA_] A kiedy mówię skurwielu... mam na myśli, że on dosłownie pieprzy swoją mamę!"

# game/UpdateScript0.08_2.rpy:5268 #-#-# translate crowdin prison_visit_ea2a7b2a:
msgid "[_BA_] Yeah... Fucking pervert!"
msgstr "[_BA_] Tak... Pieprzony zboczeniec!"

# game/UpdateScript0.08_2.rpy:5269 #-#-# translate crowdin prison_visit_fe3a7601:
msgid "[_R_] Well, maybe his mom was a really beautiful and awesome woman."
msgstr "[_R_] Cóż, może jego mama była naprawdę piękną i niesamowitą kobietą."

# game/UpdateScript0.08_2.rpy:5270 #-#-# translate crowdin prison_visit_5a9234cb:
msgid "[_BA_] My dad worked with her, said she wasn't that great."
msgstr "[_BA_] Mój tata z nią pracował, powiedział, że nie jest taka świetna."

# game/UpdateScript0.08_2.rpy:5271 #-#-# translate crowdin prison_visit_17eaedc9:
msgid "[_BA_] Besides, even if she was, who fucks their own mother?"
msgstr "[_BA_] Poza tym nawet gdyby była, to kto pieprzy własną matkę?"

# game/UpdateScript0.08_2.rpy:5277 #-#-# translate crowdin prison_visit_a4bd062f:
msgid "[_R_] Yeah... That's... I know I wouldn't do that."
msgstr "[_R_] Tak... To jest... Wiem, że bym tego nie zrobił."

# game/UpdateScript0.08_2.rpy:5278 #-#-# translate crowdin prison_visit_b59e3d24:
msgid "[_BA_] Right?"
msgstr "[_BA_] Zgadzasz się?"

# game/UpdateScript0.08_2.rpy:5281 #-#-# translate crowdin prison_visit_66164e55:
msgid "{i}\"Meanwhile\"{/i}"
msgstr "{i}„Tymczasem”{/i}"

# game/UpdateScript0.08_2.rpy:5287 #-#-# translate crowdin prison_visit_cd789dc7:
msgid "[_PG_] Right this way, Ma'am."
msgstr "[_PG_] Tędy, proszę pani."

# game/UpdateScript0.08_2.rpy:5288 #-#-# translate crowdin prison_visit_aed70a7c:
msgid "[_PG_] Go to booth seven... It's the second to last."
msgstr "[_PG_] Idź do stoiska numer siedem... To przedostatnie."

# game/UpdateScript0.08_2.rpy:5300 #-#-# translate crowdin prison_visit_f9dc1820:
msgid "[_ER_] God!... You must be [mom_name]. You're even more beautiful in person."
msgstr "[_ER_] Boże!... Musisz być [mom_name]. Na żywo jesteś jeszcze piękniejsza."

# game/UpdateScript0.08_2.rpy:5301 #-#-# translate crowdin prison_visit_ff4c73d0:
msgid "[_MT_] {i}Why does that man look familiar?{/i}"
msgstr "[_MT_] {i}Dlaczego ten mężczyzna wygląda znajomo?{/i}"

# game/UpdateScript0.08_2.rpy:5302 #-#-# translate crowdin prison_visit_2b0bbaa6:
msgid "[_MT_] {i}Like, a face I've seen in one of those games I played recently.{/i}"
msgstr "[_MT_] {i}Na przykład twarz, którą widziałem w jednej z gier, w które ostatnio grałem.{/i}"

# game/UpdateScript0.08_2.rpy:5305 #-#-# translate crowdin prison_visit_b32ba459:
msgid "[_ER_] Hold still."
msgstr "[_ER_] Nie ruszaj się."

# game/UpdateScript0.08_2.rpy:5308 #-#-# translate crowdin prison_visit_9dcda4e4:
msgid "[_ER_] Got it!"
msgstr "[_ER_] Rozumiem!"

# game/UpdateScript0.08_2.rpy:5309 #-#-# translate crowdin prison_visit_c047fbbb:
msgid "[_M_] Did you just take a picture of me?"
msgstr "[_M_] Czy właśnie zrobiłeś mi zdjęcie?"

# game/UpdateScript0.08_2.rpy:5310 #-#-# translate crowdin prison_visit_286ce3e4:
msgid "[_ER_] Oh yeah... And it's going to keep me warm tonight."
