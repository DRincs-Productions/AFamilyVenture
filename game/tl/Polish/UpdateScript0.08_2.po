# game/UpdateScript0.08_2.rpy:35 #-#-# translate crowdin mom_bumps_sidney_4855b389:
msgid "[_S_] Just like you said."
msgstr "[_S_] Tak jak powiedziałeś."

# game/UpdateScript0.08_2.rpy:38 #-#-# translate crowdin mom_bumps_sidney_60220ee0:
msgid "[_A_] Flirt just enough to get a good tip, but not so much that he grabs your tit."
