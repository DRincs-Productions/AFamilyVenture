# game/UpdateScript0.08_2.rpy:7706 #-#-# translate crowdin weekend_date_shopping_continued_a69b8ec8:
msgid "[_RT_] {i}And according to my new philosophy on life, when opportunity knocks, I'm going to answer.{/i}"
