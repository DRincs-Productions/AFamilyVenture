# game/UpdateScript0.08_2.rpy:6397 #-#-# translate crowdin weekend_date_shopping_74e5d6ff_1:
msgid "[_MT_] {i}Ugghhh... I was worried they'd say something... I'm so embarrassed.{/i}"
msgstr "[_MT_] {i}Ugghhh... Bałam się, że coś powiedzą... Tak mi wstyd.{/i}"

# game/UpdateScript0.08_2.rpy:6404 #-#-# translate crowdin weekend_date_shopping_791eddba_1:
msgid "[_X_] You two make such a cute couple. Let me know if I can help you find anything."
msgstr "[_X_] Wy dwoje tworzycie taką uroczą parę.\n"
"Daj mi znać, jeśli będę mógł pomóc Ci coś znaleźć."

# game/UpdateScript0.08_2.rpy:6405 #-#-# translate crowdin weekend_date_shopping_c529e626_1:
