msgstr "[_M_] Do zobaczenia wkrótce."

# game/UpdateScript0.08_2.rpy:5212 #-#-# translate crowdin prison_visit_a2ddc80f:
msgid "[_RT_] {i}Ugghhh... No remote. Looks like I'm stuck watching two teams I know nothing about play soccer.{/i}"
msgstr "[_RT_] {i}Ugghhh... Brak pilota.\n"
"Wygląda na to, że utknąłem, obserwując dwie drużyny, które nie mają pojęcia o grze w piłkę nożną.{/i}"

# game/UpdateScript0.08_2.rpy:5213 #-#-# translate crowdin prison_visit_2c7f6957:
msgid "[_RT_] {i}Could this day get any worse?{/i}"
msgstr "[_RT_] {i}Czy ten dzień może być jeszcze gorszy?{/i}"

# game/UpdateScript0.08_2.rpy:5216 #-#-# translate crowdin prison_visit_3e860fc4:
