# TODO: Translation updated at 2024-07-23 08:27 #|#|# # game/UpdateScript0.08_2.rpy:9 #-#-# translate crowdin mom_bumps_sidney_bc054bd6:
msgid "[_G_] Well, if it isn't the lovely Miss [mom_name]."
msgstr "[_G_] No cóż, gdyby nie urocza Panna [mom_name]."

# game/UpdateScript0.08_2.rpy:10 #-#-# translate crowdin mom_bumps_sidney_66320591:
msgid "[_G_] Funny seeing you here on a Monday night... And at your own free will, to boot."
msgstr "[_G_] Zabawnie cię tu widzieć w poniedziałkowy wieczór... I na dodatek z własnej woli."

# game/UpdateScript0.08_2.rpy:11 #-#-# translate crowdin mom_bumps_sidney_0f4894df:
msgid "[_M_] I've got an important message I'm supposed to deliver to Joey's hands only... Is he here in the club?"
msgstr "[_M_] Mam ważną wiadomość, którą mam dostarczyć tylko do rąk Joey’a.. Czy on jest tutaj, w klubie?"

# game/UpdateScript0.08_2.rpy:12 #-#-# translate crowdin mom_bumps_sidney_349d1fec:
msgid "[_G_] Sure thing. He's actually been expecting a visit from you. He's in his office. Past the stage, down the hall, third door on the left."
msgstr "[_G_] Jasne. Właściwie to już czekał na twoją wizytę. Jest w swoim gabinecie. Za sceną, na końcu korytarza, trzecie drzwi po lewej stronie."

# game/UpdateScript0.08_2.rpy:13 #-#-# translate crowdin mom_bumps_sidney_1dc55007:
msgid "[_MT_] {i}Fucking [dad_name]!... Making me be his delivery girl!... I hate coming to this place!{/i}"
msgstr "[_MT_] {i}Kurwa [dad_name]!... Sprawiasz, że jestem jego dostawcą!... Nienawidzę przychodzić do tego miejsca!{/i}"

# game/UpdateScript0.08_2.rpy:14 #-#-# translate crowdin mom_bumps_sidney_6406a5fc:
msgid "[_MT_] {i}I wish I'd brought [ryan] with me.{/i}"
msgstr "[_MT_] {i}Szkoda, że ​​nie zabrałem ze sobą [ryan] .{/i}"

# game/UpdateScript0.08_2.rpy:15 #-#-# translate crowdin mom_bumps_sidney_d3664a49:
msgid "[_MT_] {i}However; I don't think Joey would have liked that.{/i}"
msgstr "[_MT_] {i}Jednakże;\n"
"Nie sądzę, żeby Joeyowi spodobało się to.{/i}"

# game/UpdateScript0.08_2.rpy:22 #-#-# translate crowdin mom_bumps_sidney_9d6c2467:
msgid "[_A_] Be careful in the lounge area, Senator McFeely is extra grabby tonight."
