"Idę spróbować."

# game/UpdateScript0.08_2.rpy:7702 #-#-# translate crowdin weekend_date_shopping_continued_4a46cae9:
msgid "[_RT_] {i}I'm so glad I was able to make Mom happy today!{/i}"
