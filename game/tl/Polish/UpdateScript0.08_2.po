# game/UpdateScript0.08_2.rpy:134 #-#-# translate crowdin mom_bumps_sidney_f1074d7d:
msgid "[_MT_] {i}Oh, God... What do I do?{/i}"
msgstr "[_MT_] {i}O Boże... Co mam zrobić?{/i}"

# game/UpdateScript0.08_2.rpy:136 #-#-# translate crowdin mom_bumps_sidney_8115025d:
msgid "[_M_] I'm not having sex with you... But there's other things I'd be willing to do."
msgstr "[_M_] Nie będę uprawiać z tobą seksu... Ale są inne rzeczy, które chętnie zrobię."

# game/UpdateScript0.08_2.rpy:137 #-#-# translate crowdin mom_bumps_sidney_f30e4e00:
