msgid "[_D_] That's just Eric... He's not so bad."
msgstr "[_D_] To tylko Eric... Nie jest taki zły."

# game/UpdateScript0.08_2.rpy:5323 #-#-# translate crowdin prison_visit_00246dc9:
msgid "[_M_] [dad_name]!"
msgstr "[_M_] [dad_name]!"

# game/UpdateScript0.08_2.rpy:5324 #-#-# translate crowdin prison_visit_3af7a138:
msgid "[_M_] It's so good to see you!"
msgstr "[_M_] Tak się cieszę, że cię widzę!"

# game/UpdateScript0.08_2.rpy:5330 #-#-# translate crowdin prison_visit_cef35593:
msgid "[_PG_] Alright, [dad_name]."
msgstr "[_PG_] OK, [dad_name]."

# game/UpdateScript0.08_2.rpy:5331 #-#-# translate crowdin prison_visit_20fa1a1c:
