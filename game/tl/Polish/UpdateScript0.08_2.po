# game/UpdateScript0.08_2.rpy:1048 #-#-# translate crowdin vip_access_ed453c65:
msgid "[_RV_] Can I start you off with a drink?"
msgstr "[_RV_] Czy mogę zacząć od drinka?"

# game/UpdateScript0.08_2.rpy:1049 #-#-# translate crowdin vip_access_06db211e:
msgid "[_RV_] Maybe you'd enjoy some mood altering substances?"
