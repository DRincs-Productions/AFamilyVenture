# game/UpdateScript0.08_2.rpy:6333 #-#-# translate crowdin weekend_date_shopping_6fd0126b:
msgid "[_R_] What!?"
msgstr "[_R_] Co!?"

# game/UpdateScript0.08_2.rpy:6334 #-#-# translate crowdin weekend_date_shopping_d4aa34d7:
msgid "[_R_] I haven't bought you any lingerie yet."
msgstr "[_R_] Nie kupiłam Ci jeszcze bielizny."

# game/UpdateScript0.08_2.rpy:6337 #-#-# translate crowdin weekend_date_shopping_7fe97c55:
msgid "[_M_] You know that you don't have to buy me lingerie every time we come here, don't you?"
msgstr "[_M_] Wiesz, że nie musisz kupować mi bielizny za każdym razem, gdy tu przychodzimy, prawda?"

# game/UpdateScript0.08_2.rpy:6338 #-#-# translate crowdin weekend_date_shopping_aaa2c7e1:
msgid "[_R_] Of course, I know that. But I still want to."
msgstr "[_R_] Oczywiście, że to wiem.\n"
"Ale nadal chcę."

# game/UpdateScript0.08_2.rpy:6339 #-#-# translate crowdin weekend_date_shopping_8ea4e6b9:
msgid "[_M_] I don't even have anyone to wear this for."
msgstr "[_M_] Nawet nie mam dla kogo tego nosić."

# game/UpdateScript0.08_2.rpy:6340 #-#-# translate crowdin weekend_date_shopping_74810515:
msgid "[_R_] You can always wear it for me."
msgstr "[_R_] Zawsze możesz to dla mnie założyć."

# game/UpdateScript0.08_2.rpy:6341 #-#-# translate crowdin weekend_date_shopping_23e420e6:
msgid "[_M_] [ryan]!..."
msgstr "[_M_] [ryan]!..."

# game/UpdateScript0.08_2.rpy:6342 #-#-# translate crowdin weekend_date_shopping_c852f111:
msgid "[_R_] Let's go pick one out."
msgstr "[_R_] Wybierzmy jedno."

# game/UpdateScript0.08_2.rpy:6349 #-#-# translate crowdin weekend_date_shopping_a9fad4b4:
msgid "[_M_] They're all very lovely!"
msgstr "[_M_] Wszystkie są bardzo urocze!"

# game/UpdateScript0.08_2.rpy:6350 #-#-# translate crowdin weekend_date_shopping_2d84cf69:
msgid "[_M_] Once again, since you're buying, I'll let you choose one."
msgstr "[_M_] Po raz kolejny, skoro już kupujesz, pozwolę ci wybrać jeden."

# game/UpdateScript0.08_2.rpy:6351 #-#-# translate crowdin weekend_date_shopping_0e575052:
msgid "[_R_] Again?... Only one!?"
msgstr "[_R_] Znowu?... Tylko jeden!?"

# game/UpdateScript0.08_2.rpy:6352 #-#-# translate crowdin weekend_date_shopping_8f98b13f:
msgid "[_M_] Yes! I'm not your personal model, thank you."
msgstr "[_M_] Tak!\n"
"Nie jestem twoim osobistym modelem, dziękuję."

# game/UpdateScript0.08_2.rpy:6353 #-#-# translate crowdin weekend_date_shopping_ad0afef1:
msgid "[_R_] Well, you actually are, because I'm the only photo studio who's done any sets with you."
msgstr "[_R_] No cóż, rzeczywiście tak jest, ponieważ jestem jedynym studiem fotograficznym, które wykonywało z Tobą jakiekolwiek plany zdjęciowe."

# game/UpdateScript0.08_2.rpy:6354 #-#-# translate crowdin weekend_date_shopping_cd3a8a89:
msgid "[_M_] This is not a negotiation!"
msgstr "[_M_] To nie są negocjacje!"

# game/UpdateScript0.08_2.rpy:6355 #-#-# translate crowdin weekend_date_shopping_308c8bd3:
msgid "[_R_] Fine. I'll settle on one if you'll do some modeling poses too."
msgstr "[_R_] Dobrze.\n"
"Zdecyduję się na jedną, jeśli zrobisz też kilka pozycji modelki."

# game/UpdateScript0.08_2.rpy:6356 #-#-# translate crowdin weekend_date_shopping_4eb71a06:
msgid "[_M_] Well, I'll admit I had fun doing that last time. Hopefully the large dressing room is available again."
msgstr "[_M_] Przyznam, że ostatnim razem dobrze się przy tym bawiłem.\n"
"Mam nadzieję, że duża garderoba będzie ponownie dostępna."

# game/UpdateScript0.08_2.rpy:6359 #-#-# translate crowdin weekend_date_shopping_62b36bc8:
msgid "[_M_] So, which one are you going to choose?"
msgstr "[_M_] To który z nich wybierzesz?"

# game/UpdateScript0.08_2.rpy:6365 #-#-# translate crowdin weekend_date_shopping_3b0e78e0:
msgid "[_M_] So, What are the plans for our date?"
msgstr "[_M_] Więc jakie mamy plany na naszą randkę?"

# game/UpdateScript0.08_2.rpy:6366 #-#-# translate crowdin weekend_date_shopping_8112025f:
msgid "[_R_] Well... I was thinking that we should get the worst part over with first."
msgstr "[_R_] Cóż... Pomyślałem, że najpierw powinniśmy mieć za sobą najgorszą część."

# game/UpdateScript0.08_2.rpy:6369 #-#-# translate crowdin weekend_date_shopping_98349f67:
msgid "[_M_] Oh, you still hate shopping?"
msgstr "[_M_] Och, nadal nienawidzisz zakupów?"

# game/UpdateScript0.08_2.rpy:6370 #-#-# translate crowdin weekend_date_shopping_837dc3cb:
msgid "[_R_] I didn't say I hated it, but it's definitely the part of the date I'm least looking forward to."
msgstr "[_R_] Nie powiedziałem, że tego nienawidzę, ale zdecydowanie tej części randki nie mogę się doczekać najmniej."

# game/UpdateScript0.08_2.rpy:6373 #-#-# translate crowdin weekend_date_shopping_5d123c4d:
msgid "[_R_] We'll get some dinner after, and then... If we're up for it. I was thinking we could do something a bit more... adventurous."
msgstr "[_R_] Potem zjemy kolację, a potem... Jeśli mamy na to ochotę.\n"
"Pomyślałem, że moglibyśmy zrobić coś bardziej... pełnego przygód."

# game/UpdateScript0.08_2.rpy:6374 #-#-# translate crowdin weekend_date_shopping_f22dbd7f_1:
msgid "[_M_] Oh? And what, pray tell, do you mean by adventurous?"
msgstr "[_M_] Och?\n"
"A co, powiedz proszę, przez przygodę?"

# game/UpdateScript0.08_2.rpy:6375 #-#-# translate crowdin weekend_date_shopping_828941e4_1:
msgid "[_R_] That's a surprise... You'll have to wait and see."
msgstr "[_R_] To niespodzianka... Będziesz musiał poczekać i zobaczyć."

# game/UpdateScript0.08_2.rpy:6376 #-#-# translate crowdin weekend_date_shopping_9eebceaa_1:
msgid "[_M_] Hmm... How mysterious!... I can't wait!"
