# game/UpdateScript0.08_2.rpy:7685 #-#-# translate crowdin weekend_date_shopping_continued_8f003d7c:
msgid "[_M_] We rushed our wedding since I was pregnant with Sidney, and our Catholic parents didn't want their friends talking."
