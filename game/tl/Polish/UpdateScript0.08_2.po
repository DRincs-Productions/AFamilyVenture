msgstr "[_RT_] {i}Ona tu podchodzi!... Co mam zrobić?{/i}"

# game/UpdateScript0.08_2.rpy:5227 #-#-# translate crowdin prison_visit_9fc9a438:
msgid "[_UG_] Cola Cola, or Mounted Spew?"
msgstr "[_UG_] Cola Cola czy rzygacz konny?"

# game/UpdateScript0.08_2.rpy:5228 #-#-# translate crowdin prison_visit_4881927b:
