msgstr "[_J_] Ahhh... Urocza Pani [mom_name]!"

# game/UpdateScript0.08_2.rpy:53 #-#-# translate crowdin mom_bumps_sidney_c69c961b:
msgid "[_J_] I've been expecting you."
msgstr "[_J_] Spodziewałem się ciebie."

# game/UpdateScript0.08_2.rpy:54 #-#-# translate crowdin mom_bumps_sidney_02206088:
msgid "[_J_] Please, come in and sit down."
msgstr "[_J_] Proszę wejść i usiąść."

# game/UpdateScript0.08_2.rpy:57 #-#-# translate crowdin mom_bumps_sidney_9f6fc4a4:
msgid "[_J_] I take it you've brought me the important note from your husband in prison?"
msgstr "[_J_] Rozumiem, że przyniosłaś mi ważną notatkę od swojego męża przebywającego w więzieniu?"

# game/UpdateScript0.08_2.rpy:58 #-#-# translate crowdin mom_bumps_sidney_0febadfa:
msgid "[_M_] Yes, it's right here in my pocket."
msgstr "[_M_] Tak, mam go tutaj, w kieszeni."

# game/UpdateScript0.08_2.rpy:59 #-#-# translate crowdin mom_bumps_sidney_15c77084:
msgid "[_J_] Please, hand it over."
msgstr "[_J_] Proszę, oddaj to."

# game/UpdateScript0.08_2.rpy:64 #-#-# translate crowdin mom_bumps_sidney_cfa910c4:
msgid "[_J_] Thank you... I'll rest much easier now that I've got that information."
msgstr "[_J_] Dziękuję... Teraz, gdy mam te informacje, będę znacznie łatwiejszy."

# game/UpdateScript0.08_2.rpy:65 #-#-# translate crowdin mom_bumps_sidney_8e5555e3:
msgid "[_J_] Did you try to read it?"
msgstr "[_J_] Próbowałeś to przeczytać?"

# game/UpdateScript0.08_2.rpy:68 #-#-# translate crowdin mom_bumps_sidney_ae9b6a9f:
msgid "[_M_] What would I get out of reading a coded message?"
