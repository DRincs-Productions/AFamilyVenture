# game/UpdateScript0.08_2.rpy:11601 #-#-# translate crowdin sushi_date_ryan_5f6f87bd_1:
msgid "[_M_] Good, right?"
msgstr "[_M_] Dobre, prawda?"

# game/UpdateScript0.08_2.rpy:11602 #-#-# translate crowdin sushi_date_ryan_5420d556_1:
