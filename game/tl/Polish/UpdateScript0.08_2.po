# game/UpdateScript0.08_2.rpy:24 #-#-# translate crowdin mom_bumps_sidney_43e761cc:
msgid "[_S_] Are there any more beers, or do I need to go grab some in storage?"
msgstr "[_S_] Czy jest jeszcze jakieś piwo, czy muszę je kupić w magazynie?"

# game/UpdateScript0.08_2.rpy:25 #-#-# translate crowdin mom_bumps_sidney_673c1109:
msgid "[_A_] Check the bottom shelf."
