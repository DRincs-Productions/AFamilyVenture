# game/UpdateScript0.08_2.rpy:6298 #-#-# translate crowdin weekend_date_shopping_9d7aeb3c:
msgid "[_R_] Yeah, you know, we had such a great time last time we were here, and that lingerie looked so good, that we decided to come back again this week."
msgstr "[_R_] Tak, wiesz, świetnie się bawiliśmy, kiedy tu byliśmy ostatnim razem, a ta bielizna wyglądała tak dobrze, że postanowiliśmy wrócić tu ponownie w tym tygodniu."

# game/UpdateScript0.08_2.rpy:6299 #-#-# translate crowdin weekend_date_shopping_7ccdbba8:
msgid "[_AG_] Well, I'm so glad you had such a good experience."
msgstr "[_AG_] Cóż, cieszę się, że masz tak dobre doświadczenia."

# game/UpdateScript0.08_2.rpy:6300 #-#-# translate crowdin weekend_date_shopping_5d25d352:
msgid "[_AG_] Let me know if I can help with anything."
