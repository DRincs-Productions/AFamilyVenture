msgstr "[_M_] Bądź grzeczny, kiedy mnie nie będzie."

# game/UpdateScript0.08_2.rpy:5197 #-#-# translate crowdin prison_visit_94797697:
msgid "[_R_] I'm in a prison. What trouble could I get into?"
msgstr "[_R_] Jestem w więzieniu.\n"
"W jakie kłopoty mogę się wpakować?"

# game/UpdateScript0.08_2.rpy:5198 #-#-# translate crowdin prison_visit_5ae8f7c8:
msgid "[_M_] Haha... Good point."
msgstr "[_M_] Haha... Dobra uwaga."

# game/UpdateScript0.08_2.rpy:5199 #-#-# translate crowdin prison_visit_68ac2925:
msgid "[_R_] Ohhh... This is going to be so boring."
msgstr "[_R_] Och... To będzie strasznie nudne."

# game/UpdateScript0.08_2.rpy:5200 #-#-# translate crowdin prison_visit_18db230f:
msgid "[_M_] I see there's a TV over there, you like watching sports, right?"
msgstr "[_M_] Widzę, że tam jest telewizor. Lubisz oglądać sport, prawda?"

# game/UpdateScript0.08_2.rpy:5201 #-#-# translate crowdin prison_visit_d8ef6eac:
msgid "[_R_] If there's nothing else on."
msgstr "[_R_] Jeśli nie ma nic więcej."

# game/UpdateScript0.08_2.rpy:5202 #-#-# translate crowdin prison_visit_14010d02:
msgid "[_M_] Well, maybe you can find the remote... I've got to go. Good luck!"
msgstr "[_M_] No cóż, może znajdziesz pilota... Muszę lecieć.\n"
"Powodzenia!"

# game/UpdateScript0.08_2.rpy:5203 #-#-# translate crowdin prison_visit_149cec79:
msgid "[_R_] You too."
msgstr "[_R_] Ty też."

# game/UpdateScript0.08_2.rpy:5204 #-#-# translate crowdin prison_visit_3bc357c1:
