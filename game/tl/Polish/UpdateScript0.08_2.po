# game/UpdateScript0.08_2.rpy:142 #-#-# translate crowdin mom_bumps_sidney_8418c5c9:
msgid "[_J_] Mmmmm... That's what I like to hear."
msgstr "[_J_] Mmmmm... Właśnie to lubię słyszeć."

# game/UpdateScript0.08_2.rpy:145 #-#-# translate crowdin mom_bumps_sidney_4e4b5013:
