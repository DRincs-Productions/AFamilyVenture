# game/UpdateScript0.08_2.rpy:7619 #-#-# translate crowdin weekend_date_shopping_continued_41432102:
msgid "[_AG_] Since your son was so polite to me, even when I wasn't very kind to him, I'd like to make it up by letting you use this special dressing room for free."
msgstr "[_AG_] Skoro Twój syn był dla mnie taki uprzejmy, nawet gdy ja nie byłam dla niego zbyt miła, chcę to wynagrodzić, udostępniając Ci tę specjalną garderobę za darmo."

# game/UpdateScript0.08_2.rpy:7620 #-#-# translate crowdin weekend_date_shopping_continued_7db8d8cf:
msgid "[_M_] Wow, really!?"
msgstr "[_M_] Wow, naprawdę!?"

# game/UpdateScript0.08_2.rpy:7621 #-#-# translate crowdin weekend_date_shopping_continued_058b9eb2:
msgid "[_M_] That's so nice!"
