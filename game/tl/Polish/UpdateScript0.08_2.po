# game/UpdateScript0.08_2.rpy:5223 #-#-# translate crowdin prison_visit_7e52acd8:
msgid "[_RT_] {i}Oh shit!... She caught me staring!{/i}"
msgstr "[_RT_] {i}O cholera!... Przyłapała mnie na gapieniu się!{/i}"

# game/UpdateScript0.08_2.rpy:5224 #-#-# translate crowdin prison_visit_20c2b799:
