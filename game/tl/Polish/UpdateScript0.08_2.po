# game/UpdateScript0.08_2.rpy:7703 #-#-# translate crowdin weekend_date_shopping_continued_8b9c2b45_1:
msgid "[_RT_] {i}Sometimes it feels really good to do something for someone other than myself.{/i}"
msgstr "[_RT_] {i}Czasami naprawdę dobrze jest zrobić coś dla kogoś innego niż dla siebie.{/i}"

# game/UpdateScript0.08_2.rpy:7704 #-#-# translate crowdin weekend_date_shopping_continued_7723898d:
msgid "[_RT_] {i}Speaking of which, I think it's time to do something for myself.{/i}"
