msgid "[_R_] You know, let you in free, and then you can't really do anything unless you buy it."
msgstr "[_R_] Wiesz, wpuszczę cię za darmo i wtedy tak naprawdę nie będziesz mógł nic zrobić, chyba że to kupisz."

# game/UpdateScript0.08_2.rpy:1074 #-#-# translate crowdin vip_access_8105a278:
msgid "[_RV_] That's called life, Dear."
msgstr "[_RV_] To się nazywa życie, kochanie."

# game/UpdateScript0.08_2.rpy:1075 #-#-# translate crowdin vip_access_78ede992:
msgid "[_RV_] Most of us working in here, have tons of money that we, or our families, owe to the Mafia."
