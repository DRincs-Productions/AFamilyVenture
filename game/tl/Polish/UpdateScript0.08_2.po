# game/UpdateScript0.08_2.rpy:1044 #-#-# translate crowdin vip_access_343162f7:
msgid "[_RV_] Welcome to the VIP room King [ryan]"
msgstr "[_RV_] Witamy w pokoju VIP King [ryan]"

# game/UpdateScript0.08_2.rpy:1045 #-#-# translate crowdin vip_access_f450949f:
