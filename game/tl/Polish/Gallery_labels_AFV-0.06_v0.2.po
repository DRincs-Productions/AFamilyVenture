# game/Gallery_labels_AFV-0.06_v0.2.rpy:33418 #-#-# translate crowdin label_gal_mom_sushi_date_joey_64e553b7:
msgid "[_J_] Well, just say the word, and I'll make sure he stays in prison... haha... Just kidding... or am I?"
