# game/Gallery_labels_AFV-0.06_v0.2.rpy:12576 #-#-# translate crowdin label_locker_room_run_799b08e6:
msgid "[_R_] Ok, so she told me she would only dig up dirt on Matt if I plant a secret spy camera in the girls' showers."
