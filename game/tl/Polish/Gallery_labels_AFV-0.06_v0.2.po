# TODO: Translation updated at 2024-07-23 08:27 #|#|# # game/Gallery_labels_AFV-0.06_v0.2.rpy:15 #-#-# translate crowdin label_gal_mom_drunk_e1aba2f6:
msgid "[_RT_] {i}Hmmm.... no answer. I don't have a key, but I'm started to get a little worried about her.{/i}"
msgstr "[_RT_] {i}Hmmm.... brak odpowiedzi. Nie mam klucza, ale zaczynam się o nią trochę martwić.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16 #-#-# translate crowdin label_gal_mom_drunk_e517f87b:
msgid "[_RT_] {i}There's a sliding door outside on the patio into her room. Hopefully it's unlocked.{/i}"
msgstr "[_RT_] {i}Na patio są przesuwane drzwi prowadzące do jej pokoju. Mam nadzieję, że są otwarte.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:20 #-#-# translate crowdin label_gal_mom_drunk_c6d27ccf:
msgid "[_RT_] {i}Bingo.... {/i}"
msgstr "[_RT_] {i}Bingo.... {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21 #-#-# translate crowdin label_gal_mom_drunk_435e36e6:
msgid "[_RT_] {i}Looks like she's passed out.{/i}"
msgstr "[_RT_] {i}Wygląda na to, że zemdlała.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:22 #-#-# translate crowdin label_gal_mom_drunk_c5d45a3e:
msgid "[_RT_] {i}Is that one of [dad_name]'s empty whiskey bottles she's cuddling?{/i}"
msgstr "[_RT_] {i}Czy to jedna z pustych butelek po whisky ojca, którą przytula?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23 #-#-# translate crowdin label_gal_mom_drunk_f6b7fd29:
msgid "[_RT_] {i}I wonder how much of it she drank. I don't think I've actually ever seen her dead drunk before.{/i}"
msgstr "[_RT_] {i}Zastanawiam się, ile tego wypiła. Nie wydaje mi się, żebym kiedykolwiek widział ją tak zalaną.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:24 #-#-# translate crowdin label_gal_mom_drunk_cc3b4bb3:
msgid "[_RT_] {i}Last night must have been pretty traumatic for her.{/i}"
msgstr "[_RT_] {i}Ostatnia noc musiała być dla niej dość traumatyczna.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:25 #-#-# translate crowdin label_gal_mom_drunk_01252357:
msgid "[_RT_] {i}She didn't even change. I can see she's still wearing the thong from last night.{/i}"
msgstr "[_RT_] {i}Nawet się nie przebrała. Widzę, że wciąż ma na sobie stringi z zeszłej nocy.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:28 #-#-# translate crowdin label_gal_mom_drunk_8081fe7a:
msgid "[_M_] Mmmhhh.... who.... who's there?"
msgstr "[_M_] Mmmhhhh... kto.... kto tam?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:29 #-#-# translate crowdin label_gal_mom_drunk_3687d940:
msgid "[_R_] Hey Mom, it's ok, it's just me."
msgstr "[_R_] Hej mamo, wszystko w porządku, to tylko ja."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:30 #-#-# translate crowdin label_gal_mom_drunk_c5d3b6b3:
msgid "[_M_] [ryan]?.... What are you doing in my room?"
msgstr "[_M_] [ryan]?.... Co robisz w moim pokoju?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:31 #-#-# translate crowdin label_gal_mom_drunk_62dded21:
msgid "[_R_] I was worried about you, so I came through the patio door to check on you."
msgstr "[_R_] Martwiłem się o ciebie, więc wszedłem przez drzwi na patio, żeby sprawdzić, co u ciebie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:34 #-#-# translate crowdin label_gal_mom_drunk_00eadc61:
msgid "[_M_] You were worried about me?..."
msgstr "[_M_] Martwiłeś się o mnie?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:35 #-#-# translate crowdin label_gal_mom_drunk_cc4aeec0:
msgid "[_M_] Really?.... I thought you hated me after last night."
msgstr "[_M_] Naprawdę?.... Myślałam, że mnie nienawidzisz po ostatniej nocy."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:36 #-#-# translate crowdin label_gal_mom_drunk_d87d739d:
msgid "[_R_] Hated you.... Mom.... I could never hate you!.... I love you!"
msgstr "[_R_] Nienawidzić cię.... Mamo.... Nigdy bym cię nie znienawidził!.... Kocham Cię!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37 #-#-# translate crowdin label_gal_mom_drunk_4f67cde2:
msgid "[_M_] Really?.... But the way you were looking at me last night when you walked in on my dance..."
msgstr "[_M_] Naprawdę? Ale sposób, w jaki patrzyłeś na mnie zeszłej nocy, kiedy przyszedłeś na mój taniec..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:38 #-#-# translate crowdin label_gal_mom_drunk_09e6732a:
msgid "[_M_] You looked so ashamed of me..."
msgstr "[_M_] Wyglądałeś na takiego zawstydzonego..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:39 #-#-# translate crowdin label_gal_mom_drunk_a57afe94:
msgid "[_M_] No boy should see their mother like that..."
msgstr "[_M_] Żaden chłopak nie powinien widzieć swojej matki w takiej sytuacji..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:40 #-#-# translate crowdin label_gal_mom_drunk_fcfab8fc:
msgid "[_M_] So, I just thought you hated me for it."
msgstr "[_M_] Więc myślałam, że znienawidzisz mnie za to."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:41 #-#-# translate crowdin label_gal_mom_drunk_68a77305:
msgid "[_R_] Oh, God no Mom, to be completely honest I looked that way because I was ashamed of myself."
msgstr "[_R_] Boże, nie, mamo, szczerze mówiąc wyglądałem tak, bo się wstydziłem sam za siebie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:42 #-#-# translate crowdin label_gal_mom_drunk_268ee363:
msgid "[_M_] Oh, honey.... why would you be ashamed of yourself?"
msgstr "[_M_] Och, skarbie... dlaczego miałbyś się za siebie wstydzić?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:43 #-#-# translate crowdin label_gal_mom_drunk_d12044ff:
msgid "[_R_] Because I thought you looked amazing.... , and I know that sons shouldn't think that way about their moms."
msgstr "[_R_] Ponieważ pomyślałem, że wyglądałaś niesamowicie... i wiem, że synowie nie powinni myśleć tak o swoich matkach."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:46 #-#-# translate crowdin label_gal_mom_drunk_66c8cd26:
msgid "[_M_] Oh, honey.... that's one of the cutest things I've ever heard you say."
msgstr "[_M_] Och, skarbie... to jedna z najsłodszych rzeczy, jakie kiedykolwiek słyszałam."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:47 #-#-# translate crowdin label_gal_mom_drunk_734a07c0:
msgid "[_R_] Cute?..."
msgstr "[_R_] Słodkich?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:48 #-#-# translate crowdin label_gal_mom_drunk_117e273f:
msgid "[_M_] I mean yes.... hahaha.... boys should not think of their mothers that way, but that's very flattering to me that you thought I looked amazing."
msgstr "[_M_] To znaczy tak... hahaha... chłopcy nie powinni myśleć o swoich matkach w ten sposób, ale bardzo mi to pochlebia, że uważasz, że wyglądam niesamowicie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:49 #-#-# translate crowdin label_gal_mom_drunk_106b90a6:
msgid "[_M_] I know those horny old farts at the club like what they see, but the fact that I'm still attractive to a young man is nice for me to hear."
msgstr "[_M_] Wiem, że tym napalonym starym pierdzielom w klubie podoba się to, co widzą, ale fakt, że wciąż jestem atrakcyjna dla młodego mężczyzny jest dla mnie miły."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:50 #-#-# translate crowdin label_gal_mom_drunk_05ce16c3:
msgid "[_M_] And it's not weird to have those kind of thoughts when you see a mostly nude woman moving that way on a stripper pole."
msgstr "[_M_] I nie jest dziwne mieć takie myśli, gdy widzi się prawie nagą kobietę poruszającą się w ten sposób na rurze striptizerskiej."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:51 #-#-# translate crowdin label_gal_mom_drunk_c5cf5648:
msgid "[_M_] That's totally normal, so don't feel ashamed of yourself."
msgstr "[_M_] To całkowicie normalne, więc nie czuj z tego powodu wstydu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:54 #-#-# translate crowdin label_gal_mom_drunk_0034c9ce:
msgid "[_M_] The fact that it was your mom on the pole was just a fucked up situation, that you had no control over. Oh.... sorry about my language."
msgstr "[_M_] Fakt, że to twoja mama tańczyła na rurze, był po prostu pojebaną sytuacją, nad którą nie miałeś kontroli. Och... przepraszam za mój język."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:55 #-#-# translate crowdin label_gal_mom_drunk_48e363d8:
msgid "[_M_] But just so we're clear, I want you to try and get those images of me stripping out of your head. Continuing to think about that wouldn't be normal. Just kind of creepy."
msgstr "[_M_] Ale żeby było jasne, chcę, żebyś spróbował wyrzucić z głowy te obrazy mnie uprawiającej striptiz. Dalsze myślenie o tym nie byłoby normalne. To trochę przerażające."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:56 #-#-# translate crowdin label_gal_mom_drunk_8c4a8881:
msgid "[_R_] Oh.... I know that."
msgstr "[_R_] Och... Wiem o tym."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:57 #-#-# translate crowdin label_gal_mom_drunk_2e1b5de5:
msgid "[_M_] Good!"
msgstr "[_M_] To dobrze!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:58 #-#-# translate crowdin label_gal_mom_drunk_4bcd6c55:
msgid "[_M_] How did you get into the club?"
msgstr "[_M_] Jak dostałeś się do klubu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:59 #-#-# translate crowdin label_gal_mom_drunk_cde9614c:
msgid "[_R_] They just let me in without even asking if I was old enough."
msgstr "[_R_] Po prostu mnie wpuścili, nawet nie pytając, czy jestem pełnoletni."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:60 #-#-# translate crowdin label_gal_mom_drunk_76ad1eeb:
msgid "[_MT_] {i}That stupid asshole Joey!{/i}"
msgstr "[_MT_] {i}Ten głupi dupek Joey!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:61 #-#-# translate crowdin label_gal_mom_drunk_2cebebe1:
msgid "[_R_] And I just searched around until I found you."
msgstr "[_R_] I po prostu szukałem po klubie, aż w końcu cię znalazłem."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:62 #-#-# translate crowdin label_gal_mom_drunk_653c5abd:
msgid "[_R_] I wanted to be sure you were safe."
msgstr "[_R_] Chciałem mieć pewność, że jesteś bezpieczna."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:65 #-#-# translate crowdin label_gal_mom_drunk_e8ae05e2:
msgid "[_M_] That is so chival.... chiverrll.... chivalrous of you!"
msgstr "[_M_] To takie szal.... szchal.... szlachetne z twojej strony!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:66 #-#-# translate crowdin label_gal_mom_drunk_02555554:
msgid "[_M_] What a perfect little gentleman I raised."
msgstr "[_M_] Wychowałam idealnego małego dżentelmena."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:67 #-#-# translate crowdin label_gal_mom_drunk_77dfbcbd:
msgid "[_R_] Yeah, well Dad said I'm the man of the house now."
msgstr "[_R_] No cóż, tata powiedział, że jestem teraz panem domu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:68 #-#-# translate crowdin label_gal_mom_drunk_eb77d169:
msgid "[_R_] So, I felt responsible for keeping you safe."
msgstr "[_R_] Czułem się odpowiedzialny za zapewnienie ci bezpieczeństwa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:69 #-#-# translate crowdin label_gal_mom_drunk_632b859b:
msgid "[_M_] Ok, let's get this straight. You may be the only male in the house, but I'm the man of the house so to speak! I'm responsible for this family!"
msgstr "[_M_] Ok, wyjaśnijmy to sobie. Możesz być jedynym mężczyzną w domu, ale to ja jestem panem domu, że tak to ujmę! Jestem odpowiedzialna za tę rodzinę!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:70 #-#-# translate crowdin label_gal_mom_drunk_bd6afc4c:
msgid "[_R_] Well, still.... I'm going to try to work my ass off to make sure you don't have to go back there next week."
msgstr "[_R_] Cóż, wracając... Postaram się ruszyć tyłek, żebyś nie musiała tam wracać w przyszłym tygodniu."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:71 #-#-# translate crowdin label_gal_mom_drunk_abe00cf7:
msgid "[_M_] Ok honey, that's very noble of you, but don't forget that you have to go to school too. I would feel like a terrible mother if you didn't graduate again this year."
msgstr "[_M_] Kochanie, to bardzo szlachetne z twojej strony, ale nie zapominaj, że ty też musisz chodzić do szkoły. Czułabym się jak wyrodna matka, gdybyś znów nie ukończył szkoły w tym roku."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:72 #-#-# translate crowdin label_gal_mom_drunk_960540d8:
msgid "[_R_] Well, lucky for me you're my teacher, so you can give me extra help at home, and cover for me in the afternoons when I have to go work at Dad's office."
msgstr "[_R_] Na szczęście jesteś moją nauczycielką, więc możesz mi dodatkowo pomagać w domu i kryć mnie popołudniami, kiedy muszę pracować w biurze taty."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:75 #-#-# translate crowdin label_gal_mom_drunk_73513521:
msgid "[_M_] Are you sure working at Dad's office is such a great idea. His business is what got us into this mess in the first place."
msgstr "[_M_] Jesteś pewny, że praca w biurze taty to świetny pomysł? To jego biznes wpędził nas w ten bałagan."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:76 #-#-# translate crowdin label_gal_mom_drunk_3f7f084c:
msgid "[_R_] Yeah.... well.... I'm not doing anything illegal there, just doing some cleaning and light maintenance."
msgstr "[_R_] Tak.... Cóż.... Nie robię tam nic nielegalnego, tylko sprzątam i wykonuję drobne prace."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:77 #-#-# translate crowdin label_gal_mom_drunk_0d68121a:
msgid "[_M_] Ok, I'm going to cover for you temporarily until we figure something else out."
msgstr "[_M_] Ok, będę cię tymczasowo kryła, dopóki nie wymyślimy czegoś innego."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:78 #-#-# translate crowdin label_gal_mom_drunk_7ef26f24:
msgid "[_R_] Thanks Mom! I won't let you down. I'll try to make sure you never have to get on that pole again."
msgstr "[_R_] Dzięki mamo! Nie zawiodę cię. Postaram się, żebyś już nigdy nie musiała wchodzić na ten drążek."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:79 #-#-# translate crowdin label_gal_mom_drunk_a40ea466:
msgid "[_R_] Oh, and Mom?"
msgstr "[_R_] Och, i mama?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:80 #-#-# translate crowdin label_gal_mom_drunk_b1f8706c:
msgid "[_M_] Yes?..."
msgstr "[_M_] Tak?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:81 #-#-# translate crowdin label_gal_mom_drunk_353210ff:
msgid "[_R_] Why is it you're so good at pole dancing?"
msgstr "[_R_] Dlaczego jesteś taka dobra w tańcu na rurze?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:82 #-#-# translate crowdin label_gal_mom_drunk_c1148d09:
msgid "[_M_] Oh, God.... I hoped you wouldn't ask me that!"
msgstr "[_M_] O, Boże... Miałam nadzieję, że mnie o to nie zapytasz!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:83 #-#-# translate crowdin label_gal_mom_drunk_c6841c25:
msgid "[_R_] ..."
msgstr "[_R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:84 #-#-# translate crowdin label_gal_mom_drunk_cb598cac:
msgid "[_M_] Well, to tell you the truth. Before I met your father I did some stripping at a night club."
msgstr "[_M_] Cóż, powiem ci prawdę. Zanim poznałam twojego ojca, robiłam striptiz w nocnym klubie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:85 #-#-# translate crowdin label_gal_mom_drunk_9b48d8c2:
msgid "[_R_] I figured that must have been it."
msgstr "[_R_] Domyślałem się, że to musiało być to."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:86 #-#-# translate crowdin label_gal_mom_drunk_4759f635:
msgid "[_M_] Yeah, well I really wanted to go to modeling school, so I needed the money to pay for it."
msgstr "[_M_] Tak, naprawdę chciałam iść do szkoły modelingu, więc potrzebowałam pieniędzy, żeby za nią zapłacić."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:87 #-#-# translate crowdin label_gal_mom_drunk_c64f3658:
msgid "[_M_] I also thought being on a stage in front of people would give me good experience."
msgstr "[_M_] Pomyślałam też, że występy na scenie przed ludźmi dadzą mi dobre doświadczenie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:88 #-#-# translate crowdin label_gal_mom_drunk_1350208d:
msgid "[_M_] The money I made also kept me fed and a roof over my head."
msgstr "[_M_] Pieniądze, które zarabiałam, wystarczały mi na jedzenie i zapewnienie dachu nad głową."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:89 #-#-# translate crowdin label_gal_mom_drunk_3e825270:
msgid "[_R_] And is that where you met Dad?"
msgstr "[_R_] I to tam poznałaś tatę?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:90 #-#-# translate crowdin label_gal_mom_drunk_ca2630e0:
msgid "[_M_] Yes.... not a very romantic tale for your kids, is it?"
msgstr "[_M_] Tak.... niezbyt romantyczna opowieść dla dzieci, prawda?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:91 #-#-# translate crowdin label_gal_mom_drunk_c000a46d:
msgid "[_R_] I guess not..."
msgstr "[_R_] Chyba nie..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:92 #-#-# translate crowdin label_gal_mom_drunk_8d3e6e02:
msgid "[_M_] So, we met, he liked me a lot, kept coming in while I was working, giving me lots of tips, soon he asked me out, and not long after I was pregnant with Sidney."
msgstr "[_M_] Więc, spotkaliśmy się, bardzo mnie polubił, przychodził, gdy pracowałam, dawał mi mnóstwo napiwków, wkrótce zaprosił mnie na randkę, a niedługo potem byłam w ciąży z Sidney."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:93 #-#-# translate crowdin label_gal_mom_drunk_f9c6d4cb:
msgid "[_M_] Once I was pregnant we had to get married, both of us coming from strict Catholic families."
msgstr "[_M_] Kiedy byłam w ciąży, musieliśmy się pobrać, oboje pochodzimy z surowych katolickich rodzin."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:94 #-#-# translate crowdin label_gal_mom_drunk_ab79c2de:
msgid "[_M_] And then the rest just kind of fell into place."
msgstr "[_M_] A potem reszta po prostu ułożyła się sama."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:95 #-#-# translate crowdin label_gal_mom_drunk_1590f43a:
msgid "[_R_] Why didn't you finish modeling school?"
msgstr "[_R_] Dlaczego nie skończyłaś szkoły modelingu?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:96 #-#-# translate crowdin label_gal_mom_drunk_fbbbdded:
msgid "[_M_] Your selfish, over protective, jealous dad didn't want anyone else even looking at me."
msgstr "[_M_] Twój samolubny, nadopiekuńczy, zazdrosny ojciec nie chciał, żeby ktokolwiek inny na mnie nawet patrzył."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:97 #-#-# translate crowdin label_gal_mom_drunk_3ca1cf91:
msgid "[_R_] Oh come on! You're more to us than that."
msgstr "[_R_] Daj spokój! Jesteś dla nas kimś więcej."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:98 #-#-# translate crowdin label_gal_mom_drunk_d630b695:
