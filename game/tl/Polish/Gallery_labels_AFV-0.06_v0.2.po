# game/Gallery_labels_AFV-0.06_v0.2.rpy:697 #-#-# translate crowdin label_gal_mom_weekend_pool_01_702aacb5:
msgid "[_R_] Good! I'm so glad to see you looking happy. I know your stress has to be through the roof."
