# game/Gallery_labels_AFV-0.06_v0.2.rpy:12590 #-#-# translate crowdin label_locker_room_run_dbb84d14:
msgid "[_L_] Well, normally I wouldn't... but if it helps me get dirt on Matt so I can win the election, I'm more than okay with it."
msgstr "[_L_] Cóż, normalnie bym tego nie zrobiła... ale jeśli pomoże mi to zdobyć brudy na Matta, abym mogła wygrać wybory, to nie mam nic przeciwko."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:12591 #-#-# translate crowdin label_locker_room_run_bb794cd3:
msgid "[_R_] Wow, I'm really surprised how much you're willing to do to win."
