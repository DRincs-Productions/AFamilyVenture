# game/Gallery_labels_AFV-0.06_v0.2.rpy:21285 #-#-# translate crowdin label_gal_aunt_05_957462e5:
msgid "[_M_] No, I told Mr. DeCapo that I would find a way to pay Camille's gambling debts."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21286 #-#-# translate crowdin label_gal_aunt_05_9658bf24:
msgid "[_S_] How much did Aunt Camille lose?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21287 #-#-# translate crowdin label_gal_aunt_05_193e7b17:
msgid "[_M_] A lot."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21288 #-#-# translate crowdin label_gal_aunt_05_cd17eb60:
msgid "[_L_] How are we going to pay it when we already have Dad's debts to deal with?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21289 #-#-# translate crowdin label_gal_aunt_05_71ca139d:
msgid "[_M_] I don't know."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21292 #-#-# translate crowdin label_gal_aunt_05_53212abd:
msgid "[_L_] You don't know? How can you not know?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21293 #-#-# translate crowdin label_gal_aunt_05_3301e5d9:
msgid "[_L_] The mobs going kill us!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21294 #-#-# translate crowdin label_gal_aunt_05_ef0236d9:
msgid "[_R_] Lauren, calm down, okay? We'll figure something out."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21295 #-#-# translate crowdin label_gal_aunt_05_645e5ff5:
msgid "[_S_] I can help. I've been saving all my pay from the club, and maybe Mr. DeCapo will let me pick up some extra shifts?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21296 #-#-# translate crowdin label_gal_aunt_05_26bb9677:
msgid "[_M_] No!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21297 #-#-# translate crowdin label_gal_aunt_05_0e3273a2:
msgid "[_M_] That money is for college. You need to get back to design school so you can escape all this."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21298 #-#-# translate crowdin label_gal_aunt_05_b2ab9a00:
msgid "[_S_] Then how are we going to..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21299 #-#-# translate crowdin label_gal_aunt_05_08b55e30:
msgid "[_L_] Yeah! How are we going to not get murdered?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21302 #-#-# translate crowdin label_gal_aunt_05_c1be3483:
msgid "[_M_] I said, I don't know!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21303 #-#-# translate crowdin label_gal_aunt_05_dc9b4f74:
msgid "[_M_] Stop talking about getting murdered! I don't know how I'm going to fix it, but I will!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21304 #-#-# translate crowdin label_gal_aunt_05_49e94d7d:
msgid "[_M_] I just need some time to think!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21305 #-#-# translate crowdin label_gal_aunt_05_973ae88c:
msgid "[_R_] Mom, take it easy..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21306 #-#-# translate crowdin label_gal_aunt_05_2fed90a6:
msgid "[_R_] My business is doing really well... If everyone helped out at my studio, I'm sure we could..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21307 #-#-# translate crowdin label_gal_aunt_05_26bb9677_1:
msgid "[_M_] No!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21310 #-#-# translate crowdin label_gal_aunt_05_0e147b20:
msgid "[_M_] I will handle it. Don't involve your sisters in this anymore than you already have."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21311 #-#-# translate crowdin label_gal_aunt_05_a9026e51:
msgid "[_R_] But, Mom..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21312 #-#-# translate crowdin label_gal_aunt_05_f104711c:
msgid "[_M_] I said, no!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21313 #-#-# translate crowdin label_gal_aunt_05_85456a66:
msgid "[_M_] I'm your mother. This is my burden not yours."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21314 #-#-# translate crowdin label_gal_aunt_05_84e20f91:
msgid "[_M_] {b}I{/b} will handle this."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21315 #-#-# translate crowdin label_gal_aunt_05_9acb6ba1:
msgid "[_M_] {b}I{/b} will find a way to pay Mr. DeCapo."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21316 #-#-# translate crowdin label_gal_aunt_05_7ce0505e:
msgid "[_M_] Lauren, you and [ryan] need to focus on passing your exams and graduating high school. Sidney, you need to look for a respectable job and focus on getting back into design school."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21317 #-#-# translate crowdin label_gal_aunt_05_0e9cf35b:
msgid "[_M_] Now go back to bed, all of you."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21320 #-#-# translate crowdin label_gal_aunt_05_a2b80596:
msgid "[_RT_] {i}...{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21321 #-#-# translate crowdin label_gal_aunt_05_d366d3b2:
msgid "[_RT_] {i}How did this night go so wrong, so fast?...{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21325 #-#-# translate crowdin label_gal_aunt_05_43091f1e:
msgid "[_RT_] {i}I know Mom's putting on a brave face for us, but she was barely keeping it together. This is too much for her to take on alone.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21326 #-#-# translate crowdin label_gal_aunt_05_6bb804f9:
msgid "[_RT_] {i}I thought Mom had started to see me as a man. Her man...{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21327 #-#-# translate crowdin label_gal_aunt_05_76067d3b:
msgid "[_RT_] {i}But tonight, I went back to being the little boy she needs to protect.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21328 #-#-# translate crowdin label_gal_aunt_05_dbbfc7f9:
msgid "[_RT_] {i}I have to show her I can be the guy... the man she counts on! Now, more than ever, I need to prove she can depend on me.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21329 #-#-# translate crowdin label_gal_aunt_05_e3233cc8:
msgid "[_RT_] {i}But how?{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21330 #-#-# translate crowdin label_gal_aunt_05_632747d3:
msgid "[_RT_] {i}Aunt Cami let Joey loan her so much money before she lost it all. This won't be like Dad's debts, where Joey lets us get away with only making payments on the interest.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21331 #-#-# translate crowdin label_gal_aunt_05_131a6656:
msgid "[_RT_] {i}He's going to use this to force Mom deeper into his clutches. If I don't do something, Mom will end up like Candy.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21332 #-#-# translate crowdin label_gal_aunt_05_e2ebf4ce:
msgid "[_RT_] {i}Just another one of Joey DeCapo's whores.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21333 #-#-# translate crowdin label_gal_aunt_05_53c73fe0:
msgid "[_RT_] {i}My photoshoots made good money, but I've pretty much wrapped each of them up. I'm going to start losing subscribers if I don't put out something new.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21334 #-#-# translate crowdin label_gal_aunt_05_bc27a031:
msgid "[_RT_] {i}To make the kind of money we'll need, it'll take more than another softcore shoot. I'll need to do something big. Something that would get a lot of online attention.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21335 #-#-# translate crowdin label_gal_aunt_05_df18cbbc:
msgid "[_RT_] {i}The Perry Hotter set with Mom and Megan did really well. So, something with two girls would be best.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21336 #-#-# translate crowdin label_gal_aunt_05_0ebff335:
msgid "[_RT_] {i}Lauren and Mandy's Instaslam certainly got big quick with their lezzy pictures. Girl on girl is always very popular, but what really got their subscriber count to take off, was them being cousins.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21337 #-#-# translate crowdin label_gal_aunt_05_5a0ca020:
msgid "[_RT_] {i}An incestuous lesbian shoot with Lauren and Mandy would be perfect, but even if I could get Lauren to agree to do it, Mandy's gone now.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21338 #-#-# translate crowdin label_gal_aunt_05_d7351c47:
msgid "[_RT_] {i}Mom would probably be really mad anyways, if I used any of the girls behind her back. After that speech, she's going to insist on being involved in whatever I come up with.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21339 #-#-# translate crowdin label_gal_aunt_05_b749df57:
msgid "[_RT_] {i}So, a shoot with Mom and someone else would be best, but who should I have with her?{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21340 #-#-# translate crowdin label_gal_aunt_05_21ec90af:
msgid "[_RT_] {i}Maybe Megan? She'd be up for it, no question... And they've already done one photoshoot together.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21341 #-#-# translate crowdin label_gal_aunt_05_628b1f96:
msgid "[_RT_] {i}Shit. With how well the incest angle worked for Lauren and Mandy's InstaSlam account, I really think that's the way to go. Megan and Mom don't look anything like each other though. No one's going to believe they're related.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21342 #-#-# translate crowdin label_gal_aunt_05_d877be7c_1:
msgid "[_R_] {i}(sigh){/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21343 #-#-# translate crowdin label_gal_aunt_05_15480b02:
msgid "[_RT_] {i}Well, there's no point in just standing around. I can work out the details later. For now, I should go talk to Mom and make sure she knows she can count on me to keep us safe.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21344 #-#-# translate crowdin label_gal_aunt_05_c4e7f950:
msgid "[_RT_] {i}Maybe I should check on Lauren and Sidney first? They both looked pretty shaken up.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21353 #-#-# translate crowdin label_gal_aunt_06_fc17ce9e:
msgid "[_C_] Please, Brittney!... It would only be for a couple weeks until we can find something more permanant."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21354 #-#-# translate crowdin label_gal_aunt_06_84d0a507:
msgid "[_X_] {i}(Voice muffled over intercom){/i} That doesn't change the fact that you're the wife and daughter of a known fugitive."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21355 #-#-# translate crowdin label_gal_aunt_06_07c3a6b8:
msgid "[_X_] The PTA elections are coming up, how am I going to keep my spot as president if I'm harboring terrorists."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21358 #-#-# translate crowdin label_gal_aunt_06_9f85b907:
msgid "[_C_] Oh, we're terrorists now? Fuck you Brittney!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21359 #-#-# translate crowdin label_gal_aunt_06_b99736a7:
msgid "[_C_] When your mom had that stroke, and you had to rush to be by her side, who took care of your little Chelsie?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21360 #-#-# translate crowdin label_gal_aunt_06_3f5c5177:
msgid "[_X_] Your nanny Cindy did! It wasn't you. And we paid her extra since she was watching both our girls."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21361 #-#-# translate crowdin label_gal_aunt_06_eee29b6d:
msgid "[_C_] Yeah, but I'm still the one who made that happen! She stayed at our house, ate our food. I could have forbid Cindy from watching Chelsie."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21362 #-#-# translate crowdin label_gal_aunt_06_ebc07522:
msgid "[_X_] And we really appreciated it, but this is much different."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21363 #-#-# translate crowdin label_gal_aunt_06_e4eb81ac:
msgid "[_X_] I'm sorry, I just can't expose my family to the horrors of organized crime."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21364 #-#-# translate crowdin label_gal_aunt_06_6fab91fa:
msgid "[_C_] We wouldn't..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21365 #-#-# translate crowdin label_gal_aunt_06_d3316366:
msgid "[_X_] I'm going back to bed... Goodbye, Camille! {i}(Click){/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21366 #-#-# translate crowdin label_gal_aunt_06_e547f083:
msgid "[_C_] Aaahhh!!!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21369 #-#-# translate crowdin label_gal_aunt_06_640a690f:
msgid "[_C_] After everything we've done for these snobs, they don't want to touch us with a ten foot pole."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21370 #-#-# translate crowdin label_gal_aunt_06_47d1eb62:
msgid "[_MD_] Who's next on our list?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21371 #-#-# translate crowdin label_gal_aunt_06_06a04f28:
msgid "[_C_] That's it... I'm out of friends."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21372 #-#-# translate crowdin label_gal_aunt_06_5b551849:
msgid "[_C_] Eleven houses, eleven rejections."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21373 #-#-# translate crowdin label_gal_aunt_06_364430ca:
msgid "[_MD_] Then... Can we please just go back to Aunt [mom_name]'s?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21376 #-#-# translate crowdin label_gal_aunt_06_38806f7a:
msgid "[_C_] Are you fucking out of your mind!?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21377 #-#-# translate crowdin label_gal_aunt_06_adeb2ad2:
msgid "[_C_] After everything they've done to us!?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21378 #-#-# translate crowdin label_gal_aunt_06_7be5c6ed:
msgid "[_C_] It felt so good to finally tell my sister off, tell her what I think of that God aweful son of hers..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21379 #-#-# translate crowdin label_gal_aunt_06_5d90219d:
msgid "[_C_] And you want me to take it all back? Beg her to let us come back?..."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21380 #-#-# translate crowdin label_gal_aunt_06_d1e189ab:
msgid "[_C_] Uh uh... No way!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21381 #-#-# translate crowdin label_gal_aunt_06_eb56ddad:
msgid "[_MD_] Sorry... I shouldn't have suggested that."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21384 #-#-# translate crowdin label_gal_aunt_06_d1bc117e:
msgid "[_MD_] But, where are we going to go? We don't even have money for a cheap motel."
