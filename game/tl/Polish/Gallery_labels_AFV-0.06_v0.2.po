# game/Gallery_labels_AFV-0.06_v0.2.rpy:698 #-#-# translate crowdin label_gal_mom_weekend_pool_01_4f0d1e73:
msgid "[_R_] I really admire how well you're handling everything that's going on."
msgstr "[_R_] Naprawdę podziwiam, jak dobrze radzisz sobie ze wszystkim, co się dzieje."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:699 #-#-# translate crowdin label_gal_mom_weekend_pool_01_40b4335f:
msgid "[_M_] Oh, [ryan], you're so sweet!"
