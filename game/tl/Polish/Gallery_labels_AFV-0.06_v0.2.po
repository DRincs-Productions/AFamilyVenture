# game/Gallery_labels_AFV-0.06_v0.2.rpy:21407 #-#-# translate crowdin label_gal_aunt_06_4681ab68:
msgid "[_MD_] It's Lauren... She's worried about us."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21408 #-#-# translate crowdin label_gal_aunt_06_a3677cac:
msgid "[_MD_] I'm just letting her know we're all right."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21409 #-#-# translate crowdin label_gal_aunt_06_70822dc2:
msgid "[_C_] You didn't tell her we're sleeping at the park, did you?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21410 #-#-# translate crowdin label_gal_aunt_06_f49decc5:
msgid "[_MD_] I haven't yet, but I'm about to."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21411 #-#-# translate crowdin label_gal_aunt_06_4751d619:
msgid "[_C_] Don't you dare!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21414 #-#-# translate crowdin label_gal_aunt_06_a83da3de:
msgid "[_MD_] {i}(Yelling){/i} Why not, Mom!?"
