# game/UpdateScript0.08_1.rpy:7540 #-#-# translate crowdin prison_fashion_show_417dd063:
msgid "{b}{i}\"Mom's Affection +1\"{/i}{/b}"
msgstr "{b}{i}„Uczucie Mamy +1”{/i}{/b}"

# game/UpdateScript0.08_1.rpy:7542 #-#-# translate crowdin prison_fashion_show_c4c354cf:
