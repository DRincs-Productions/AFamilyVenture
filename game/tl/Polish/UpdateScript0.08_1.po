# game/UpdateScript0.08_1.rpy:2618 #-#-# translate crowdin mom_investigates_365c198a:
msgid "[_R_] We both know there's nothing to be scared of, but I haven't been able to convince Sidney's simple mind, that there aren't any monsters lurking in our lounge."
msgstr "[_R_] Oboje wiemy, że nie ma się czego bać, ale nie udało mi się przekonać prostego umysłu Sidney, że w naszym salonie nie czają się żadne potwory."

# game/UpdateScript0.08_1.rpy:2619 #-#-# translate crowdin mom_investigates_39eea2ce:
msgid "[_ST_] {i}Simple mind?{/i}"
msgstr "[_ST_] {i}Prosty umysł?{/i}"

# game/UpdateScript0.08_1.rpy:2620 #-#-# translate crowdin mom_investigates_0ae3c472:
msgid "[_RT_] {i}Does she think she can tease me without getting teased back?{/i}"
