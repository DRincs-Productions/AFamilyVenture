# game/UpdateScript0.08_1.rpy:4899 #-#-# translate crowdin weekend_date_lounge_fa273b36_1:
msgid "[_RT_] {i}Which one should I wear?{/i}"
msgstr "[_RT_] {i}Który mam założyć?{/i}"

# game/UpdateScript0.08_1.rpy:4905 #-#-# translate crowdin weekend_date_lounge_aed8e672_1:
msgid "[_RT_] {i}The more casual outfit?{/i}"
msgstr "[_RT_] {i}Bardziej swobodny strój?{/i}"

# game/UpdateScript0.08_1.rpy:4911 #-#-# translate crowdin weekend_date_lounge_5e2d7d70_1:
msgid "[_RT_] {i}Or the more formal looking one?{/i}"
msgstr "[_RT_] {i}A może bardziej formalny?{/i}"

# game/UpdateScript0.08_1.rpy:4919 #-#-# translate crowdin weekend_date_lounge_f91d85b8_2:
msgid "[_RT_] {i}Yeah, I look great!... This is definitely the way to go.{/i}"
msgstr "[_RT_] {i}Tak, wyglądam świetnie!... To zdecydowanie właściwa droga.{/i}"

# game/UpdateScript0.08_1.rpy:4930 #-#-# translate crowdin weekend_date_lounge_f91d85b8_3:
msgid "[_RT_] {i}Yeah, I look great!... This is definitely the way to go.{/i}"
msgstr "[_RT_] {i}Tak, wyglądam świetnie!... To zdecydowanie właściwa droga.{/i}"

# game/UpdateScript0.08_1.rpy:4941 #-#-# translate crowdin weekend_date_lounge_8c8ad84f_1:
msgid "[_RT_] {i}I definitely look pretty fancy in this outfit, but I can't afford a dress collar shirt kind of date.{/i}"
msgstr "[_RT_] {i}Zdecydowanie wyglądam bardzo elegancko w tym stroju, ale nie stać mnie na randkę z kołnierzykiem i koszulą.{/i}"

# game/UpdateScript0.08_1.rpy:4944 #-#-# translate crowdin weekend_date_lounge_1c81fffc_1:
msgid "[_RT_] {i}There... That outfit suits my budget a little better.{/i}"
msgstr "[_RT_] {i}No właśnie... Ten strój trochę lepiej pasuje do mojego budżetu.{/i}"

# game/UpdateScript0.08_1.rpy:4951 #-#-# translate crowdin weekend_date_lounge_83300a2b_1:
msgid "[_RT_] {i}Mom's taking a while to get ready.{/i}"
msgstr "[_RT_] {i}Mama potrzebuje trochę czasu, aby się przygotować.{/i}"

# game/UpdateScript0.08_1.rpy:4952 #-#-# translate crowdin weekend_date_lounge_a661ec36_1:
msgid "[_RT_] {i}Maybe I should peek at the spycams to see what she's doing.{/i}"
msgstr "[_RT_] {i}Może powinienem zerknąć na kamery szpiegowskie, żeby zobaczyć, co ona robi.{/i}"

# game/UpdateScript0.08_1.rpy:4953 #-#-# translate crowdin weekend_date_lounge_f9040412_1:
msgid "[_RT_] {i}Hmm... Not in the bathroom.{/i}"
msgstr "[_RT_] {i}Hmm... Nie w łazience.{/i}"

# game/UpdateScript0.08_1.rpy:4954 #-#-# translate crowdin weekend_date_lounge_edc56aab_1:
msgid "[_RT_] {i}Not in her bedroom...{/i}"
msgstr "[_RT_] {i}Nie w jej sypialni...{/i}"

# game/UpdateScript0.08_1.rpy:4968 #-#-# translate crowdin weekend_date_lounge_ee7e1a83_1:
msgid "[_R_] Wow, you look incredible! I never get tired of seeing you in that dress."
msgstr "[_R_] Wow, wyglądasz niesamowicie!\n"
"Nigdy nie znudzi mi się widok ciebie w tej sukience."

# game/UpdateScript0.08_1.rpy:4972 #-#-# translate crowdin weekend_date_lounge_14fb298e_1:
msgid "[_M_] Thank you, but... What are you wearing?"
msgstr "[_M_] Dziękuję, ale... Co masz na sobie?"

# game/UpdateScript0.08_1.rpy:4973 #-#-# translate crowdin weekend_date_lounge_b094a3f2_1:
msgid "[_R_] I dressed up nice again... These are my really expensive designer jeans."
msgstr "[_R_] Znowu ładnie się ubrałam... To moje naprawdę drogie markowe dżinsy."

# game/UpdateScript0.08_1.rpy:4974 #-#-# translate crowdin weekend_date_lounge_3fa6eeae_1:
msgid "[_M_] Ummm... Ok."
msgstr "[_M_] Umm... OK."

# game/UpdateScript0.08_1.rpy:4975 #-#-# translate crowdin weekend_date_lounge_6aba5dba_1:
msgid "[_R_] You don't like..."
msgstr "[_R_] Nie lubisz..."

# game/UpdateScript0.08_1.rpy:4976 #-#-# translate crowdin weekend_date_lounge_7ef721ed_1:
msgid "[_M_] No... You should be yourself... I'm sure it'll be just fine."
msgstr "[_M_] Nie... Powinieneś być sobą... Jestem pewien, że wszystko będzie dobrze."

# game/UpdateScript0.08_1.rpy:4980 #-#-# translate crowdin weekend_date_lounge_deab7f06_1:
msgid "[_M_] You clean up pretty well yourself."
msgstr "[_M_] Sam sprzątasz całkiem nieźle."

# game/UpdateScript0.08_1.rpy:4981 #-#-# translate crowdin weekend_date_lounge_d54dc0f2:
msgid "[_M_] What a handsome young man you've become!"
msgstr "[_M_] Jakim przystojnym młodym mężczyzną się stałeś!"

# game/UpdateScript0.08_1.rpy:4982 #-#-# translate crowdin weekend_date_lounge_890450ef_1:
msgid "[_R_] Should we go?"
msgstr "[_R_] Czy powinniśmy iść?"

# game/UpdateScript0.08_1.rpy:4983 #-#-# translate crowdin weekend_date_lounge_c777253e:
msgid "[_M_] Yeah, I can't wait!"
msgstr "[_M_] Tak, nie mogę się doczekać!"

# game/UpdateScript0.08_1.rpy:4991 #-#-# translate crowdin weekend_date_lounge_16d61a7e:
msgid "[_RT_] {i}Shit!... What did that bastard do now?{/i}"
msgstr "[_RT_] {i}Cholera!... Co ten drań teraz zrobił?{/i}"

# game/UpdateScript0.08_1.rpy:4992 #-#-# translate crowdin weekend_date_lounge_a7453bdb:
msgid "[_RT_] {i}Dad doesn't deserve such an amazing woman.{/i}"
msgstr "[_RT_] {i}Tata nie zasługuje na tak niesamowitą kobietę.{/i}"

# game/UpdateScript0.08_1.rpy:4993 #-#-# translate crowdin weekend_date_lounge_edc1f122:
msgid "[_RT_] {i}Now, I've just got to get Mom to see it that way.{/i}"
msgstr "[_RT_] {i}Teraz muszę tylko przekonać mamę, żeby tak to postrzegała.{/i}"

# game/UpdateScript0.08_1.rpy:4996 #-#-# translate crowdin weekend_date_lounge_9eaf5062:
msgid "[_R_] Mom?"
msgstr "[_R_] Mamo?"

# game/UpdateScript0.08_1.rpy:4997 #-#-# translate crowdin weekend_date_lounge_62720feb:
msgid "[_R_] Are you ok?"
msgstr "[_R_] Wszystko w porządku?"

# game/UpdateScript0.08_1.rpy:5000 #-#-# translate crowdin weekend_date_lounge_d9440449:
msgid "[_M_] What is it, [ryan]!?"
msgstr "[_M_] Co to jest [ryan]!?"

# game/UpdateScript0.08_1.rpy:5001 #-#-# translate crowdin weekend_date_lounge_2c999767:
msgid "[_M_] I don't need any of your bullshit problems right now!"
msgstr "[_M_] Nie potrzebuję teraz żadnych twoich bzdurnych problemów!"

# game/UpdateScript0.08_1.rpy:5002 #-#-# translate crowdin weekend_date_lounge_f2a3a4f7:
msgid "[_R_] I... Uh..."
msgstr "[_R_] Ja... Ech..."

# game/UpdateScript0.08_1.rpy:5005 #-#-# translate crowdin weekend_date_lounge_46bfb67f:
msgid "[_M_] Oh, my God!... [ryan], I'm so sorry!"
msgstr "[_M_] O mój Boże!... [ryan], Tak mi przykro!"

# game/UpdateScript0.08_1.rpy:5006 #-#-# translate crowdin weekend_date_lounge_9695457e:
msgid "[_M_] I don't know what came over me..."
msgstr "[_M_] Nie wiem, co we mnie wstąpiło..."

# game/UpdateScript0.08_1.rpy:5007 #-#-# translate crowdin weekend_date_lounge_d0952f9b:
msgid "[_M_] It's just... I'm sorry!"
msgstr "[_M_] To po prostu... Przepraszam!"

# game/UpdateScript0.08_1.rpy:5010 #-#-# translate crowdin weekend_date_lounge_3a614dc0:
msgid "[_M_] Come here... Tell me what you need."
msgstr "[_M_] Chodź tutaj... Powiedz mi, czego potrzebujesz."

# game/UpdateScript0.08_1.rpy:5013 #-#-# translate crowdin weekend_date_lounge_620a5d49:
msgid "[_R_] Don't worry about what I need, Mom."
msgstr "[_R_] Nie martw się o to, czego potrzebuję, mamo."

# game/UpdateScript0.08_1.rpy:5014 #-#-# translate crowdin weekend_date_lounge_98756d7f:
msgid "[_R_] What can I do for you?... What do you need?"
msgstr "[_R_] Co mogę dla Ciebie zrobić?... Czego potrzebujesz?"

# game/UpdateScript0.08_1.rpy:5015 #-#-# translate crowdin weekend_date_lounge_f1fa41f9:
msgid "[_M_] Oh, it's just more problems with your dad."
msgstr "[_M_] Och, to po prostu więcej problemów z twoim tatą."

# game/UpdateScript0.08_1.rpy:5016 #-#-# translate crowdin weekend_date_lounge_9bc746ce:
msgid "[_M_] He doesn't want me to come during visitation hours anymore, unless he specifically invites me."
msgstr "[_M_] Nie chce już, żebym przychodziła w godzinach odwiedzin, chyba że mnie specjalnie zaprosi."

# game/UpdateScript0.08_1.rpy:5017 #-#-# translate crowdin weekend_date_lounge_f9f0e419:
msgid "[_M_] He said that since I didn't bother to come see him for so long after he got arrested, I can just wait longer to see him again."
msgstr "[_M_] Powiedział, że skoro nie zawracałem sobie głowy wizytą u niego przez tak długi czas po jego aresztowaniu, mogę po prostu poczekać dłużej, zanim znów się z nim zobaczę."

# game/UpdateScript0.08_1.rpy:5018 #-#-# translate crowdin weekend_date_lounge_6c687195:
msgid "[_M_] He said he needs that time to strategize with his lawyer."
msgstr "[_M_] Powiedział, że potrzebuje tego czasu na ustalenie strategii ze swoim prawnikiem."

# game/UpdateScript0.08_1.rpy:5019 #-#-# translate crowdin weekend_date_lounge_0adcfa48:
msgid "[_M_] But I was able to get his lawyer to admit that he's got someone else visiting him, but he wouldn't say who."
msgstr "[_M_] Ale udało mi się nakłonić jego prawnika, aby przyznał, że odwiedza go ktoś inny, ale nie powiedział kto."

# game/UpdateScript0.08_1.rpy:5020 #-#-# translate crowdin weekend_date_lounge_bde806c2:
msgid "[_R_] What a bastard!"
msgstr "[_R_] Co za drań!"

# game/UpdateScript0.08_1.rpy:5021 #-#-# translate crowdin weekend_date_lounge_d5af3c18:
msgid "[_M_] Normally I'd tell you not to talk about your dad like that, but right now, I don't disagree."
msgstr "[_M_] Normalnie powiedziałbym Ci, żebyś nie mówił w ten sposób o swoim tacie, ale teraz się z tym nie zgadzam."

# game/UpdateScript0.08_1.rpy:5022 #-#-# translate crowdin weekend_date_lounge_859a7d3b:
msgid "[_R_] Well, screw him... We don't need him."
msgstr "[_R_] No cóż, pieprzyć go... Nie potrzebujemy go."

# game/UpdateScript0.08_1.rpy:5023 #-#-# translate crowdin weekend_date_lounge_97ed3663:
msgid "[_R_] Let's show him that we can live our lives just fine without him."
msgstr "[_R_] Pokażmy mu, że możemy żyć bez niego."

# game/UpdateScript0.08_1.rpy:5024 #-#-# translate crowdin weekend_date_lounge_d9fea21f:
msgid "[_R_] Let's start by doing something to lift our spirits."
msgstr "[_R_] Zacznijmy od zrobienia czegoś, co poprawi nam nastrój."

# game/UpdateScript0.08_1.rpy:5025 #-#-# translate crowdin weekend_date_lounge_f78f8e23:
msgid "[_R_] I'm going to take you out on a date."
msgstr "[_R_] Zabiorę Cię na randkę."

# game/UpdateScript0.08_1.rpy:5026 #-#-# translate crowdin weekend_date_lounge_4e45d19b:
msgid "[_M_] [ryan], we don't have the money to do anything fun."
msgstr "[_M_] [ryan], nie mamy pieniędzy, żeby zrobić coś fajnego."

# game/UpdateScript0.08_1.rpy:5027 #-#-# translate crowdin weekend_date_lounge_44f79c29:
msgid "[_R_] Mom... We don't need money to have fun, but we can definitely have more fun with money."
msgstr "[_R_] Mamo... Nie potrzebujemy pieniędzy, żeby się dobrze bawić, ale z pewnością możemy mieć więcej zabawy za pieniądze."

# game/UpdateScript0.08_1.rpy:5028 #-#-# translate crowdin weekend_date_lounge_8e9a9855:
msgid "[_R_] That's why I've got some extra cash put aside for just such an emergency."
msgstr "[_R_] Dlatego odłożyłem trochę dodatkowej gotówki na taką awaryjną sytuację."

# game/UpdateScript0.08_1.rpy:5029 #-#-# translate crowdin weekend_date_lounge_3412a677:
msgid "[_M_] But [ryan], we need to use that money to..."
msgstr "[_M_] Ale [ryan], musimy wykorzystać te pieniądze, aby..."

# game/UpdateScript0.08_1.rpy:5030 #-#-# translate crowdin weekend_date_lounge_adcc06b0:
msgid "[_R_] We haven't fallen behind on our Mafia debt payments. If we don't do something for us, what's the point of living?"
msgstr "[_R_] Nie zalegamy ze spłatami długów mafii.\n"
"Jeśli nie zrobimy czegoś dla siebie, jaki jest sens życia?"

# game/UpdateScript0.08_1.rpy:5033 #-#-# translate crowdin weekend_date_lounge_7f0c2eeb:
msgid "[_M_] Yeah?"
msgstr ""

# game/UpdateScript0.08_1.rpy:5034 #-#-# translate crowdin weekend_date_lounge_11868771:
msgid "[_M_] Okay, I could really use a day out."
msgstr "[_M_] OK, naprawdę przydałby mi się dzień wolny."

# game/UpdateScript0.08_1.rpy:5035 #-#-# translate crowdin weekend_date_lounge_6a521fef:
msgid "[_M_] But, don't call it a date. That just sounds... weird."
msgstr "[_M_] Ale nie nazywaj tego randką.\n"
"To po prostu brzmi... dziwnie."

# game/UpdateScript0.08_1.rpy:5036 #-#-# translate crowdin weekend_date_lounge_6f86c43a:
msgid "[_R_] Why not?... When I was little, you always called our alone time together \"a date with Mommy.\""
msgstr "[_R_] Dlaczego nie?... Kiedy byłem mały, zawsze nazywałeś nasz wspólny czas „randką z mamusią”.\""

# game/UpdateScript0.08_1.rpy:5037 #-#-# translate crowdin weekend_date_lounge_9cf32931:
msgid "[_M_] Well, yeah... It was cute back then... Now it seems... inappropriate."
msgstr "[_M_] No cóż... Wtedy było to urocze... Teraz wydaje się... niestosowne."

# game/UpdateScript0.08_1.rpy:5038 #-#-# translate crowdin weekend_date_lounge_2053b440:
msgid "[_R_] I don't care what we call it. I'm just excited to spend some time with you."
msgstr "[_R_] Nie obchodzi mnie, jak to nazwiemy.\n"
"Jestem po prostu podekscytowany możliwością spędzenia z tobą trochę czasu."

# game/UpdateScript0.08_1.rpy:5039 #-#-# translate crowdin weekend_date_lounge_34d68d23:
msgid "[_M_] I guess this could be fun?"
msgstr "[_M_] Myślę, że to może być zabawne?"

# game/UpdateScript0.08_1.rpy:5040 #-#-# translate crowdin weekend_date_lounge_8edb11af:
msgid "[_M_] What do you have in mind?"
msgstr "[_M_] Co masz na myśli?"

# game/UpdateScript0.08_1.rpy:5041 #-#-# translate crowdin weekend_date_lounge_ed4750e0:
msgid "[_R_] Well, I know you like shopping."
msgstr "[_R_] No cóż, wiem, że lubisz zakupy."

# game/UpdateScript0.08_1.rpy:5042 #-#-# translate crowdin weekend_date_lounge_468f3437:
msgid "[_M_] I did like shopping... Now buying our clothes at the local Mal-Mart just doesn't get me very excited."
msgstr "[_M_] Lubiłem robić zakupy... Teraz kupowanie naszych ubrań w lokalnym Mal-Marcie po prostu nie wywołuje we mnie zbyt dużej ekscytacji."

# game/UpdateScript0.08_1.rpy:5043 #-#-# translate crowdin weekend_date_lounge_e7e9f191:
msgid "[_M_] I miss shopping downtown at the luxe clothing stores."
msgstr "[_M_] Tęsknię za zakupami w centrum miasta w luksusowych sklepach odzieżowych."

# game/UpdateScript0.08_1.rpy:5044 #-#-# translate crowdin weekend_date_lounge_9e4bdd83:
msgid "[_R_] Well, let's do that then."
msgstr "[_R_] No cóż, w takim razie zróbmy to."

# game/UpdateScript0.08_1.rpy:5045 #-#-# translate crowdin weekend_date_lounge_f020a73f:
msgid "[_M_] We can't afford to..."
msgstr "[_M_] Nie stać nas na..."

# game/UpdateScript0.08_1.rpy:5046 #-#-# translate crowdin weekend_date_lounge_70aaebe4:
msgid "[_R_] I think I can swing it."
msgstr "[_R_] Myślę, że dam radę."

# game/UpdateScript0.08_1.rpy:5049 #-#-# translate crowdin weekend_date_lounge_d7bb5c32:
msgid "[_M_] Seriously?"
msgstr "[_M_] Poważnie?"

# game/UpdateScript0.08_1.rpy:5050 #-#-# translate crowdin weekend_date_lounge_c605fb67:
msgid "[_R_] You bet."
msgstr "[_R_] No pewnie."

# game/UpdateScript0.08_1.rpy:5051 #-#-# translate crowdin weekend_date_lounge_888d7dbb:
msgid "[_R_] We'll go as soon as you're ready."
msgstr "[_R_] Pójdziemy, gdy tylko będziesz gotowy."

# game/UpdateScript0.08_1.rpy:5052 #-#-# translate crowdin weekend_date_lounge_5c641c9a:
msgid "[_M_] Okay, but you get ready too. You can't go to those fancy stores looking like that."
msgstr "[_M_] OK, ale ty też się przygotuj.\n"
"Nie możesz chodzić do tych drogich sklepów, wyglądając tak."

# game/UpdateScript0.08_1.rpy:5053 #-#-# translate crowdin weekend_date_lounge_9961b472:
msgid "[_R_] No... Of course not."
msgstr "[_R_] Nie... Oczywiście, że nie."

# game/UpdateScript0.08_1.rpy:5054 #-#-# translate crowdin weekend_date_lounge_687c6eee:
msgid "[_RT_] {i}What's wrong with shorts and a tank top?{/i}"
msgstr "[_RT_] {i}Co jest złego w szortach i podkoszulku?{/i}"

# game/UpdateScript0.08_1.rpy:5057 #-#-# translate crowdin weekend_date_lounge_88406c08_2:
msgid "[_RT_] {i}Hell, yeah!... Mom accepted my date invitation!{/i}"
msgstr "[_RT_] {i}Do diabła, tak!... Mama przyjęła moje zaproszenie na randkę!{/i}"

# game/UpdateScript0.08_1.rpy:5058 #-#-# translate crowdin weekend_date_lounge_57ab5b0f:
msgid "[_RT_] {i}She can call it whatever she likes, we both know what this is.{/i}"
msgstr "[_RT_] {i}Może to nazywać, jak chce, oboje wiemy, co to jest.{/i}"

# game/UpdateScript0.08_1.rpy:5059 #-#-# translate crowdin weekend_date_lounge_2a361a99_2:
msgid "[_RT_] {i}Now... What should I wear?{/i}"
msgstr "[_RT_] {i}Teraz... W co mam się ubrać?{/i}"

# game/UpdateScript0.08_1.rpy:5062 #-#-# translate crowdin weekend_date_lounge_3d471aa1_2:
msgid "[_RT_] {i}This looks a little casual, but anyone who knows about style will recognize that these jeans cost more than five hundred dollars.{/i}"
msgstr "[_RT_] {i}Wygląda to trochę zwyczajnie, ale każdy, kto zna się na stylu, zauważy, że te dżinsy kosztują ponad pięćset dolarów.{/i}"

# game/UpdateScript0.08_1.rpy:5063 #-#-# translate crowdin weekend_date_lounge_e8949588_2:
msgid "[_RT_] {i}And this shirt says a lot about who I am.{/i}"
msgstr "[_RT_] {i}Ta koszulka wiele mówi o tym, kim jestem.{/i}"

# game/UpdateScript0.08_1.rpy:5064 #-#-# translate crowdin weekend_date_lounge_789e57db:
msgid "[_RT_] {i}Holy hell!... I've been so busy lately that I've hardly gamed at all... I wonder if my online gamer buddies miss me.{/i}"
msgstr "[_RT_] {i}Do diabła!... Ostatnio byłem tak zajęty, że prawie w ogóle nie grałem... Zastanawiam się, czy moi kumple-gracze online tęsknią za mną.{/i}"

# game/UpdateScript0.08_1.rpy:5065 #-#-# translate crowdin weekend_date_lounge_30b7190a:
msgid "[_RT_] {i}Anyways... I think I look good, but maybe I should wear something else.{/i}"
msgstr "[_RT_] {i}W każdym razie... Myślę, że wyglądam dobrze, ale może powinienem założyć coś innego.{/i}"

# game/UpdateScript0.08_1.rpy:5071 #-#-# translate crowdin weekend_date_lounge_22148c7e_2:
msgid "[_RT_] {i}Damn... I look good!{/i}"
msgstr "[_RT_] {i}Cholera... Dobrze wyglądam!{/i}"

# game/UpdateScript0.08_1.rpy:5072 #-#-# translate crowdin weekend_date_lounge_839388d7_2:
msgid "[_RT_] {i}But am I overdoing it in a button up shirt?{/i}"
msgstr "[_RT_] {i}Ale czy nie przesadzę w koszuli zapinanej na guziki?{/i}"

# game/UpdateScript0.08_1.rpy:5073 #-#-# translate crowdin weekend_date_lounge_5d02071c:
msgid "[_RT_] {i}Is the other outfit too casual?... I haven't been shopping with Mom for so long, I can't remember how she'd have me dress.{/i}"
msgstr "[_RT_] {i}Czy ten drugi strój nie jest zbyt swobodny?... Już dawno nie chodzę z mamą na zakupy, nie pamiętam, jak kazała mi się ubrać.{/i}"

# game/UpdateScript0.08_1.rpy:5074 #-#-# translate crowdin weekend_date_lounge_fa273b36_2:
msgid "[_RT_] {i}Which one should I wear?{/i}"
msgstr "[_RT_] {i}Który mam założyć?{/i}"

# game/UpdateScript0.08_1.rpy:5080 #-#-# translate crowdin weekend_date_lounge_aed8e672_2:
msgid "[_RT_] {i}The more casual outfit?{/i}"
msgstr "[_RT_] {i}Bardziej swobodny strój?{/i}"

# game/UpdateScript0.08_1.rpy:5086 #-#-# translate crowdin weekend_date_lounge_5e2d7d70_2:
msgid "[_RT_] {i}Or the more formal looking one?{/i}"
msgstr "[_RT_] {i}A może bardziej formalny?{/i}"

# game/UpdateScript0.08_1.rpy:5094 #-#-# translate crowdin weekend_date_lounge_f91d85b8_4:
