# TODO: Translation updated at 2024-07-23 08:27 #|#|# # game/Cosplay_gallery.rpy:1214 #-#-# translate crowdin cosplay_label_c1f386dd:
msgid "[_RT_] {i}Yes... I have sold another pair of oufits for $[sold] more.{/i}"
msgstr "[_RT_] {i}Tak... Sprzedałem kolejną parę strojów za $[sold] więcej.{/i}"

# game/Cosplay_gallery.rpy:1219 #-#-# translate crowdin cosplay_label_16130f80:
msgid "[_RT_] {i}I should check if I got any likes and if I can transfer the money to my account.{/i}"
msgstr "[_RT_] {i}Powinienem sprawdzić, czy mam jakieś polubienia i czy mogę przelać pieniądze na moje konto.{/i}"

# game/Cosplay_gallery.rpy:1794 #-#-# translate crowdin supporters_income_photoshoot_26a16025:
msgid "You were sponsored by a total of [var_total_supporters] supporters and earned $[var_earnings_from_supporters]!"
msgstr "Byłeś sponsorowany przez [var_total_supporters] wspierających i zarobiłeś $[var_earnings_from_supporters]!"

# game/Cosplay_gallery.rpy:1799 #-#-# translate crowdin supporters_income_photoshoot_aa36c7f3:
msgid "You have already withdrawn the money that you have earned this month!"
msgstr "Pieniądze zarobione w tym miesiącu zostały już wypłacone!"

# game/Cosplay_gallery.rpy:1804 #-#-# translate crowdin supporters_income_photoshoot_ed87ddab:
msgid "[_RT_] {i}I must wait until the end of the month to withdraw my funds.{/i}"
msgstr "[_RT_] {i}Muszę poczekać do końca miesiąca, aby wypłacić moje środki."

# game/Cosplay_gallery.rpy:1823 #-#-# translate crowdin income_photoshoot_9eef3851:
msgid "You have received [new_likes] new likes and earned $[income]!"
msgstr "Otrzymałeś [new_likes] nowych polubień i zarobiłeś $[income]!"

# game/Cosplay_gallery.rpy:1828 #-#-# translate crowdin income_photoshoot_e4c275b3:
msgid "You have already withdrawn the money that you have earned!"
msgstr "Wypłaciłeś już zarobione pieniądze!"

# game/Cosplay_gallery.rpy:1833 #-#-# translate crowdin income_photoshoot_35500616:
msgid "[_RT_] {i}I must wait until the end of the week to withdraw my funds.{/i}"
msgstr "[_RT_] {i}Muszę poczekać do końca tygodnia, aby wypłacić moje środki."

# game/Cosplay_gallery.rpy:1847 #-#-# translate crowdin advertising_label_4491e190:
msgid "[_RT_] {i}For only 5 bucks I'll get more likes. I should remember to do this daily.{/i}"
msgstr "[_RT_] {i}Za jedyne 5 dolców dostanę więcej polubień. Powinienem pamiętać, żeby robić to codziennie."

# game/Cosplay_gallery.rpy:1850 #-#-# translate crowdin advertising_label_15ea30e2:
msgid "[_RT_] {i}I already advertised today.{/i}"
msgstr "[_RT_] {i}Reklamowałem się już dzisiaj.{/i}"

# game/Cosplay_gallery.rpy:1865 #-#-# translate crowdin outfits_sell_label_606ee1bf:
msgid "[_RT_] {i}Yes... The outfits were sold and now I have $[sold] more in my account.{/i}"
msgstr "[_RT_] {i}Tak... Stroje zostały sprzedane i teraz mam $[sold] więcej na moim koncie.{/i}"

# game/Cosplay_gallery.rpy:1872 #-#-# translate crowdin outfits_sell_label_68310073:
msgid "[_RT_] {i}I should sell the cosplay outfits.{/i}"
msgstr "[_RT_] {i}Powinienem sprzedać stroje cosplayowe.{/i}"

# game/Cosplay_gallery.rpy:1874 #-#-# translate crowdin outfits_sell_label_5cd5db5b:
msgid "[_RT_] {i}There... all outfits have been put up for sale, now I'll just have to wait and see if they'll sell.{/i}"
msgstr "[_RT_] {i}Tam... wszystkie stroje zostały wystawione na sprzedaż, teraz muszę tylko poczekać i zobaczyć, czy się sprzedadzą."

# game/Cosplay_gallery.rpy:1880 #-#-# translate crowdin outfits_sell_label_b7c5d749:
msgid "[_RT_] {i}I don't have anything to sell.{/i}"
msgstr "[_RT_] {i}Nie mam nic do sprzedania.{/i}"

# game/Cosplay_gallery.rpy:1889 #-#-# translate crowdin outfit_info_488a37ce:
msgid "[_RT_] {i} The first cosplay outfit that [outfit_nfo_name] wore on our first photoshoot.{/i}"
msgstr "[_RT_] {i} Pierwszy strój, który [outfit_nfo_name] miał na sobie podczas naszej pierwszej sesji zdjęciowej.{/i}"

# game/Cosplay_gallery.rpy:1890 #-#-# translate crowdin outfit_info_d4afad73:
msgid "[_RT_] {i}I hope we can sell more of them.{/i}"
msgstr "[_RT_] {i}Mam nadzieję, że uda nam się sprzedać ich więcej.{/i}"

