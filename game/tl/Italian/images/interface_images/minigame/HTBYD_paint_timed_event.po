# TODO: Translation updated at 2024-07-23 08:27 #|#|# # game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:126 #-#-# translate crowdin HTBYD_game_start_lbl_2bc58679:
msgid "[_MS_] That's the picture of Lauren you're going to use?"
msgstr "[_MS_] Questa è la foto di Lauren che userete?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:127 #-#-# translate crowdin HTBYD_game_start_lbl_09808be8:
msgid "[_R_] Yeah, do you like it?"
msgstr "[_R_] Sì, ti piace?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:128 #-#-# translate crowdin HTBYD_game_start_lbl_f8e32db7:
msgid "[_MS_] I'm... It's... Well..."
msgstr "[_MS_] Io... Eh... Beh..."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:129 #-#-# translate crowdin HTBYD_game_start_lbl_b68b5762:
msgid "[_MS_] Is Lauren okay with this?"
msgstr "[_MS_] Lauren è d'accordo?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:130 #-#-# translate crowdin HTBYD_game_start_lbl_d597c159:
msgid "[_R_] It was mostly her idea."
msgstr "[_R_] E' stata soprattutto una sua idea."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:131 #-#-# translate crowdin HTBYD_game_start_lbl_f7155a88:
msgid "[_RT_] {i}With a lot of coaxing.{/i}"
msgstr "[_RT_] {i}Con un bel po' di persuasione.{/i}"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:132 #-#-# translate crowdin HTBYD_game_start_lbl_2dc7ff8f:
msgid "[_MST_] {i}Oh my God!... That will get the attention of all the students for sure. These kids are bringing their \"A game\"{/i}"
msgstr "[_MST_] {i}Oh mio Dio!... Così avrà l'attenzione di tutti gli studenti di sicuro. Questi ragazzi stanno dando il meglio di sè{/i}"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:133 #-#-# translate crowdin HTBYD_game_start_lbl_2fb4108b:
msgid "[_MST_] {i}It's also useful to know that [ryan] and Lauren are anything but prudes.{/i}"
msgstr "[_MST_] {i}È anche utile sapere che [ryan] e Lauren sono tutt'altro che bacchettoni.{/i}"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:134 #-#-# translate crowdin HTBYD_game_start_lbl_6a9bbe49:
msgid "[_MS_] Lauren looks a lot like the girl in that movie \"How to Breed your Dragon.\", only with much fewer... clothes on... What's her name?... Assturd?"
msgstr "[_MS_] Lauren assomiglia molto alla ragazza in quel film \"Come Allevare il tuo Drago.\", solo con molti meno... vestiti... Come si chiamava?... Assturd?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:135 #-#-# translate crowdin HTBYD_game_start_lbl_1ab2361d:
msgid "[_R_] Yeah, that's exactly right."
msgstr "[_R_] Sì, esatto."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:136 #-#-# translate crowdin HTBYD_game_start_lbl_aab0d72b:
msgid "[_MS_] Ok, good. So you want the poster to reflect that with a proper background, and a proper slogan... So take a second to think about it."
msgstr "[_MS_] Ok, bene. Quindi vuoi che il poster rifletta questa cosa con uno sfondo ad hoc, e uno slogan adeguato... Allora prenditi un secondo per pensarci."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:137 #-#-# translate crowdin HTBYD_game_start_lbl_dc7a84b6:
msgid "[_R_] ...."
msgstr "[_R_] ...."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:138 #-#-# translate crowdin HTBYD_game_start_lbl_9126eb03:
msgid "[_R_] Ok... I think I've got an idea."
msgstr "[_R_] Ok... Penso di avere un'idea."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:139 #-#-# translate crowdin HTBYD_game_start_lbl_75b88557:
msgid "[_MS_] Ok... Just let your creativity flow."
msgstr "[_MS_] Ok... Lascia che la tua creatività fluisca."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:141 #-#-# translate crowdin HTBYD_game_start_lbl_d89be794:
msgid "[_MS_] You still want to use that particular picture?"
msgstr "[_MS_] Vuoi ancora usare quella particolare immagine?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:142 #-#-# translate crowdin HTBYD_game_start_lbl_d6db9db2:
msgid "[_R_] Yeah, why not?"
msgstr "[_R_] Sì, perché no?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:143 #-#-# translate crowdin HTBYD_game_start_lbl_d30bcd4d:
msgid "[_MS_] No reason."
msgstr "[_MS_] Non c'è motivo."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:144 #-#-# translate crowdin HTBYD_game_start_lbl_0d5e265d:
msgid "[_MST_] {i}Unless you've got something even sexier.{/i}"
msgstr "[_MST_] {i}A meno che tu non abbia qualcosa di più sexy{/i}"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:145 #-#-# translate crowdin HTBYD_game_start_lbl_e0d14e45:
msgid "[_MST_] {i}I'm not even into women, but I can appreciate a beautiful young ass.{/i}"
msgstr "[_MST_] {i}Nemmeno mi piacciono le donne, ma riesco ad apprezzare un bel culo giovane.{/i}"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:146 #-#-# translate crowdin HTBYD_game_start_lbl_89598738:
msgid "[_MS_] Now, remember your theme."
msgstr "[_MS_] Ora, ricorda il tuo tema."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:147 #-#-# translate crowdin HTBYD_game_start_lbl_83bad045:
msgid "[_MS_] Think of a good slogan..."
msgstr "[_MS_] Pensa a un buon slogan..."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:148 #-#-# translate crowdin HTBYD_game_start_lbl_4de1d815:
msgid "[_MS_] And let your creativity flow."
msgstr "[_MS_] E lasciate fluire la vostra creatività."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:149 #-#-# translate crowdin HTBYD_game_start_lbl_771f9494:
msgid "[_R_] Ok... I think I'm ready."
msgstr "[_R_] Ok... Penso di essere pronto."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:161 #-#-# translate crowdin HTBYD_game_end_lbl_fccd1316:
msgid "[_MS_] Wow... That's really good."
msgstr "[_MS_] Wow... Questo è davvero buono."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:162 #-#-# translate crowdin HTBYD_game_end_lbl_9284b59b:
msgid "[_MST_] {i}The slogan is a bit provocative, but it definitely goes with the flavor of the picture.{/i}"
msgstr "[_MST_] {i}Lo slogan è un po' provocatorio, ma sicuramente si sposa con quel che c'è nella foto.{/i}"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:163 #-#-# translate crowdin HTBYD_game_end_lbl_618f050e:
msgid "[_R_] Yeah... I just did exactly what you said..."
msgstr "[_R_] Sì... Ho fatto esattamente quello che hai detto..."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:164 #-#-# translate crowdin HTBYD_game_end_lbl_768d340b:
msgid "[_R_] You're such a good art teacher!"
msgstr "[_R_] Sei davvero un'ottima insegnante di arte!"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:165 #-#-# translate crowdin HTBYD_game_end_lbl_6a29bd12:
msgid "[_MS_] Ohhh... That's so sweet!"
msgstr "[_MS_] Ohhh... Che dolce!"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:166 #-#-# translate crowdin HTBYD_game_end_lbl_685dbb3b:
msgid "[_MS_] Now, is that it, or did you say you need to design another poster?"
msgstr "[_MS_] Ora, va bene così, o volevi progettare un altro poster?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:167 #-#-# translate crowdin HTBYD_game_end_lbl_955333a5:
msgid "[_R_] I've got one more."
msgstr "[_R_] Ne ho un altro."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:168 #-#-# translate crowdin HTBYD_game_end_lbl_9de72fec:
msgid "[_MS_] Ok, let's set it up."
msgstr "[_MS_] Ok, sviluppiamolo."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:176 #-#-# translate crowdin HTBYD_game_end_lbl_acb68e2b:
msgid "[_MS_] The background is looking nice, now bring it home with a creative slogan."
msgstr "[_MS_] Lo sfondo sembra bello, ora portalo a casa con uno slogan creativo."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:177 #-#-# translate crowdin HTBYD_game_end_lbl_67c6ec22:
msgid "[_R_] Alright... I've got this."
msgstr "[_R_] Bene... Ho questo."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:184 #-#-# translate crowdin HTBYD_game_end_lbl_6a323a1c:
msgid "[_MS_] Oh... That's... Hmmm..."
msgstr "[_MS_] Oh... Qui... Hmmm..."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:185 #-#-# translate crowdin HTBYD_game_end_lbl_8c85cc34:
msgid "[_R_] Well... That didn't end up the way I planned."
msgstr "[_R_] Bene... Non è finita come avevo pianificato."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:186 #-#-# translate crowdin HTBYD_game_end_lbl_14eba41d:
msgid "[_R_] But, I think nobody will really care since they will just be paying attention to the picture of Lauren."
msgstr "[_R_] Ma, penso che nessuno si interesserà davvero, perché presteranno attenzione solo alla foto di Lauren."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:187 #-#-# translate crowdin HTBYD_game_end_lbl_6c494ceb:
msgid "[_MS_] Hmmm... Well, you may be right."
msgstr "[_MS_] Hmmm... Beh, potresti aver ragione."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:188 #-#-# translate crowdin HTBYD_game_end_lbl_685dbb3b_1:
msgid "[_MS_] Now, is that it, or did you say you need to design another poster?"
msgstr "[_MS_] Ora, va bene così, o volevi progettare un altro poster?"

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:189 #-#-# translate crowdin HTBYD_game_end_lbl_955333a5_1:
msgid "[_R_] I've got one more."
msgstr "[_R_] Ne ho un altro."

# game/images/interface_images/minigame/HTBYD_paint_timed_event.rpy:190 #-#-# translate crowdin HTBYD_game_end_lbl_9de72fec_1:
msgid "[_MS_] Ok, let's set it up."
msgstr "[_MS_] Ok, sviluppiamolo."

