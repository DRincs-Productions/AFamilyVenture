msgstr "[_R_] Non ho capito bene allora, ma ora comincia ad avere un pò di senso.... "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18113 #-#-# translate crowdin label_gal_aunt_01_19ab8463:
