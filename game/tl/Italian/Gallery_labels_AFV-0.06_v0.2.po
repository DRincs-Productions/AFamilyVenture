# game/Gallery_labels_AFV-0.06_v0.2.rpy:4196 #-#-# translate crowdin label_gal_mom_sushi_date_fe59078e:
msgid "[_R_] Joey's the one who had it made for me. I imagine it's pretty bullet proof."
msgstr "[_R_] Joey è quello che ha fatto per me. Immagino che sia una bella prova di proiettile."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4197 #-#-# translate crowdin label_gal_mom_sushi_date_15873dbb:
msgid "[_R_] Did you ever have a fake ID?"
