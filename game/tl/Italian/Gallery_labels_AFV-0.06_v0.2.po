# game/Gallery_labels_AFV-0.06_v0.2.rpy:18087 #-#-# translate crowdin label_gal_aunt_01_4ba52396:
msgid "[_C_] I've been a stay at home mom for 18 years.... I have no work experience.... "
msgstr "[_C_] Sono stata una mamma casalinga per 18 anni.... Non ho esperienza lavorativa.... "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18088 #-#-# translate crowdin label_gal_aunt_01_80934761:
msgid "[_C_] I have no money to try and start a business with."
