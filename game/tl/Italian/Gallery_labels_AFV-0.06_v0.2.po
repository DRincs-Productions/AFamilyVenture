# game/Gallery_labels_AFV-0.06_v0.2.rpy:17992 #-#-# translate crowdin label_gal_aunt_01_856c6b5b:
msgid "[_B_] I'll only be sending enough money to take care of her bills, plus an extra $200 a week to pay you for your trouble."
