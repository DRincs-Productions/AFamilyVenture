# game/Gallery_labels_AFV-0.06_v0.2.rpy:21532 #-#-# translate crowdin label_gal_aunt_06_962d70e9:
msgid "[_C_] I can't believe this! You should be chasing down that filthy pervert, not obeying some criminal's orders!"
