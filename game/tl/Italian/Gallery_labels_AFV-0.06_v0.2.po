# game/Gallery_labels_AFV-0.06_v0.2.rpy:16170 #-#-# translate crowdin label_gal_halloween_event_start_d281af74:
msgid "[_RT_] {i}Shit!... Was the headboard banging the wall, or something?{/i}"
msgstr "[_RT_] {i}Shit!... La testiera stava sbattendo il muro, o qualcosa?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16171 #-#-# translate crowdin label_gal_halloween_event_start_6b240bd3:
msgid "[_M_] Sidney said she was helping you with your homework."
msgstr "[_M_] Sidney ha detto che ti stava aiutando con i compiti."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16172 #-#-# translate crowdin label_gal_halloween_event_start_3efe6b16:
msgid "[_R_] Oh, yeah... she was helping me with my science homework."
msgstr "[_R_] Oh, sì... mi stava aiutando con i miei compiti di scienza."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16173 #-#-# translate crowdin label_gal_halloween_event_start_630cfec0:
