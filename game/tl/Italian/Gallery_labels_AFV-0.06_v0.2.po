# game/Gallery_labels_AFV-0.06_v0.2.rpy:23147 #-#-# translate crowdin label_gal_Xmas_event_49d996c3:
msgid "[_GP_] Oh, stop thinking with your cock, and try to appreciate this moment. You're about to see them fall in love!"
