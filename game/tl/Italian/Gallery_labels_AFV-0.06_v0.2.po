msgid "[_M_] [ryan] isn't taking any history classes this semester."
msgstr "[_M_] [ryan] non sta prendendo nessuna classe di storia questo semestre."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16147 #-#-# translate crowdin label_gal_halloween_event_start_552dbc0d:
msgid "[_S_] I meant math... I was helping him with his math."
msgstr "[_S_] intendevo matematica... lo stavo aiutando con la sua matematica."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16150 #-#-# translate crowdin label_gal_halloween_event_start_6341bb24:
msgid "[_R_] No, I'm not telling you. Try to remember what the dwarves told you about the DemiGobbler in the tavern."
msgstr "[_R_] No, non ti sto dicendo. Prova a ricordare quello che i nani ti hanno detto del DemiGobbler nella taverna."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16151 #-#-# translate crowdin label_gal_halloween_event_start_5a4ee3dd:
msgid "[_L_] That was like three campaigns ago!"
msgstr "[_L_] Era come tre campagne fa!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16154 #-#-# translate crowdin label_gal_halloween_event_start_2d13ad32:
msgid "[_R_] Well, you should have written it down!"
msgstr "[_R_] Beh, dovresti averlo scritto!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16157 #-#-# translate crowdin label_gal_halloween_event_start_6d3df87a:
msgid "{b}{i}SMACK!{/i}{/b}"
msgstr "{b}{i}SMACK!{/i}{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16160 #-#-# translate crowdin label_gal_halloween_event_start_6acbbe13:
msgid "[_R_] Ow!"
msgstr "[_R_] Ow!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16161 #-#-# translate crowdin label_gal_halloween_event_start_88d32b57:
msgid "[_S_] Later, nerds!"
msgstr "[_S_] Più tardi, nerds!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16164 #-#-# translate crowdin label_gal_halloween_event_start_f8055650_1:
msgid "[_M_] [ryan]?"
msgstr "[_M_] [ryan]?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16165 #-#-# translate crowdin label_gal_halloween_event_start_c92246b7:
msgid "[_R_] Really, Mom? You're going to interrupt our campaign again?"
msgstr "[_R_] Davvero, Mom? Stai per interrompere di nuovo la nostra campagna?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16166 #-#-# translate crowdin label_gal_halloween_event_start_59feb98a:
msgid "[_M_] What were you and Sidney doing up so late last night?"
