# game/Gallery_labels_AFV-0.06_v0.2.rpy:23146 #-#-# translate crowdin label_gal_Xmas_event_2e5bac34:
msgid "[_RT_] {i}Well, I know seeing Mom strip made me fall in love.... that is, I already loved her, but now I want to bang her.{/i}"
