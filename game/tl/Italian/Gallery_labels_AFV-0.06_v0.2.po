# game/Gallery_labels_AFV-0.06_v0.2.rpy:18104 #-#-# translate crowdin label_gal_aunt_01_3cd78526:
msgid "[_C_] .... {i}(loud whispering){/i} Camille.... "
msgstr "[_C_] .... {i}(forte whispering){/i} Camilla.... "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18105 #-#-# translate crowdin label_gal_aunt_01_664b74a7:
msgid "[_R_] Is there anything I can do to help?"
