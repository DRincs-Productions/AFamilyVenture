# game/Gallery_labels_AFV-0.06_v0.2.rpy:33597 #-#-# translate crowdin label_gal_mom_sushi_date_joey_5b2f8cb0:
msgid "[_A_] Is your mom that easy?"
msgstr "[_A_] Tua mamma è così facile?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33598 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d6797e6b:
