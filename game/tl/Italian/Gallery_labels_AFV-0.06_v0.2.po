# game/Gallery_labels_AFV-0.06_v0.2.rpy:3733 #-#-# translate crowdin label_gal_mom_ph_read_a7b77f27:
msgid "[_RT_] {i}Uggghh...{/i}"
msgstr "[_RT_] {i}Uggghh...{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3734 #-#-# translate crowdin label_gal_mom_ph_read_a854f278:
msgid "[_RT_] {i}I've avoided reading this series for as long as I could.{/i}"
msgstr "[_RT_] {i}Ho evitato di leggere questa serie il più a lungo possibile."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3735 #-#-# translate crowdin label_gal_mom_ph_read_7d0423a7:
msgid "[_RT_] {i}I always thought being a Perry Hotter nerd would keep me from getting laid.{/i}"
msgstr "[_RT_] {i}Ho sempre pensato che essere un nerd Perry Hotter mi avrebbe impedito di fare sesso.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3736 #-#-# translate crowdin label_gal_mom_ph_read_185f75a4:
msgid "[_RT_] {i}Now, it seems like it's the best path to getting laid.{/i}"
msgstr "[_RT_] {i}Ora, sembra che sia la strada migliore per fare sesso.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3737 #-#-# translate crowdin label_gal_mom_ph_read_fce8b27c:
