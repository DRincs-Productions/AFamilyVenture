# game/Gallery_labels_AFV-0.06_v0.2.rpy:21019 #-#-# translate crowdin label_gal_aunt_05_6cc092fc:
msgid "[_BJ_dealer_] Do you want to double up?"
msgstr "[_BJ_dealer_] Si desidera raddoppiare?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21020 #-#-# translate crowdin label_gal_aunt_05_dc424d0b:
msgid "[_C_] What's that?"
msgstr "[_C_] Che cos'è?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21021 #-#-# translate crowdin label_gal_aunt_05_20493be9:
msgid "[_BJ_dealer_] House rule... You can double your bet on certain pairs, even if you split them."
msgstr "[_BJ_dealer_] Regola di casa... Puoi raddoppiare la tua scommessa su certe coppie, anche se le hai divise."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21022 #-#-# translate crowdin label_gal_aunt_05_c3278244:
msgid "[_BJ_dealer_] This way you can win twice as much on each card."
msgstr "[_BJ_dealer_] In questo modo puoi vincere il doppio di ogni carta."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21025 #-#-# translate crowdin label_gal_aunt_05_e6940f66:
msgid "[_R_] Whoa, hang on! That would..."
msgstr "[_R_] Whoa, appendere! Quello..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21026 #-#-# translate crowdin label_gal_aunt_05_429203a2:
msgid "[_C_] My, god! Will you stop nagging me you little shit?! I know... I know what I'm doing."
msgstr "[_C_] Mia, dio! Smetterai di mettermi in cattiva morta?! Lo so... so cosa sto facendo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21027 #-#-# translate crowdin label_gal_aunt_05_6a865b58:
msgid "[_C_] Double up!"
msgstr "[_C_] Doppio!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21028 #-#-# translate crowdin label_gal_aunt_05_8b3c7297:
msgid "[_C_] Hehe... that's fun to say."
msgstr "[_C_] Hehe... è divertente da dire."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21031 #-#-# translate crowdin label_gal_aunt_05_0a4ea6ad:
msgid "[_R_] You're drunk... Look at your chips! You're all in! If you lose this, you'll owe Mr. DeCapo a ton of money. Just like my Mom."
msgstr "[_R_] Sei ubriaco... Guarda i tuoi chip! Sei tutto! Se perdi questo, dovrai il signor DeCapo un sacco di soldi. Proprio come la mia mamma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21032 #-#-# translate crowdin label_gal_aunt_05_d24b15e9:
msgid "[_C_] Oh... I... Shit! The dealer had a jack... I didn't even look at her card."
msgstr "[_C_] Oh... Io... Merda! Il concessionario aveva un jack... Non ho nemmeno guardato la sua carta."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21035 #-#-# translate crowdin label_gal_aunt_05_899ef953:
msgid "[_BJ_dealer_] A ten for the lucky lady."
msgstr "[_BJ_dealer_] Una decina per la fortunata."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21036 #-#-# translate crowdin label_gal_aunt_05_5318e77d:
msgid "[_C_] Hah! Twenty one!"
msgstr "[_C_] Hah! Ventuno!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21039 #-#-# translate crowdin label_gal_aunt_05_182d8c88:
msgid "[_BJ_dealer_] Another ten. Player has twenty one on both bets."
msgstr "[_BJ_dealer_] Un altro dieci. Il giocatore ha ventuno su entrambe le puntate."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21040 #-#-# translate crowdin label_gal_aunt_05_5d8c8893:
msgid "[_C_] Oh, my God!"
msgstr "[_C_] Oh, mio Dio!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21043 #-#-# translate crowdin label_gal_aunt_05_cbbb16b5:
msgid "[_C_] I finally did it! I haven't... haven't felt this good since before my no-good-cheating-husb... husband left!"
msgstr "[_C_] Finalmente l'ho fatta! Non l'ho fatto... non mi sono sentito bene da prima che il mio no-buon tradimento-marito... marito se ne andasse!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21044 #-#-# translate crowdin label_gal_aunt_05_1ca33fa7:
msgid "[_R_] Phew."
msgstr "[_R_] Phew."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21045 #-#-# translate crowdin label_gal_aunt_05_500a276c:
msgid "[_R_] Well... Mom will be happy, I guess."
msgstr "[_R_] Bene... La mamma sarà felice, immagino."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21048 #-#-# translate crowdin label_gal_aunt_05_31f992ee:
msgid "[_C_] Hah! You think I'm going to spend a single dollar on her husband's debts?"
msgstr "[_C_] Hah! Pensi che spenderò un solo dollaro per i debiti del marito?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21049 #-#-# translate crowdin label_gal_aunt_05_99c2d48d:
msgid "[_C_] Not a chance!"
msgstr "[_C_] Non è un'occasione!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21050 #-#-# translate crowdin label_gal_aunt_05_0493fb33:
msgid "[_C_] I'm taking Mandy, and we're moving out as soon as possible to start our new life."
msgstr "[_C_] Sto prendendo Mandy, e ci stiamo muovendo il più presto possibile per iniziare la nostra nuova vita."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21051 #-#-# translate crowdin label_gal_aunt_05_71667086:
msgid "[_R_] Wait, what about us?"
msgstr "[_R_] Aspetta, che dire di noi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21052 #-#-# translate crowdin label_gal_aunt_05_a01f3434:
msgid "[_R_] Mom took you in when Uncle Bobby ran off, after the feds took your house... if it wasn't for Mom letting you live with us, you'd be in some shitty run down apartment."
msgstr "[_R_] Mamma ti ha portato quando lo zio Bobby è scappato, dopo che i letti hanno preso la tua casa... se non fosse per la mamma che ti ha permesso di vivere con noi, saresti in un po 'di ciottolo correre giù l'appartamento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21055 #-#-# translate crowdin label_gal_aunt_05_8e645972:
msgid "[_C_] So, what?"
msgstr "[_C_] Allora, cosa?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21056 #-#-# translate crowdin label_gal_aunt_05_72bfa7fd:
msgid "[_C_] I'm supposed to be grateful after she made me wear that ridiculous maid costume, and clean her house?"
msgstr "[_C_] Dovrei essere grato dopo che mi ha fatto indossare quel costume da cameriera ridicolo, e pulire la sua casa?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21057 #-#-# translate crowdin label_gal_aunt_05_d413d281:
msgid "[_C_] She treated me like I was her servant!"
msgstr "[_C_] Mi ha trattato come se fossi il suo servo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21058 #-#-# translate crowdin label_gal_aunt_05_c8d60631:
msgid "[_C_] As for you, you little shit."
msgstr "[_C_] Per quanto riguarda te, piccola merda."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21059 #-#-# translate crowdin label_gal_aunt_05_7ae66dfe:
msgid "[_C_] Always sneaking around, leering at Mandy and me."
msgstr "[_C_] sempre furtivamente intorno, appoggiandosi a Mandy e me."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21060 #-#-# translate crowdin label_gal_aunt_05_272e3e7a:
msgid "[_C_] You're a creep, [ryan]! Even when you were a little kid, I had you pegged as a loser."
msgstr "[_C_] Sei uno strisciante, [ryan]! Anche quando eri un bambino, ti avevo ancorato come un perdente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21061 #-#-# translate crowdin label_gal_aunt_05_8f115a63:
msgid "{i}{b}\"Aunt Camille's Affection =0\"{/b}{/i}"
msgstr "{i}{b}\"Aunt Camille's Affection =0\"{/b}{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21062 #-#-# translate crowdin label_gal_aunt_05_5e599aa5:
msgid "[_C_] You'll never amount to anything."
msgstr "[_C_] Non ammonterai mai a niente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21063 #-#-# translate crowdin label_gal_aunt_05_a56d0f26:
msgid "{i}{b}\"Aunt Camille's Respect = 0\"{/b}{/i}"
msgstr "{i}{b}\"Aunt Camille's Respect = 0\"{/b}{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21064 #-#-# translate crowdin label_gal_aunt_05_02d158d0:
msgid "[_C_] I can't believe I ever let you treat me like you have. Well, not anymore."
msgstr "[_C_] Non posso credere che ti lasci mai trattare come te. Beh, non più."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21065 #-#-# translate crowdin label_gal_aunt_05_56090968:
msgid "{i}{b}\"Aunt Camille's Submission = 0\"{/b}{/i}"
msgstr "{i}{b}\"Aunt Camille's Submission = 0\"{/b}{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21066 #-#-# translate crowdin label_gal_aunt_05_a7f1039d:
msgid "[_C_] Soon, I'll be drinking the best wines, and taking Mandy to get manny petties on the weekends..."
msgstr "[_C_] Presto berò i migliori vini e prenderò Mandy per prendere dei piccoli maniaci nei fine settimana..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21067 #-#-# translate crowdin label_gal_aunt_05_da6005ab:
msgid "[_BJ_dealer_] Ace of Diamonds... Dealer has {b}BlackJack{/b}."
msgstr "[_BJ_dealer_] Asso di diamanti... Il concessionario ha {b}BlackJack{/b}."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21070 #-#-# translate crowdin label_gal_aunt_05_8a709e4a:
msgid "[_BJ_dealer_] Player loses."
msgstr "[_BJ_dealer_] Giocatore perde."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21071 #-#-# translate crowdin label_gal_aunt_05_6e3a2a53_1:
msgid "[_C_] What?"
msgstr "[_C_] Cosa?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21072 #-#-# translate crowdin label_gal_aunt_05_466961ca:
msgid "[_R_] Oh, fuck..."
msgstr "[_R_] Oh, fuck..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21075 #-#-# translate crowdin label_gal_aunt_05_33e40c4d:
msgid "[_R_] I told you to quit while you were ahead!"
msgstr "[_R_] Ti ho detto di uscire mentre eri in avanti!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21076 #-#-# translate crowdin label_gal_aunt_05_e2c8cd52:
msgid "[_C_] But... Hang on, it's a tie... I mean a, umm... a push!"
msgstr "[_C_] Ma... Aspetta, è una cravatta... intendo a, umm... una spinta!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21079 #-#-# translate crowdin label_gal_aunt_05_e96c9672:
msgid "[_C_] Stop!"
msgstr "[_C_] Fermato!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21080 #-#-# translate crowdin label_gal_aunt_05_d573edcc:
msgid "[_C_] We both have twenty one. It's a tie!"
msgstr "[_C_] Abbiamo entrambi ventuno. È una cravatta!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21081 #-#-# translate crowdin label_gal_aunt_05_d9dcc9e3:
msgid "[_BJ_dealer_] Sorry, but a blackjack beats a twenty one. I'll need to take these chips Ma'am."
msgstr "[_BJ_dealer_] Mi dispiace, ma un blackjack batte una ventina. Dovrò prendere queste fiches Ma'am."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21084 #-#-# translate crowdin label_gal_aunt_05_3e8fee8a:
msgid "[_J_] Hello, Camille. Just checking in. Thought I'd bring you over another drink."
msgstr "[_J_] Ciao, Camille. Basta controllare. Pensavo che ti avrei portato sopra un'altra bevanda."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21085 #-#-# translate crowdin label_gal_aunt_05_c6f31f01:
msgid "[_C_] Joey! Tell your employee that I didn't lose. It's a tie!"
msgstr "[_C_] Joey! Dite al vostro dipendente che non ho perso. È una cravatta!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21086 #-#-# translate crowdin label_gal_aunt_05_0dddcc04:
msgid "[_J_] I'm afraid it looks like the dealer has blackjack."
msgstr "[_J_] Temo che sembri che il concessionario abbia il blackjack."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21087 #-#-# translate crowdin label_gal_aunt_05_05819562:
msgid "[_J_] Oooo... and you were doing so well too. Bad luck on that ace."
msgstr "[_J_] Oooo... e lo stavi facendo anche bene. Cattiva fortuna su quell'asso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21088 #-#-# translate crowdin label_gal_aunt_05_d856478d:
msgid "[_C_] The Ace! I saw that ace two hands ago. It shouldn't have still been in the deck."
msgstr "[_C_] The Ace! Ho visto quell'asso due mani fa. Non avrebbe dovuto essere ancora nel mazzo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21089 #-#-# translate crowdin label_gal_aunt_05_bcfcd6dc:
msgid "[_J_] Well, no... The shoe has six decks in it."
msgstr "[_J_] Beh, no... La scarpa ha sei mazzi in esso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21092 #-#-# translate crowdin label_gal_aunt_05_9b9c6d76:
msgid "[_C_] You can't do that!"
msgstr "[_C_] Non puoi farlo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21093 #-#-# translate crowdin label_gal_aunt_05_3c2551b4:
msgid "[_R_] Hey, hey... calm down, Camille."
msgstr "[_R_] Hey, hey... calma, Camille."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21094 #-#-# translate crowdin label_gal_aunt_05_0d0d0958:
msgid "[_RT_] {i}Wow, she stopped sluring her words! Losing everything sobered her up quick.{/i}"
msgstr "[_RT_] {i}Wow, ha smesso di rallentare le sue parole! Perdere tutto la sua sobrietà veloce.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21095 #-#-# translate crowdin label_gal_aunt_05_211fd6fd:
msgid "[_J_] I'm afraid we can."
msgstr "[_J_] Temo che possiamo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21096 #-#-# translate crowdin label_gal_aunt_05_88ebe59d:
msgid "[_J_] Now, let's talk about how I can help you pay that money back."
msgstr "[_J_] Ora parliamo di come posso aiutarti a ripagare quei soldi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21097 #-#-# translate crowdin label_gal_aunt_05_f15c6346:
msgid "[_J_] I understand you aren't current working. I can offer you a way to make enough money..."
msgstr "[_J_] Capisco che non stai lavorando attualmente. Posso offrirvi un modo per fare abbastanza soldi..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21100 #-#-# translate crowdin label_gal_aunt_05_d65ab0fd:
msgid "[_C_] That's what this is about! You're trying to turn me into a stripper like my sister."
msgstr "[_C_] Questo è ciò di cui stiamo parlando! Stai cercando di trasformarmi in uno spogliarellista come mia sorella."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21101 #-#-# translate crowdin label_gal_aunt_05_ce242892:
msgid "[_C_] Well, you can forget it!"
msgstr "[_C_] Beh, puoi dimenticarlo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21102 #-#-# translate crowdin label_gal_aunt_05_04fdcb7b:
msgid "[_C_] I'll never work for you, and you can bet on that!"
msgstr "[_C_] Non lavorerò mai per te, e puoi scommettere su questo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21103 #-#-# translate crowdin label_gal_aunt_05_45844a13:
msgid "[_J_] You'd be amazed how many of my employees have said that. In the end, they all found working for me preferable to the \"alternative\"."
msgstr "[_J_] Saresti stupito di quanti dei miei dipendenti hanno detto questo: alla fine, tutti hanno trovato lavoro per me preferibile all'\"alternativa\"."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21104 #-#-# translate crowdin label_gal_aunt_05_58ec583b:
msgid "[_R_] Whoa, there's no need for threats, Mr. DeCapo! My aunt's has had a lot to drink. She doesn't know what she's saying."
msgstr "[_R_] Whoa, non c'è bisogno di minacce, signor DeCapo! Mia zia ha avuto molto da bere. Non sa cosa sta dicendo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21105 #-#-# translate crowdin label_gal_aunt_05_8bb33983:
msgid "[_R_] We can work something out here."
msgstr "[_R_] Qui possiamo lavorare qualcosa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21108 #-#-# translate crowdin label_gal_aunt_05_a8884214:
msgid "[_C_] Don't speak for me!"
msgstr "[_C_] Non parlate per me!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21109 #-#-# translate crowdin label_gal_aunt_05_2fe00404:
msgid "[_C_] As far as I'm concerned, there's nothing to work out. You got your money back Joey. It's right there on your table."
msgstr "[_C_] Per quanto mi riguarda, non c'è niente da risolvere. Hai ottenuto i tuoi soldi indietro Joey. È proprio lì sul tuo tavolo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21110 #-#-# translate crowdin label_gal_aunt_05_85674604:
msgid "[_C_] Goodbye, Mr. DeCapo."
msgstr "[_C_] Arrivederci, Signor DeCapo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21111 #-#-# translate crowdin label_gal_aunt_05_a4cb35fb:
msgid "[_C_] I'm going home to take a nice bath to forget all about tonight, and you."
msgstr "[_C_] Sto andando a casa per fare un bel bagno per dimenticare tutto stasera, e voi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21119 #-#-# translate crowdin label_gal_aunt_05_5170838f:
msgid "[_RT_] {i}Goddammit!{/i}"
msgstr "[_RT_] {i}Dannazione! {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21120 #-#-# translate crowdin label_gal_aunt_05_4685db1f:
msgid "[_RT_] {i}How stupid can she be?{/i}"
msgstr "[_RT_] {i}Quanto stupido può essere?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21121 #-#-# translate crowdin label_gal_aunt_05_617ef5d9:
msgid "[_RT_] {i}Working as a stripper to pay the DeCapos back all that money wouldn't be the worst thing ever.{/i}"
msgstr "[_RT_] {i}Lavorare come spogliarellista per pagare il DeCapos indietro tutto ciò che il denaro non sarebbe la cosa peggiore mai.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21122 #-#-# translate crowdin label_gal_aunt_05_2b455b71:
msgid "[_RT_] {i}Hell, having to shake her tits and ass on stage might be good for that ego of hers.{/i}"
msgstr "[_RT_] {i}Inferno, dover scuotere le tette e il culo sul palco potrebbe essere un bene per quell'ego di lei.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21123 #-#-# translate crowdin label_gal_aunt_05_6e3eaa09:
msgid "[_RT_] {i}It's certainly better than what ever the \"alternative\" Joey DeCapo mentioned.{/i}"
msgstr "[_RT_] {i}È sicuramente meglio di quello che mai ha detto l'\"alternativa\" Joey DeCapo.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21124 #-#-# translate crowdin label_gal_aunt_05_63c4e501:
msgid "[_RT_] {i}But storming out, after telling him off like that? That has to be the most bone-headed thing she's ever done.{/i}"
msgstr "[_RT_] {i}Ma sbalorditivamente, dopo averlo raccontato così? Questa deve essere la cosa più ossata che abbia mai fatto.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21125 #-#-# translate crowdin label_gal_aunt_05_044493a3:
msgid "[_RT_] {i}I've got to make her understand the situation she's in before she gets herself killed.{/i}"
msgstr "[_RT_] {i}Devo farle capire la situazione in cui si trova prima di farsi uccidere.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21126 #-#-# translate crowdin label_gal_aunt_05_385ac909:
msgid "[_RT_] {i}I hate her guts right now, but she's still my aunt. Mandy would be devastated if anything happened to her mom.{/i}"
msgstr "[_RT_] {i}Odio il suo coraggio in questo momento, ma lei è ancora mia zia. Mandy sarebbe devastato se fosse successo qualcosa a sua mamma.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21127 #-#-# translate crowdin label_gal_aunt_05_b7680fa3:
msgid "[_R_] {i}(Screaming){/i} Fuck!"
msgstr "[_R_] {i}(Screaming){/i} Fuck!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21128 #-#-# translate crowdin label_gal_aunt_05_437aacac:
msgid "[_RT_] {i}All she had to do was walk away, but now I have to deal with the shit-storm she's created.{/i}"
msgstr "[_RT_] {i}Tutto quello che doveva fare era andare via, ma ora ho a che fare con la tempesta di merda che ha creato.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21129 #-#-# translate crowdin label_gal_aunt_05_d877be7c:
msgid "[_R_] {i}(sigh){/i}"
msgstr "[_R_] {i}(sigh){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21130 #-#-# translate crowdin label_gal_aunt_05_37fae585:
msgid "[_RT_] {i}If I can just get her to listen to me for once. There might be a way I can turn this disaster around, somehow.{/i}"
msgstr "[_RT_] {i}Se posso solo farla ascoltare per una volta. Ci potrebbe essere un modo in cui posso girare questa catastrofe, in qualche modo.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21135 #-#-# translate crowdin label_gal_aunt_05_eeba1944:
msgid "[_R_] Cami! Cami, wait!"
msgstr "[_R_] Cami! Cami, wait!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21138 #-#-# translate crowdin label_gal_aunt_05_774e49a4:
msgid "[_R_] Cami, we have to talk about this!"
msgstr "[_R_] Cami, dobbiamo parlare di questo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21139 #-#-# translate crowdin label_gal_aunt_05_b10d177b:
msgid "[_C_] Let go of me!"
msgstr "[_C_] Lasciami andare!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21140 #-#-# translate crowdin label_gal_aunt_05_b1b8799c:
msgid "[_R_] Cami, listen..."
msgstr "[_R_] Cami, listen..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21141 #-#-# translate crowdin label_gal_aunt_05_b76f6487:
msgid "[_C_] For the last time. It's Camille!"
msgstr "[_C_] Per l'ultima volta. È Camille!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21142 #-#-# translate crowdin label_gal_aunt_05_17d23c91:
msgid "[_R_] This isn't just going to go away Aunt Cami... Camille."
msgstr "[_R_] Questo non sta per andare via zia Cam... Camille."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21143 #-#-# translate crowdin label_gal_aunt_05_ae4c3057:
msgid "[_R_] We're talking about the Mafia here. They don't let people just not pay them. You need to start coming up with a plan to pay back the DeCapos. "
msgstr "[_R_] Stiamo parlando della mafia qui. Non lasciano che la gente semplicemente non li paga. È necessario iniziare a venire con un piano per rimborsare il DeCapos. "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21144 #-#-# translate crowdin label_gal_aunt_05_94166cd5:
msgid "[_R_] I can help you with that."
msgstr "[_R_] Posso aiutarvi con quello."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21145 #-#-# translate crowdin label_gal_aunt_05_d61ec227:
msgid "[_C_] Hah! How are you going to help me with \"The Mob\"?"
msgstr "[_C_] Hah! Come mi aiuterai con \"The Mob\"?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21146 #-#-# translate crowdin label_gal_aunt_05_78cdf9eb:
msgid "[_R_] My business venture is really starting to take off. If you were to come down to my studio..."
msgstr "[_R_] La mia impresa sta davvero iniziando a decollare. Se dovessi scendere al mio studio..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21147 #-#-# translate crowdin label_gal_aunt_05_6d03738a:
msgid "[_C_] I should have known."
msgstr "[_C_] avrei dovuto sapere."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21148 #-#-# translate crowdin label_gal_aunt_05_f7130a8e:
msgid "[_C_] You want me to be a model for one of your perverted photoshoots? Is that it?"
msgstr "[_C_] Vuoi che io sia un modello per uno dei tuoi photoshoots? È vero?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21149 #-#-# translate crowdin label_gal_aunt_05_23c7fd46:
msgid "[_C_] Well forget it! I'm not stripping for that mafia goon's customers, or for you and whoever you peddle your disgusting pictures to."
msgstr "[_C_] Bene dimenticatelo! Non sto spogliando per i clienti di quella mafia, o per te e per chi ti pedala le tue immagini disgustose."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21150 #-#-# translate crowdin label_gal_aunt_05_59ae25f7:
msgid "[_C_] Now let go of me before I scream!"
msgstr "[_C_] Ora lasciami andare prima di urlare!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21154 #-#-# translate crowdin label_gal_aunt_05_c53d385c:
msgid "[_R_] {i}(Whispering){/i} Just hear me out. You're going to have to do something. At least in my studio you won't be surrounded by a bunch of strangers drooling on you."
msgstr "[_R_] {i}(Whispering){/i} Basta sentirmi. Dovrai fare qualcosa. Almeno nel mio studio non sarete circondati da un mucchio di sconosciuti che si affogano su di voi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21155 #-#-# translate crowdin label_gal_aunt_05_f8c7f7f8:
msgid "[_R_] It would be private, just the two of us."
msgstr "[_R_] Sarebbe privato, solo i due di noi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21156 #-#-# translate crowdin label_gal_aunt_05_2647e4fb:
msgid "[_C_] {i}(Whispering){/i} Hah. I'll bet."
msgstr "[_C_] {i}(Whispering){/i} Hah. Scommetterò."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21157 #-#-# translate crowdin label_gal_aunt_05_b55a0762:
msgid "[_R_] Come on... Let's just talk about it."
msgstr "[_R_] Avanti... Parliamo di esso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21158 #-#-# translate crowdin label_gal_aunt_05_c003a8db:
msgid "[_C_] There's nothing to talk about. In fact, I never want to hear about it ever again."
msgstr "[_C_] Non c'è niente di cui parlare. In realtà, non voglio mai più sentirne parlare."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21159 #-#-# translate crowdin label_gal_aunt_05_45edbafe:
msgid "[_C_] So, you'd better keep your mouth shut about tonight."
msgstr "[_C_] Quindi, faresti meglio a tenere la bocca chiusa stasera."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21162 #-#-# translate crowdin label_gal_aunt_05_523b94ea:
msgid "[_R_] (Whispering) Why should I? After Joey's goons have tossed you into the river, who do you think they'll come after next..."
msgstr "[_R_] (Whispering) Perché dovrei io? Dopo che i goons di Joey ti hanno gettato nel fiume, chi pensi che arriveranno dopo..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21166 #-#-# translate crowdin label_gal_aunt_05_9fbeb471:
msgid "[_R_] Oof...!"
msgstr "[_R_] Oof...!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21167 #-#-# translate crowdin label_gal_aunt_05_01d43429:
msgid "[_R_] {i}(Whispering){/i} What the hell?..."
msgstr "[_R_] {i}(Whispering){/i} Che inferno?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21168 #-#-# translate crowdin label_gal_aunt_05_89c55f4e:
msgid "[_M_] {b}How much did she lose?!{/b}"
msgstr "[_M_] {b}Quanto ha perso?!{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21172 #-#-# translate crowdin label_gal_aunt_05_153a1a55:
msgid "[_M_] There has to be some mistake... My sister would never..."
msgstr "[_M_] Ci deve essere qualche errore... Mia sorella mai..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21173 #-#-# translate crowdin label_gal_aunt_05_45cd2128:
msgid "[_M_] But we're already struggling to pay back [dad_name]'s..."
msgstr "[_M_] Ma stiamo già lottando per restituire [dad_name]'..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21176 #-#-# translate crowdin label_gal_aunt_05_cd7bac83:
msgid "[_M_] No! No... You don't have to do that... I just..."
msgstr "[_M_] No! No... Non devi farlo... solo..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21179 #-#-# translate crowdin label_gal_aunt_05_7c5938af:
msgid "[_J_] {i}(Muffled){/i} I'm sorry, [mom_name], but I have a reputation to maintain. If she refuses to pay back what she owes, I'm afraid I'll need to make an example of her."
msgstr "[_J_] {i}(Muffled){/i} Mi dispiace, [mom_name], ma ho una reputazione da mantenere. Se si rifiuta di ripagare ciò che doveva, temo che dovrò fare un esempio di lei."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21180 #-#-# translate crowdin label_gal_aunt_05_a465606c:
msgid "[_M_] Please, please don't. I'll pay it. I just... can you give me some time to..."
msgstr "[_M_] Per favore, non lo pagherò. Io solo... puoi darmi un po' di tempo per..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21181 #-#-# translate crowdin label_gal_aunt_05_954a7936:
msgid "[_C_] {b}Get off me you creep!{/b}"
msgstr "[_C_] {b}Scaricami strisci!{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21184 #-#-# translate crowdin label_gal_aunt_05_c8f4d59e:
msgid "[_M_] You! What have you done?!"
msgstr "[_M_] Tu! Cosa hai fatto?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21185 #-#-# translate crowdin label_gal_aunt_05_d80e7e24:
msgid "[_J_] {i}(Muffled){/i} It sounds like your sister's back home. I'll leave you two to talk. We'll be in touch."
msgstr "[_J_] {i}(Muffled){/i} Sembra che tua sorella torni a casa. Ti lascerò due per parlare. Saremo in contatto."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21190 #-#-# translate crowdin label_gal_aunt_05_ca4c42aa:
msgid "[_M_] How could you be so stupid?!"
msgstr "[_M_] Come potresti essere così stupido?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21191 #-#-# translate crowdin label_gal_aunt_05_3b34085f:
msgid "[_C_] It's not a big deal."
msgstr "[_C_] Non è un grande affare."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21192 #-#-# translate crowdin label_gal_aunt_05_591126a4:
msgid "[_M_] Not a big deal?"
msgstr "[_M_] Non è un grande affare?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21193 #-#-# translate crowdin label_gal_aunt_05_10370d14:
msgid "[_M_] Explain to me how taking out a loan from the {b}mafia{/b}..."
msgstr "[_M_] Spiega a me come prendere un prestito dalla mafia {b}{/b}..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21194 #-#-# translate crowdin label_gal_aunt_05_321be3ad:
msgid "[_M_] Then playing blackjack till you {b}lost it all...{/b}"
msgstr "[_M_] Poi giocando a blackjack fino a quando {b}ha perso tutto...{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21195 #-#-# translate crowdin label_gal_aunt_05_1536ef34:
msgid "[_M_] Is not a big deal?!"
msgstr "[_M_] Non è un grande affare?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21196 #-#-# translate crowdin label_gal_aunt_05_244daeaf:
msgid "[_C_] Look, I was up by a lot, okay?"
msgstr "[_C_] Guarda, sono stato alzato da molto, okay?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21197 #-#-# translate crowdin label_gal_aunt_05_94ac1ccd:
msgid "[_C_] I only lost because they cheated. I don't have to pay a crooked casino anything. Gambling's not even legal in this city."
msgstr "[_C_] Ho solo perso perché hanno imbrogliato. Non devo pagare un casinò tormentato nulla. Il gioco d'azzardo non è nemmeno legale in questa città."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21198 #-#-# translate crowdin label_gal_aunt_05_ab7e6ace:
msgid "[_C_] Joey's lucky I don't report his establishment to the police right now."
msgstr "[_C_] Joey fortunato non segnalo la sua istituzione alla polizia in questo momento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21199 #-#-# translate crowdin label_gal_aunt_05_384f0b0d:
msgid "[_RT_] {i}Holy shit.. Is she trying to get us all killed?{/i}"
msgstr "[_RT_] {i}merda santa.. Sta cercando di farci tutti uccisi?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21200 #-#-# translate crowdin label_gal_aunt_05_201738dc:
msgid "[_M_] Are you trying to get us all killed?!"
msgstr "[_M_] Stai cercando di farci tutti uccisi?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21201 #-#-# translate crowdin label_gal_aunt_05_b2caa137:
msgid "[_M_] You think he doesn't have the police in his pocket?"
msgstr "[_M_] Pensi che lui non abbia la polizia in tasca?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21202 #-#-# translate crowdin label_gal_aunt_05_2b907914:
msgid "[_C_] Oh, please... You're being silly. The FBI is watching everything we do. He can't do anything to me."
msgstr "[_C_] Oh, per favore... Sei stupido. L'FBI sta guardando tutto quello che facciamo. Non può fare nulla per me."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21203 #-#-# translate crowdin label_gal_aunt_05_9407c934:
msgid "[_M_] Camille, do you remember that FBI agent that helped you move?"
msgstr "[_M_] Camille, ti ricordi che l'agente dell'FBI che ti ha aiutato a muoverti?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21204 #-#-# translate crowdin label_gal_aunt_05_de81bc24:
msgid "[_C_] I don't know, maybe? What about her?"
msgstr "[_C_] Non lo so, forse? E lei?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21205 #-#-# translate crowdin label_gal_aunt_05_08881def:
msgid "[_M_] She's in his club every time I've been in there. You think she'd be hanging out in an illegal club if he didn't have her and god knows who else on his payroll?!"
msgstr "[_M_] Lei è nel suo club ogni volta che sono lì dentro. Pensi che lei sarebbe andare fuori in un club illegale se non avesse lei e il dio sa chi altro sul suo libro paga?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21206 #-#-# translate crowdin label_gal_aunt_05_382f2116:
msgid "[_R_] {i}(Muttering){/i} Pretty sure that our city's mayor is a regular there too."
msgstr "[_R_] {i}(Muttering){/i} È abbastanza sicuro che il sindaco della nostra città è un normale anche lì."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21207 #-#-# translate crowdin label_gal_aunt_05_460ed95d:
msgid "[_M_] I always knew you were selfish, but I didn't think you were an idiot!"
msgstr "[_M_] Ho sempre saputo che eravate egoisti, ma non pensavo che foste un idiota!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21210 #-#-# translate crowdin label_gal_aunt_05_7845abcb:
msgid "[_C_] Hey, the only reason any of this happened is because of your {i}idiot{/i} husband!"
msgstr "[_C_] Hey, l'unico motivo per cui è successo uno di questi eventi è a causa del tuo idiota {i}{/i} marito!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21211 #-#-# translate crowdin label_gal_aunt_05_faa67948:
msgid "[_M_] At least my husband didn't run off with the {b}nanny{/b}!"
msgstr "[_M_] Almeno mio marito non è sceso con l' {b}nanny{/b}!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21212 #-#-# translate crowdin label_gal_aunt_05_5b3eed7d:
msgid "[_R_] Uncle Bobby was Dad's right hand man, Aunt Cami. He's just as much to blame as Dad."
msgstr "[_R_] Lo zio Bobby era l'uomo della mano destra del papà, zia Cami. È tanto da biasimare quanto papà."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21213 #-#-# translate crowdin label_gal_aunt_05_b52fea57:
msgid "[_C_] Stay out of this, you little runt!"
msgstr "[_C_] Rimanete fuori da questo, poco runt!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21214 #-#-# translate crowdin label_gal_aunt_05_d5566705:
msgid "[_M_] {b}Don't you talk to my son like that, you bitch! You're the one who's endangered this family!{/b}"
msgstr "[_M_] {b}Non parli così con mio figlio, ti cagna! Sei quello che ha messo in pericolo questa famiglia!{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21215 #-#-# translate crowdin label_gal_aunt_05_01b4bbe8:
msgid "[_C_] {b}Don't call me a bitch, you...{/b}"
msgstr "[_C_] {b}Non chiamarmi una cagna, tu...{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21216 #-#-# translate crowdin label_gal_aunt_05_1e1c2ed6:
msgid "[_MD_] Mom?"
msgstr "[_MD_] Mamma?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21219 #-#-# translate crowdin label_gal_aunt_05_3956ecc6:
msgid "[_C_] Mandy!"
msgstr "[_C_] Mandato!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21220 #-#-# translate crowdin label_gal_aunt_05_27efc408:
msgid "[_MD_] Did you really get us into trouble with the mob?"
msgstr "[_MD_] Ci hai davvero messo nei guai con il mob?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21221 #-#-# translate crowdin label_gal_aunt_05_8aa039b1:
msgid "[_C_] Baby, it's not like that. I did it for us."
msgstr "[_C_] Baby, non è così. L'ho fatto per noi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21222 #-#-# translate crowdin label_gal_aunt_05_41a2294f:
msgid "[_S_] Why is everyone yelling?"
msgstr "[_S_] Perché tutti stanno urlando?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21225 #-#-# translate crowdin label_gal_aunt_05_c20775b5:
msgid "[_S_] What's going on?"
msgstr "[_S_] Cosa sta succedendo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21226 #-#-# translate crowdin label_gal_aunt_05_604a034d:
msgid "[_M_] Well? Go on Camille..."
msgstr "[_M_] Bene? Vai su Camille..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21227 #-#-# translate crowdin label_gal_aunt_05_5a03f786:
msgid "[_M_] Tell our girls why you've put all their lives in danger so you could have some fun at a mafia casino."
msgstr "[_M_] Dite alle nostre ragazze perché hai messo in pericolo tutta la loro vita in modo da poter divertirsi in un casinò mafioso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21228 #-#-# translate crowdin label_gal_aunt_05_98f001be:
msgid "[_C_] That's not what happened!"
msgstr "[_C_] Non è quello che è successo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21229 #-#-# translate crowdin label_gal_aunt_05_107ff339:
msgid "[_C_] Girls, look..."
msgstr "[_C_] Ragazze, guarda..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21230 #-#-# translate crowdin label_gal_aunt_05_2676a1f4:
msgid "[_C_] I... I borrowed some money from Joey DeCapo."
msgstr "[_C_] Io... Ho preso in prestito alcuni soldi da Joey DeCapo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21231 #-#-# translate crowdin label_gal_aunt_05_cfa4ae8a:
msgid "[_S_] What?"
msgstr "[_S_] Cosa?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21232 #-#-# translate crowdin label_gal_aunt_05_82bd0641:
msgid "[_MD_] The mob boss? But, why? Isn't that how Uncle [dad_name] got in trouble?"
msgstr "[_MD_] Il mob cap? Ma, perché? Non è come lo zio [dad_name] è in difficoltà?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21233 #-#-# translate crowdin label_gal_aunt_05_7ecf6601:
msgid "[_C_] I was... You see..."
msgstr "[_C_] Ero... Vedi..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21234 #-#-# translate crowdin label_gal_aunt_05_49f3af73:
msgid "[_C_] I was trying to, to win enough money to pay off [dad_name]'s debt!"
msgstr "[_C_] stavo provando, per vincere abbastanza soldi per pagare il debito di [dad_name]!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21235 #-#-# translate crowdin label_gal_aunt_05_1c17a687:
msgid "[_C_] If I won big at the club, then I could pay it all off, and we'd all get our lives back."
msgstr "[_C_] Se avessi vinto grandi al club, allora potrei pagare tutto fuori, e tutti otterremmo la nostra vita indietro."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21236 #-#-# translate crowdin label_gal_aunt_05_c0b5c051:
msgid "[_R_] Bullshit!"
msgstr "[_R_] Bullshit!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21237 #-#-# translate crowdin label_gal_aunt_05_ad14a32b:
msgid "[_R_] You said you were going to take Mandy and leave the rest of us. Going back to living the good life, you said... Buying expensive wines, and getting \"manny petties\", whatever that hell that is."
msgstr "[_R_] Hai detto che stavi per prendere Mandy e lasciare il resto di noi. Tornando a vivere la vita buona, hai detto. . Comprare vini costosi, e ottenere \"petties manny\", qualunque diavolo che è."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21238 #-#-# translate crowdin label_gal_aunt_05_525b3774:
msgid "[_MD_] You were going to run out on them? Like Dad did to us?"
msgstr "[_MD_] Stavi per finire su di loro? Come ci ha fatto papà?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21239 #-#-# translate crowdin label_gal_aunt_05_a2ed6b24:
msgid "[_M_] Unbelievable! After I took you into my home, you'd abandon us, just so you could sip Chateau wines and have your nails done?"
msgstr "[_M_] Incredibile! Dopo averti portato a casa mia, ci abbandoneresti, così potevi sorseggiare i vini del castello e avere le unghie fatte?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21240 #-#-# translate crowdin label_gal_aunt_05_1db3343f:
msgid "[_M_] You ungrateful cunt!"
msgstr "[_M_] Hai grato la figa!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21243 #-#-# translate crowdin label_gal_aunt_05_06b9ae4c:
msgid "[_C_] Don't talk to me like that!"
msgstr "[_C_] Non parlarmi così!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21244 #-#-# translate crowdin label_gal_aunt_05_f3a9fb46:
msgid "[_C_] This isn't my fault! None of this is my fault!"
msgstr "[_C_] Questa non è colpa mia! Niente di questo è colpa mia!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21245 #-#-# translate crowdin label_gal_aunt_05_c873b5d5:
msgid "[_C_] I had the perfect life! A rich husband, a daughter I could spoil with all my attention, in my spacious house!"
msgstr "[_C_] Ho avuto la vita perfetta! Un marito ricco, una figlia che ho potuto rovinare con tutta la mia attenzione, nella mia spaziosa casa!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21246 #-#-# translate crowdin label_gal_aunt_05_d2525d04:
msgid "[_C_] Now, I'm stuck living with my sister and her family."
msgstr "[_C_] Ora, sono bloccato a vivere con mia sorella e la sua famiglia."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21247 #-#-# translate crowdin label_gal_aunt_05_7b75fb88:
msgid "[_C_] Your son is bad enough, always bossing me around or trying to perv on me and my daughter."
msgstr "[_C_] Tuo figlio è abbastanza cattivo, mi bacchetta sempre intorno o cercando di perv su di me e mia figlia."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21248 #-#-# translate crowdin label_gal_aunt_05_74dd52f2:
msgid "[_C_] But you!"
msgstr "[_C_] Ma tu!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21249 #-#-# translate crowdin label_gal_aunt_05_032b2cea:
msgid "[_C_] You humiliate me every chance you get, [mom_name]! Making me clean your house in that stupid maid costume while your son leers at me."
msgstr "[_C_] Mi umili ogni possibilità che ottieni, [mom_name]! Mi fa pulire la tua casa in quel costume da cameriera stupido mentre tuo figlio mi guasta."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21250 #-#-# translate crowdin label_gal_aunt_05_1e00af5a:
msgid "[_C_] I have to scrub your dammed bathroom in that skimpy thing!"
msgstr "[_C_] Devo strofinare il vostro bagno martellato in quella cosa skimpy!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21251 #-#-# translate crowdin label_gal_aunt_05_9d9dab82:
msgid "[_C_] I hate that bathroom!"
msgstr "[_C_] Odio quel bagno!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21252 #-#-# translate crowdin label_gal_aunt_05_edcdae72:
msgid "[_C_] There's always pee on the toilet seat, and the hair from five girls in the shower drain!"
msgstr "[_C_] C'è sempre pisello sul sedile della toilette, e i capelli da cinque ragazze sotto la doccia drenano!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21253 #-#-# translate crowdin label_gal_aunt_05_1da185a9:
msgid "[_C_] It's degrading!"
msgstr "[_C_] è degradante!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21254 #-#-# translate crowdin label_gal_aunt_05_f7d731b4:
msgid "[_C_] Six people in this house, and only {b}one bathroom!{/b}"
msgstr "[_C_] Sei persone in questa casa, e solo {b}un bagno!{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21255 #-#-# translate crowdin label_gal_aunt_05_b6a35d45:
msgid "[_C_] {b}One bathroom that I have to clean in that stupid sexy maid costume!{/b}"
msgstr "[_C_] {b}Un bagno che devo pulire in quel stupido costume da cameriera sexy!{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21256 #-#-# translate crowdin label_gal_aunt_05_0ce449ba:
msgid "[_C_] Well, you know what? I'm not going to put up with this shit anymore!"
msgstr "[_C_] Beh, sai cosa? Non sto più per sopportare questa merda!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21259 #-#-# translate crowdin label_gal_aunt_05_0338b8ca:
msgid "[_C_] Mandy, get dressed and get your things together. We're leaving."
msgstr "[_C_] Mandy, vestiti e unisci le tue cose. Partiamo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21260 #-#-# translate crowdin label_gal_aunt_05_0a630831:
msgid "[_MD_] We're leaving? Why?"
msgstr "[_MD_] stiamo partendo? Perché?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21261 #-#-# translate crowdin label_gal_aunt_05_205d747c:
msgid "[_C_] I said get dressed!"
msgstr "[_C_] ho detto di vestirsi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21264 #-#-# translate crowdin label_gal_aunt_05_19cb5e8e:
msgid "[_M_] Oh, here we go."
msgstr "[_M_] Oh, qui andiamo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21265 #-#-# translate crowdin label_gal_aunt_05_ae637927:
msgid "[_M_] Little Camille makes a mess, then runs away from home because she doesn't want to face the consequences."
msgstr "[_M_] Little Camille fa un casino, poi scappa da casa perché non vuole affrontare le conseguenze."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21266 #-#-# translate crowdin label_gal_aunt_05_126e45bc:
msgid "[_M_] How many times did you perform this little drama for Mom and Dad?"
msgstr "[_M_] Quante volte hai eseguito questo piccolo dramma per mamma e papà?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21267 #-#-# translate crowdin label_gal_aunt_05_46f77175:
msgid "[_C_] Shut up!"
msgstr "[_C_] Stai zitto!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21268 #-#-# translate crowdin label_gal_aunt_05_2e2c108a:
msgid "[_C_] I don't have to live like this!"
msgstr "[_C_] Non devo vivere così!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21269 #-#-# translate crowdin label_gal_aunt_05_81d93ea2:
msgid "[_M_] Fine with me. Go!"
msgstr "[_M_] Bene con me. Vai!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21270 #-#-# translate crowdin label_gal_aunt_05_501e1175:
msgid "[_M_] Go sleep in your car for all I care! That'll be so much better for Mandy!"
msgstr "[_M_] Vai a dormire in macchina per tutto quello che mi importa! Sarà molto meglio per Mandy!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21271 #-#-# translate crowdin label_gal_aunt_05_225b4138:
msgid "[_C_] I have friends! Good, wealthy friends, who'll take us in and treat me with some respect."
msgstr "[_C_] Ho amici! Amici benissimi, ricchi, che ci porteranno e mi tratteranno con un po' di rispetto."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21272 #-#-# translate crowdin label_gal_aunt_05_824b31c0:
msgid "[_M_] What? Those country club snobs?"
msgstr "[_M_] Cosa? Quei club di campagna snobs?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21273 #-#-# translate crowdin label_gal_aunt_05_cf22926a:
msgid "[_M_] Hah! Good luck with that!"
msgstr "[_M_] Hah! Buona fortuna con quello!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21274 #-#-# translate crowdin label_gal_aunt_05_3345fee6:
msgid "[_M_] Do you know where all my good wealthy friends went as soon as they found out about [dad_name]?"
msgstr "[_M_] Sai dove sono andati tutti i miei buoni amici ricchi non appena hanno scoperto di [dad_name]?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21275 #-#-# translate crowdin label_gal_aunt_05_59d6c27e:
msgid "[_M_] Vanished like a fart in the wind."
msgstr "[_M_] Vanished come una fiamma nel vento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21276 #-#-# translate crowdin label_gal_aunt_05_138cc9bf:
msgid "[_C_] That probably says more about you than them!"
msgstr "[_C_] Probabilmente ti dice di più di loro!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21277 #-#-# translate crowdin label_gal_aunt_05_afc1014b:
msgid "[_C_] Now get moving, Mandy!... Just pack what you need for a couple days. We can come back for the rest of our stuff."
msgstr "[_C_] Ora mossi, Mandy!... Basta mettere in confezione quello che serve per un paio di giorni. Possiamo tornare per il resto della nostra roba."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21283 #-#-# translate crowdin label_gal_aunt_05_1c0ec001:
msgid "[_R_] Wow, I can't believe they're really leaving..."
msgstr "[_R_] Wow, non riesco a credere che stanno davvero andando..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21284 #-#-# translate crowdin label_gal_aunt_05_24c5dfe0:
msgid "[_L_] Mom, is the mob going to go after Mandy and Aunt Camille?"
msgstr "[_L_] Mamma, la folla sta per andare dopo Mandy e zia Camille?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21285 #-#-# translate crowdin label_gal_aunt_05_957462e5:
msgid "[_M_] No, I told Mr. DeCapo that I would find a way to pay Camille's gambling debts."
msgstr "[_M_] No, ho detto al signor DeCapo che avrei trovato un modo per pagare i debiti da gioco di Camille."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21286 #-#-# translate crowdin label_gal_aunt_05_9658bf24:
msgid "[_S_] How much did Aunt Camille lose?"
msgstr "[_S_] Quanto ha perso zia Camille?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21287 #-#-# translate crowdin label_gal_aunt_05_193e7b17:
msgid "[_M_] A lot."
msgstr "[_M_] Un sacco."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21288 #-#-# translate crowdin label_gal_aunt_05_cd17eb60:
msgid "[_L_] How are we going to pay it when we already have Dad's debts to deal with?"
msgstr "[_L_] Come lo pagheremo quando abbiamo già i debiti di papà?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21289 #-#-# translate crowdin label_gal_aunt_05_71ca139d:
msgid "[_M_] I don't know."
msgstr "[_M_] non lo so."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21292 #-#-# translate crowdin label_gal_aunt_05_53212abd:
msgid "[_L_] You don't know? How can you not know?"
msgstr "[_L_] Non lo sa? Come non sapete?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21293 #-#-# translate crowdin label_gal_aunt_05_3301e5d9:
msgid "[_L_] The mobs going kill us!"
msgstr "[_L_] I mob stanno per ucciderci!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21294 #-#-# translate crowdin label_gal_aunt_05_ef0236d9:
msgid "[_R_] Lauren, calm down, okay? We'll figure something out."
msgstr "[_R_] Lauren, calmati, ok? Scopriremo qualcosa."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21295 #-#-# translate crowdin label_gal_aunt_05_645e5ff5:
msgid "[_S_] I can help. I've been saving all my pay from the club, and maybe Mr. DeCapo will let me pick up some extra shifts?"
msgstr "[_S_] posso aiutare. Ho salvato tutta la mia paga dal club, e forse il signor DeCapo mi lascerà prendere alcuni turni in più?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21296 #-#-# translate crowdin label_gal_aunt_05_26bb9677:
msgid "[_M_] No!"
msgstr "[_M_] No!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21297 #-#-# translate crowdin label_gal_aunt_05_0e3273a2:
msgid "[_M_] That money is for college. You need to get back to design school so you can escape all this."
msgstr "[_M_] Quel denaro è per l'università. Devi tornare alla scuola di design in modo da poter sfuggire a tutto questo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21298 #-#-# translate crowdin label_gal_aunt_05_b2ab9a00:
msgid "[_S_] Then how are we going to..."
msgstr "[_S_] Allora come stiamo andando..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21299 #-#-# translate crowdin label_gal_aunt_05_08b55e30:
msgid "[_L_] Yeah! How are we going to not get murdered?"
msgstr "[_L_] Sì! Come non faremo assassinare?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21302 #-#-# translate crowdin label_gal_aunt_05_c1be3483:
msgid "[_M_] I said, I don't know!"
msgstr "[_M_] ho detto, non lo so!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21303 #-#-# translate crowdin label_gal_aunt_05_dc9b4f74:
msgid "[_M_] Stop talking about getting murdered! I don't know how I'm going to fix it, but I will!"
msgstr "[_M_] Smettila di parlare di essere assassinato! Non so come risolverò, ma lo farò!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21304 #-#-# translate crowdin label_gal_aunt_05_49e94d7d:
msgid "[_M_] I just need some time to think!"
msgstr "[_M_] Ho solo bisogno di un po' di tempo per pensare!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21305 #-#-# translate crowdin label_gal_aunt_05_973ae88c:
msgid "[_R_] Mom, take it easy..."
msgstr "[_R_] Mamma, prendi facile..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21306 #-#-# translate crowdin label_gal_aunt_05_2fed90a6:
msgid "[_R_] My business is doing really well... If everyone helped out at my studio, I'm sure we could..."
msgstr "[_R_] La mia attività sta facendo davvero bene... Se tutti hanno aiutato nel mio studio, sono sicuro che potremmo..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21307 #-#-# translate crowdin label_gal_aunt_05_26bb9677_1:
msgid "[_M_] No!"
msgstr "[_M_] No!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21310 #-#-# translate crowdin label_gal_aunt_05_0e147b20:
msgid "[_M_] I will handle it. Don't involve your sisters in this anymore than you already have."
msgstr "[_M_] lo gestirò. Non coinvolgere le tue sorelle in questo più di quanto tu abbia già."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21311 #-#-# translate crowdin label_gal_aunt_05_a9026e51:
msgid "[_R_] But, Mom..."
msgstr "[_R_] Ma, Moma..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21312 #-#-# translate crowdin label_gal_aunt_05_f104711c:
msgid "[_M_] I said, no!"
msgstr "[_M_] ho detto, no!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21313 #-#-# translate crowdin label_gal_aunt_05_85456a66:
msgid "[_M_] I'm your mother. This is my burden not yours."
msgstr "[_M_] sono tua madre. Questo è il mio peso non vostro."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21314 #-#-# translate crowdin label_gal_aunt_05_84e20f91:
msgid "[_M_] {b}I{/b} will handle this."
msgstr "[_M_] {b}I{/b} gestirà questo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21315 #-#-# translate crowdin label_gal_aunt_05_9acb6ba1:
msgid "[_M_] {b}I{/b} will find a way to pay Mr. DeCapo."
msgstr "[_M_] {b}I{/b} troverà un modo per pagare il signor DeCapo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21316 #-#-# translate crowdin label_gal_aunt_05_7ce0505e:
msgid "[_M_] Lauren, you and [ryan] need to focus on passing your exams and graduating high school. Sidney, you need to look for a respectable job and focus on getting back into design school."
msgstr "[_M_] Lauren, tu e [ryan] devi concentrarti sulla trasmissione degli esami e sulla laurea del liceo. Sidney, è necessario cercare un lavoro rispettabile e concentrarsi su tornare nella scuola di design."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21317 #-#-# translate crowdin label_gal_aunt_05_0e9cf35b:
msgid "[_M_] Now go back to bed, all of you."
msgstr "[_M_] Ora torna a letto, tutti voi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21320 #-#-# translate crowdin label_gal_aunt_05_a2b80596:
msgid "[_RT_] {i}...{/i}"
msgstr "[_RT_] {i}...{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21321 #-#-# translate crowdin label_gal_aunt_05_d366d3b2:
msgid "[_RT_] {i}How did this night go so wrong, so fast?...{/i}"
msgstr "[_RT_] {i}Come è andata così male questa notte?...{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21325 #-#-# translate crowdin label_gal_aunt_05_43091f1e:
msgid "[_RT_] {i}I know Mom's putting on a brave face for us, but she was barely keeping it together. This is too much for her to take on alone.{/i}"
msgstr "[_RT_] {i}So che la mamma sta mettendo su un volto coraggioso per noi, ma lei stava a malapena tenendolo insieme. Questo è troppo per lei per prendere da solo.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21326 #-#-# translate crowdin label_gal_aunt_05_6bb804f9:
msgid "[_RT_] {i}I thought Mom had started to see me as a man. Her man...{/i}"
msgstr "[_RT_] {i}Pensavo che la mamma avesse iniziato a vedermi come un uomo. Il suo uomo...{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21327 #-#-# translate crowdin label_gal_aunt_05_76067d3b:
msgid "[_RT_] {i}But tonight, I went back to being the little boy she needs to protect.{/i}"
msgstr "[_RT_] {i}Ma stasera sono tornato ad essere il ragazzino che ha bisogno di proteggere.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21328 #-#-# translate crowdin label_gal_aunt_05_dbbfc7f9:
msgid "[_RT_] {i}I have to show her I can be the guy... the man she counts on! Now, more than ever, I need to prove she can depend on me.{/i}"
msgstr "[_RT_] {i}Devo mostrarle che posso essere il ragazzo... l'uomo su cui conta lei! Ora, più che mai, ho bisogno di dimostrare che può dipendere da me.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21329 #-#-# translate crowdin label_gal_aunt_05_e3233cc8:
msgid "[_RT_] {i}But how?{/i}"
msgstr "[_RT_] {i}Ma come?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21330 #-#-# translate crowdin label_gal_aunt_05_632747d3:
msgid "[_RT_] {i}Aunt Cami let Joey loan her so much money before she lost it all. This won't be like Dad's debts, where Joey lets us get away with only making payments on the interest.{/i}"
msgstr "[_RT_] {i}zia Cami ha lasciato Joey prestito i suoi così tanti soldi prima che abbia perso tutto. Questo non sarà come il debito di papà, dove Joey ci permette di farci via con solo effettuare pagamenti sull'interesse.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21331 #-#-# translate crowdin label_gal_aunt_05_131a6656:
msgid "[_RT_] {i}He's going to use this to force Mom deeper into his clutches. If I don't do something, Mom will end up like Candy.{/i}"
msgstr "[_RT_] {i}Sta per usare questo per forzare la mamma più in profondità nelle sue frizioni. Se non faccio qualcosa, la mamma finirà come Candy.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21332 #-#-# translate crowdin label_gal_aunt_05_e2ebf4ce:
msgid "[_RT_] {i}Just another one of Joey DeCapo's whores.{/i}"
msgstr "[_RT_] {i}Solo un altro delle puttane di Joey DeCapo.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21333 #-#-# translate crowdin label_gal_aunt_05_53c73fe0:
msgid "[_RT_] {i}My photoshoots made good money, but I've pretty much wrapped each of them up. I'm going to start losing subscribers if I don't put out something new.{/i}"
msgstr "[_RT_] {i}Le mie photoshoots hanno fatto buoni soldi, ma ho praticamente avvolto ciascuno di loro. Inizierò a perdere gli abbonati se non metto qualcosa di nuovo.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21334 #-#-# translate crowdin label_gal_aunt_05_bc27a031:
msgid "[_RT_] {i}To make the kind of money we'll need, it'll take more than another softcore shoot. I'll need to do something big. Something that would get a lot of online attention.{/i}"
msgstr "[_RT_] {i}Per fare il tipo di denaro di cui abbiamo bisogno, ci vorrà più di un altro shooting softcore. Avrò bisogno di fare qualcosa di grande. Qualcosa che otterrebbe molta attenzione online.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21335 #-#-# translate crowdin label_gal_aunt_05_df18cbbc:
msgid "[_RT_] {i}The Perry Hotter set with Mom and Megan did really well. So, something with two girls would be best.{/i}"
msgstr "[_RT_] {i}Il set Perry Hotter con mamma e Megan ha fatto davvero bene. Quindi, qualcosa con due ragazze sarebbe stato il migliore.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21336 #-#-# translate crowdin label_gal_aunt_05_0ebff335:
msgid "[_RT_] {i}Lauren and Mandy's Instaslam certainly got big quick with their lezzy pictures. Girl on girl is always very popular, but what really got their subscriber count to take off, was them being cousins.{/i}"
msgstr "[_RT_] {i}Lauren e Mandy's Instaslam hanno sicuramente ottenuto grandi veloci con le loro immagini magre. Ragazza su ragazza è sempre molto popolare, ma quello che realmente ha ottenuto il loro abbonato per decollare, era loro essere cugini.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21337 #-#-# translate crowdin label_gal_aunt_05_5a0ca020:
msgid "[_RT_] {i}An incestuous lesbian shoot with Lauren and Mandy would be perfect, but even if I could get Lauren to agree to do it, Mandy's gone now.{/i}"
msgstr "[_RT_] {i}Una lesbica incestuosa spara con Lauren e Mandy sarebbe perfetta, ma anche se potessi convincere Lauren ad accettare di farlo, Mandy è andato adesso. /i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21338 #-#-# translate crowdin label_gal_aunt_05_d7351c47:
msgid "[_RT_] {i}Mom would probably be really mad anyways, if I used any of the girls behind her back. After that speech, she's going to insist on being involved in whatever I come up with.{/i}"
msgstr "[_RT_] {i}Mamma probabilmente sarebbe davvero pazza comunque, se ho usato una qualsiasi delle ragazze dietro la schiena. Dopo quel discorso, lei insisterà per essere coinvolta in qualsiasi cosa venga. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21339 #-#-# translate crowdin label_gal_aunt_05_b749df57:
msgid "[_RT_] {i}So, a shoot with Mom and someone else would be best, but who should I have with her?{/i}"
msgstr "[_RT_] {i}Quindi, un tiro con la mamma e qualcun altro sarebbe migliore, ma chi dovrei avere con lei? {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21340 #-#-# translate crowdin label_gal_aunt_05_21ec90af:
msgid "[_RT_] {i}Maybe Megan? She'd be up for it, no question... And they've already done one photoshoot together.{/i}"
msgstr "[_RT_] {i}Forse Megan? Sarebbe stato per esso, senza domande... E hanno già fatto una foto insieme.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21341 #-#-# translate crowdin label_gal_aunt_05_628b1f96:
msgid "[_RT_] {i}Shit. With how well the incest angle worked for Lauren and Mandy's InstaSlam account, I really think that's the way to go. Megan and Mom don't look anything like each other though. No one's going to believe they're related.{/i}"
msgstr "[_RT_] {i}Mossa Con quanto bene l'angolo incesto ha funzionato per Lauren e l'account InstaSlam di Mandy, penso davvero che sia la strada da percorrere. Megan e Mamma non assomigliano a vicenda. Nessuno crederà di essere relazionato.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21342 #-#-# translate crowdin label_gal_aunt_05_d877be7c_1:
msgid "[_R_] {i}(sigh){/i}"
msgstr "[_R_] {i}(sigh){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21343 #-#-# translate crowdin label_gal_aunt_05_15480b02:
msgid "[_RT_] {i}Well, there's no point in just standing around. I can work out the details later. For now, I should go talk to Mom and make sure she knows she can count on me to keep us safe.{/i}"
msgstr "[_RT_] {i}Beh, non ha senso stare in piedi. Posso trovare i dettagli più tardi. Per ora, dovrei andare a parlare con la mamma e assicurarsi che lei sa che può contare su di me per tenerci al sicuro.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21344 #-#-# translate crowdin label_gal_aunt_05_c4e7f950:
msgid "[_RT_] {i}Maybe I should check on Lauren and Sidney first? They both looked pretty shaken up.{/i}"
msgstr "[_RT_] {i}Forse dovrei controllare prima Lauren e Sidney? Entrambi sembravano piuttosto scossi. {/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21353 #-#-# translate crowdin label_gal_aunt_06_fc17ce9e:
msgid "[_C_] Please, Brittney!... It would only be for a couple weeks until we can find something more permanant."
msgstr "[_C_] Per favore, bretney!... sarebbe solo per un paio di settimane fino a quando non riusciamo a trovare qualcosa di più permanente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21354 #-#-# translate crowdin label_gal_aunt_06_84d0a507:
msgid "[_X_] {i}(Voice muffled over intercom){/i} That doesn't change the fact that you're the wife and daughter of a known fugitive."
msgstr "[_X_] {i}(Voice smorzato sul cito){/i} Ciò non cambia il fatto che sei la moglie e la figlia di un noto fuggitivo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21355 #-#-# translate crowdin label_gal_aunt_06_07c3a6b8:
msgid "[_X_] The PTA elections are coming up, how am I going to keep my spot as president if I'm harboring terrorists."
msgstr "[_X_] Le elezioni del PTA si stanno avvicinando, come terrò il mio posto di presidente se porto dei terroristi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21358 #-#-# translate crowdin label_gal_aunt_06_9f85b907:
msgid "[_C_] Oh, we're terrorists now? Fuck you Brittney!"
msgstr "[_C_] Oh, siamo terroristi adesso? Cazzo voi Bretagna!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21359 #-#-# translate crowdin label_gal_aunt_06_b99736a7:
msgid "[_C_] When your mom had that stroke, and you had to rush to be by her side, who took care of your little Chelsie?"
msgstr "[_C_] Quando tua mamma ebbe quel colpo e dovevi correre per stare al suo fianco, chi si prese cura del tuo piccolo Chelsie?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21360 #-#-# translate crowdin label_gal_aunt_06_3f5c5177:
msgid "[_X_] Your nanny Cindy did! It wasn't you. And we paid her extra since she was watching both our girls."
msgstr "[_X_] La tua bambinaia Cindy ha fatto! Non eri tu. E la abbiamo pagata in più da quando stava guardando entrambe le nostre ragazze."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21361 #-#-# translate crowdin label_gal_aunt_06_eee29b6d:
msgid "[_C_] Yeah, but I'm still the one who made that happen! She stayed at our house, ate our food. I could have forbid Cindy from watching Chelsie."
msgstr "[_C_] Sì, ma sono ancora colui che ha fatto accadere! Lei è rimasta a casa nostra, ha mangiato il nostro cibo. Avrei potuto vietare a Cindy di guardare Chelsie."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21362 #-#-# translate crowdin label_gal_aunt_06_ebc07522:
msgid "[_X_] And we really appreciated it, but this is much different."
msgstr "[_X_] E abbiamo apprezzato molto, ma questo è molto diverso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21363 #-#-# translate crowdin label_gal_aunt_06_e4eb81ac:
msgid "[_X_] I'm sorry, I just can't expose my family to the horrors of organized crime."
msgstr "[_X_] Mi dispiace, non posso esporre la mia famiglia agli orrori del crimine organizzato."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21364 #-#-# translate crowdin label_gal_aunt_06_6fab91fa:
msgid "[_C_] We wouldn't..."
msgstr "[_C_] Noi no..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21365 #-#-# translate crowdin label_gal_aunt_06_d3316366:
msgid "[_X_] I'm going back to bed... Goodbye, Camille! {i}(Click){/i}"
msgstr "[_X_] Sto tornando a letto... Arrivederci, Camille! {i}(Clic){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21366 #-#-# translate crowdin label_gal_aunt_06_e547f083:
msgid "[_C_] Aaahhh!!!"
msgstr "[_C_] Aaahhh!!!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21369 #-#-# translate crowdin label_gal_aunt_06_640a690f:
msgid "[_C_] After everything we've done for these snobs, they don't want to touch us with a ten foot pole."
msgstr "[_C_] Dopo tutto quello che abbiamo fatto per questi snobs, non vogliono toccarci con un polo di dieci piedi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21370 #-#-# translate crowdin label_gal_aunt_06_47d1eb62:
msgid "[_MD_] Who's next on our list?"
msgstr "[_MD_] Chi è il prossimo nella nostra lista?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21371 #-#-# translate crowdin label_gal_aunt_06_06a04f28:
msgid "[_C_] That's it... I'm out of friends."
msgstr "[_C_] Questo è tutto... Sono fuori dagli amici."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21372 #-#-# translate crowdin label_gal_aunt_06_5b551849:
msgid "[_C_] Eleven houses, eleven rejections."
msgstr "[_C_] Undici case, undici rifiuti."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21373 #-#-# translate crowdin label_gal_aunt_06_364430ca:
msgid "[_MD_] Then... Can we please just go back to Aunt [mom_name]'s?"
msgstr "[_MD_] allora... possiamo semplicemente tornare alla zia [mom_name]?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21376 #-#-# translate crowdin label_gal_aunt_06_38806f7a:
msgid "[_C_] Are you fucking out of your mind!?"
msgstr "[_C_] Stai scopando fuori di testa!?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21377 #-#-# translate crowdin label_gal_aunt_06_adeb2ad2:
msgid "[_C_] After everything they've done to us!?"
msgstr "[_C_] Dopo tutto quello che ci hanno fatto!?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21378 #-#-# translate crowdin label_gal_aunt_06_7be5c6ed:
msgid "[_C_] It felt so good to finally tell my sister off, tell her what I think of that God aweful son of hers..."
msgstr "[_C_] Mi è sembrato così bello dire finalmente a mia sorella, dirle quello che penso di quel Dio figlio di lei..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21379 #-#-# translate crowdin label_gal_aunt_06_5d90219d:
msgid "[_C_] And you want me to take it all back? Beg her to let us come back?..."
msgstr "[_C_] E volete che me lo riprenda tutto? Pregatela di farci tornare indietro?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21380 #-#-# translate crowdin label_gal_aunt_06_d1e189ab:
msgid "[_C_] Uh uh... No way!"
msgstr "[_C_] Uh uh... Nessun modo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21381 #-#-# translate crowdin label_gal_aunt_06_eb56ddad:
msgid "[_MD_] Sorry... I shouldn't have suggested that."
msgstr "[_MD_] Mi dispiace... non avrei dovuto suggerirlo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21384 #-#-# translate crowdin label_gal_aunt_06_d1bc117e:
msgid "[_MD_] But, where are we going to go? We don't even have money for a cheap motel."
msgstr "[_MD_] Ma, dove andremo? Non abbiamo nemmeno soldi per un motel a buon mercato."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21385 #-#-# translate crowdin label_gal_aunt_06_a1963be1:
msgid "[_MD_] We can't even drive very far before we run out of gas."
msgstr "[_MD_] Non possiamo nemmeno guidare molto lontano prima di esaurire il gas."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21386 #-#-# translate crowdin label_gal_aunt_06_a74b5b4f:
msgid "[_C_] We've just got to figure out something for tonight. We'll have all day tomorrow to find something more permanant."
msgstr "[_C_] Abbiamo appena capito qualcosa per stasera. Avremo tutto il giorno domani per trovare qualcosa di più permanente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21392 #-#-# translate crowdin label_gal_aunt_06_fc48da1a:
msgid "[_MD_] Oh, no... You're kidding me! We're going to sleep in the park?"
msgstr "[_MD_] Oh, no... Mi stai scherzando! Dormiremo nel parco?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21393 #-#-# translate crowdin label_gal_aunt_06_49dc9c53:
msgid "[_MD_] Mom... It's against the law to sleep in the park."
msgstr "[_MD_] Moma... È contro la legge dormire nel parco."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21394 #-#-# translate crowdin label_gal_aunt_06_4ce2fd4e:
msgid "[_C_] Do you have a better idea?"
msgstr "[_C_] Hai un'idea migliore?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21395 #-#-# translate crowdin label_gal_aunt_06_baeedf73:
msgid "[_MDT_] {i}Yeah, Aunt [mom_name]'s, but Mom will cut my head off if I suggest that again.{/i}"
msgstr "[_MDT_] {i}Yeah, zia [mom_name], ma la mamma taglierà la testa se lo suggerisco di nuovo.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21398 #-#-# translate crowdin label_gal_aunt_06_1c7c6958:
msgid "[_C_] If we park behind these bushes, we'll be pretty hard to spot."
msgstr "[_C_] Se parcheggiamo dietro questi cespugli, saremo piuttosto difficili da individuare."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21399 #-#-# translate crowdin label_gal_aunt_06_dfb5fdec:
msgid "[_C_] Luckily it's a warm night... We should be just fine."
msgstr "[_C_] Fortunatamente è una notte calda... Dovremmo stare bene."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21400 #-#-# translate crowdin label_gal_aunt_06_fa39b579:
msgid "[_C_] Lay down your seat, and try to get some sleep."
msgstr "[_C_] Posare giù il posto e cercare di dormire un po'."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21406 #-#-# translate crowdin label_gal_aunt_06_440653d4:
msgid "[_C_] Who are you texting at this hour?"
msgstr "[_C_] Chi stai inviando SMS a quest'ora?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21407 #-#-# translate crowdin label_gal_aunt_06_4681ab68:
msgid "[_MD_] It's Lauren... She's worried about us."
msgstr "[_MD_] È Lauren... è preoccupata per noi."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21408 #-#-# translate crowdin label_gal_aunt_06_a3677cac:
msgid "[_MD_] I'm just letting her know we're all right."
msgstr "[_MD_] Le sto solo facendo sapere che stiamo bene."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21409 #-#-# translate crowdin label_gal_aunt_06_70822dc2:
msgid "[_C_] You didn't tell her we're sleeping at the park, did you?"
msgstr "[_C_] Non le hai detto che stiamo dormendo al parco, vero?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21410 #-#-# translate crowdin label_gal_aunt_06_f49decc5:
msgid "[_MD_] I haven't yet, but I'm about to."
msgstr "[_MD_] non l'ho ancora fatto, però sto per farlo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21411 #-#-# translate crowdin label_gal_aunt_06_4751d619:
msgid "[_C_] Don't you dare!"
msgstr "[_C_] Non si osa!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21414 #-#-# translate crowdin label_gal_aunt_06_a83da3de:
msgid "[_MD_] {i}(Yelling){/i} Why not, Mom!?"
msgstr "[_MD_] {i}(Yelling){/i} Perché no, Moma!?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21415 #-#-# translate crowdin label_gal_aunt_06_966c89d6:
msgid "[_MD_] We fucking \"are\" sleeping in the park!"
msgstr "[_MD_] Noi scopiamo \"sono\" dormendo nel parco!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21416 #-#-# translate crowdin label_gal_aunt_06_7293f9f6:
msgid "[_MD_] Are you too prideful to let anyone know you're not sleeping in a five star hotel?!"
msgstr "[_MD_] Sei troppo orgoglioso per far sapere a chiunque di non dormire in un hotel a cinque stelle?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21417 #-#-# translate crowdin label_gal_aunt_06_57d403f6:
msgid "[_MD_] Why do you think you're better than other people!?"
msgstr "[_MD_] Perché pensi di essere meglio di altre persone!?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21418 #-#-# translate crowdin label_gal_aunt_06_cc4ee298:
msgid "[_C_] I don't thi..."
msgstr "[_C_] Io non ti..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21419 #-#-# translate crowdin label_gal_aunt_06_356cc723:
msgid "[_MD_] My question is rhetorical!"
msgstr "[_MD_] La mia domanda è retorica!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21420 #-#-# translate crowdin label_gal_aunt_06_e15ea36c:
msgid "[_MD_] What have you ever achieved to make you think you're better than anyone else!?"
msgstr "[_MD_] Che cosa hai mai realizzato per farti pensare di essere migliore di chiunque altro!?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21421 #-#-# translate crowdin label_gal_aunt_06_fdf11a84:
msgid "[_MD_] You've never made any money, you only ever spend it! And guess what? The money you spent wasn't even earned legitimately!"
msgstr "[_MD_] Non hai mai fatto soldi, lo spendi! E indovinate cosa? I soldi che hai speso non sono stati neanche guadagnati legittimamente!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21422 #-#-# translate crowdin label_gal_aunt_06_0e3bc1fe:
msgid "[_MD_] You're a stay-at-home mom who didn't even raise her only child."
msgstr "[_MD_] Sei una mamma di casa che non ha nemmeno allevato il suo unico figlio."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21423 #-#-# translate crowdin label_gal_aunt_06_a791155a:
msgid "[_MD_] I was mostly raised by our nanny, Cindy!"
msgstr "[_MD_] Sono stato per lo più cresciuto dalla nostra nanny, Cindy!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21424 #-#-# translate crowdin label_gal_aunt_06_1833013d:
msgid "[_MD_] Your only contribution to parenting was setting those fucking puritanical rules, and then making me feel guilt for ever questioning any of them!"
msgstr "[_MD_] Il tuo unico contributo alla genitorialità stava impostando quelle regole puritaniche del cazzo, e poi facendomi sentire colpevole per aver mai messo in discussione qualcuno di loro!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21425 #-#-# translate crowdin label_gal_aunt_06_381a3838:
msgid "[_MD_] Your only focus is keeping that aging body in shape, and even half of that is made of plastic!"
msgstr "[_MD_] Il tuo unico focus è mantenere quel corpo di invecchiamento in forma, e anche la metà di quello è fatta di plastica!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21426 #-#-# translate crowdin label_gal_aunt_06_bd5fe5a4:
msgid "[_C_] You need to calm down right..."
msgstr "[_C_] Devi calmarti a destra..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21427 #-#-# translate crowdin label_gal_aunt_06_0e53808d:
msgid "[_MD_] And you think Aunt [mom_name] and [ryan] treated you with disrespect?!"
msgstr "[_MD_] E pensi che la zia [mom_name] e [ryan] ti abbia curato con disrispetto?!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21428 #-#-# translate crowdin label_gal_aunt_06_56a60b50:
msgid "[_MD_] Heaven forbid you should have to work for once in your life!"
msgstr "[_MD_] Il Cielo vieta che dovresti lavorare per una volta nella tua vita!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21429 #-#-# translate crowdin label_gal_aunt_06_2363addb:
msgid "[_MD_] And yeah... They made you wear a humiliating maid outfit, but did you ever think that maybe you deserved it for always throwing shade at Aunt [mom_name]?"
msgstr "[_MD_] E sì... Ti hanno fatto indossare un abito da cameriera umiliante, ma hai mai pensato che forse l'hai meritata per aver sempre gettato ombra alla zia [mom_name]?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21430 #-#-# translate crowdin label_gal_aunt_06_be556bf1:
msgid "[_MD_] With your constant underhanded comments about her being a stripper, when all she's trying to do is prevent her family from being killed by the mafia!"
msgstr "[_MD_] Con i tuoi continui commenti sottomessi su di lei essere un stripper, quando tutto quello che sta cercando di fare è evitare che la sua famiglia venga uccisa dalla mafia!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21431 #-#-# translate crowdin label_gal_aunt_06_f1d13c5b:
msgid "[_MD_] I know I hoped that outfit would help humble you, but no! If anything, you somehow became even more prideful!"
msgstr "[_MD_] So che speravo che quell'abito ti avrebbe aiutato umile, ma no! Semmai, in qualche modo sei diventato ancora più orgoglioso!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21432 #-#-# translate crowdin label_gal_aunt_06_3758f9bd:
msgid "[_C_] Mandy! How dare you disrespect..."
msgstr "[_C_] Mandy! Come osate non rispettare..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21433 #-#-# translate crowdin label_gal_aunt_06_8fb4fe58:
msgid "[_MD_] You're not deserving of any respect!... You're a fucking..."
msgstr "[_MD_] Non ti meriti alcun rispetto!... Sei un cazzo..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21436 #-#-# translate crowdin label_gal_aunt_06_be6faaa4:
msgid "[_MD_] Aaahhh!!"
msgstr "[_MD_] Aaahhh!!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21437 #-#-# translate crowdin label_gal_aunt_06_eb6aa88b:
msgid "[_C_] Mandy, what's wrong!?..."
msgstr "[_C_] Mandy, cosa c'è di male!?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21438 #-#-# translate crowdin label_gal_aunt_06_7c9033fe:
msgid "[_MD_] Behind you!"
msgstr "[_MD_] Dietro di te!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21441 #-#-# translate crowdin label_gal_aunt_06_304ba5bb:
msgid "[_MP_] You've got to help me!"
msgstr "[_MP_] Devi aiutarmi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21442 #-#-# translate crowdin label_gal_aunt_06_b999e7ec:
msgid "[_MP_] I've been betrayed!"
msgstr "[_MP_] Sono stato tradito!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21445 #-#-# translate crowdin label_gal_aunt_06_c12c469e:
msgid "[_C_] It's okay, Mister... I think you might be a little confused."
msgstr "[_C_] Va bene, Mister... penso che potresti essere un po' confuso."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21446 #-#-# translate crowdin label_gal_aunt_06_fffea158:
msgid "[_MP_] No!"
msgstr "[_MP_] No!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21449 #-#-# translate crowdin label_gal_aunt_06_48fe6b3a:
msgid "[_MP_] The commies have infiltrated our government!"
msgstr "[_MP_] Le commesse si sono infiltrate nel nostro governo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21450 #-#-# translate crowdin label_gal_aunt_06_c5a125ab:
msgid "[_MP_] They stuck me in a secret facility! They're forcing me to take mind altering drugs!"
msgstr "[_MP_] Mi hanno bloccato in una struttura segreta! Mi stanno costringendo a prendere la mente alterando le droghe!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21451 #-#-# translate crowdin label_gal_aunt_06_c3e565bc:
msgid "[_MP_] They're doing experiments on me!"
msgstr "[_MP_] Mi stanno facendo esperimenti!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21452 #-#-# translate crowdin label_gal_aunt_06_f0f65aa1:
msgid "[_MP_] They want to steal all my sperm to make super soldiers!"
msgstr "[_MP_] Vogliono rubare tutto il mio sperma per fare super soldati!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21453 #-#-# translate crowdin label_gal_aunt_06_1bf15627:
msgid "[_C_] I don't think..."
msgstr "[_C_] Non penso..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21456 #-#-# translate crowdin label_gal_aunt_06_ea273ba0:
msgid "[_MP_] But, why am I telling you all this?"
msgstr "[_MP_] Ma, perché vi dico tutto questo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21457 #-#-# translate crowdin label_gal_aunt_06_5f956c1e:
msgid "[_MP_] You can't help me, can you?"
