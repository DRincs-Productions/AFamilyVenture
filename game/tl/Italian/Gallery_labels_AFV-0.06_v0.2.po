# game/Gallery_labels_AFV-0.06_v0.2.rpy:25224 #-#-# translate crowdin label_gal_Xmas_event_60356abf:
msgid "[_S_] No.... I wasn't living at home at the time. I was too busy with the DeCapos. Joey had me living in his high rise apartment."
msgstr "[_S_] No.... Non vivevo a casa all'epoca. Ero troppo occupato con i Decapo. Joey mi faceva vivere nel suo appartamento ai piani alti."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:25225 #-#-# translate crowdin label_gal_Xmas_event_19650fdb:
msgid "[_S_] And you refused to even come visit me."
