# game/Gallery_labels_AFV-0.06_v0.2.rpy:3746 #-#-# translate crowdin label_gal_mom_ph_read_b2c2b3d8:
msgid "[_RT_] {i}([ryan] still reading in head) It's tonight, said Perry, once he was sure Professor McGargleCum was out of earshot.{/i}"
msgstr "[_RT_] {i}([ryan] ancora leggendo nella testa) È stasera, disse Perry, una volta che fu sicuro che il professor McGargleCum fosse fuori portata d'orecchio.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3749 #-#-# translate crowdin label_gal_mom_ph_read_d28db84e:
msgid "[_M_] Oh, hey!"
msgstr "[_M_] Oh, hey!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3750 #-#-# translate crowdin label_gal_mom_ph_read_c95e429e:
msgid "[_R_] Oh, hi Mom."
msgstr "[_R_] Oh, ciao mamma."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3751 #-#-# translate crowdin label_gal_mom_ph_read_ba492937:
msgid "[_M_] Sorry to interrupt you... I was on my way to my bedroom after my shower, and saw your light on... I was going to turn it off... but now I see you're in here."
msgstr "[_M_] Scusa se ti ho interrotto... Stavo andando in camera mia dopo la doccia e ho visto la tua luce accesa... Stavo per spegnerla... ma ora vedo che sei qui."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3754 #-#-# translate crowdin label_gal_mom_ph_read_5fccb590:
msgid "[_M_] Oh, hey!... Is that Perry Hotter you're reading?"
msgstr "[_M_] Oh, ehi!... È Perry Hotter quello che stai leggendo?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3755 #-#-# translate crowdin label_gal_mom_ph_read_73fa0da8:
