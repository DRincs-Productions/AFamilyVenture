# game/Gallery_labels_AFV-0.06_v0.2.rpy:33557 #-#-# translate crowdin label_gal_mom_sushi_date_joey_af9ee080:
msgid "[_A_] At any given time most of those dinning rooms are empty, meaning that almost nobody will be using these bathrooms."
