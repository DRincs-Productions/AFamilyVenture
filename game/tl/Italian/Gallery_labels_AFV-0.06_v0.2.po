# game/Gallery_labels_AFV-0.06_v0.2.rpy:18106 #-#-# translate crowdin label_gal_aunt_01_16430f7a:
msgid "[_M_] Uncle Bobby has dissapeared and left Camille and Mandy without anything.... "
