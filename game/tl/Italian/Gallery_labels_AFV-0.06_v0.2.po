# game/Gallery_labels_AFV-0.06_v0.2.rpy:4182 #-#-# translate crowdin label_gal_mom_sushi_date_25879369:
msgid "[_R_] Yes, please!"
msgstr "[_R_] Sì, per piacere!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4185 #-#-# translate crowdin label_gal_mom_sushi_date_0573f4ca:
msgid "[_W_] Oh, and one thing you should be aware of, in a private dinning room like this, we respect the privacy of our dinners. so after we bring you your food, we won't come back unless you summon us."
msgstr "[_W_] Oh, e una cosa di cui dovresti essere consapevole, in una sala da pranzo privata come questa, rispettiamo la privacy delle nostre cene . così dopo che ti portiamo il tuo cibo, non torneremo a meno che tu non ci chiami."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4186 #-#-# translate crowdin label_gal_mom_sushi_date_accb9c5f:
msgid "[_W_] You can summon us by texting the number on that card we left on the table, and we'll send someone in immediately."
msgstr "[_W_] Puoi evocarci scrivendo il numero su quella carta che abbiamo lasciato sul tavolo, e invieremo immediatamente qualcuno in questa carta."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4187 #-#-# translate crowdin label_gal_mom_sushi_date_e70ac03f:
msgid "[_M_] Oh... That's really nice."
msgstr "[_M_] Oh... È davvero bello."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:4190 #-#-# translate crowdin label_gal_mom_sushi_date_8cd338aa:
msgid "[_M_] I'm worried you're going to get us in trouble with that fake ID."
