# game/Gallery_labels_AFV-0.06_v0.2.rpy:23160 #-#-# translate crowdin label_gal_Xmas_event_f2ca3f91:
msgid "[_GP_] No.... It's nothing like that! There isn't anything we can do here that will change the future. The past is already written."
msgstr "[_GP_] No.... Non è niente del genere! Non c'è niente che possiamo fare qui che cambierà il futuro. Il passato è già scritto."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23161 #-#-# translate crowdin label_gal_Xmas_event_8c5b85fb:
