# game/Gallery_labels_AFV-0.06_v0.2.rpy:23796 #-#-# translate crowdin label_gal_Xmas_event_3864a5ae:
msgid "[_AD_] If you'll let me be the director and photographer of your photo shoot, you won't have to pay me for this week, or next week."
