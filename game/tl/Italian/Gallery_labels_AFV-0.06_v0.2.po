# game/Gallery_labels_AFV-0.06_v0.2.rpy:18908 #-#-# translate crowdin gal_aunt_clean_kitchen_28a6be74:
msgid "[_R_] And since I'm paying you to do a job, what will you give me to do your job for you?"
