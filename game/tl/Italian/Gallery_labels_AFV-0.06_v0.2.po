# game/Gallery_labels_AFV-0.06_v0.2.rpy:15895 #-#-# translate crowdin label_gal_mom_investigates_f2e1fc74_1:
msgid "[_R_] Yes, please."
msgstr "[_R_] Sì, per piacere."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15901 #-#-# translate crowdin label_gal_mom_investigates_c1759516:
msgid "[_R_] My God, Sidney!"
msgstr "[_R_] Mio Dio, Sidney!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15902 #-#-# translate crowdin label_gal_mom_investigates_96dcd49f:
msgid "[_R_] I can't believe you did that!"
msgstr "[_R_] Non posso credere che tu l'abbia fatto!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15903 #-#-# translate crowdin label_gal_mom_investigates_80e648c0:
msgid "[_S_] You fucking deserved it."
msgstr "[_S_] Lo hai fatto meritare."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15904 #-#-# translate crowdin label_gal_mom_investigates_9d01c4d1:
msgid "[_R_] You started the teasing!"
msgstr "[_R_] Hai iniziato a prendere in giro!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15907 #-#-# translate crowdin label_gal_mom_investigates_87eb05dc:
msgid "[_S_] And now look... We don't have to be so sneaky anymore."
msgstr "[_S_] E ora guardano... Non dobbiamo più essere così subdoli."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15908 #-#-# translate crowdin label_gal_mom_investigates_c53f52e2_1:
msgid "[_S_] And now, I'm going to sleep."
msgstr "[_S_] E ora, dormirò."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15909 #-#-# translate crowdin label_gal_mom_investigates_cf5810a5:
msgid "[_R_] Everyone will soon know we're sleeping together. You won't have to rush out of bed so early in the morning anymore."
msgstr "[_R_] Tutti sapranno presto che stiamo dormendo insieme. Non dovrai più correre dal letto così presto al mattino."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15910 #-#-# translate crowdin label_gal_mom_investigates_1caa3650:
msgid "[_S_] Sleeping together... that sounds so naughty... Still... I probably will continue to sneak out early. Running every morning has been really therapeutic for me."
msgstr "[_S_] Dormire insieme... che suona così cattivo... ancora... probabilmente continuerò a uscire presto fuori. Correre ogni mattina è stato davvero terapeutico per me."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15911 #-#-# translate crowdin label_gal_mom_investigates_eb301bc7:
msgid "[_R_] Suit yourself. Maybe I'll join you one of these mornings."
msgstr "[_R_] Suit te stesso. Forse mi unirò a te una di queste mattine."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15912 #-#-# translate crowdin label_gal_mom_investigates_5bbe8cfd:
msgid "[_S_] Ooohh... You want to get in an extra workout at the park?"
msgstr "[_S_] Ooohh... Vuoi ottenere un allenamento extra al parco?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15913 #-#-# translate crowdin label_gal_mom_investigates_0a0025a1:
msgid "[_S_] I'm up for it anytime."
msgstr "[_S_] lo sto per in qualsiasi momento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15917 #-#-# translate crowdin label_gal_mom_investigates_1705afeb:
msgid "[_RT_] And that's all the memory I have of that event!"
msgstr "[_RT_] E questo è tutto il ricordo che ho di quell'evento!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15930 #-#-# translate crowdin label_gal_halloween_event_start_5c240a68:
msgid "{b}{i}\"Happy Halloween, and welcome to \"Stranger Ventures\"!\"{/i}{/b}"
msgstr "{b}{i}\"Happy Halloween, e benvenuto a \"Stranger Ventures\"!\"{/i}{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15931 #-#-# translate crowdin label_gal_halloween_event_start_62c4ee5d:
msgid "{b}{i}\"We hope you enjoy!\"{/i}{/b}"
msgstr "{b}{i}\"Speriamo che ti piace!\"{/i}{/b}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15959 #-#-# translate crowdin label_gal_halloween_event_start_e5884594:
msgid "[_SM_] We've got to find a way out!"
msgstr "[_SM_] Dobbiamo trovare una via d'uscita!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15962 #-#-# translate crowdin label_gal_halloween_event_start_a5c87e11:
msgid "[_SM_] Martha! We can't stop running!"
msgstr "[_SM_] Martha! Non possiamo smettere di correre!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15963 #-#-# translate crowdin label_gal_halloween_event_start_1a58b5c5:
msgid "[_SM_] That... Thing... is right behind us!"
msgstr "[_SM_] Quello... La cosa... è proprio dietro di noi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15964 #-#-# translate crowdin label_gal_halloween_event_start_81e91006:
msgid "[_SF_] My lungs... are about... to explode!"
msgstr "[_SF_] I miei polmoni... sono circa... per esplodere!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15965 #-#-# translate crowdin label_gal_halloween_event_start_bd7f4e76:
msgid "[_SM_] Can't we just... Hide for a minute?"
msgstr "[_SM_] Non possiamo solo... Nascondere per un minuto?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15968 #-#-# translate crowdin label_gal_halloween_event_start_c7b400af:
msgid "[_SM_] I don't hear it coming anymore."
msgstr "[_SM_] Non lo sento più venire."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15969 #-#-# translate crowdin label_gal_halloween_event_start_c00ac7f6:
msgid "[_SF_] I think I'm about to lose my lunch!"
msgstr "[_SF_] penso che sto per perdere il mio pranzo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15970 #-#-# translate crowdin label_gal_halloween_event_start_04fa5a7d:
msgid "[_SF_] What the hell was that thing?"
msgstr "[_SF_] Che diavolo era quella cosa?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15971 #-#-# translate crowdin label_gal_halloween_event_start_2ae9a32d:
msgid "[_SM_] I don't know... But we never should have been playing God!"
msgstr "[_SM_] Non lo so... Ma non avremmo mai dovuto suonare Dio!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15972 #-#-# translate crowdin label_gal_halloween_event_start_03f09a4a:
msgid "[_SM_] Now, how can we ask him to save us?"
msgstr "[_SM_] Ora, come possiamo chiedergli di salvarci?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15973 #-#-# translate crowdin label_gal_halloween_event_start_cdd3babd:
msgid "[_SF_] Are you kidding? Did you see that thing? There is no God!"
msgstr "[_SF_] stai scherzando? Hai visto quella cosa? Non c'è Dio!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15974 #-#-# translate crowdin label_gal_halloween_event_start_0ea38a0f:
msgid "[_SF_] We have to save ourselves!"
msgstr "[_SF_] Dobbiamo salvare noi stessi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15977 #-#-# translate crowdin label_gal_halloween_event_start_802617d3:
msgid "[_SM_] Fuck, Martha! The guards are all dead!"
msgstr "[_SM_] Cazzo Martha! Le guardie sono tutte morte!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15978 #-#-# translate crowdin label_gal_halloween_event_start_1242aa5b:
msgid "[_SM_] How are we supposed to defend ourselves?"
msgstr "[_SM_] Come dobbiamo difenderci?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15981 #-#-# translate crowdin label_gal_halloween_event_start_987d0ace:
msgid "[_SM_] Ok, I see a crowbar over there."
msgstr "[_SM_] Ok, vedo un crowbar laggiù."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15982 #-#-# translate crowdin label_gal_halloween_event_start_45ba0be1:
msgid "[_SM_] I'm going to run grab it!"
msgstr "[_SM_] sto per correre afferrarlo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15983 #-#-# translate crowdin label_gal_halloween_event_start_4bfa3019:
msgid "[_SF_] A crowbar? The guards couldn't even stop this thing with bullets!"
msgstr "[_SF_] Un crowbar? Le guardie non potevano nemmeno fermare questa cosa con i proiettili!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15984 #-#-# translate crowdin label_gal_halloween_event_start_b40de364:
msgid "[_SM_] It's better than nothing!"
msgstr "[_SM_] È meglio di niente!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15987 #-#-# translate crowdin label_gal_halloween_event_start_52d50737:
msgid "[_SF_] You're just going to get yourself killed."
msgstr "[_SF_] Hai solo intenzione di farti uccidere."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15988 #-#-# translate crowdin label_gal_halloween_event_start_06c92f66:
msgid "[_SF_] Dr. Branson?"
msgstr "[_SF_] Dr. Branson?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15991 #-#-# translate crowdin label_gal_halloween_event_start_669aa1e2:
msgid "[_SF_] Fuck!"
msgstr "[_SF_] Scopata!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15992 #-#-# translate crowdin label_gal_halloween_event_start_44c00ede:
msgid "[_SF_] He's going to get us both killed!"
msgstr "[_SF_] Ci farà uccidere entrambi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15998 #-#-# translate crowdin label_gal_halloween_event_start_c60945d4:
msgid "[_SF_] {i}(Whispering){/i} Dr. Branson? Where did you go?"
msgstr "[_SF_] {i}(Whispering){/i} Dr. Branson? Dove sei andato?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:15999 #-#-# translate crowdin label_gal_halloween_event_start_06c92f66_1:
msgid "[_SF_] Dr. Branson?"
msgstr "[_SF_] Dr. Branson?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16002 #-#-# translate crowdin label_gal_halloween_event_start_32b0b14d:
msgid "[_SF_] {i}(Whispering to herself){/i} Oh, no!... Oh, God!..."
msgstr "[_SF_] {i}(Whispering to self){/i} Oh, no!... Oh, Dio!..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16003 #-#-# translate crowdin label_gal_halloween_event_start_ccb61749:
msgid "[_SF_] I can't die! Who's goin to take care of my cats?"
msgstr "[_SF_] Non posso morire! Chi va a prendersi cura dei miei gatti?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16006 #-#-# translate crowdin label_gal_halloween_event_start_100fd34f:
msgid "[_SF_] Dr. Branson! Where are you?"
msgstr "[_SF_] Dr. Branson! Dove sei?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16007 #-#-# translate crowdin label_gal_halloween_event_start_8c14b33a:
msgid "[_SF_] Oh, God... Oh, no..."
msgstr "[_SF_] Oh, Dio... Oh, no..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16010 #-#-# translate crowdin label_gal_halloween_event_start_4f90af39:
msgid "[_SF_] Is that blood?"
msgstr "[_SF_] È quel sangue?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16011 #-#-# translate crowdin label_gal_halloween_event_start_7d00402d:
msgid "[_SF_] Is that the crowbar Dr. Branson was trying to get?"
msgstr "[_SF_] È che il crowbar Dr. Branson stava cercando di ottenere?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16014 #-#-# translate crowdin label_gal_halloween_event_start_c6d900c0:
msgid "[_SF_] What on earth is this viscous substance it's laying in?"
msgstr "[_SF_] Che cosa è sulla terra questa sostanza viscosa che sta posando?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16015 #-#-# translate crowdin label_gal_halloween_event_start_19d64e0f:
msgid "[_SF_] Is it glowing?"
msgstr "[_SF_] È splendore?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16018 #-#-# translate crowdin label_gal_halloween_event_start_aa784e8e:
msgid "[_SF_] Is this from the thing that's wreaking havoc on the lab?"
msgstr "[_SF_] È questa la cosa che sta distruggendo il laboratorio?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16019 #-#-# translate crowdin label_gal_halloween_event_start_3f4361f5:
msgid "[_SF_] Is it some sort of bioluminescent discharge?"
msgstr "[_SF_] È una sorta di scarico bioluminescente?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16026 #-#-# translate crowdin label_gal_halloween_event_start_33d8c602:
msgid "[_SF_] Goddammit! If I wasn't running for my life, I'd take a sample to study."
msgstr "[_SF_] Goddammit! Se non fossi in esecuzione per la mia vita, prenderei un esempio per studiare."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16027 #-#-# translate crowdin label_gal_halloween_event_start_b95c5c2f:
msgid "[_SF_] Maybe I've got time to collect a small amount."
msgstr "[_SF_] Forse ho il tempo di raccogliere una piccola quantità."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16059 #-#-# translate crowdin label_gal_halloween_event_start_989a8cfd:
msgid "[_MD_] Good God, [ryan]! Tell us!"
msgstr "[_MD_] Buon Dio, [ryan]! Diteci!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16062 #-#-# translate crowdin label_gal_halloween_event_start_3ff91ba6:
msgid "[_L_] Yeah! I broke my level sixty nine magic staff to get that tomb unsealed!"
msgstr "[_L_] Yeah! Ho rotto il mio personale magico di livello sessantanove per ottenere quella tomba smantellata!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16063 #-#-# translate crowdin label_gal_halloween_event_start_afd432ea:
msgid "[_MD_] What's waiting behind the door?"
msgstr "[_MD_] Cosa sta aspettando dietro la porta?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16064 #-#-# translate crowdin label_gal_halloween_event_start_7ea9d909:
msgid "[_MG_] Yeah, enough with the suspense!"
msgstr "[_MG_] Sì, basta con la sospensione!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16065 #-#-# translate crowdin label_gal_halloween_event_start_80e18cae:
msgid "[_R_] Alright, alright, Sheesh!"
msgstr "[_R_] Va bene, va bene, Sheesh!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16066 #-#-# translate crowdin label_gal_halloween_event_start_0007043b:
msgid "[_R_] Nobody appreciates the art of a good Dungeon Master."
msgstr "[_R_] Nessuno apprezza l'arte di un buon Dungeon Master."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16069 #-#-# translate crowdin label_gal_halloween_event_start_eae336f0:
msgid "[_R_] So, as the heavy stone door of the ancient king's tomb crashed to the floor, the stench of putrid rotting flesh overwhelms you nostrils!"
msgstr "[_R_] Così, come la pesante porta in pietra della tomba del re antico si schiantò al pavimento, il putrido di carne marciante ti travolge le narici!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16070 #-#-# translate crowdin label_gal_halloween_event_start_33241e1b:
msgid "[_R_] As you try to peer into the darkness, you suddenly hear a high pitched"
msgstr "[_R_] Mentre provi a sbirciare nell'oscurità, senti improvvisamente un campo alto"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16073 #-#-# translate crowdin label_gal_halloween_event_start_8d1d31a2:
msgid "[_R_] SCRRREEEAAAACH!..."
msgstr "[_R_] SCRRREEEAAAACH!..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16074 #-#-# translate crowdin label_gal_halloween_event_start_b317e21c:
msgid "[_MG_] Oh, God! What could it be? I'm literally on the edge of my seat!"
msgstr "[_MG_] Oh, Dio! Cosa potrebbe essere? Sono letteralmente sul bordo del mio posto!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16077 #-#-# translate crowdin label_gal_halloween_event_start_8b8de774:
msgid "[_R_] From the darkness within, you can barely see the terrifying silhouette of a creature emerging into the pale torch light."
msgstr "[_R_] Dall'oscurità all'interno, si vede a malapena la terrificante silhouette di una creatura che emerge nella luce pallida della torcia."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16078 #-#-# translate crowdin label_gal_halloween_event_start_e13c10eb:
msgid "[_MB_] {i}(Muttering to himself){/i}Oh my God... I can't believe this is how we're spending our Sunday night."
msgstr "[_MB_] {i}(Muttering to se stesso){/i}Oh mio Dio... Non riesco a credere che questo sia il modo in cui passiamo la domenica sera."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16079 #-#-# translate crowdin label_gal_halloween_event_start_8dc27091:
msgid "[_R_] To your horror, you finally are able to identify this horrifying monster!"
msgstr "[_R_] Per il tuo orrore, sei finalmente in grado di identificare questo orribile mostro!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16082 #-#-# translate crowdin label_gal_halloween_event_start_5f4e26c3:
msgid "[_R_] The DemiGobbler!"
msgstr "[_R_] Il DemiGobbler!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16083 #-#-# translate crowdin label_gal_halloween_event_start_983a5f8e:
msgid "[_L_] Noooo!"
msgstr "[_L_] Noooo!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16086 #-#-# translate crowdin label_gal_halloween_event_start_917370fe:
msgid "[_R_] I'm afraid so."
msgstr "[_R_] Ho paura di sì."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16087 #-#-# translate crowdin label_gal_halloween_event_start_5a62aa47:
msgid "[_R_] A creature so powerfull, that it will take all of your strength, skills, and powers, not to mention, a lot of luck, to defeat."
msgstr "[_R_] Una creatura così potente, che ci vorrà tutta la tua forza, abilità e poteri, per non menzionare, molta fortuna, per sconfiggere."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16088 #-#-# translate crowdin label_gal_halloween_event_start_f8055650:
msgid "[_M_] [ryan]?"
msgstr "[_M_] [ryan]?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16089 #-#-# translate crowdin label_gal_halloween_event_start_c531636f:
msgid "[_R_] You'll have to have a combined roll of over 40 to be able to vanquish this foe!"
msgstr "[_R_] Dovrai avere un rotolo combinato di oltre 40 per essere in grado di sconfiggere questo nemico!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16090 #-#-# translate crowdin label_gal_halloween_event_start_c93d9342:
msgid "[_M_] [ryan]!"
msgstr "[_M_] [ryan]!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16093 #-#-# translate crowdin label_gal_halloween_event_start_4fb90733:
msgid "[_R_] What is it, Mom?"
msgstr "[_R_] Che cos'è, la mamma?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16094 #-#-# translate crowdin label_gal_halloween_event_start_4e0f6478:
msgid "[_R_] Can't you see we're busy?"
msgstr "[_R_] Non riesci a vedere che siamo occupati?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16095 #-#-# translate crowdin label_gal_halloween_event_start_ad462e5a:
msgid "[_M_] Don't you talk to your mother like that, Mister!"
msgstr "[_M_] Non parli così con tua madre, Mister!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16096 #-#-# translate crowdin label_gal_halloween_event_start_fbd15a76:
msgid "[_M_] I've had it with you leaving the toilet seat up, and not wiping up your pee from the edge of the bowl!"
msgstr "[_M_] L'ho avuto con te lasciando il sedile dei servizi igienici in su, e non spazzare via il tuo pisello dal bordo della ciotola!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16097 #-#-# translate crowdin label_gal_halloween_event_start_2ef650d1:
msgid "[_M_] Imagine my surprise when I went to sit and almost fell through into the water, only to catch myself by sticking my hand in a puddle of your piss!"
msgstr "[_M_] Immaginate la mia sorpresa quando sono andato a sedermi e quasi caduto nell'acqua, solo per prendermi attaccando la mia mano in una pozza del vostro piss!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16098 #-#-# translate crowdin label_gal_halloween_event_start_a251dcb4:
msgid "[_R_] How do you know it was me?... Maybe it was Lauren."
msgstr "[_R_] Come sai che ero io?... Forse era Lauren."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16101 #-#-# translate crowdin label_gal_halloween_event_start_680f266a:
msgid "[_M_] Yeah, right... That would almost be as difficult for her, as you not doing it in the first place."
msgstr "[_M_] Sì, giusto... Questo sarebbe quasi difficile per lei, come non lo fai in primo luogo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16102 #-#-# translate crowdin label_gal_halloween_event_start_aa250f49:
msgid "{i}(Sound of door opening.){/i}"
msgstr "{i}(Sound of door opening.){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16105 #-#-# translate crowdin label_gal_halloween_event_start_dd130cdc:
msgid "[_S_] Mom!... I'm home!"
msgstr "[_S_] Mom!... Sono a casa!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16106 #-#-# translate crowdin label_gal_halloween_event_start_9b20b04e:
msgid "[_M_] We're in the dining room, Honey!"
msgstr "[_M_] Siamo nella sala da pranzo, miele!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16109 #-#-# translate crowdin label_gal_halloween_event_start_f682c073:
msgid "[_S_] What's up guys?"
msgstr "[_S_] Che cos'è dei ragazzi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16110 #-#-# translate crowdin label_gal_halloween_event_start_9a9829af:
msgid "[_S_] Oh, I see... A nerd party. {i}(sarcastically){/i} How fun."
msgstr "[_S_] Oh, vedo... Una festa nerd. {i}(sarcastically){/i} Quanto divertimento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16111 #-#-# translate crowdin label_gal_halloween_event_start_16e01f6b:
msgid "[_MB_] Tell me about it!"
msgstr "[_MB_] Me ne parla!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16112 #-#-# translate crowdin label_gal_halloween_event_start_33a42f8d:
msgid "[_L_] Monsters and Mountains is not nerdy... Well, maybe a little, but can we please get on with the game?"
msgstr "[_L_] Mostri e montagne non sono nerd... Beh, forse un po ', ma possiamo andare avanti con il gioco?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16113 #-#-# translate crowdin label_gal_halloween_event_start_0dfcbda7:
msgid "[_R_] Yeah... We've had enough interruptions."
msgstr "[_R_] Sì... Abbiamo avuto abbastanza interruzioni."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16114 #-#-# translate crowdin label_gal_halloween_event_start_1493be72:
msgid "[_S_] Whatever, nerds!"
msgstr "[_S_] Qualunque sia il nerds!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16117 #-#-# translate crowdin label_gal_halloween_event_start_db286e98:
msgid "[_M_] Sidney, please don't tell me you went jogging this late!"
msgstr "[_M_] Sidney, per favore non dirmi che sei andato a fare jogging questo tardi!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16120 #-#-# translate crowdin label_gal_halloween_event_start_97a4deee:
msgid "[_S_] Yeah, of course I did. Why else would I be dressed like this?"
msgstr "[_S_] Sì, naturalmente, ho fatto. Perché altrimenti sarei vestito così?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16121 #-#-# translate crowdin label_gal_halloween_event_start_95d45328:
msgid "[_S_] And don't worry, Mom! I didn't wear ear buds, and I kept my eyes open for any creepers."
msgstr "[_S_] E non preoccupatevi, Mamma! Non indossavo gemme di orecchio, e tenevo gli occhi aperti per qualsiasi creeper."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16124 #-#-# translate crowdin label_gal_halloween_event_start_d993d008:
msgid "[_M_] I don't care how careful you were. Creepers are going to be just as sneaky as you are careful!"
msgstr "[_M_] Non mi importa quanto sei stato attento. I creeper saranno altrettanto subdoli come se fossi prudente!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16125 #-#-# translate crowdin label_gal_halloween_event_start_6694184d:
msgid "[_M_] Sidney, we've been over this!"
msgstr "[_M_] Sidney, siamo stati finiti!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16128 #-#-# translate crowdin label_gal_halloween_event_start_7ae131c6:
msgid "[_S_] Yeah, so there's no point in going over it again."
msgstr "[_S_] Sì, quindi non ha senso riprenderlo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16129 #-#-# translate crowdin label_gal_halloween_event_start_82fefad3:
msgid "[_M_] Well, apparently there is, since you didn't listen to me."
msgstr "[_M_] Beh, a quanto pare c'è, dal momento che non mi hai ascoltato."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16130 #-#-# translate crowdin label_gal_halloween_event_start_da9793c0:
msgid "[_M_] I'm only trying to keep you safe!"
msgstr "[_M_] Sto solo cercando di tenerti al sicuro!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16133 #-#-# translate crowdin label_gal_halloween_event_start_fe80a189:
msgid "[_S_] I know, Mom! I'm sorry. I do try to listen."
msgstr "[_S_] lo so, mamma! Mi dispiace. Cerco di ascoltare."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16134 #-#-# translate crowdin label_gal_halloween_event_start_3c0fea65:
msgid "[_S_] Normally I jog in the early morning, but [ryan] and I were up super late last night, and I was too tired to get up this morning."
msgstr "[_S_] Normalmente ho suonato la mattina presto, ma [ryan] ed io eravamo super tardi ieri sera, ed ero troppo stanco per alzarmi questa mattina."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16135 #-#-# translate crowdin label_gal_halloween_event_start_4dc99e42:
msgid "[_M_] What were you two doing up so late?"
msgstr "[_M_] Che cosa stavate facendo due così tardi?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16138 #-#-# translate crowdin label_gal_halloween_event_start_97cf3728:
msgid "[_ST_] {i}Oh, fuck! Why did I tell her [ryan] and I were up late? What was I thinking?{/i}"
msgstr "[_ST_] {i}Oh, cazzo! Perché le ho detto [ryan] e sono stato in ritardo? Cosa stavo pensando?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16139 #-#-# translate crowdin label_gal_halloween_event_start_0d30d34c:
msgid "[_ST_] {i}Am I supposed to tell her that my brother was cleaning out my pussy with his tongue, or that I was getting my womb smashed by his huge cock?{/i}"
msgstr "[_ST_] {i}Dovrei dirle che mio fratello stava pulendo la mia figa con la sua lingua, o che stavo facendo scoppiare il mio grembo dal suo enorme cazzo? /i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16140 #-#-# translate crowdin label_gal_halloween_event_start_dd6a859c:
msgid "[_ST_] {i}Hurry, brain! Come up with an excuse!{/i}"
msgstr "[_ST_] {i}Affretta, cervello! Vieni con una scusa!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16143 #-#-# translate crowdin label_gal_halloween_event_start_8da91fd4:
msgid "[_S_] I was helping him with his history homework, okay? Now I need to run take a shower."
