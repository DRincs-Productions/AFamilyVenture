# game/Gallery_labels_AFV-0.06_v0.2.rpy:25190 #-#-# translate crowdin label_gal_Xmas_event_6d0a575f:
msgid "[_RT_] {i}And to think, I was a totally normal kid, not too long ago.{/i}"
