# game/Gallery_labels_AFV-0.06_v0.2.rpy:33586 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0cec3e07:
msgid "[_A_] Diaz said he was about to shove a wrench in her ass before you walked in."
