msgstr "[_R_] Uhhhh... Sì, prima era matematica, poi mi ha aiutato anche con la mia scienza."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16175 #-#-# translate crowdin label_gal_halloween_event_start_253c31cb:
msgid "[_MT_] {i}Hmmmm... Those two are hiding something from me!{/i}"
msgstr "[_MT_] {i}Hmmmm... Questi due mi stanno nascondendo qualcosa!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16176 #-#-# translate crowdin label_gal_halloween_event_start_aa328946:
msgid "[_R_] Now, can we get back to our campaign?"
msgstr "[_R_] Ora, possiamo tornare alla nostra campagna?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16179 #-#-# translate crowdin label_gal_halloween_event_start_4a66e22a:
msgid "[_M_] Are you guys playing Monsters and Mountains?"
msgstr "[_M_] Stai giocando a mostri e montagne?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16180 #-#-# translate crowdin label_gal_halloween_event_start_2eac35f8:
msgid "[_MD_] Yeah, you've heard of it?"
msgstr "[_MD_] Sì, ne hai sentito parlare?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16181 #-#-# translate crowdin label_gal_halloween_event_start_150e397d:
msgid "[_M_] Are you kidding? It was really popular when I was a teenager."
msgstr "[_M_] Stai scherzando? Era davvero popolare quando ero adolescente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16182 #-#-# translate crowdin label_gal_halloween_event_start_e330fbb8:
msgid "[_M_] Your grandma wouldn't let your mom or I play it. She thought that it had ties the occult."
msgstr "[_M_] Tua nonna non lascerebbe che tua mamma o io la suoni. Pensava che avesse legami l'occulto."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16183 #-#-# translate crowdin label_gal_halloween_event_start_9f2ccaa5:
msgid "[_R_] Well it's too late for you to join our game. We're already well into our campaign."
msgstr "[_R_] Beh, è troppo tardi per partecipare al nostro gioco. Siamo già bene nella nostra campagna."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16184 #-#-# translate crowdin label_gal_halloween_event_start_65df31b1:
msgid "[_M_] Oh, relax! I'm not trying to join your little game."
msgstr "[_M_] Oh, rilassati! Non sto cercando di partecipare alla tua piccola partita."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16185 #-#-# translate crowdin label_gal_halloween_event_start_15986399:
msgid "[_R_] It's a campaign, Mom!"
msgstr "[_R_] È una campagna, mamma!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16188 #-#-# translate crowdin label_gal_halloween_event_start_f8a389ba:
msgid "[_MB_] She can take over my character. I'm ready to be done for the night."
msgstr "[_MB_] Lei può assumere il mio personaggio. Sono pronto per essere fatto per la notte."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16189 #-#-# translate crowdin label_gal_halloween_event_start_358d5e5e:
msgid "[_MB_] I still don't see what the hell you all see in this game."
msgstr "[_MB_] Non vedo ancora cosa l'inferno che tutti vedete in questo gioco."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16192 #-#-# translate crowdin label_gal_halloween_event_start_af8e38af:
msgid "[_MB_] Pretty much this exact game exists in video games, but it doesn't take ten days to finish a campaign."
msgstr "[_MB_] Molto questo gioco esatto esiste nei videogiochi, ma non ci vogliono dieci giorni per finire una campagna."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16195 #-#-# translate crowdin label_gal_halloween_event_start_16c7e4a6:
msgid "[_MG_] Would you please stop shitting all over this game! I swear, if you say one more bad thing about Monsters and Mountains than we'll be through for good!"
msgstr "[_MG_] smetteresti di fermare tutto questo gioco! Giuro, se dici ancora una cosa cattiva di Mostri e Montagne che faremo per bene!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16196 #-#-# translate crowdin label_gal_halloween_event_start_f2d85997:
msgid "[_MB_] Sheesh... Why so touchy?"
msgstr "[_MB_] Sheesh... Perché così toccato?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16197 #-#-# translate crowdin label_gal_halloween_event_start_a8ea0db5:
msgid "[_MG_] I've got great memories of playing this with my brothers when I was little, and your ruining my love for this game!"
msgstr "[_MG_] Ho grandi ricordi di giocare a questo con i miei fratelli quando ero piccolo, e il vostro rovinare il mio amore per questo gioco!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16198 #-#-# translate crowdin label_gal_halloween_event_start_9df97cb7:
msgid "[_MG_] So, shut up, or fuck off!"
msgstr "[_MG_] Quindi, zitte, o scopare fuori!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16201 #-#-# translate crowdin label_gal_halloween_event_start_34d711fe:
msgid "[_MD_] {i}(Talking quietly){/i} [ryan] I think you ought to get the game rolling again."
msgstr "[_MD_] {i}(Talking quietly){/i} [ryan] Penso che si dovrebbe ottenere il gioco di nuovo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16202 #-#-# translate crowdin label_gal_halloween_event_start_cfb218d0:
msgid "[_R_] I think you're right."
msgstr "[_R_] penso che tu abbia ragione."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16203 #-#-# translate crowdin label_gal_halloween_event_start_49f47229:
msgid "[_R_] Who's turn is it?"
msgstr "[_R_] Chi è il turno?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16206 #-#-# translate crowdin label_gal_halloween_event_start_81b96cfa:
msgid "[_L_] It's my turn. I was trying to decide which spell I should use against the DemiGobbler."
msgstr "[_L_] È il mio turno. Stavo cercando di decidere quale incantesimo dovrei usare contro il DemiGobbler."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16209 #-#-# translate crowdin label_gal_halloween_event_start_1901061c:
msgid "[_L_] If I remember right, I think a fire spell would be best."
msgstr "[_L_] Se mi ricordo bene, penso che un incantesimo di fuoco sarebbe meglio."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:16212 #-#-# translate crowdin label_gal_halloween_event_start_0f32dc9f:
msgid "[_MG_] No, isn't water it's weakness?"
