# game/Gallery_labels_AFV-0.06_v0.2.rpy:23155 #-#-# translate crowdin label_gal_Xmas_event_2250e01b:
msgid "[_M_] Oh, be nice!.... Nobody should feel pressured into tipping me, but I'll tell you what I'll do. Whichever of you tips me the most tonight will get a private lap dance from me."
