# game/Gallery_labels_AFV-0.06_v0.2.rpy:3740 #-#-# translate crowdin label_gal_mom_ph_read_038b4d59:
msgid "[_RT_] {i}([ryan] reading in head) Mr. and Mrs. Bursley, of number five Pecker Drive, were proud to say they were immaculately normal, thank you very much...{/i}"
msgstr "[_RT_] {i}([ryan] leggendo nella testa) Il signore e la signora Bursley, del numero cinque di Pecker Drive, erano orgogliosi di dire che erano immacolatamente normali, grazie mille...{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:3743 #-#-# translate crowdin label_gal_mom_ph_read_b6829274:
msgid "{i}\"Some time later.\"{/i}"
