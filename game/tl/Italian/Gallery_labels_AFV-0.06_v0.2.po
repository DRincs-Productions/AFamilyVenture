# game/Gallery_labels_AFV-0.06_v0.2.rpy:23159 #-#-# translate crowdin label_gal_Xmas_event_db059cc9:
msgid "[_RT_] {i}Why?.... Is it like the movie \"Back to the Future\", where I'll stop existing if my parents don't fall in love?{/i}"
