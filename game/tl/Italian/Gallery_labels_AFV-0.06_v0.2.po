# game/Gallery_labels_AFV-0.06_v0.2.rpy:33648 #-#-# translate crowdin label_gal_mom_sushi_date_joey_dbd8c3c9:
msgid "[_R_] It's like you read my thoughts."
msgstr "[_R_] È come se leggessi i miei pensieri."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33649 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a7c2e11c:
msgid "[_A_] Everybody thinks that... Why do you think I wear it?"
msgstr "[_A_] Tutti lo pensano... Perché pensi che lo indosso?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33652 #-#-# translate crowdin label_gal_mom_sushi_date_joey_e2128c58:
msgid "[_A_] Now, follow me."
