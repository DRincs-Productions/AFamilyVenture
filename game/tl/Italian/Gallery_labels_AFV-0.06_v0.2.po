# game/Gallery_labels_AFV-0.06_v0.2.rpy:23150 #-#-# translate crowdin label_gal_Xmas_event_40e8a5e1:
msgid "[_D_] Hey buddy!.... Are you just going to stare at us all day? Why don't you be a gentleman and tip the nice lady. It is Christmas, you know."
