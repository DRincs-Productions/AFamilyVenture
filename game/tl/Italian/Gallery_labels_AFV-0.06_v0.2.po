# game/Gallery_labels_AFV-0.06_v0.2.rpy:18880 #-#-# translate crowdin gal_aunt_clean_kitchen_7003ea28:
msgid "[_R_] I can see pieces of food from here that are stuck on the backsplash, and you haven't even touched the floor."
msgstr "[_R_] posso vedere pezzi di cibo da qui che sono bloccati sul backsplash, e non hai nemmeno toccato il pavimento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18881 #-#-# translate crowdin gal_aunt_clean_kitchen_6f8fb000:
msgid "[_R_] So, you better get back to work."
