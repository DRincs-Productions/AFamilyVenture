# game/Gallery_labels_AFV-0.06_v0.2.rpy:18100 #-#-# translate crowdin label_gal_aunt_01_a1c494ed:
msgid "[_M_] {i}(yelling){/i} Hey, [ryan]!.... Can you come in here really quickly?"
