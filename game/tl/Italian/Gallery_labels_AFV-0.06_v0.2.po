# game/Gallery_labels_AFV-0.06_v0.2.rpy:33594 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a0a161a3:
msgid "[_R_] Normally I'd be all about that, but for all I know, your uncle is fucking my mom just down the hall."
