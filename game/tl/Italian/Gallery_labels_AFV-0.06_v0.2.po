# game/Gallery_labels_AFV-0.06_v0.2.rpy:33665 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a3a6ba42:
msgid "[_MT_] {i}And as horny as I am right now, I'm about to rip those pants down and do it again!{/i}"
msgstr "[_MT_] {i}E così eccitata come sono in questo momento, sto per strappare quei pantaloni giù e farlo di nuovo!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33666 #-#-# translate crowdin label_gal_mom_sushi_date_joey_89159364:
msgid "[_MT_] {i}But what about [dad_name]?{/i}"
msgstr "[_MT_] {i}Ma che dire di [dad_name]?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33667 #-#-# translate crowdin label_gal_mom_sushi_date_joey_4a0dd9df:
msgid "[_M_] [dad_name] is going to kill me when he finds out!"
msgstr "[_M_] [dad_name] mi ucciderà quando scoprirà!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33668 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0d0d778b:
msgid "[_J_] [dad_name] isn't going to find out, and even if he does, I'll make it clear to him that if he does anything against you in revenge, he'll be wearing a cement pair of shoes."
msgstr "[_J_] [dad_name] non scoprirà, e anche se lo fa, Gli dirò chiaramente che se fa qualcosa contro di te in vendetta, indosserà un paio di scarpe da cemento."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33669 #-#-# translate crowdin label_gal_mom_sushi_date_joey_94a35e65:
msgid "[_MT_] {i}Jesus, he's talking about killing my husband!{/i}"
msgstr "[_MT_] {i}Gesù, sta parlando di uccidere mio marito!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33670 #-#-# translate crowdin label_gal_mom_sushi_date_joey_8c207342:
msgid "[_M_] [dad_name] isn't the greatest husband, but I wouldn't ever want him dead!"
msgstr "[_M_] [dad_name] non è il marito più grande, ma non lo vorrei mai morto!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33671 #-#-# translate crowdin label_gal_mom_sushi_date_joey_345741a4:
msgid "[_J_] Well, then... I'd show restraint... until you ask me not to."
msgstr "[_J_] Beh, allora... mostrerei la moderazione... finché non mi chiedi di non farlo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33672 #-#-# translate crowdin label_gal_mom_sushi_date_joey_cc036e59:
msgid "[_J_] Do you want to know what I'm having a hard time restraining, though?"
msgstr "[_J_] Vuoi sapere cosa sto avendo difficoltà a trattenersi, però?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33675 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b1831733:
msgid "[_M_] Let me guess. You're desire for me?"
msgstr "[_M_] Lasciami indovinare. Sei desiderato per me?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33676 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b0631b0f:
msgid "[_J_] Oh, hoho... It sounds like you've been hit on before."
msgstr "[_J_] Oh, hoho... Sembra che tu sia stato colpito prima."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33677 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a04033ff:
msgid "[_J_] And yes, that's a hard thing to restrain."
msgstr "[_J_] E sì, è una cosa difficile da trattenere."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33678 #-#-# translate crowdin label_gal_mom_sushi_date_joey_896bb817:
