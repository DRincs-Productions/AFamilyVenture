# game/Gallery_labels_AFV-0.06_v0.2.rpy:18385 #-#-# translate crowdin gal_assign_chores_65ee0a89:
msgid "[_R_] Well, I still don't like it! Besides the fact that you don't do as good of a job when you've had a few,"
