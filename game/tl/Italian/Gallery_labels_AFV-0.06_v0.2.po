# game/Gallery_labels_AFV-0.06_v0.2.rpy:17989 #-#-# translate crowdin label_gal_aunt_01_a52711ac:
msgid "[_B_] In my goodbye letter to her, I'll tell her to rely on you to take care of her financially."
