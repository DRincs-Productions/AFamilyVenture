# game/Gallery_labels_AFV-0.06_v0.2.rpy:25051 #-#-# translate crowdin label_gal_Xmas_event_b570d46e:
msgid "[_L_] Although, to be totally honest, I'm still screwing them, so that their swimmers will still be strong when we're ready for baby number two."
