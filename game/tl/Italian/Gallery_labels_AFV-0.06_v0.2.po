msgstr "[_R_] Gasp.... stai scherzando!.... "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18108 #-#-# translate crowdin label_gal_aunt_01_16de88fb:
msgid "[_M_] No, I'm not.... he told Camille in his goodbye letter that you would support them financially."
msgstr "[_M_] No, non lo sono.... ha detto a Camille nella sua lettera di addio che le avresti sostenute finanziariamente."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18109 #-#-# translate crowdin label_gal_aunt_01_e26bb0e2:
msgid "[_M_] Do you know anything about that?"
msgstr "[_M_] Ne sai qualcosa?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:18110 #-#-# translate crowdin label_gal_aunt_01_aa1e165b:
msgid "[_R_] No.... I mean.... I just received a really weird email from him this morning."
