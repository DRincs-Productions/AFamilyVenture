# game/Gallery_labels_AFV-0.06_v0.2.rpy:33575 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d020eaa9:
msgid "[_A_] Oh, good! I was starting to worry that maybe you wouldn't follow."
