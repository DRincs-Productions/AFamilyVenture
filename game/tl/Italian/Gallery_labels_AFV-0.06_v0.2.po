# game/Gallery_labels_AFV-0.06_v0.2.rpy:18877 #-#-# translate crowdin gal_aunt_clean_kitchen_6d24a592:
msgid "[_R_] First.... there's still finger prints all over the microwave door, there's water all around the sink area,"
