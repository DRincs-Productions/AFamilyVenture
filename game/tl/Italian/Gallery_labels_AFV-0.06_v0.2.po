# game/Gallery_labels_AFV-0.06_v0.2.rpy:20942 #-#-# translate crowdin label_gal_aunt_05_dcb73d89:
msgid "[_RT_] {i}Should I use logic to get her to stop, or appeal to her ego?{/i}"
