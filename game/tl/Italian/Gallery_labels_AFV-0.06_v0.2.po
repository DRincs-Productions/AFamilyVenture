# game/Gallery_labels_AFV-0.06_v0.2.rpy:25257 #-#-# translate crowdin label_gal_Xmas_event_a1e26de1:
msgid "[_S_] Needless to say. Lauren and I, are both very proud to be carrying your babies!"
