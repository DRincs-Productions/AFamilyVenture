# game/Gallery_labels_AFV-0.06_v0.2.rpy:18860 #-#-# translate crowdin gal_aunt_clean_kitchen_53454531:
msgid "[_R_] Well, the floor needs to be swept, but since you've worked so hard, why don't you take off a little early and I'll just do it myself today."
