# game/Gallery_labels_AFV-0.06_v0.2.rpy:37126 #-#-# translate crowdin label_gal_cosplay_02_5b03caaa:
msgid "[_R_] I've been playing with the ZAD 3D computer program, and I should be able to do a lot of fun effects with the pictures we take."
msgstr "[_R_] Ho giocato con il programma per computer ZAD 3D, e dovrei essere in grado di fare un sacco di effetti divertenti con le foto che prendiamo."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:37127 #-#-# translate crowdin label_gal_cosplay_02_6844630d:
