# game/Gallery_labels_AFV-0.06_v0.2.rpy:23153 #-#-# translate crowdin label_gal_Xmas_event_d1cd41da:
msgid "[_GP_] OK.... don't panic.... I gave you some Christmas magic when I blew that Christmas dust on you."
