# game/Gallery_labels_AFV-0.06_v0.2.rpy:25187 #-#-# translate crowdin label_gal_Xmas_event_fe30230a:
msgid "[_RT_] {i}Every single one of the girls still looks sexy as hell, even with their huge baby bumps.{/i}"
