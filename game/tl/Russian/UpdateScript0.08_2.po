# game/UpdateScript0.08_2.rpy:6922 #-#-# translate crowdin weekend_date_shopping_continued_b69b193e:
msgid "[_AG_] Yep, it's for not reserving in a timely manner."
msgstr "[_AG_] Да, это за то, что не зарезервировали вовремя."

# game/UpdateScript0.08_2.rpy:6923 #-#-# translate crowdin weekend_date_shopping_continued_3b827a5d:
msgid "[_RT_] {i}I'd pay five hundred to see mom posing in lingerie again.{/i}"
