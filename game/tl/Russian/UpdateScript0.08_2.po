# game/UpdateScript0.08_2.rpy:9225 #-#-# translate crowdin pizza_date_e38268ca_1:
msgid "[_R_] I'm going to go pay the bill."
msgstr "[_R_] Я собираюсь заплатить счет."

# game/UpdateScript0.08_2.rpy:9226 #-#-# translate crowdin pizza_date_3b189362_1:
