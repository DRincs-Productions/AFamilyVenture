# game/UpdateScript0.08_2.rpy:6929 #-#-# translate crowdin weekend_date_shopping_continued_65d8b766:
msgid "[_RT_] {i}Shit... If I give her one hundred and fifty dollars, I won't have enough in my date budget to take Mom out to dinner.{/i}"
msgstr "[_RT_] {i}Чёрт... Если я дам ей сто пятьдесят долларов, у меня не хватит денег на свидание, чтобы пригласить маму на ужин.{/i}"

# game/UpdateScript0.08_2.rpy:6930 #-#-# translate crowdin weekend_date_shopping_continued_f568a668:
msgid "[_RT_] {i}I guess I could offer her the little bit of extra I have.{/i}"
