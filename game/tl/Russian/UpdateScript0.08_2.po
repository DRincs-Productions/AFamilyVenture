# game/UpdateScript0.08_2.rpy:9328 #-#-# translate crowdin pizza_date_859d95ca_1:
msgid "[_RT_] Shit!... I fucked up."
msgstr "[_RT_] Чёрт!... Я облажался."

# game/UpdateScript0.08_2.rpy:9329 #-#-# translate crowdin pizza_date_531662fe:
msgid "[_RT_] If only fucking Matt hadn't shown up!"
