# game/UpdateScript0.08_2.rpy:3801 #-#-# translate crowdin girl_time_club_fce36149:
msgid "[_AD_] {b}Sidney!{/b}"
msgstr "[_AD_] {b}Sidney!{/b}"

# game/UpdateScript0.08_2.rpy:3805 #-#-# translate crowdin girl_time_club_547b2603:
