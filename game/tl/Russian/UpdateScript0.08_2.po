# game/UpdateScript0.08_2.rpy:3811 #-#-# translate crowdin girl_time_club_6c62b533_1:
msgid "[_AD_] Great! I knew I could count on you for that lapdance."
msgstr "[_AD_] Отлично! Я знала, что могу рассчитывать на тебя в этом приватном танце."

# game/UpdateScript0.08_2.rpy:3812 #-#-# translate crowdin girl_time_club_fce36149_1:
msgid "[_AD_] {b}Sidney!{/b}"
msgstr "[_AD_] {b}Sidney!{/b}"

# game/UpdateScript0.08_2.rpy:3816 #-#-# translate crowdin girl_time_club_a81e891a:
msgid "[_AD_] Why am I even talking to you?"
msgstr "[_AD_] Зачем я вообще с тобой разговариваю?"

# game/UpdateScript0.08_2.rpy:3817 #-#-# translate crowdin girl_time_club_f97c6ad8:
msgid "[_AD_] Scram! you're bumming me out! Now beat it before I rat you out to Sidney."
msgstr "[_AD_] Катись! Ты меня выводишь из себя! А теперь проваливай, пока я тебя Сидни не сдал."

# game/UpdateScript0.08_2.rpy:3818 #-#-# translate crowdin girl_time_club_810851ee:
msgid "[_R_] No, I'll give you the five hundred! Just let me owe it to you!"
msgstr "[_R_] Нет, я дам тебе пятьсот! Только позволь мне быть твоим должником!"

# game/UpdateScript0.08_2.rpy:3819 #-#-# translate crowdin girl_time_club_387776d2:
msgid "[_AD_] Hmmm... I guess I could take it out of your cute little sister and cousin?"
msgstr "[_AD_] Хммм... Думаю, я смогу вытянуть из твоей милой младшей сестры и кузины кое-что?"

# game/UpdateScript0.08_2.rpy:3820 #-#-# translate crowdin girl_time_club_dc7a84b6:
