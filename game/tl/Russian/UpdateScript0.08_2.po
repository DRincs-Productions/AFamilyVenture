# game/UpdateScript0.08_2.rpy:11994 #-#-# translate crowdin sushi_date_ryan_decb6d19_1:
msgid "[_R_] I feel so lucky to be your son!"
msgstr "Мне так повезло быть твоим сыном!"

# game/UpdateScript0.08_2.rpy:11995 #-#-# translate crowdin sushi_date_ryan_12ecb543_1:
msgid "[_M_] Thanks, my little gentleman."
msgstr "Спасибо, мой маленький джентльмен."

# game/UpdateScript0.08_2.rpy:11996 #-#-# translate crowdin sushi_date_ryan_b4a078ed_1:
msgid "[_R_] Mom!"
msgstr "[ _R_] Мама!"

# game/UpdateScript0.08_2.rpy:11997 #-#-# translate crowdin sushi_date_ryan_252f8b9a_1:
msgid "[_M_] Sorry, I mean big gentleman."
msgstr "Извини, я имею в виду большого джентльмена."

# game/UpdateScript0.08_2.rpy:11998 #-#-# translate crowdin sushi_date_ryan_2da90b8e_1:
msgid "[_M_] Now, let's get out of here."
msgstr "[_M_] Теперь давайте выйдем сюда."

# game/UpdateScript0.08_2.rpy:11999 #-#-# translate crowdin sushi_date_ryan_2a7ad131_1:
msgid "[_R_] You might want to get dressed first."
msgstr "[_R_] Возможно, вам захочется сначала одеться."

# game/UpdateScript0.08_2.rpy:12007 #-#-# translate crowdin sushi_date_ryan_51fb20d8_1:
msgid "[_M_] I've really enjoyed our date!"
msgstr "[_M_] Мне очень понравилась наша свидания!"

# game/UpdateScript0.08_2.rpy:12008 #-#-# translate crowdin sushi_date_ryan_b1a54848:
msgid "[_M_] Thank you so much for taking me out. I really needed this!"
msgstr "[ _M_] Спасибо большое за то, что вы меня вытащили. Мне это действительно нужно!"

# game/UpdateScript0.08_2.rpy:12009 #-#-# translate crowdin sushi_date_ryan_7147a093_1:
msgid "[_R_] You're welcome."
msgstr "Добро пожаловать."

# game/UpdateScript0.08_2.rpy:12012 #-#-# translate crowdin sushi_date_ryan_a52cbe36_1:
msgid "[_R_] So, you ready for some more fun?"
msgstr "[ _R_] Итак, ты готова к веселою?"

# game/UpdateScript0.08_2.rpy:12015 #-#-# translate crowdin sushi_date_ryan_c5a107e6_1:
msgid "[_M_] Really?... I kind of thought our date was over."
msgstr "Правда? Я думал, что наша дата закончилась."

# game/UpdateScript0.08_2.rpy:12016 #-#-# translate crowdin sushi_date_ryan_bede9e5d_1:
msgid "[_R_] I had one more little adventure in mind."
msgstr "У меня было еще одно маленькое приключение."

# game/UpdateScript0.08_2.rpy:12017 #-#-# translate crowdin sushi_date_ryan_0eea338b_1:
msgid "[_R_] That is, if you're still up for some fun."
msgstr "То есть, если ты все еще хочешь немного повеселиться."

# game/UpdateScript0.08_2.rpy:12018 #-#-# translate crowdin sushi_date_ryan_21d94d7f_1:
msgid "[_M_] Hmmm... More fun than we've already had?"
msgstr "[ _M_] Hmmm ... Веселее, чем у нас уже было?"

# game/UpdateScript0.08_2.rpy:12021 #-#-# translate crowdin sushi_date_ryan_2a065f78_1:
msgid "[_M_] Yes, please!"
msgstr "[ _M_] Да, пожалуйста!"

# game/UpdateScript0.08_2.rpy:12022 #-#-# translate crowdin sushi_date_ryan_22715e52_1:
msgid "[_R_] Awesome! Now, when you get to our road, don't turn down it... Just keep going straight towards the ocean."
msgstr "[ _R_] Великолепно! А теперь, когда ты доберишься до нашей дороги, не выключай ... Просто продолжай идти прямо к океану."

# game/UpdateScript0.08_2.rpy:12031 #-#-# translate crowdin sushi_date_ryan_426e5fb8_1:
msgid "[_M_] So... It's getting pretty late."
msgstr "[_M_] Итак... Это становится довольно поздно."

# game/UpdateScript0.08_2.rpy:12032 #-#-# translate crowdin sushi_date_ryan_23b19b42_1:
msgid "[_M_] We've both got school tomorrow... Maybe we should call it a night."
msgstr "[_M_] Завтра нам обоим в школу... Может, нам пора спать?"

# game/UpdateScript0.08_2.rpy:12033 #-#-# translate crowdin sushi_date_ryan_e8d66187_1:
msgid "[_R_] Yeah... I mean, I had one more fun adventure planned for us, but I guess if you're too tired..."
msgstr "[_R_] Да... Я имею в виду, что я запланировал для нас еще одно веселое приключение, но, думаю, если ты слишком устал..."

# game/UpdateScript0.08_2.rpy:12034 #-#-# translate crowdin sushi_date_ryan_44e322eb_1:
msgid "[_M_] I'm sorry, I just still have some work I need to do before school, some papers I need to grade tonight."
msgstr "[_M_] Извините, мне просто нужно сделать кое-какую работу перед школой, и сегодня вечером проверить несколько работ."

# game/UpdateScript0.08_2.rpy:12037 #-#-# translate crowdin sushi_date_ryan_f6cce9cf_1:
msgid "[_M_] But I really did have a good time."
msgstr "[_M_] Но я действительно хорошо провел время."

# game/UpdateScript0.08_2.rpy:12038 #-#-# translate crowdin sushi_date_ryan_42713ea2_1:
msgid "[_M_] I'm hoping you'll invite me out for another date next week?"
msgstr "[_M_] Надеюсь, ты пригласишь меня на свидание на следующей неделе?"

# game/UpdateScript0.08_2.rpy:12039 #-#-# translate crowdin sushi_date_ryan_71b9cafc_1:
msgid "[_R_] It would be my pleasure."
msgstr "[_R_] С удовольствием."

# game/UpdateScript0.08_2.rpy:12040 #-#-# translate crowdin sushi_date_ryan_a4f27e39_1:
msgid "[_RT_] {i}I better make better choices and step up the date next week. I really want to take her on a little adventure next time.{/i}"
msgstr "[_RT_] {i}Лучше мне принять более взвешенное решение и назначить свидание на следующей неделе. Я очень хочу устроить ей небольшое приключение в следующий раз.{/i}"

# game/UpdateScript0.08_2.rpy:12047 #-#-# translate crowdin beach_date_matt_b1867f4b:
msgid "[_M_] Hey, Honey!... I just wanted to let you know that I've had a great time on our date today!"
msgstr "[_M_] Привет, дорогая!... Я просто хотел сказать тебе, что мы прекрасно провели время на сегодняшнем свидании!"

# game/UpdateScript0.08_2.rpy:12051 #-#-# translate crowdin beach_date_matt_aabd7c14:
msgid "[_R_] But Let me guess. Matt's car just showed up."
msgstr "[_R_] Дай угадаю. Машина Мэтта только что подъехала."

# game/UpdateScript0.08_2.rpy:12052 #-#-# translate crowdin beach_date_matt_0e01d5fa:
msgid "[_M_] Yes, those are his headlights blinking in the parking lot."
msgstr "[_M_] Да, это его фары, мигающие в парковочном участке."

# game/UpdateScript0.08_2.rpy:12053 #-#-# translate crowdin beach_date_matt_363ce102:
msgid "[_M_] I promised him I'd meet him at the dressing shacks again."
msgstr "[_M_] Я обещал ему, что снова встречусь с ним в раздевалке."

# game/UpdateScript0.08_2.rpy:12054 #-#-# translate crowdin beach_date_matt_a1cee86e:
msgid "[_R_] Goddammit!... Well, don't let me stop you."
msgstr "[_R_] Черт возьми!... Ну, не позволяй мне тебя останавливать."

# game/UpdateScript0.08_2.rpy:12055 #-#-# translate crowdin beach_date_matt_8873ec46:
msgid "[_M_] Don't be like that!"
msgstr "[_M_] Не нравится это!"

# game/UpdateScript0.08_2.rpy:12056 #-#-# translate crowdin beach_date_matt_b67e44a4:
msgid "[_M_] It's like I said before..."
msgstr "[_M_] Как я уже говорил..."

# game/UpdateScript0.08_2.rpy:12057 #-#-# translate crowdin beach_date_matt_9117ce43:
msgid "[_R_] I know!... I should be happy for you, and it's better for both of us if we can find other's to satisfy our sexual frustration."
msgstr "[_R_] Я знаю!... Я должен быть рад за тебя, и для нас обоих будет лучше, если мы найдем других, кто удовлетворит нашу сексуальную неудовлетворенность."

# game/UpdateScript0.08_2.rpy:12058 #-#-# translate crowdin beach_date_matt_38fcd702:
msgid "[_M_] Exactly! And I need this! You really got me worked up today! So I need to go get some release in a healthier way than getting it from my son."
msgstr "[_M_] Точно! И мне это нужно! Ты меня сегодня здорово взбудоражила! Так что мне нужно найти более здоровый способ разрядиться, чем с сыном."

# game/UpdateScript0.08_2.rpy:12059 #-#-# translate crowdin beach_date_matt_706b79ad:
msgid "[_M_] I expect you to start finding other girls to help you out as well."
msgstr "[_M_] Я ожидаю, что ты начнешь искать других девушек, которые тоже тебе помогут."

# game/UpdateScript0.08_2.rpy:12060 #-#-# translate crowdin beach_date_matt_118798be:
msgid "[_M_] Trust me... It's best for both of us."
msgstr "[_M_] Поверь мне... Так будет лучше для нас обоих."

# game/UpdateScript0.08_2.rpy:12061 #-#-# translate crowdin beach_date_matt_b9ea9e00:
msgid "[_R_] Fine... Just go."
msgstr "[_R_] Ладно... Просто иди."

# game/UpdateScript0.08_2.rpy:12062 #-#-# translate crowdin beach_date_matt_9ad872bf:
msgid "[_M_] Would you mind finding our clothes and bringing them over to the shack in about thirty minutes?"
msgstr "[_M_] Не могли бы вы найти нашу одежду и принести ее в хижину примерно через тридцать минут?"

# game/UpdateScript0.08_2.rpy:12063 #-#-# translate crowdin beach_date_matt_81f7f94e:
msgid "[_R_] Yes, just... go!"
msgstr "[_R_] Да, просто... иди!"

# game/UpdateScript0.08_2.rpy:12065 #-#-# translate crowdin beach_date_matt_93eec994:
msgid "[_R_] Me too! It's been an awesome day."
msgstr "[_R_] Я тоже! День был просто потрясающий."

# game/UpdateScript0.08_2.rpy:12066 #-#-# translate crowdin beach_date_matt_7dc72d33:
msgid "[_M_] I hate to cut our time short but at the restaurant I promised Matt that I'd meet him at the changing shacks tonight."
msgstr "[_M_] Мне не хочется прерывать наше общение, но в ресторане я пообещал Мэтту, что встречусь с ним сегодня вечером в раздевалке."

# game/UpdateScript0.08_2.rpy:12069 #-#-# translate crowdin beach_date_matt_85175c8b:
msgid "[_R_] No, you didn't!"
msgstr "[_R_] Нет, не ты!"

# game/UpdateScript0.08_2.rpy:12070 #-#-# translate crowdin beach_date_matt_dcdf36b6:
msgid "[_M_] Yes, I did. That's his car flashing it's lights in the parking lot."
msgstr "[_M_] Да, видел. Это его машина мигает фарами на парковке."

# game/UpdateScript0.08_2.rpy:12071 #-#-# translate crowdin beach_date_matt_5cc84499:
msgid "[_R_] Why would you?..."
msgstr "[_R_] Зачем вам это?..."

# game/UpdateScript0.08_2.rpy:12072 #-#-# translate crowdin beach_date_matt_184ca617:
msgid "[_M_] I need you to understand, when I get worked up, I need to get a release."
msgstr "[_M_] Мне нужно, чтобы вы поняли, когда я доработал, мне нужно получить релиз."

# game/UpdateScript0.08_2.rpy:12073 #-#-# translate crowdin beach_date_matt_7a29eeb8:
msgid "[_R_] I understand that! That's why I help you out!"
msgstr "[_R_] Я понимаю! Поэтому я тебе и помогаю!"

# game/UpdateScript0.08_2.rpy:12074 #-#-# translate crowdin beach_date_matt_1ef8ec4f:
msgid "[_M_] And the fact that I've been getting that help from my own son is just about the worst mothering I've ever heard of."
msgstr "[_M_] И тот факт, что я получаю эту помощь от собственного сына, — это, пожалуй, худшее проявление материнства, о котором я когда-либо слышала."

# game/UpdateScript0.08_2.rpy:12075 #-#-# translate crowdin beach_date_matt_1cf09dd5:
msgid "[_M_] I'm completely failing you as a mother!"
msgstr "[_M_] Я полностью отказовываю вас как матери!"

# game/UpdateScript0.08_2.rpy:12077 #-#-# translate crowdin beach_date_matt_e2d833f7:
msgid "[_R_] Yeah, well fucking Matt and Joey left and right doesn't make you a better one."
msgstr "[_R_] Да, ну, трахая Мэтта и Джоуи налево и направо, ты не становишься лучше."

# game/UpdateScript0.08_2.rpy:12079 #-#-# translate crowdin beach_date_matt_c73582d6:
msgid "[_R_] Yeah, well fucking Matt left and right doesn't make you a better one."
msgstr "[_R_] Да, ну, трахая Мэтта слева и справа, ты не станешь лучше."

# game/UpdateScript0.08_2.rpy:12080 #-#-# translate crowdin beach_date_matt_56ab2a9b:
msgid "[_M_] You know I'm a very sexual person, and I know you are too. I'm sure you probably get that from me."
msgstr "[_M_] Ты знаешь, что я очень половой человек, и я знаю, что ты тоже. Я уверен, что ты получишь это от меня."

# game/UpdateScript0.08_2.rpy:12081 #-#-# translate crowdin beach_date_matt_d214c835:
msgid "[_M_] And if the shoe were on the other foot, I'd be happy for you."
msgstr "[_M_] А если бы ситуация была иной, я бы за тебя порадовался."

# game/UpdateScript0.08_2.rpy:12082 #-#-# translate crowdin beach_date_matt_1dd12ced:
msgid "[_M_] So, if you can't be happy for me, the least you can do is be understanding."
msgstr "[_M_] Так что, если ты не можешь порадоваться за меня, то, по крайней мере, можешь проявить понимание."

# game/UpdateScript0.08_2.rpy:12083 #-#-# translate crowdin beach_date_matt_762a3c1b:
msgid "[_M_] And be grateful you weren't raised by ultra religious, puritanical parents like your father and I were."
msgstr "[_M_] И будь благодарен, что тебя не воспитывали ультрарелигиозные, пуританские родители, как твой отец и я."

# game/UpdateScript0.08_2.rpy:12085 #-#-# translate crowdin beach_date_matt_17091ba9:
msgid "[_R_] But why Matt? Joey's bad enough, but Matt is my worst enemy!"
msgstr "[_R_] Но зачем мат? Джо достаточно плохо, но Мэтт - это мой самый ужасный враг!"

# game/UpdateScript0.08_2.rpy:12087 #-#-# translate crowdin beach_date_matt_2ab23996:
msgid "[_R_] But why Matt? He's my worst enemy!"
msgstr "[_R_] Но зачем мат? Он мой самый злейший враг!"

# game/UpdateScript0.08_2.rpy:12088 #-#-# translate crowdin beach_date_matt_e595ac82:
msgid "[_M_] Matt's a great young man! I know you've been jealous of him ever since you stopped growing and Matt didn't."
msgstr "[_M_] Мэтт — замечательный молодой человек! Я знаю, ты завидовал ему с тех пор, как перестал расти, а Мэтт — нет."

# game/UpdateScript0.08_2.rpy:12089 #-#-# translate crowdin beach_date_matt_f6e26140:
msgid "[_M_] You were better at basketball than him, but eventually height won over skill."
msgstr "[_M_] Вы были лучше в баскетболе, чем он, но в конце концов рост одержал победу."

# game/UpdateScript0.08_2.rpy:12090 #-#-# translate crowdin beach_date_matt_7db292b4:
msgid "[_M_] That wasn't his fault! You need to get over that!"
msgstr "[_M_] Это не его вина! Тебе нужно с этим смириться!"

# game/UpdateScript0.08_2.rpy:12091 #-#-# translate crowdin beach_date_matt_9115611d:
msgid "[_R_] That's not it at all."
msgstr "[_R_] Это совсем не так."

# game/UpdateScript0.08_2.rpy:12092 #-#-# translate crowdin beach_date_matt_ae829f5a:
msgid "[_M_] Uh huh, sure!"
msgstr "[_M_] Ага, конечно!"

# game/UpdateScript0.08_2.rpy:12093 #-#-# translate crowdin beach_date_matt_43bca27b:
msgid "[_M_] Now, whether you like it or not, I'm going to head over to the changing shacks to meet Matt."
msgstr "[_M_] А теперь, нравится вам это или нет, я пойду в раздевалку, чтобы встретиться с Мэттом."

# game/UpdateScript0.08_2.rpy:12094 #-#-# translate crowdin beach_date_matt_a6292d04:
msgid "[_M_] I'd be grateful if you go get our clothes and bring them over to the shack in about thirty minutes."
msgstr "[_M_] Я был бы признателен, если бы ты забрал нашу одежду и принес ее в хижину примерно через тридцать минут."

# game/UpdateScript0.08_2.rpy:12095 #-#-# translate crowdin beach_date_matt_71718fb1:
msgid "[_R_] Fine... Just... go"
msgstr "[_R_] Ладно... Просто... иди"

# game/UpdateScript0.08_2.rpy:12098 #-#-# translate crowdin beach_date_matt_5170838f:
msgid "[_RT_] {i}Goddammit!{/i}"
msgstr "[_RT_] {i}Goddammit!{/i}"

# game/UpdateScript0.08_2.rpy:12099 #-#-# translate crowdin beach_date_matt_4ed90083:
msgid "[_RT_] {i}This sucks!{/i}"
msgstr "[_RT_] {i}Это сосуда!{/i}"

# game/UpdateScript0.08_2.rpy:12101 #-#-# translate crowdin beach_date_matt_ee29dfb9:
msgid "[_RT_] {i}I guess I still haven't come to grips that it should be okay for Mom to fuck other people when I am too.{/i}"
msgstr "[_RT_] {i}Полагаю, что я до сих пор не приехал, чтобы мама сбивала других людей, когда я тоже.{/i}"

# game/UpdateScript0.08_2.rpy:12103 #-#-# translate crowdin beach_date_matt_47f22f15:
msgid "[_RT_] {i}But I guess I shouldn't expect Mom to only be faithful to me when I've been anything but to her.{/i}"
msgstr "[_RT_] {i}Но думаю, я не должен ожидать, что Мама будет только верна мне, когда я ничего не был.{/i}"

# game/UpdateScript0.08_2.rpy:12104 #-#-# translate crowdin beach_date_matt_d108672a:
msgid "[_RT_] {i}What the hell am I supposed to do for a half hour?{/i}"
msgstr "[_RT_] {i}Что я должен сделать в течение полутора часов?{/i}"

# game/UpdateScript0.08_2.rpy:12108 #-#-# translate crowdin beach_date_matt_77777e15:
msgid "{i}\"Much less than a half hour later.\"{/i}"
msgstr "{i}\"Гораздо меньше чем через полчаса спустя.\"{/i}"

# game/UpdateScript0.08_2.rpy:12112 #-#-# translate crowdin beach_date_matt_c99c4f9d:
msgid "[_RT_] {i}Why am I coming back early? Watching them last time made me so angry!{/i}"
msgstr "[_RT_] {i}Почему я рано возвращаюсь? Посмотрев в последний раз, я так рассердился!{/i}"

# game/UpdateScript0.08_2.rpy:12113 #-#-# translate crowdin beach_date_matt_6783b95f:
msgid "[_RT_] {i}Why am I trying to punish myself again?{/i}"
msgstr "[_RT_] {i}Почему я пытаюсь наказать себя снова?{/i}"

# game/UpdateScript0.08_2.rpy:12115 #-#-# translate crowdin beach_date_matt_49154212:
msgid "[_RT_] {i}Maybe they haven't done anything.{/i}"
msgstr "[_RT_] {i}Может быть, они ничего не сделали.{/i}"

# game/UpdateScript0.08_2.rpy:12116 #-#-# translate crowdin beach_date_matt_ec273dbe:
msgid "[_RT_] {i}Maybe Matt said something stupid to piss her off.{/i}"
msgstr "[_RT_] {i}Может быть, Матт сказал что-нибудь глупое, чтобы ее распустить.{/i}"

# game/UpdateScript0.08_2.rpy:12117 #-#-# translate crowdin beach_date_matt_457bc17a:
msgid "[_RT_] {i}Maybe I can show up early, punch Matt in the face and be Mom's knight in shining armour.{/i}"
msgstr "[_RT_] {i}Может быть, я мог бы появиться рано, пронзать матч на лице и быть рыцарем мамы сияющим доспехом.{/i}"

# game/UpdateScript0.08_2.rpy:12121 #-#-# translate crowdin beach_date_matt_9327d48c:
msgid "[_RT_] {i}Oh, Goddammit! And here comes the regret.{/i}"
msgstr "[_RT_] {i}Ох, чёрт возьми! И вот оно, сожаление.{/i}"

# game/UpdateScript0.08_2.rpy:12123 #-#-# translate crowdin beach_date_matt_e3746e44:
msgid "[_RT_] {i}Oh, Goddammit! It's worse than I thought!{/i}"
msgstr "[_RT_] {i}О, чёрт возьми! Всё хуже, чем я думал!{/i}"

# game/UpdateScript0.08_2.rpy:12131 #-#-# translate crowdin beach_date_matt_b756440a:
msgid "[_RT_] {i}Did I think things would be any different this time?{/i}"
msgstr "[_RT_] {i}Думал ли я, что в этот раз всё будет иначе?{/i}"

# game/UpdateScript0.08_2.rpy:12132 #-#-# translate crowdin beach_date_matt_2932974d:
msgid "[_RT_] {i}I mean, God!... If anything, Matt's railing her even harder.{/i}"
msgstr "[_RT_] {i}Боже мой!... Мэтт, пожалуй, стал ругать её ещё сильнее.{/i}"

# game/UpdateScript0.08_2.rpy:12134 #-#-# translate crowdin beach_date_matt_500b597e:
msgid "[_RT_] {i}Fuck, he's really giving it to her!{/i}"
msgstr "[_RT_] {i}Fuck, он действительно отдал её!{/i}"

