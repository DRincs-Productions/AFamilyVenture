# game/UpdateScript0.08_2.rpy:6404 #-#-# translate crowdin weekend_date_shopping_791eddba_1:
msgid "[_X_] You two make such a cute couple. Let me know if I can help you find anything."
msgstr "[_X_] Вы двое такая милая пара. Дай знать, если смогу что-нибудь найти."

