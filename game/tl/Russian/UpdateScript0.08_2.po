# game/UpdateScript0.08_2.rpy:6916 #-#-# translate crowdin weekend_date_shopping_continued_d174db02:
msgid "[_AG_] We?..."
msgstr "[_AG_] Мы?..."

# game/UpdateScript0.08_2.rpy:6917 #-#-# translate crowdin weekend_date_shopping_continued_751770c7:
msgid "[_AG_] So you're hoping to use the bridal dressing room again, I assume?"
