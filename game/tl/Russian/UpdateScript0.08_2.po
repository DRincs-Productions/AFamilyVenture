# game/UpdateScript0.08_2.rpy:6388 #-#-# translate crowdin weekend_date_shopping_5b817ba9:
msgid "[_R_] I promise, I'll be on my best behavior."
msgstr "[_R_] Обещаю, я буду вести себя хорошо."

# game/UpdateScript0.08_2.rpy:6391 #-#-# translate crowdin weekend_date_shopping_5145c2c3_1:
msgid "[_X_] Welcome to Pierre Govanni's."
