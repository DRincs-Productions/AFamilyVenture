# game/UpdateScript0.08_2.rpy:6321 #-#-# translate crowdin weekend_date_shopping_ce15d491:
msgid "[_R_] You just don't understand, Mom."
msgstr "[_R_] Ты просто не понимаешь, мама."

# game/UpdateScript0.08_2.rpy:6327 #-#-# translate crowdin weekend_date_shopping_268e63e3:
msgid "[_R_] You'll never stand in the way of our love!"
