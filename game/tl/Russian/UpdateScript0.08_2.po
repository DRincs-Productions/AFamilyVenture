# game/UpdateScript0.08_2.rpy:4538 #-#-# translate crowdin girl_time_club_cffb496d:
msgid "[_R_] No! He wouldn't."
msgstr "[_R_] Нет! Он бы этого не сделал."

# game/UpdateScript0.08_2.rpy:4539 #-#-# translate crowdin girl_time_club_b3b04a69:
msgid "[_AD_] Why do you think I had you sit in that stool with your back to them?"
