# game/UpdateScript0.08_2.rpy:6396 #-#-# translate crowdin weekend_date_shopping_0ac56048_1:
msgid "[_R_] See... I knew these jeans would open doors."
msgstr "[_R_] Видишь ли... Я знал, что эти джинсы откроют двери."

# game/UpdateScript0.08_2.rpy:6397 #-#-# translate crowdin weekend_date_shopping_74e5d6ff_1:
msgid "[_MT_] {i}Ugghhh... I was worried they'd say something... I'm so embarrassed.{/i}"
