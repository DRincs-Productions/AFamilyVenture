# game/UpdateScript0.08_2.rpy:9330 #-#-# translate crowdin pizza_date_35690913_1:
msgid "[_RT_] {i}Hopefully Mom will forgive me, it sounds like she will.{/i}"
msgstr "[_RT_] {i}Надеюсь, что Мама простит меня, это звучит как она.{/i}"

# game/UpdateScript0.08_2.rpy:9331 #-#-# translate crowdin pizza_date_19401b6c_1:
msgid "[_RT_] {i}She left the option of going on another date next weekend on the table.{/i}"
msgstr "[_RT_] {i}Она оставила возможность перейти на другую дату в следующей выходной день в таблице.{/i}"

# game/UpdateScript0.08_2.rpy:9332 #-#-# translate crowdin pizza_date_2cf65c74_1:
msgid "[_RT_] {i}I've just got to get her to feel like I deserve it.{/i}"
msgstr "[_RT_] {i}Я только что понял, что она заслуживает.{/i}"

# game/UpdateScript0.08_2.rpy:9337 #-#-# translate crowdin pizza_date_7c2a48d3:
msgid "[_MB_] It's so crazy we just ran into you right now, Miss [mom_name]... We were just talking about you."
msgstr "Это так безумие, что мы просто столкнулись с тобой прямо сейчас, мисс [ мамочка] ... Мы просто говорили о тебе."

# game/UpdateScript0.08_2.rpy:9338 #-#-# translate crowdin pizza_date_1a9ee574:
msgid "[_M_] Oh?... Good things, I hope?"
msgstr "[ _M_] Oh? ... Хорошие вещи, надеюсь?"

# game/UpdateScript0.08_2.rpy:9339 #-#-# translate crowdin pizza_date_d26e188d:
