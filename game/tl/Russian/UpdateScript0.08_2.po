# game/UpdateScript0.08_2.rpy:6301 #-#-# translate crowdin weekend_date_shopping_ee903cde:
msgid "[_R_] You got it."
msgstr "[_R_] Вы поняли."

# game/UpdateScript0.08_2.rpy:6308 #-#-# translate crowdin weekend_date_shopping_8e3e1572:
msgid "[_MT_] {i}I wonder if I'll find [ryan] feeling up the mannequins again?{/i}"
