# game/UpdateScript0.08_2.rpy:9230 #-#-# translate crowdin pizza_date_9f596231_1:
msgid "[_MT_] {i}Does he know what I did?... Did he see something?{/i}"
msgstr "[_MT_] {i}Он знает, что я сделал?... Он что-то вижет?{/i}"

# game/UpdateScript0.08_2.rpy:9231 #-#-# translate crowdin pizza_date_f9dc0ef5_1:
