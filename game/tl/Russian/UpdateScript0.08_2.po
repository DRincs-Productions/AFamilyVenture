# game/UpdateScript0.08_2.rpy:6918 #-#-# translate crowdin weekend_date_shopping_continued_a2cb905f:
msgid "[_AG_] You should have just reserved it like everyone else does."
msgstr "[_AG_] Вам следовало бы просто зарезервировать его, как это делают все остальные."

# game/UpdateScript0.08_2.rpy:6919 #-#-# translate crowdin weekend_date_shopping_continued_4f8b9a41:
msgid "[_R_] I rarely plan that far ahead."
msgstr "[_R_] Я редко планирую так далеко вперед."

# game/UpdateScript0.08_2.rpy:6920 #-#-# translate crowdin weekend_date_shopping_continued_793b9171:
msgid "[_AG_] Well, you're in luck. It does happen to be available, but this time I need one hundred and fifty."
msgstr "[_AG_] Что ж, тебе повезло. Он как раз есть в наличии, но на этот раз мне нужно сто пятьдесят."

# game/UpdateScript0.08_2.rpy:6921 #-#-# translate crowdin weekend_date_shopping_continued_c863ca4f:
