# game/UpdateScript0.08_2.rpy:9223 #-#-# translate crowdin pizza_date_82d37dfd_1:
msgid "[_RT_] {i}If I say anything she'll be pissed. If I accuse her of being unfaithful to Dad, it will drive her away from me!{/i}"
msgstr "[_RT_] {i}Если скажу что-то, что будет похлынуть. Если я обвиняю ее в верности папе, она избавит её от меня!{/i}"

# game/UpdateScript0.08_2.rpy:9224 #-#-# translate crowdin pizza_date_68e4051f_1:
