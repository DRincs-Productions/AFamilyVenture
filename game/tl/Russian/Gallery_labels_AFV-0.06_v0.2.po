# game/Gallery_labels_AFV-0.06_v0.2.rpy:17867 #-#-# translate crowdin label_gal_aunt_01_2056fd1c:
msgid "[_RT_] {i}Uuuuugghhh, who's texting me this early in the morning?{/i}"
