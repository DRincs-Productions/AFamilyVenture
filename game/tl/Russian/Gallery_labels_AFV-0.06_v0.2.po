# game/Gallery_labels_AFV-0.06_v0.2.rpy:21518 #-#-# translate crowdin label_gal_aunt_06_cacf8cdb:
msgid "[_C_] Officer, thank God!... You showed up just in time."
msgstr "Офицер, слава Богу! Ты появился как раз в свое время."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21519 #-#-# translate crowdin label_gal_aunt_06_6962b662:
msgid "[_MD_] {i}Damn!... I wanted to see him nut!{/i}"
msgstr "[_MD_] {i}Черт!... Я хотел его посмотреть!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21520 #-#-# translate crowdin label_gal_aunt_06_05fac196:
msgid "[_MD_] {i}I wonder if he could have shot far enough to hit us from where he was standing.{/i}"
