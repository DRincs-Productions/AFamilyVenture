# game/Gallery_labels_AFV-0.06_v0.2.rpy:19092 #-#-# translate crowdin gal_aunt_clean_kitchen_3cffb2eb_1:
msgid "[_R_] I don't want no Hawaiian shirts!.... I had something else in mind."
msgstr "[_R_] Я не хочу, чтобы никаких гавайских рубашек!.... У меня было что-то еще."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:19095 #-#-# translate crowdin gal_aunt_clean_kitchen_19c4f2aa_1:
msgid "[_C_] Oh, no.... not like in the bathroom?.... "
