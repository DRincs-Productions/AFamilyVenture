# game/Gallery_labels_AFV-0.06_v0.2.rpy:21105 #-#-# translate crowdin label_gal_aunt_05_8bb33983:
msgid "[_R_] We can work something out here."
msgstr "Мы можем кое-что поработать здесь."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21108 #-#-# translate crowdin label_gal_aunt_05_a8884214:
msgid "[_C_] Don't speak for me!"
msgstr "[_C_] Не говорите со мной!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21109 #-#-# translate crowdin label_gal_aunt_05_2fe00404:
msgid "[_C_] As far as I'm concerned, there's nothing to work out. You got your money back Joey. It's right there on your table."
msgstr "[ _C_] Что касается меня, то ничего не выйдет. Ты получил деньги обратно Джоуи. Это прямо на твоей столике."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21110 #-#-# translate crowdin label_gal_aunt_05_85674604:
msgid "[_C_] Goodbye, Mr. DeCapo."
msgstr "[_C_] Прощай, мистер ДеКапо."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21111 #-#-# translate crowdin label_gal_aunt_05_a4cb35fb:
msgid "[_C_] I'm going home to take a nice bath to forget all about tonight, and you."
