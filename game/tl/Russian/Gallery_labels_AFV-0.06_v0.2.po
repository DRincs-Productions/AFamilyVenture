# game/Gallery_labels_AFV-0.06_v0.2.rpy:21498 #-#-# translate crowdin label_gal_aunt_06_6a38514f:
msgid "[_MDT_] {i}Oh, my God!... It's Mr. Peterson! Sidney told me all about him!{/i}"
