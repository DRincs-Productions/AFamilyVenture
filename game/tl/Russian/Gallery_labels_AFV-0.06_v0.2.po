msgstr "Вообще-то нет."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17910 #-#-# translate crowdin label_gal_aunt_01_9d58336f:
msgid "[_B_] I'm in some trouble, and I've gots to dissapear."
msgstr "Я в беде, и у меня все в порядке."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17911 #-#-# translate crowdin label_gal_aunt_01_fc60abf1:
msgid "[_R_] Oh my God, are you serious?"
msgstr "О боже, ты серьезно?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17914 #-#-# translate crowdin label_gal_aunt_01_226b6c69:
msgid "[_B_] Unfortunately, yes.... "
msgstr "[ _B_] К сожалению, да .... "

# game/Gallery_labels_AFV-0.06_v0.2.rpy:17915 #-#-# translate crowdin label_gal_aunt_01_d5446a1a:
msgid "[_B_] I just got a tip from our friend Agent Diaz.... "
