# game/Gallery_labels_AFV-0.06_v0.2.rpy:23841 #-#-# translate crowdin label_gal_Xmas_event_88823a4a:
msgid "[_LT_] {i}It's not everyday I get to spend time with my sister. At least not dressed like total sluts. Damn, she looks hot!{/i}"
msgstr "[_LT_] {i}Не каждый день я собираюсь провести время с сестрой. По крайней мере не одеть как общее количество шлюз. Черта, она выглядит неплохо!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:23842 #-#-# translate crowdin label_gal_Xmas_event_a44b827d:
msgid "[_GCP_] You degenerates!"
