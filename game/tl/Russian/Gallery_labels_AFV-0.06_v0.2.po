# game/Gallery_labels_AFV-0.06_v0.2.rpy:13716 #-#-# translate crowdin label_gal_Sidney_park_activities_232c6572:
msgid "[_MS_] Let me just help you up, and give you a great big hug!"
msgstr "Позволь мне помочь тебе и обнять тебя!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13719 #-#-# translate crowdin label_gal_Sidney_park_activities_bb1c3ae1:
msgid "[_R_] Thanks, Mrs. Stone!"
msgstr "Спасибо, миссис Стоун!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13720 #-#-# translate crowdin label_gal_Sidney_park_activities_855e6e00:
msgid "[_MS_] I just can't believe how brave you were!"
