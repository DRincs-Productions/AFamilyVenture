# game/Gallery_labels_AFV-0.06_v0.2.rpy:21503 #-#-# translate crowdin label_gal_aunt_06_75d40e7a:
msgid "[_X_] {i}(Distant voice){/i} There's some movement behind the bushes, I think I might have found him."
msgstr "[ _X_] {i}(Непостоянный голос) { /i } Есть какое-то движение за кустами, я думаю, что я мог найти его."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21504 #-#-# translate crowdin label_gal_aunt_06_c64da52b:
