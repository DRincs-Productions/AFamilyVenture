# game/Gallery_labels_AFV-0.06_v0.2.rpy:19079 #-#-# translate crowdin gal_aunt_clean_kitchen_79f8eb59_1:
msgid "[_R_] I'll see you in a few days.... enjoy your time off.... you earned it!"
