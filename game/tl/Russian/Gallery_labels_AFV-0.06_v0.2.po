msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33845 #-#-# translate crowdin label_gal_mom_sushi_date_joey_47cff4b2:
msgid "[_J_] I didn't even notice."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33846 #-#-# translate crowdin label_gal_mom_sushi_date_joey_9846eaa8:
msgid "[_J_] Can you go settle the bill and get Franky to bring the car to the front?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33847 #-#-# translate crowdin label_gal_mom_sushi_date_joey_c24de89c:
msgid "[_J_] Have Franky take Armani home... We'll be going with Johnny. We've got some unexpected business we've got to take care of tonight."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33848 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b76bb3e3:
msgid "[_G_] Sure thing, Boss."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33851 #-#-# translate crowdin label_gal_mom_sushi_date_joey_2a67bc20:
msgid "[_A_] It looks like we're going."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33852 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0dd17f6a:
msgid "[_A_] Thanks for keeping me company."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33853 #-#-# translate crowdin label_gal_mom_sushi_date_joey_231a6974:
msgid "[_A_] I'll see you around the club?"
msgstr "[_A_] Я тебя посмотрю вокруг клуба?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33854 #-#-# translate crowdin label_gal_mom_sushi_date_joey_c860f7e2:
msgid "[_R_] Yeah, most likely."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33857 #-#-# translate crowdin label_gal_mom_sushi_date_joey_50ffe2b7:
msgid "[_J_] Sorry to interrupt your time with your mom tonight."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33858 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0b114fce:
msgid "[_J_] Don't worry, I was a complete gentleman, and I'm even paying the bill."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33859 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a5884518:
msgid "[_RT_] {i}As if that's a fair trade for whatever it was you did to my mom!{/i}"
msgstr "[_RT_] {i}Как будто это честная сделка за то, что ты сделал моей мане!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33860 #-#-# translate crowdin label_gal_mom_sushi_date_joey_32067551:
msgid "[_RT_] {i}And I can't say anything, or I'll end up on the bottom of the harbor.{/i}"
msgstr "[_RT_] {i}И я ничего не могу сказать, или я в конце конца гавани.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33861 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d2840c20:
msgid "[_R_] Thank you."
msgstr "Спасибо."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33862 #-#-# translate crowdin label_gal_mom_sushi_date_joey_44356edd:
msgid "[_J_] I think your mom had a good time. I think it was good for her to have a conversation with someone a little closer to her age."
msgstr "[_J_] Я думаю, что ваша мама имела хорошее время. Я думаю, что ей было хорошо общаться с кем-то чуть ближе к ее возрасту."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33863 #-#-# translate crowdin label_gal_mom_sushi_date_joey_2b3daa3f:
msgid "[_RT_] {i}I'm all alone in this hallway with him... I'd be doing the world a favor if I killed him now.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33864 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d120c301:
msgid "[_RT_] {i}If only I knew how to kill a man with my bare hands.{/i}"
msgstr "[_RT_] {i}Если только я знал, как убить человека голыми руками.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33865 #-#-# translate crowdin label_gal_mom_sushi_date_joey_6f71af60:
msgid "[_J_] Anyways, thanks for sharing her with me tonight, and now, she's all yours."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33868 #-#-# translate crowdin label_gal_mom_sushi_date_joey_9435c8ad:
msgid "[_RT_] {i}Goddammit!... What happened in there?{/i}"
msgstr "[_RT_] {i}Годдамт!... Что там случилось?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33869 #-#-# translate crowdin label_gal_mom_sushi_date_joey_8d7192d6:
msgid "[_RT_] {i}I wonder if I'll be able to tell?{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33872 #-#-# translate crowdin label_gal_mom_sushi_date_joey_3ba797c5:
msgid "[_M_] Oh... Hey, [ryan]."
msgstr "[_M_] Oh... Hey, [ryan]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33873 #-#-# translate crowdin label_gal_mom_sushi_date_joey_eff30755:
msgid "[_R_] Mom?... you doing ok?"
msgstr "[_R_] Mom?... Вы делаете правильно?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33874 #-#-# translate crowdin label_gal_mom_sushi_date_joey_db33e34a:
msgid "[_M_] Yeah, I'm doing great."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33875 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b96064ef:
msgid "[_RT_] {i}There's a puddle of water next to her. There's no water cups on the table, so... not a spill.{/i}"
msgstr "[_RT_] {i}Рядом с ней появился малыш воды. На столе нет чашек с водой, так что не было.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33878 #-#-# translate crowdin label_gal_mom_sushi_date_joey_cc508ab7:
msgid "[_M_] Joey's paying for our dinner, so I guess we can go any time you're ready."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33881 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d00dd51d:
msgid "[_R_] That sounds good, but I've got to ask. Why is there a puddle right under you?"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33882 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b319d0df:
msgid "[_MT_] Oh, fuck!... I should have wiped that up before he came in here."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33885 #-#-# translate crowdin label_gal_mom_sushi_date_joey_3b0962d2:
msgid "[_M_] Is there?... Huh..."
msgstr "[_M_] здесь?... А... А... А..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33886 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d54888fd:
msgid "[_MT_] {i}Think, [mom_name]!{/i}"
msgstr "[_MT_] {i}Think, [mom_name]!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33887 #-#-# translate crowdin label_gal_mom_sushi_date_joey_fe22034a:
msgid "[_M_] Maybe one of us spilled our water."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33888 #-#-# translate crowdin label_gal_mom_sushi_date_joey_8c3cd221:
msgid "[_R_] We didn't get any water... only wine."
msgstr "[_R_] У нас не было воды... только вино."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33889 #-#-# translate crowdin label_gal_mom_sushi_date_joey_067533fb:
msgid "[_R_] And that's definitely not wine."
msgstr "[_R_] И это определенно не вино."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33890 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d41afebb:
msgid "[_R_] Mom... Is that?..."
msgstr "[_R_] Мама... Вот так?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33893 #-#-# translate crowdin label_gal_mom_sushi_date_joey_7e08a163:
msgid "[_M_] Is it what?"
msgstr "[_M_] Это что?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33894 #-#-# translate crowdin label_gal_mom_sushi_date_joey_c6841c25:
msgid "[_R_] ..."
msgstr "[ _R_] ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33895 #-#-# translate crowdin label_gal_mom_sushi_date_joey_6114f84e:
msgid "[_M_] What were you going to say?"
msgstr "[_M_] Что вы скажете?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33896 #-#-# translate crowdin label_gal_mom_sushi_date_joey_2e764014:
msgid "[_R_] Let's just say, I've seen you leave puddles in other places before, too."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33897 #-#-# translate crowdin label_gal_mom_sushi_date_joey_73a80eec:
msgid "[_M_] I don't like what you're insinuating!"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33898 #-#-# translate crowdin label_gal_mom_sushi_date_joey_eb8b7b1b:
msgid "[_M_] You'd better watch it!"
msgstr "[_M_] Ты бы лучше посмотрел его!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33901 #-#-# translate crowdin label_gal_mom_sushi_date_joey_13594df2:
msgid "[_M_] I think we'd better go before you say something stupid."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33906 #-#-# translate crowdin label_gal_mom_sushi_date_joey_641cc204:
msgid "[_R_] Yeah. I've lost my appetite, so we can go."
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33909 #-#-# translate crowdin label_gal_mom_sushi_date_joey_74259267:
msgid "[_MT_] {i}Is he upset?... Does he suspect something?{/i}"
msgstr "[_MT_] {i}расстроен?... Есть ли у него что-нибудь?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33910 #-#-# translate crowdin label_gal_mom_sushi_date_joey_ebe26aff:
msgid "[_MT_] {i}Shit! Were we more obvious than I thought?{/i}"
msgstr "[_MT_] {i}Зашел! Были ли мы более очевидными, чем я думал?{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33916 #-#-# translate crowdin label_gal_mom_sushi_date_joey_51fb20d8:
msgid "[_M_] I've really enjoyed our date!"
msgstr "[_M_] Мне очень понравилась наша свидания!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33917 #-#-# translate crowdin label_gal_mom_sushi_date_joey_b1a54848:
msgid "[_M_] Thank you so much for taking me out. I really needed this!"
msgstr "[ _M_] Спасибо большое за то, что вы меня вытащили. Мне это действительно нужно!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33918 #-#-# translate crowdin label_gal_mom_sushi_date_joey_7147a093:
msgid "[_R_] You're welcome."
msgstr "Добро пожаловать."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33921 #-#-# translate crowdin label_gal_mom_sushi_date_joey_e6ab092d:
msgid "[_RT_] {i}Ok, [ryan]... Mom seems pretty happy.{/i}"
msgstr "[_RT_] {i}Хорошо, [ryan]... Мама кажется очень счастливым.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33922 #-#-# translate crowdin label_gal_mom_sushi_date_joey_aa7d2a69:
msgid "[_RT_] {i}She doesn't need you ruining her day by calling her out for a moment of weakness.{/i}"
msgstr "[_RT_] {i}Ей не нужно, чтобы ты погубила свой день, вызывая её на мгновение слабости.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33923 #-#-# translate crowdin label_gal_mom_sushi_date_joey_16e5c810:
msgid "[_RT_] {i}I mean, she's your mom for fuck's sake! Of course in her head, getting relief from someone outside the family is more moral than getting it from me.{/i}"
msgstr "[_RT_] {i}Я имею в виду, она твоя мама для саксофона! Конечно, ее голова, получение помощи от кого-то за пределами семьи является более моральным, чем получение его от меня. /i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33924 #-#-# translate crowdin label_gal_mom_sushi_date_joey_4a6483dc:
msgid "[_RT_] {i}I'm the one who's been pushing her to be more open sexually, and I need to accept the fact that I can't predict or control all the unintended consequences.{/i}"
msgstr "[_RT_] {i}Я тот, кто толкал ее к более активному сексуальному поведению, и мне нужно согласиться с тем, что я не могу предсказать и контролировать все непреднамеренные последствия. /i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33925 #-#-# translate crowdin label_gal_mom_sushi_date_joey_379e0756:
msgid "[_RT_] {i}The night is still young.{/i}"
msgstr "[_RT_] {i}Ночь ещё молодая.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33926 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0a169539:
msgid "[_RT_] {i}I might be able to salvage what's left of it.{/i}"
msgstr "[_RT_] {i}Я могу спасти то, что осталось от него.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33927 #-#-# translate crowdin label_gal_mom_sushi_date_joey_afa8f235:
msgid "[_RT_] {i}Time to stop acting butt hurt, and treat Mom like the goddess she is.{/i}"
msgstr ""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33928 #-#-# translate crowdin label_gal_mom_sushi_date_joey_a52cbe36:
msgid "[_R_] So, you ready for some more fun?"
msgstr "[ _R_] Итак, ты готова к веселою?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33931 #-#-# translate crowdin label_gal_mom_sushi_date_joey_c5a107e6:
msgid "[_M_] Really?... I kind of thought our date was over."
msgstr "Правда? Я думал, что наша дата закончилась."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33932 #-#-# translate crowdin label_gal_mom_sushi_date_joey_bede9e5d:
msgid "[_R_] I had one more little adventure in mind."
msgstr "У меня было еще одно маленькое приключение."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33933 #-#-# translate crowdin label_gal_mom_sushi_date_joey_0eea338b:
msgid "[_R_] That is, if you're still up for some fun."
msgstr "То есть, если ты все еще хочешь немного повеселиться."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33934 #-#-# translate crowdin label_gal_mom_sushi_date_joey_21d94d7f:
msgid "[_M_] Hmmm... More fun than we've already had?"
msgstr "[ _M_] Hmmm ... Веселее, чем у нас уже было?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33937 #-#-# translate crowdin label_gal_mom_sushi_date_joey_2a065f78:
msgid "[_M_] Yes, please!"
msgstr "[ _M_] Да, пожалуйста!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33938 #-#-# translate crowdin label_gal_mom_sushi_date_joey_22715e52:
msgid "[_R_] Awesome! Now, when you get to our road, don't turn down it... Just keep going straight towards the ocean."
msgstr "[ _R_] Великолепно! А теперь, когда ты доберишься до нашей дороги, не выключай ... Просто продолжай идти прямо к океану."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33947 #-#-# translate crowdin label_gal_pizza_date_matt_b4d1bf22:
msgid "[_R_] See?... What did I tell you?"
msgstr "[ _R_] Смотрите? ... Что я тебе говорил?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33948 #-#-# translate crowdin label_gal_pizza_date_matt_69eb8bf9:
msgid "[_MT_] {i}That woman looks like me ten years ago.{/i}"
msgstr "[_MT_] {i}Эта женщина выглядит мне десять лет назад.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33949 #-#-# translate crowdin label_gal_pizza_date_matt_015b8f8c:
msgid "[_MT_] {i}I need to warn her!{/i}"
msgstr "[_MT_] {i}Мне нужно ее предупредить!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33950 #-#-# translate crowdin label_gal_pizza_date_matt_692b3472:
msgid "[_MT_] {i}Keep that son of yours away from incest games!{/i}"
msgstr "[_MT_] {i}Держите этого сына от игры inces!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33951 #-#-# translate crowdin label_gal_pizza_date_matt_9eaf5062:
msgid "[_R_] Mom?"
msgstr "Мам?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33954 #-#-# translate crowdin label_gal_pizza_date_matt_836ca93d:
msgid "[_M_] Didn't this used to be Paul's Pizza?"
msgstr "Не раньше ли это была Пицца Пола?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33955 #-#-# translate crowdin label_gal_pizza_date_matt_fa3b5526:
msgid "[_R_] Maybe, it just re-opened last year. Now it's called \"The La Trattoria\"."
msgstr "[ _R_] Может быть, она только что открылась в прошлом году. Теперь она называется \"The La Trattoria\"."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33956 #-#-# translate crowdin label_gal_pizza_date_matt_a5b744f5:
msgid "[_M_] You mean La Trattoria."
msgstr "Вы имеете в виду Ла Траттория."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33957 #-#-# translate crowdin label_gal_pizza_date_matt_29aad80e:
msgid "[_R_] No, I'm pretty sure it's The La Trattoria"
msgstr "Нет, я уверен, что это \"The La Trattoria\""

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33958 #-#-# translate crowdin label_gal_pizza_date_matt_92d77159:
msgid "[_M_] But that means it's called The The Tratt... Never mind."
msgstr "[_M_] Но это означает, что это называется Трат... Ничего."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33959 #-#-# translate crowdin label_gal_pizza_date_matt_63c62402:
msgid "[_R_] Should we find a seat?"
msgstr "[_R_] Нужно ли нам найти место?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33962 #-#-# translate crowdin label_gal_pizza_date_matt_31331a46:
msgid "[_M_] Okay, lets go sit in a booth in that dark corner over there."
msgstr "[ _M_] Хорошо, давайте сядем в кабинку в этом темном углу."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33963 #-#-# translate crowdin label_gal_pizza_date_matt_27a190cb:
msgid "[_R_] Okay, but the waitress might not see us over..."
msgstr "Хорошо, но официантка нас не увидит ..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33964 #-#-# translate crowdin label_gal_pizza_date_matt_0911d791:
msgid "[_R_] Oh... Never mind."
msgstr "[ _R_] Oh ... Не обращай внимания."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33967 #-#-# translate crowdin label_gal_pizza_date_matt_2dbb0075:
msgid "[_R_] It's not too pricey and the food is excellent!"
msgstr "[_R_] Это не слишком дорогой и еда отлична!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33968 #-#-# translate crowdin label_gal_pizza_date_matt_da238438:
msgid "[_M_] I can't wait."
msgstr "Я не могу ждать."

