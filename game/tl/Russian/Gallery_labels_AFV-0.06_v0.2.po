# game/Gallery_labels_AFV-0.06_v0.2.rpy:21158 #-#-# translate crowdin label_gal_aunt_05_c003a8db:
msgid "[_C_] There's nothing to talk about. In fact, I never want to hear about it ever again."
msgstr "[ _C_] Не о чем говорить. На самом деле, я никогда больше не хочу об этом слышать."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21159 #-#-# translate crowdin label_gal_aunt_05_45edbafe:
