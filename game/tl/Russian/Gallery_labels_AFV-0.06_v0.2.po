# game/Gallery_labels_AFV-0.06_v0.2.rpy:25214 #-#-# translate crowdin label_gal_Xmas_event_1cb0423e:
msgid "[_RT_] {i}Trust me, I'm keeping a mental list of things I need to change.{/i}"
msgstr "[_RT_] {i}Доверяю мне, я веду список необходимых мне вещей.{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:25215 #-#-# translate crowdin label_gal_Xmas_event_b8544f5a:
msgid "[_RT_] {i}Though they're not the kind of changes your sisters would want me to make.{/i}"
