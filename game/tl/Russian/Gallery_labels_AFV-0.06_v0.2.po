# game/Gallery_labels_AFV-0.06_v0.2.rpy:21088 #-#-# translate crowdin label_gal_aunt_05_d856478d:
msgid "[_C_] The Ace! I saw that ace two hands ago. It shouldn't have still been in the deck."
