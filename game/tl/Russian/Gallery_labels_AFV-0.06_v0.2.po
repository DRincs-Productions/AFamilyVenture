# game/Gallery_labels_AFV-0.06_v0.2.rpy:21089 #-#-# translate crowdin label_gal_aunt_05_bcfcd6dc:
msgid "[_J_] Well, no... The shoe has six decks in it."
msgstr "Ну, нет ... В туфле шесть палуб."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21092 #-#-# translate crowdin label_gal_aunt_05_9b9c6d76:
msgid "[_C_] You can't do that!"
msgstr "[_C_] Вы не можете сделать это!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21093 #-#-# translate crowdin label_gal_aunt_05_3c2551b4:
