# game/Gallery_labels_AFV-0.06_v0.2.rpy:21119 #-#-# translate crowdin label_gal_aunt_05_5170838f:
msgid "[_RT_] {i}Goddammit!{/i}"
msgstr "[_RT_] {i}Goddammit!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21120 #-#-# translate crowdin label_gal_aunt_05_4685db1f:
msgid "[_RT_] {i}How stupid can she be?{/i}"
