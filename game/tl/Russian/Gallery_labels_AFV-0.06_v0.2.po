# game/Gallery_labels_AFV-0.06_v0.2.rpy:21126 #-#-# translate crowdin label_gal_aunt_05_385ac909:
msgid "[_RT_] {i}I hate her guts right now, but she's still my aunt. Mandy would be devastated if anything happened to her mom.{/i}"
msgstr "[ _RT_] {i}Я ненавижу ее китов прямо сейчас, но она все еще моя тетя. Мэнди была бы опустошена, если бы что-нибудь случилось с ее мамой. { /i }"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:21127 #-#-# translate crowdin label_gal_aunt_05_b7680fa3:
