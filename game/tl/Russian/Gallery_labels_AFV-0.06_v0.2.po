# game/Gallery_labels_AFV-0.06_v0.2.rpy:13758 #-#-# translate crowdin label_gal_Sidney_park_activities_5b557bee:
msgid "[_MS_] Goodbye, my savior!"
msgstr "[ _MS_] Прощай, мой спасиор!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:13763 #-#-# translate crowdin label_gal_Sidney_park_activities_8d8c66e6:
