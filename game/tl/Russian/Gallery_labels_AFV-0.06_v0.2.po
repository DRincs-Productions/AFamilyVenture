# game/Gallery_labels_AFV-0.06_v0.2.rpy:7327 #-#-# translate crowdin label_gal_beach_date_2d316a35_2:
msgid "[_R_] Oh, God!"
msgstr "[_R_] О, Боже!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7328 #-#-# translate crowdin label_gal_beach_date_78cd2079_2:
msgid "[_M_] Yes!"
msgstr "[_M_] Да!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7337 #-#-# translate crowdin label_gal_beach_date_66164e55_1:
msgid "{i}\"Meanwhile\"{/i}"
msgstr "{i}\"Значит\"{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7340 #-#-# translate crowdin label_gal_beach_date_554b7484:
msgid "[_AD_] You sure you want to come?"
msgstr "[_AD_] Вы уверены, что хотите приехать?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7341 #-#-# translate crowdin label_gal_beach_date_e5343ba0:
msgid "[_AD_] We both know how to dispose of a corpse, you know?"
msgstr "[_AD_] Мы оба знаем, как избавиться от трупа, понимаешь?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7342 #-#-# translate crowdin label_gal_beach_date_745c9267:
msgid "[_J_] Oh, no... I want to burry that traitorous son of a bitch personally."
msgstr "[_J_] О, нет... Я хочу лично похоронить этого предателя и сукина сына."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7343 #-#-# translate crowdin label_gal_beach_date_b35441f5:
msgid "[_J_] Do we need to watch out for the police?"
msgstr "[_J_] Нужно ли нам следить за полицией?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7344 #-#-# translate crowdin label_gal_beach_date_0ee9daa0:
msgid "[_AD_] No... Sergeant Philips said he'd keep the beach clear tonight, and take off as soon as I radio him, which I've done."
msgstr "[_AD_] Нет... Сержант Филипс сказал, что сегодня ночью он будет держать пляж чистым и улетит, как только я свяжусь с ним по радио, что я и сделал."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7345 #-#-# translate crowdin label_gal_beach_date_d588d203:
msgid "[_J_] Perfect, Diaz! You're a real asset to the family."
msgstr "[_J_] Отлично, Диас! Ты настоящий подарок для семьи."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7346 #-#-# translate crowdin label_gal_beach_date_255d4000:
msgid "[_AD_] Thank you, sir!"
msgstr "[_AD_] Спасибо, сэр!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7352 #-#-# translate crowdin label_gal_beach_date_7e571462:
msgid "{i}(Sound of footsteps in the sand){/i}"
msgstr "{i}(Звук шагов по песку){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7355 #-#-# translate crowdin label_gal_beach_date_6bd29fae:
msgid "{i}(Muffled noise coming from the shacks){/i}"
msgstr "{i}(измельченный шум, исходящий из лачуг){/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7356 #-#-# translate crowdin label_gal_beach_date_9981b96c:
msgid "[_J_] Wait, did you hear something?"
msgstr "[_J_] Подожди, ты что-нибудь слышал?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7363 #-#-# translate crowdin label_gal_beach_date_eb6ead1f_1:
msgid "[_MT_] {i}Oh, yes!... God that feels...{/i}"
msgstr "[_MT_] {i}О, да!... Боже, как это...{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7364 #-#-# translate crowdin label_gal_beach_date_146a6218:
msgid "[_X_] Hey! Is somebody in there?"
msgstr "[_X_] Эй! Там кто-нибудь есть?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7367 #-#-# translate crowdin label_gal_beach_date_245a6d21_1:
msgid "[_M_] Oh, shit! Somebody's outside!"
msgstr "[_M_] Ох, чёрт! Кто-то снаружи!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7368 #-#-# translate crowdin label_gal_beach_date_0c8661aa:
msgid "[_M_] Goddammit! Are the police back?"
msgstr "[_M_] Чёрт возьми! Полиция вернулась?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7369 #-#-# translate crowdin label_gal_beach_date_fadf8045_1:
msgid "[_M_] [ryan], you'd better check it out!"
msgstr "[_M_] [ryan], вы можете проверить это!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7375 #-#-# translate crowdin label_gal_beach_date_ea4cd1ee:
msgid "[_RT_] {i}No, not Joey! Not Diaz! Anyone else, Goddammit!{/i}"
msgstr "[_RT_] {i}Нет, не Joey! Не радуйся! Никто другой, Goddammit!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7376 #-#-# translate crowdin label_gal_beach_date_aea8e1d6_1:
msgid "[_M_] {i}(Whispering){/i} [ryan], What's going on out there?"
msgstr "[_M_] {i}(Шепотая){/i} [ryan], Что там происходит?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7379 #-#-# translate crowdin label_gal_beach_date_b0ce5225:
msgid "[_R_] It's Agent Diaz, Joey Decapo and his goon! They're just standing out there."
msgstr "[_R_] Это же агент Диас, Джоуи Декапо и его приспешник! Они просто стоят там."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7380 #-#-# translate crowdin label_gal_beach_date_63034c7f_1:
msgid "[_M_] Shit!... We don't want them to find us together and naked in here."
msgstr "[_M_] Черт!... Мы не хотим, чтобы они нашли нас здесь вместе и голыми."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7381 #-#-# translate crowdin label_gal_beach_date_a0ff54c7_1:
msgid "[_M_] Hurry, shut the door. Maybe they'll go away!"
msgstr "[_M_] Скорее закройте дверь. Может, они уйдут!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7384 #-#-# translate crowdin label_gal_beach_date_3dcc2f8a:
msgid "[_R_] {i}(Muffled){/i} They already know somebody's in here. I don't think I have a choice but to go talk to them."
msgstr "[_R_] {i}(Приглушённо){/i} Они уже знают, что здесь кто-то есть. Не думаю, что у меня есть выбор, кроме как пойти и поговорить с ними."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7387 #-#-# translate crowdin label_gal_beach_date_ba72b2c9:
msgid "[_J_] If you don't come out with your hands up by the time I count to three, we're going to start shooting!"
msgstr "[_J_] Если вы не выходите с руками к тому времени, когда я считаю три, мы начнем стрелять!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7388 #-#-# translate crowdin label_gal_beach_date_baa4bcc6:
msgid "[_R_] {i}(Muffled voice yelling){/i} No, Mr. Decapo, it's us! Don't shoot!"
msgstr "[_R_] {i}(Приглушённый крик){/i} Нет, мистер Декапо, это мы! Не стреляйте!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7389 #-#-# translate crowdin label_gal_beach_date_75bc360d:
msgid "[_J_] What the hell? Who's in there?"
msgstr "[_J_] Что там ада? Кто?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7390 #-#-# translate crowdin label_gal_beach_date_156ac49b:
msgid "[_R_] It's me, [ryan], and [mom_name]'s in here with me!"
msgstr "[_R_] Это я, [ryan], и [mom_name] здесь со мной!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7391 #-#-# translate crowdin label_gal_beach_date_6f5a4445:
msgid "[_M_] {i}(Muffled voice yelling){/i} Please, don't shoot!"
msgstr "[_M_] {i}(перешитый голос желтой){/i} Пожалуйста, не стреляйте!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7394 #-#-# translate crowdin label_gal_beach_date_60821e9e:
msgid "[_J_] [ryan]?... [mom_name]?..."
msgstr "[_J_] [ryan]?... [mom_name]?..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7395 #-#-# translate crowdin label_gal_beach_date_31050196:
msgid "[_J_] What the hell is going on?"
msgstr "[_J_] Что происходит?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7398 #-#-# translate crowdin label_gal_beach_date_56564c63:
msgid "[_R_] Don't worry, Mom... It's going to be okay."
msgstr "[_R_] Не волнуйтесь, мамама... Будет хорошо."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7399 #-#-# translate crowdin label_gal_beach_date_ffe158ec_1:
msgid "[_R_] Besides, I can explain away some innocent skinny dipping and hiding from the police."
msgstr "[_R_] Кроме того, я могу объяснить несколько ни в чем не повинных кожинок и скрываться от полиции."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7402 #-#-# translate crowdin label_gal_beach_date_6385c64d_1:
msgid "{i}\"One explanation later.\"{/i}"
msgstr "{i}\"Одно объяснение позже.\"{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7405 #-#-# translate crowdin label_gal_beach_date_d118bc9f:
msgid "[_J_] But why were you skinny dipping? Why weren't you just swimming in your underwear? She's your mom for fuck's sake."
msgstr "[_J_] Но почему вы понырили? Почему вы не просто плавали в нижнем белье? Она ваша мама для мысли кулака."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7406 #-#-# translate crowdin label_gal_beach_date_e936c079:
msgid "[_R_] You saw the dress she was wearing earlier. You can't wear a bra with that dress."
msgstr "[_R_] Ты видела платье, которое она носила раньше. С этим платьем нельзя носить бюстгальтер."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7407 #-#-# translate crowdin label_gal_beach_date_3cbf588d:
msgid "[_R_] I didn't want her to feel uncomfortable being the only one naked."
msgstr "[_R_] Я не хочу, чтобы она чувствовала себя некомфортным, будучи единственным."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7408 #-#-# translate crowdin label_gal_beach_date_2c51a04d:
msgid "[_AD_] Mr. DeCapo, From my observations of the family, It appears that [ryan] might have some unnatural feelings for his mom."
msgstr "[_AD_] Мистер ДеКапо, из моих наблюдений за семьей, похоже, что [ryan] может испытывать какие-то неестественные чувства к своей матери."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7411 #-#-# translate crowdin label_gal_beach_date_1302750e:
msgid "[_R_] No, I don't"
msgstr "[_R_] Нет, не знаю."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7412 #-#-# translate crowdin label_gal_beach_date_0537f264:
msgid "[_M_] {i}(Muffled through door){/i}Oh, good God!"
msgstr "[_M_] {i}(Приглушённо через дверь){/i}О, Боже!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7413 #-#-# translate crowdin label_gal_beach_date_0cae72e7:
msgid "[_J_] It's alright, My mother was a very attractive woman too. I understand these feelings."
msgstr "[_J_] Ничего, моя мама тоже была очень привлекательной женщиной. Я понимаю эти чувства."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7414 #-#-# translate crowdin label_gal_beach_date_a81b30e0:
msgid "[_RT_] {i}Fucking Agent Diaz!{/i}"
msgstr "[_RT_] Сотрудник по фьючерсам {i}поделился!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7415 #-#-# translate crowdin label_gal_beach_date_ab7495da:
msgid "[_J_] Let's just take care of this."
msgstr "[_J_] Давайте позаботимся об этом."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7416 #-#-# translate crowdin label_gal_beach_date_abf7c1f3:
msgid "[_J_] Where did you guys leave your clothes?"
msgstr "[_J_] Куда вы ребята оставили одежду?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7419 #-#-# translate crowdin label_gal_beach_date_e019d807:
msgid "[_R_] Somewhere up the beach that way. I'm not sure how far we ran from the police before we found these shacks."
msgstr "[_R_] Где-то там, на пляже. Не знаю, как далеко мы убежали от полиции, прежде чем нашли эти хижины."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7420 #-#-# translate crowdin label_gal_beach_date_4937af5a:
msgid "[_J_] Alright, here's the plan..."
msgstr "[_J_] Хорошо, вот план..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7423 #-#-# translate crowdin label_gal_beach_date_09ccec54:
msgid "[_J_] My bodyguard is going to go on ahead and get started on the business that we came her for while we help you find your clothes."
msgstr "[_J_] Мой телохранитель собирается идти вперед и начать свое дело, пришедшее к ней, пока мы помогаем вам найти свою одежду."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7424 #-#-# translate crowdin label_gal_beach_date_fe2271dd:
msgid "[_J_] I'd hate to leave such a beautiful woman naked and afraid."
msgstr "[_J_] Мне бы не хотелось оставлять такую ​​прекрасную женщину голой и напуганной."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7427 #-#-# translate crowdin label_gal_beach_date_0f01abdb:
msgid "[_M_] {i}(Muffled through door){/i} Thank you!"
msgstr "[_M_] {i}(перемешивался через дверь){/i} Спасибо!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7428 #-#-# translate crowdin label_gal_beach_date_f6328081:
msgid "[_R_] Don't worry, Mom! We'll find them as fast as we can!"
msgstr "[_R_] Не волнуйтесь, мамама! Мы найдем их так быстро, насколько это возможно!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7434 #-#-# translate crowdin label_gal_beach_date_2282a2d2:
msgid "[_R_] Wait, I thought you were coming to help."
msgstr "[_R_] Подожди, я думал, ты придёшь помочь."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7437 #-#-# translate crowdin label_gal_beach_date_c26d4aa0:
msgid "[_J_] And leave the beautiful Miss [mom_name] all by herself?"
msgstr "[_J_] И оставить прекрасную мисс [mom_name] совсем одну?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7438 #-#-# translate crowdin label_gal_beach_date_2b1ed449:
msgid "[_J_] I couldn't possibly in good conscience leave her..."
msgstr "[_J_] Я не мог в хорошем сознании уйти из него..."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7439 #-#-# translate crowdin label_gal_beach_date_3ebfa53b_1:
msgid "[_M_] {i}(Muffled yelling){/i} I would feel better if someone were here guarding the door."
msgstr "[_M_] {i}(Приглушенный крик){/i} Мне было бы лучше, если бы кто-то охранял дверь."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7440 #-#-# translate crowdin label_gal_beach_date_f96dcc2d_1:
msgid "[_R_] I should stay, then!"
msgstr "[_R_] Тогда мне следует остаться!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7441 #-#-# translate crowdin label_gal_beach_date_37d08b7e:
msgid "[_J_] Don't be an idiot! You're the only one who knows where your clothes might be."
msgstr "[_J_] Не идиот! Вы единственный, кто знает, где может быть твоя одежда."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7442 #-#-# translate crowdin label_gal_beach_date_d5372f47:
msgid "[_J_] Don't worry, I'm going to take good care of your mom."
msgstr "[_J_] Не волнуйтесь, я буду заботиться о твоей маме."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7444 #-#-# translate crowdin label_gal_beach_date_6fcb90de:
msgid "[_AD_] Come on, [ryan]."
msgstr "[_AD_] Давай, [ryan]."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7445 #-#-# translate crowdin label_gal_beach_date_efb1ab24:
msgid "[_R_] No... Let Agent Diaz stay!"
msgstr "[_R_] Нет... Пусть агент Диас останется!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7446 #-#-# translate crowdin label_gal_beach_date_3577c871:
msgid "[_AD_] I said, come on!"
msgstr "[_AD_] Я сказал, давай!"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7452 #-#-# translate crowdin label_gal_beach_date_06d7eccb_1:
msgid "{i}\"(Knocking on door)\"{/i}"
msgstr "{i}\"(стукивание в дверь)\"{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7453 #-#-# translate crowdin label_gal_beach_date_a6ab63ed:
msgid "[_J_] {i}(Voice through door){/i} Miss [mom_name], You there?"
msgstr "[_J_] {i}(Голос через дверь){/i} Мисс [mom_name], вы там?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7454 #-#-# translate crowdin label_gal_beach_date_cbb5f2bf_1:
msgid "[_M_] Yeah... I'm here."
msgstr "[_M_] Да... Я здесь."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7455 #-#-# translate crowdin label_gal_beach_date_5f1b534c:
msgid "[_J_] You okay?"
msgstr "[_J_] Ты в порядке?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7456 #-#-# translate crowdin label_gal_beach_date_eb2f60d5_1:
msgid "[_M_] Yeah, just really embarrassed."
msgstr "[_M_] Да, просто очень стыдно."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7457 #-#-# translate crowdin label_gal_beach_date_5da42ab9_1:
msgid "[_MT_] {i}And somehow still horny!{/i}"
msgstr "[_MT_] {i}И почему-то всё ещё возбужден!{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7458 #-#-# translate crowdin label_gal_beach_date_936f6777:
msgid "[_J_] You really don't need to worry, [mom_name]. I'm not the kind of man who judges."
msgstr "[_J_] Тебе действительно не о чем беспокоиться, [mom_name]. Я не из тех, кто осуждает."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7461 #-#-# translate crowdin label_gal_beach_date_0b3eb3e0:
msgid "[_M_] I should hope not, I'm sure you've done things that would make my blood run cold."
msgstr "[_M_] Надеюсь, что нет. Уверен, ты совершил поступки, от которых у меня застыла бы кровь."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7462 #-#-# translate crowdin label_gal_beach_date_0b9609df:
msgid "[_J_] Despite what you may believe, I'm not a monster."
msgstr "[_J_] Что бы вы ни думали, я не монстр."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7463 #-#-# translate crowdin label_gal_beach_date_625817c4:
msgid "[_J_] I was born into this world, I didn't choose it. I try to run our family business as ethically and fair as possible."
msgstr "[_J_] Я родился в этом мире, я его не выбирал. Я стараюсь вести наш семейный бизнес максимально этично и честно."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7464 #-#-# translate crowdin label_gal_beach_date_f89e116e:
msgid "[_J_] Not to say I don't use our money and influence to gain advantages, but who doesn't?"
msgstr "[_J_] Не говорить, что я не использую наши деньги и влияние для получения преимуществ, но кто нет?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7465 #-#-# translate crowdin label_gal_beach_date_f0183d2b:
msgid "[_J_] And in my situation, it's kill or be killed."
msgstr "[_J_] И в моей ситуации, это убийство или быть убитым."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7466 #-#-# translate crowdin label_gal_beach_date_bd624894:
msgid "[_J_] But I respect women, and I never take advantage of them."
msgstr "[_J_] Но я уважаю женщин, и я не пользуюсь ими."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7467 #-#-# translate crowdin label_gal_beach_date_680234f5:
msgid "[_M_] Oh? And making me strip at your club if I don't have enough money each week isn't taking advantage?"
msgstr "[_M_] О? А заставлять меня танцевать стриптиз в твоём клубе, если у меня нет достаточно денег, — это не злоупотребление властью?"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:7468 #-#-# translate crowdin label_gal_beach_date_ac087e0c:
msgid "[_J_] God, no!"
