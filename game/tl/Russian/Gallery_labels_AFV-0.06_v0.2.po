msgstr "{i}{b}\"Сексуальное разочарование мамы =0\"{/b}{/i}"

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33839 #-#-# translate crowdin label_gal_mom_sushi_date_joey_7bb82505:
msgid "[_G_] It doesn't matter how many times you ask, the answer is going to be the same."
msgstr "[_G_] Не важно, сколько раз вы спрашиваете, ответ будет одинаковым."

# game/Gallery_labels_AFV-0.06_v0.2.rpy:33840 #-#-# translate crowdin label_gal_mom_sushi_date_joey_d9f9657b:
